; Backups persistentes: nao usar vl-filename-mktemp, cujos nomes sao removidos ao sair.
(defun cnp:backup-name (/ stem index candidate)
  (setq stem (strcat cnp_root "/cadnorma-backup-" (rtos (getvar "CDATE") 2 8) "-") index 1)
  (setq candidate (strcat stem (itoa index) ".bak"))
  (while (findfile candidate)
    (setq index (1+ index) candidate (strcat stem (itoa index) ".bak")))
  candidate
)
; CADNorma Mac experimental. Nenhuma chamada a COM ou shell.
(defun cnp:unsupported (name)
  (alert (strcat "CADNorma Mac: indisponivel nesta versao: " name "\nDepende de menus Windows ou de SLIDELIB.EXE. Nenhuma alteracao foi iniciada."))
  (exit)
)
(defun cnp:copy-overwrite (src dst / old)
  (if (not (findfile src)) (progn (alert (strcat "Origem ausente: " src)) (exit)))
  (setq old nil)
  (if (findfile dst)
    (progn
      (setq old (cnp:backup-name))
      (if (not (vl-file-rename dst old)) (progn (alert (strcat "Falha ao preservar: " dst)) (exit)))
    )
  )
  (if (null (vl-file-copy src dst))
    (progn
      (if (findfile dst) (vl-file-delete dst))
      (if old (vl-file-rename old dst))
      (alert (strcat "Falha ao copiar: " src "\npara: " dst))
      (exit)
    )
  )
  (if old (prompt (strcat "\nVersao anterior preservada: " old)))
  T
)
(defun cnp:copy-dir (src dst / names n count)
  (if (not (vl-file-directory-p dst))
    (if (not (vl-mkdir dst)) (progn (alert (strcat "Falha ao criar: " dst)) (exit))))
  (setq names (vl-directory-files src nil 1) count 0)
  (if (not names) (progn (alert (strcat "Diretorio vazio ou inacessivel: " src)) (exit)))
  (foreach n names
    (cnp:copy-overwrite (strcat src "/" n) (strcat dst "/" n))
    (setq count (1+ count)))
  (prompt (strcat "\nArquivos copiados: " (itoa count)))
  (princ)
)
(defun cnp:edit-shortcuts ()
  (alert (strcat "Edite este arquivo no TextEdit em modo texto simples (UTF-8):\n" cnp_root "/lisp/teclado.lsp\nDepois execute CNMACATALHOS. Ao salvar, preserve a extensao .lsp."))
)
(defun c:cnmacatalhos () (load (strcat cnp_root "/lisp/teclado.lsp")) (princ))
(defun copy_shape (/ n missing)
  (setq missing nil)
  (foreach n '("interrup.shx" "perigo.shx" "cercaeletr.shx" "seta1.shx" "seta2.shx")
    (if (not (findfile n)) (setq missing (cons n missing))))
  (if missing
    (progn
      (alert (strcat "Adicione aos Support File Search Paths:\n" cnp_root "/modelos\n" cnp_root "/hatch\nRecursos SHX nao localizados. Veja INSTALACAO-E-TESTES.txt."))
      (exit)))
  T
)
(defun c:cnmacstatus ()
  (prompt (strcat "\nCADNorma Mac experimental, raiz: " cnp_root "\nPortabilidade parcial; consulte RELATORIO.html e MATRIZ-FUNCOES.csv.\nCarga e smoke test aprovados; validacao funcional parcial. LIB indisponivel: slide_image nao suportado. Veja RESULTADO-TESTES.txt.\nGERENTE abre a lista de comandos; CFG configura o desenho."))
  (princ)
)
(defun c:gerente (/ id result pick)
  (setq id (load_dialog (strcat cnp_root "/lisp/cnmac.dcl")))
  (if (< id 0) (progn (alert "Falha ao abrir cnmac.dcl") (exit)))
  (if (not (new_dialog "cnmac" id)) (progn (unload_dialog id) (exit)))
  (start_list "comandos") (mapcar 'add_list cnp_mac_commands) (end_list)
  (setq pick 0)
  (set_tile "comandos" "0")
  (action_tile "comandos" "(setq pick (atoi $value))")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq result (start_dialog))
  (unload_dialog id)
  (if (= result 1) (eval (list (read (strcat "c:" (nth pick cnp_mac_commands))))))
  (princ)
)


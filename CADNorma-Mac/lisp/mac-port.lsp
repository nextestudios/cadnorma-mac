(defun cnp:require-vars (names / n)
  (foreach n names
    (if (null (getvar n))
      (progn (alert (strcat "Variavel requerida nao disponivel: " n "\nConfiguracao interrompida antes de modificar o desenho. Veja o relatorio.")) (exit))))
  T
)

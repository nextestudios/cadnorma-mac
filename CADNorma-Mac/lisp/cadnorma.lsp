;lê os dados iniciais da DCL no arquivo de dados
(defun scd13_last_file ()
  (if (findfile (strcat cnp_root "/config/scd13_last.txt"))
    (scd13_last_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/scd13_last.txt") "w" "utf8"))
      (write-line "28" file)
      (write-line "18.75" file)
      (write-line "8" file)
      (write-line "10" file)
      (write-line "1" file)
      (write-line "110" file)
      (write-line "scd13_vis_02" file)
      (close file)
      (scd13_last_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun scd13_last_readfile ()
  (setq	file (open (strcat cnp_root "/config/scd13_last.txt") "r" "utf8"))
  (setq	scd13_var_ldeg (read-line file))
  (setq	scd13_var_hdeg (read-line file))
  (setq	scd13_var_ndeg (read-line file))
  (setq	scd13_var_llaj (read-line file))
  (setq	scd13_var_dcor (read-line file))
  (setq	scd13_var_hcor (read-line file))
  (setq	scd13_var_svis (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun scd13_last_writefile ()
  (setq	file (open (strcat cnp_root "/config/scd13_last.txt") "w" "utf8"))
  (write-line scd13_var_ldeg file)
  (write-line scd13_var_hdeg file)
  (write-line scd13_var_ndeg file)
  (write-line scd13_var_llaj file)
  (write-line scd13_var_dcor file)
  (write-line scd13_var_hcor file)
  (write-line scd13_var_svis file)
  (close file)
)

;procedimento inicial para escadas
(defun scd13_start ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (scd13_last_file)
  (scd13_layc_file)
  (cond
    ((= cn7_dwgunit 1) (setq scd13_fator 0.01 scd13_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq scd13_fator 1.0 scd13_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq scd13_fator 10.0 scd13_blkscl 1000.0))
  )
)


;cnp_21_d_janelas

;Cadnorma Professional
;iniciado em 10/12/10
;programa de janelas
(defun c:jn ()
  ;arquivo inicial
  (jnl_last_file)
  (jnl_main)
)

;aber a DCL principal
(defun jnl_main ()
  (cn7_init)
  ;abre a caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "janela" dcl_id)) (exit))
  ;atualização de slides
  (jnl_update_slides)
    (if
    (or (= "31" jnl_var_tipo) (= "32" jnl_var_tipo) (= "33" jnl_var_tipo) (= "34" jnl_var_tipo)
	(= "41" jnl_var_tipo) (= "42" jnl_var_tipo) (= "43" jnl_var_tipo) (= "44" jnl_var_tipo))
    (mode_tile "jnl_cfg_detype" 0)
    (mode_tile "jnl_cfg_detype" 1)
  )
  ;largura em retângulos
  (set_tile "jnl_getlarg_edit" jnl_var_larg)
  (action_tile "jnl_getlarg_edit" "(jnl_getlarg_editaction)")
  (action_tile "jnl_getlarg_pick" "(done_dialog 2)")
  ;largura em diâmetros
  (set_tile "jnl_getdiam_edit" jnl_var_diam)
  (action_tile "jnl_getdiam_edit" "(jnl_getdiam_editaction)")
  ;lista de alturas
  (jnl_halt_file)
  (start_list "jnl_dcl_halt")
  (mapcar 'add_list jnl_halt_list)
  (end_list)
  (set_tile "jnl_dcl_halt" jnl_var_halt)
  (action_tile "jnl_dcl_halt" "(setq jnl_var_halt $value)")
  (action_tile "jnl_halt_edit" "(done_dialog 3)")
  ;Definições por opção de largura
  (jnl_larg_def)
  (action_tile "jnl_larg_radio1" "(jnl_larg_radio_action)")
  (action_tile "jnl_larg_radio2" "(jnl_larg_radio_action)")
  (action_tile "jnl_getdiam_pick" "(done_dialog 4)")
  ;slide do Tipo Atual
  (setq x (dimx_tile "jnl_slide_type")
	y (dimy_tile "jnl_slide_type")
  )
  (start_image "jnl_slide_type")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/jnl_" jnl_var_tipo ".sld"))
  (end_image)
;;;  ;Posicionamento
  (set_tile "jnl_posi" jnl_var_posi)
  (if (= "jnl_center" jnl_var_posi)
    (mode_tile "jnl_afas_edit" 1)
    (mode_tile "jnl_afas_edit" 0)
  )
  (action_tile "jnl_posi" "(jnl_posi_action)")
  ;afastamento
  (set_tile "jnl_afas_edit" jnl_var_afas)
  (action_tile "jnl_afas_edit" "(jnl_getafas_editaction)")
  (action_tile "jnl_get_afas" "(done_dialog 5)")
  ;parede
  (set_tile "jnl_wall_edit" jnl_var_wall)
  (action_tile "jnl_wall_edit" "(jnl_getwall_editaction)")
  (action_tile "jnl_get_wall" "(done_dialog 6)")
  ;caixilho
  (set_tile "jnl_caix_edit" jnl_var_caix)
  (action_tile "jnl_caix_edit" "(jnl_getcaix_editaction)")
  (action_tile "jnl_get_caix" "(done_dialog 7)")
  ;código de identificação
  (set_tile "jnl_iden_toggle" jnl_var_iden)
  (action_tile "jnl_iden_toggle" "(setq jnl_var_iden $value)")
  (action_tile "jnl_iden_button" "(done_dialog 8)")
  (action_tile "jnl_cfg_laycol" "(done_dialog 9)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq jnl_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 jnl_dcl_id) (jnl_ok_action))
  (if (= 2 jnl_dcl_id) (jnl_getlarg_button))
  (if (= 3 jnl_dcl_id) (jnl_haltedit_action))
  (if (= 4 jnl_dcl_id) (jnl_getdiam_button))
  (if (= 5 jnl_dcl_id) (jnl_getafas_button))
  (if (= 6 jnl_dcl_id) (jnl_getwall_button))
  (if (= 7 jnl_dcl_id) (jnl_getcaix_button))
  (if (= 8 jnl_dcl_id) (jnl_cfgiden_button))
  (if (= 9 jnl_dcl_id) (jnl_laycol_button))
  (princ)
)



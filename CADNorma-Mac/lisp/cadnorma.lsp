    "as escalas originais do Cadnorma?"
    "(Escalas adicionadas serão perdidas!)"
  )
  (if (= alert_resp "ok")
    (progn
      (setq reg_scale_list
	 (list
	   "1" "10" "100" "1000" "10000" "100000" "1000000"
	   "12.5" "125" "1250" "12500" "125000"
	   "15" "150" "1500" "15000" "150000"
	   "2" "20" "200" "2000" "20000" "200000"
	   "2.500" "25" "250" "2500" "25000" "250000"
	   "3" "30" "300" "3000" "30000" "300000"
	   "4" "40" "400" "4000" "40000" "400000"
	   "5" "50" "500" "5000" "50000" "500000"
	   "7.500" "75" "750" "7500" "75000" "750000"
	 )
      )
      (setq open_file (open (strcat cnp_root "/config/reg_scale.txt") "w" "utf8"))
      (foreach n reg_scale_list
	(write-line n open_file)
      )
      (close open_file)
    )
  )
  (cn7_rscale)
)


;******************************************************************************
;Verifica se o desenho está configurado....
;******************************************************************************
(defun cn7_init ()
  (setvar "cmdecho" 0)
  (if
    (and
	    (or
	      (and
		(/= 1.0 (getvar "userr4"))
	        (/= 100.0 (getvar "userr4"))
		(/= 1000.0 (getvar "userr4"))
	      )
	      (and
		(/= 1.0 (getvar "userr5"))
		(/= 100.0 (getvar "userr5"))
		(/= 1000.0 (getvar "userr5"))
	      )
	    );or
	    (/= (strcase (substr (getvar "dwgname") 1 7) T) "drawing")
    )
    (progn
      (cn7_alert_yes_no
	"O Cadnorma não está configurado"
	"para este desenho."
	"Deseja configurá-lo agora?")
      (if (= alert_resp "yes") (cn7_cfg_main))
    )
  )
);defun

;******************************************************************************
;preferências de carregamento - Autoload e Teclado
;******************************************************************************
(defun c:prf ()
  (cn7_autoload_file)
  (cn7_autoload)
  (princ)
)

;lê os parâmetros iniciais no arquivo
(defun cn7_autoload_file ()
  (if (not (findfile (strcat cnp_root "/config/autoload.txt")))
    (progn
      (setq file (open (strcat cnp_root "/config/autoload.txt") "w" "utf8"))
      (write-line "2" file)
      (write-line "2" file)
      (close file)
    )
  )
  ;lê as condições de carregamento
  (setq	file (open (strcat cnp_root "/config/autoload.txt") "r" "utf8"))
  (setq cn7_autoload_load (read-line file))
  (setq cn7_autoload_short (read-line file))
  (close file)
)

;função principal de autocarregamento  
(defun cn7_autoload ()
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_pref" dcl_id)) (exit))
  ;carregamento cadnorma
  (cond
    ((= cn7_autoload_load "0")
     (set_tile "cn7_pref_loadask" "cn7_pref_load_yes")
    )
    ((= cn7_autoload_load "1")
     (set_tile "cn7_pref_loadask" "cn7_pref_load_ask")
    )
    ((= cn7_autoload_load "2")
     (set_tile "cn7_pref_loadask" "cn7_pref_load_no")
    )
  )
  (action_tile "cn7_pref_loadask" "(prefload_ask)")
  	;define a variável de carregamento
  	(defun prefload_ask ()
	  (setq prefload_askvar $value)
	  (cond
	    ((= prefload_askvar "cn7_pref_load_yes") (setq cn7_autoload_load "0"))
	    ((= prefload_askvar "cn7_pref_load_ask") (setq cn7_autoload_load "1"))
	    ((= prefload_askvar "cn7_pref_load_no") (setq cn7_autoload_load "2"))
	  )
	)
  ;comandos de teclado
  (cond
    ((= cn7_autoload_short "0")
     (set_tile "cn7_pref_shortcut" "cn7_pref_short0")
    )
    ((= cn7_autoload_short "1")
     (set_tile "cn7_pref_shortcut" "cn7_pref_short1")
    )
    ((= cn7_autoload_short "2")
     (set_tile "cn7_pref_shortcut" "cn7_pref_short2")
    )
  )
  (action_tile "cn7_pref_shortcut" "(prefload_short)")
  	;define a variável de teclado
  	(defun prefload_short ()
	  (setq prefload_shortvar $value)
	  (cond
	    ((= prefload_shortvar "cn7_pref_short0") (setq cn7_autoload_short "0"))
	    ((= prefload_shortvar "cn7_pref_short1") (setq cn7_autoload_short "1"))
	    ((= prefload_shortvar "cn7_pref_short2") (setq cn7_autoload_short "2"))
	  )
	)
  ;demais ações
  (action_tile "cn7_pref_editshort" "(done_dialog 2)")
  (action_tile "cn7_pref_resetshort" "(done_dialog 3)")  
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq cn_autoload_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 3 cn_autoload_dialog)
    (progn
      (cn7_alert_yes_no
	"Deseja realmente restaurar"
	"os atalhos originais do Cadnorma?"
	"Modificações feitas serão perdidas!"
      )
      (if (= alert_resp "yes")
	(cnp:copy-overwrite (strcat cnp_root "/lisp/shortcut.lsp") (strcat cnp_root "/lisp/teclado.lsp"))
      )
    );progn
  );if   
  (if (= 2 cn_autoload_dialog) (cnp:edit-shortcuts))
  (if (= 1 cn_autoload_dialog) (cn7_autoload_ok))
);defun

;acionado OK, grava o arquivo!
(defun cn7_autoload_ok ()
  (setq file (open (strcat cnp_root "/config/autoload.txt") "w" "utf8"))
  (write-line cn7_autoload_load file)
  (write-line cn7_autoload_short file)
  (close file)
)


;******************************************************************************
;comando de configuração do desenho

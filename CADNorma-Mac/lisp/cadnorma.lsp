(defun c:cfg ()
  (cn7_cfg_main)
  (princ)
)

;******************************************************************************
;função principal de configuração
;******************************************************************************
(defun cn7_cfg_main ()
  (setq cn7_dwgspace 1
	cn7_cfgmain_return 0)
  ;inicializando caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cnp_cfg_main" dcl_id)) (exit))
  ;lê os parâmetros iniciais
  (start_list "cn10_radio_space") (mapcar 'add_list '("Model Space" "Layout (Paper Space)")) (end_list)
  (start_list "cn7_cfgmain_dwgunit") (mapcar 'add_list '("metros" "centímetros" "milímetros")) (end_list)
  (start_list "cn7_cfgmain_dimunit") (mapcar 'add_list '("metros" "centímetros" "milímetros")) (end_list)
  (cn7_cfg_defaults)
  (action_tile "cn10_radio_space" "(cn10_cfgmain_space)")
  	(defun cn10_cfgmain_space () (setq cfgdata_app_space $value))
  (action_tile "cn7_cfgmain_dwgunit" "(cn7_cfgmain_dwgunit)")
      (defun cn7_cfgmain_dwgunit () (setq cfgdata_dwgunit $value cfgdata_dimunit $value) (set_tile "cn7_cfgmain_dimunit" $value))
  ;Escolha da unidade de cotagem
  (action_tile "cn7_cfgmain_dimunit" "(cn7_dcl_dimunit)")
  	(defun cn7_dcl_dimunit () (setq cfgdata_dimunit $value))
  ;toggle limits
  (action_tile "cn7_toggle_limits" "(cfgmain_toggle_limits_action)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cn7_cfg_pref_limits" "(done_dialog 2)")
  (action_tile "cn7_cfg_pref_text" "(done_dialog 3)")
  (action_tile "cn7_cfg_pref_dim" "(done_dialog 4)")
  (action_tile "cn7_cfg_pref_layer" "(done_dialog 5)")
  (setq cn_cfgmain_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 cn_cfgmain_dialog) (cn7_cfgmain_ok))
  (if (= 2 cn_cfgmain_dialog)
    (progn
      (cn7_cfgmain_savecfg)
      (setq cn7_cfgmain_return 1)
      (cn7_cfgmain_limits)
    )
  )
  (if (= 3 cn_cfgmain_dialog)
    (progn
      (cn7_cfgmain_savecfg)
      (setq cn7_cfgmain_return 1)
      (cn7_cfgmain_text)
    )
  )
  (if (= 4 cn_cfgmain_dialog)
    (progn
      (cn7_cfgmain_savecfg)
      (setq cn7_cfgmain_return 1)
      (cn7_cfgmain_dim)
    )
  )
  (if (= 5 cn_cfgmain_dialog)
    (progn
      (cn7_cfgmain_savecfg)
      (setq cn7_cfgmain_return 1)
      (cn7_cfgmain_layer)
    )
  )
);defun


;ação do botão limites
(defun cfgmain_toggle_limits_action ()
;;;  (setq denio $value)
  (setq cfgdata_app_limits $value)
  (if (= "1" cfgdata_app_limits)
    (progn
      (setq cfgdata_app_limits "1")
      (mode_tile "cn7_cfg_pref_limits" 1)
    )
    (progn
      (setq cfgdata_app_limits "0")
      (mode_tile "cn7_cfg_pref_limits" 0)
    )
  )
;;;  (cn7_cfgmain_savecfg)
)

;********************************************************
;lê os parâmetros iniciais
;********************************************************
(defun cn7_cfg_defaults ()
  (if (not (findfile (strcat cnp_root "/config/config.txt")))
    (progn
      (setq file1 (open (strcat cnp_root "/config/config.txt") "w" "utf8"))
      (repeat 7
	(write-line "0" file1)
      )
      (close file1)
    )
  )
  (setq file1 (open (strcat cnp_root "/config/config.txt") "r" "utf8")
	cfgdata_dwgunit (read-line file1)
	cfgdata_dimunit (read-line file1)
	cfgdata_app_limits (read-line file1)
	cfgdata_app_text (read-line file1)
	cfgdata_app_dim (read-line file1)
	cfgdata_app_layer (read-line file1)
	cfgdata_app_space (read-line file1)
  )
  (close file1)
  ;vai setar os defaults na caixa de diálogo
  (cond
    ((= "0" cfgdata_dwgunit) (set_tile "cn7_cfgmain_dwgunit" "0"))
    ((= "1" cfgdata_dwgunit) (set_tile "cn7_cfgmain_dwgunit" "1"))
    ((= "2" cfgdata_dwgunit) (set_tile "cn7_cfgmain_dwgunit" "2"))
  )
  (cond
    ((= "0" cfgdata_dimunit) (set_tile "cn7_cfgmain_dimunit" "0"))
    ((= "1" cfgdata_dimunit) (set_tile "cn7_cfgmain_dimunit" "1"))
    ((= "2" cfgdata_dimunit) (set_tile "cn7_cfgmain_dimunit" "2"))
  )
  (cond
    ((= "0" cfgdata_app_space) (set_tile "cn10_radio_space" "0"))
    ((= "1" cfgdata_app_space) (set_tile "cn10_radio_space" "1"))
  )
  (cond
    ((= "0" cfgdata_app_limits) (set_tile "cn7_toggle_limits" "0"))
    ((= "1" cfgdata_app_limits) (set_tile "cn7_toggle_limits" "1"))
  )
)
  

;salva o arquivo de defaults
(defun cn7_cfgmain_savecfg ()
  (setq file1 (open (strcat cnp_root "/config/config.txt") "w" "utf8"))
  (write-line cfgdata_dwgunit file1)
  (write-line cfgdata_dimunit file1)
  (write-line cfgdata_app_limits file1)
  (write-line cfgdata_app_text file1)
  (write-line cfgdata_app_dim file1)
  (write-line cfgdata_app_layer file1)
  (write-line cfgdata_app_space file1)
  (close file1)
)




;Desenha a porta
(defun prt_drw42 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt42_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_openfree 4.0)
  (prt_drw42_caixilho)
  (prt_drw42_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw42_alisar)
  )
  (prt_drw42_porta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)


;*****************************************
;Desenho das Portas                       
;*****************************************
(defun prt_drw42_porta ()
  (setq s1 (ssadd)
	prt_porta0 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	prt_porta1 (polar prt_porta0 (+ prt_angortho pi) (* prt_fator (distof prt_pt42_poe)))
	prt_porta2 (polar prt_porta1 (+ prt_angbase (/ pi 4)) (/ prt_larg 4.0))
	prt_porta3 (polar prt_porta2 (- prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt42_poe)))
	prt_porta4 (polar prt_porta1 (- prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt42_poe)))
	prt_porta5 (polar prt_porta3 (+ prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt42_poe)))
	prt_porta6 (polar prt_porta5 (- prt_angbase (/ pi 4)) (/ prt_larg 4.0))
	prt_porta7 (polar prt_porta3 (- prt_angbase (/ pi 4)) (/ prt_larg 4.0))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2 "_non" prt_porta3 "_non" prt_porta4 "_c")
  (setq s1 (ssadd (entlast) s1))
  (command "._pline" "_non" prt_porta3 "_non" prt_porta5 "_non" prt_porta6 "_non" prt_porta7 "_c")
  (setq s1 (ssadd (entlast) s1))
  (command ".mirror" s1 "" "_non" prt_mid1 "_non" prt_mid2 "_n")
)

;*****************************************
;Desenho das Alisares                     
;*****************************************
(defun prt_drw42_alisar ()
  (cn7_verylayer prt_layc_all 7)
  (setvar "cecolor" prt_layc_alc)
  ;internos
  (if (= "1" prt_pt42_ali)
    (progn
      (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* 1.0 prt_fator))
	    prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ali_a4 (polar prt_ali_a3 prt_angortho (* 1.0 prt_fator))
	    prt_ali_b1 (polar prt_cxi2 prt_angbase (* 1.0 prt_fator))
	    prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_b3 (polar prt_ali_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ali_b4 (polar prt_ali_b3 prt_angortho (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
      (command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
    )
  )
  (if (= "1" prt_pt42_ale)
    (progn
      (setq prt_ale_a1 (polar prt_cxi3 (+ prt_angbase pi) (* 1.0 prt_fator))
	    prt_ale_a2 (polar prt_ale_a1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_a3 (polar prt_ale_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ale_a4 (polar prt_ale_a3 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ale_b1 (polar prt_cxi4 prt_angbase (* 1.0 prt_fator))
	    prt_ale_b2 (polar prt_ale_b1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_b3 (polar prt_ale_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ale_b4 (polar prt_ale_b3 (+ prt_angortho pi) (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ale_a1 "_non" prt_ale_a2 "_non" prt_ale_a3 "_non" prt_ale_a4 "")
      (command "._line" "_non" prt_ale_b1 "_non" prt_ale_b2 "_non" prt_ale_b3 "_non" prt_ale_b4 "")
    )
  )
)


;*****************************************
;Desenho das Soleiras                     
;*****************************************
(defun prt_drw42_soleira ()
  (cn7_verylayer prt_layc_sol 7)
  (setvar "cecolor" prt_layc_soc)

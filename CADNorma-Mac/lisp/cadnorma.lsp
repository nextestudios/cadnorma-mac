;configuração das notas
(defun nog_cfg_action ()
  (nog_cfg_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "nog_config" dcl_id)) (exit))
  ;layer das notas gerais
  (set_tile "nog_cfg_alllay" nogcfg_alllay)
  ;título
  (set_tile "nog_cfg_tittxt" nogcfg_tittxt)
  (action_tile "nog_cfg_tittxt" "(setq nogcfg_tittxt $value)")
  ;estilo do título
  (setq nog_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			   "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (start_list "nog_cfg_titsty")
  (mapcar 'add_list nog_stylist)
  (end_list)
  (set_tile "nog_cfg_titsty" nogcfg_titsty)
  (action_tile "nog_cfg_titsty" "(setq nogcfg_titsty $value)")
  ;cor do título
  (start_image "nog_cfg_titcol")
  (fill_image  0  0
    (dimx_tile "nog_cfg_titcol")
    (dimy_tile "nog_cfg_titcol")
    (fix (distof nogcfg_titcol))
  )
  (end_image)
  (action_tile "nog_cfg_titcol" "(nogcfg_titcol_action)")
  ;estilo das notas
  (setq nog_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			  "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (start_list "nog_cfg_notsty")
  (mapcar 'add_list nog_stylist)
  (end_list)
  (set_tile "nog_cfg_notsty" nogcfg_notsty)
  (action_tile "nog_cfg_notsty" "(setq nogcfg_notsty $value)")
  ;cor das notas
  (start_image "nog_cfg_notcol")
  (fill_image  0  0
    (dimx_tile "nog_cfg_notcol")
    (dimy_tile "nog_cfg_notcol")
    (fix (distof nogcfg_notcol))
  )
  (end_image)
  (action_tile "nog_cfg_notcol" "(nogcfg_notcol_action)")
  ;ações dos botões ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq nog_cfg_dcl (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 nog_cfg_dcl)
    (progn
      (nog_cfg_writefile)
      (if (= nog_backey 1)
	(nog_main)
	(nog_action)
      )
    )
  )
)


;*****************************************
;Desenho das Maçanetas                    
;*****************************************
(defun prt_drw11_maçaneta ()
  (setq prt_mac1 (polar prt_porta4 prt_angortho (* 7.0 prt_fator))
	prt_mac2 (polar prt_porta3 prt_angortho (* 7.0 prt_fator))
  )
  (cond

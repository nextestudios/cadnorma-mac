;decimais de textos        
(defun c:txd ()
  (setq tx_dec (getint "\nEntre com o número de casas dedimais desejado...<Enter = 0>..."))
  (if (= nil tx_dec) (setq tx_dec 0))
  (prompt "\nSelecione os textos a serem transformados...")
  (setq tx_s1 (ssget '((0 . "TEXT"))))
  (setq tx_s1n (sslength tx_s1) counter 0)
  (repeat tx_s1n
    (setq tx_ent (entget (ssname tx_s1 counter)))
    (setq tx_txt (assoc 1 tx_ent))
    (if (and (/= nil tx_txt) (distof (cdr tx_txt)))
      (progn
	(setq cn7_dzin (getvar "dimzin"))
	(setvar "dimzin" 1)
	(setq tx_new (cons 1 (rtos (atof (cdr tx_txt)) 2 tx_dec)))
	(entmod (subst tx_new tx_txt tx_ent))
	(setvar "dimzin" cn7_dzin)
      );progn
    );
    (setq counter (1+ counter))
  );repeat
 (princ) 
)

;acrescenta prefixos e/ou sufixos a textos
(defun c:presufix ()
	(setq txt_prefix (getstring T "\nEntre com o prefixo..."))
  	(setq txt_sufix (getstring T "\nEntre com o sufixo..."))
  	(while (/= nil (setq s1_txt (ssget)))
	  	(setq counter 0)
	  	(while (/= nil (setq curr_ent (ssname s1_txt counter)))
		  	(if (= (strcase "text") (cdr (assoc 0 (entget curr_ent))))
			  (progn
			  	(setq new (cons 1 (strcat txt_prefix (cdr (assoc 1 (entget curr_ent))) txt_sufix)))
			  	(setq old (assoc 1 (entget curr_ent)))
			  	(entmod (subst new old (entget curr_ent)))
			  	(setq counter (1+ counter))
			  );progn
			  (setq counter (1+ counter))
			);if
		  );while
	);while
  (princ)
);defun



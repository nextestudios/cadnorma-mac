(defun prt_drw24 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt24_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_drw24_openfree 1.0)
  (prt_drw24_caixilho)
  (prt_drw24_soleira)
  (prt_drw24_batente)
  (prt_drw24_porta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)


;desenha a fechadura
(defun prt_draw_fech ()
  (setq prt_fech0 (polar prt_porta1 prt_angbase (/ (distance prt_porta1 prt_porta3) 2.0))
	prt_fech1 (polar prt_fech0 (+ pi prt_angbase) (* prt_fator 5.0))
	prt_fech2 (polar prt_fech0 prt_angbase (* prt_fator 5.0))
	prt_fech3 (polar prt_fech2 prt_angortho (* prt_fator 3.0))
	prt_fech4 (polar prt_fech1 prt_angortho (* prt_fator 3.0))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline" "_non" prt_fech1  "_non" prt_fech2  "_non" prt_fech3  "_non" prt_fech4 "_c")
)

;denio

;desenha a projeção da porta
(defun prt_draw_proj ()
  (setq prt_proj1 (polar prt_porta2 (+ pi prt_angortho) (* prt_fator (distof prt_pt24_wid)))
	prt_proj2 (polar prt_porta4 (+ pi prt_angortho) (* prt_fator (distof prt_pt24_wid)))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" "1")
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (command "._pline" "_non" prt_porta2 "_non" prt_proj1 "_non" prt_proj2 "_non" prt_porta4 "")
  (setvar "celtype" "bylayer")
)

;desenha a porta entre os batentes
(defun prt_draw24_porta ()
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (setq prt_porta1 (polar prt_bat1 prt_angbase (* prt_fator 2.0))
	prt_porta1 (polar prt_porta1 prt_angortho (/ ( * prt_fator (distof prt_pt24_poe)) 2.0))
	prt_porta2 (polar prt_porta1 (+ pi prt_angortho) ( * prt_fator (distof prt_pt24_poe)))
	prt_porta3 (polar prt_bat2 (+ pi prt_angbase) (* prt_fator 2.0))
	prt_porta3 (polar prt_porta3 prt_angortho (/ ( * prt_fator (distof prt_pt24_poe)) 2.0))
	prt_porta4 (polar prt_porta3 (+ pi prt_angortho) ( * prt_fator (distof prt_pt24_poe)))
  )
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2 "_non" prt_porta4 "_non" prt_porta3 "_c")
)

;desenha portas simples e mútiplas
(defun prt_drw24_porta ()
  (setq n_folhas (fix (distof prt_pt24_qtd)))
  (if (= n_folhas 1)
    (progn
      (prt_draw24_porta)
      (if (= "1" prt_pt24_fch) (prt_draw_fech))
      (if (= "1" prt_pt24_prj) (prt_draw_proj))
    )
    (progn
      (setq vao (/ prt_larg n_folhas)
	    prt_bat2 prt_bat1
      )
      (repeat (1- n_folhas)
	(setq prt_bat1 prt_bat2
	      prt_bat2  (polar prt_bat2 prt_angbase vao)
	      prt_bat1a (polar prt_bat1 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	      prt_bat1b (polar prt_bat1 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	      prt_bat1c (polar prt_bat1a prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	      prt_bat1d (polar prt_bat1b prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	      prt_bat2a (polar prt_bat2 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	      prt_bat2b (polar prt_bat2 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	      prt_bat2c (polar prt_bat2a (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
	      prt_bat2d (polar prt_bat2b (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
	      prt_bat2e (polar prt_bat2a prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	      prt_bat2f (polar prt_bat2b prt_angbase ( * prt_fator (distof prt_pt24_poe)))
        )
	(cn7_verylayer "Porta_batentes" 2)
	(setvar "cecolor" "bylayer")
	(if (= prt_pt24_typ "prt_24_typ1")
	  (progn
	    (command "._pline" "_non" prt_bat2c "_non" prt_bat2e "")
	    (command "._pline" "_non" prt_bat2a "_non" prt_bat2b "")
	    (command "._pline" "_non" prt_bat2d "_non" prt_bat2f "")
          )
          (progn
	    (command "._pline" "_non" prt_bat2c "_non" prt_bat2e "")
	    (command "._pline" "_non" prt_bat2a "_non" prt_bat2b "")
          )
	)
	(prt_draw24_porta)
	(if (= "1" prt_pt24_fch) (prt_draw_fech))
	(if (= "1" prt_pt24_prj) (prt_draw_proj))
      );repeat
      (setq prt_bat1 prt_bat2
	    prt_bat2 (polar prt_bat2 prt_angbase vao)
	    prt_bat1a (polar prt_bat1 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	    prt_bat1b (polar prt_bat1 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	    prt_bat1c (polar prt_bat1a prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	    prt_bat1d (polar prt_bat1b prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	    prt_bat2a (polar prt_bat2 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	    prt_bat2b (polar prt_bat2 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	    prt_bat2c (polar prt_bat2a (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
	    prt_bat2d (polar prt_bat2b (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
      )
      (prt_draw24_porta)
      (if (= "1" prt_pt24_fch) (prt_draw_fech))
      (if (= "1" prt_pt24_prj) (prt_draw_proj))
     )	    
  )
)


;desenha os batentes para os dois tipos de portas
(defun prt_drw24_batente ()
  (setq prt_bat1 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	prt_bat2 (polar prt_cxi2 prt_angortho (/ prt_wall 2.0))
	prt_bat1a (polar prt_bat1 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	prt_bat1b (polar prt_bat1 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	prt_bat1c (polar prt_bat1a prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	prt_bat1d (polar prt_bat1b prt_angbase ( * prt_fator (distof prt_pt24_poe)))
	prt_bat2a (polar prt_bat2 (+ pi prt_angortho) (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	prt_bat2b (polar prt_bat2 prt_angortho (+ (/ ( * prt_fator (distof prt_pt24_poe)) 2.0) (* prt_fator 2)))
	prt_bat2c (polar prt_bat2a (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
	prt_bat2d (polar prt_bat2b (+ pi prt_angbase) ( * prt_fator (distof prt_pt24_poe)))
  )
  (cn7_verylayer "Porta_guias" 2)
  (setvar "cecolor" "bylayer")
  (if (= prt_pt24_typ "prt_24_typ1")
    (progn
      (command "._pline" "_non" prt_bat1c "_non" prt_bat1a "_non" prt_bat1b "_non" prt_bat1d "")
      (command "._pline" "_non" prt_bat2c "_non" prt_bat2a "_non" prt_bat2b "_non" prt_bat2d "")
    )
    (progn
      (command "._pline" "_non" prt_bat1c "_non" prt_bat1a "_non" prt_bat1b "")
      (command "._pline" "_non" prt_bat2c "_non" prt_bat2a "_non" prt_bat2b "")
    )
  )
)
    


;verifica se o valor de quantidade entrada é válida
(defun prt_24_qtd_edit_act ()
  (setq prt_var_newqtd $value)
  (if (and (distof prt_var_newqtd)
	   (equal (distof prt_var_newqtd) (fix (distof prt_var_newqtd)))
      )
    (progn
      (setq prt_pt24_qtd prt_var_newqtd)
      (prt_pt24_writefile)
    )
    (progn
      (alert "Valor Inválido!\nDigite um número inteiro.")
      (set_tile "prt_24_qtd_edit" prt_pt24_qtd)
      (mode_tile "prt_24_qtd_edit" 2)
    )
  )
)  


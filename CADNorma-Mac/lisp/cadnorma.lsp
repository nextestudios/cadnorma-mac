;altera a coleção d escalas regulares
(defun c:rscale ()
  (setq rscale_nova nil rscale_list_n nil)
  (reg_scale)
  (cn7_rscale)
  (princ)
)

;abre e gerencia DCL
(defun cn7_rscale ()
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_regscale" dcl_id)) (exit))
  (start_list "cn7_rscale_list")
  (mapcar 'add_list reg_scale_list)
  (end_list)
  (action_tile "cn7_rscale_list" "(setq rscale_list_n $value)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cn7_rscale_add" "(done_dialog 2)")
  (action_tile "cn7_rscale_remove" "(done_dialog 3)")
  (action_tile "cn7_rscale_reset" "(done_dialog 4)")
  (setq rscale_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 rscale_dialog) (rscale_ok))
  (if (= 2 rscale_dialog) (rscale_add))
  (if (= 3 rscale_dialog) (rscale_remove))
  (if (= 4 rscale_dialog) (rscale_reset))
)

;Função OK
(defun rscale_ok ()
  (setq open_file (open (strcat cnp_root "/config/reg_scale.txt") "w" "utf8"))
      (foreach n reg_scale_list
	(write-line n open_file)
      )
      (close open_file)
)

;função Adicionar
(defun rscale_add ()
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_regscale_add" dcl_id)) (exit))
  (mode_tile "rscale_newscale" 2)
  (action_tile "rscale_newscale" "(setq rscale_nova $value)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq rscale_add_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 rscale_add_dialog) (rscale_add_ok))
)

;adiciona nova escala à lista
(defun rscale_add_ok ()
  (if (and (/= nil rscale_nova) (/= "" rscale_nova) (distof rscale_nova))
    (progn
      (setq reg_scale_list (acad_strlsort (append reg_scale_list (list rscale_nova))))
      (setq open_file (open (strcat cnp_root "/config/reg_scale.txt") "w" "utf8"))
      (foreach n reg_scale_list
	(write-line n open_file)
      )
      (close open_file)
      (cn7_rscale)
    )
    (progn
      (alert "Valor Inválido\nTente novamente")
      (rscale_add)
    )
  )
)

  
;remove uma escala da lista
(defun rscale_remove ()
  (if (= nil rscale_list_n)
    (progn
      (alert "Nenhuma Escala Selecionada\npara Remoção!\nTente Novamente...")
      (cn7_rscale)
    )
    (progn
      (setq counter 0 rscale_rem (fix (distof rscale_list_n))
	    rscale_len (length reg_scale_list) rscale_newlist (list ""))
      (repeat rscale_len
	(if (/= counter rscale_rem)
	  (setq rscale_newlist (append rscale_newlist (list (nth counter reg_scale_list))))
	)
	(setq counter (1+ counter))
      )
      (setq rscale_newlist (cdr rscale_newlist))
    )
  )
  (setq reg_scale_list rscale_newlist)
  (setq rscale_list_n nil)
  (cn7_rscale)
)

;Função RESET

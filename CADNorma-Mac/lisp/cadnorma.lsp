;Texto para Texto
(defun c:tpt ()
  (prompt "\nSelecione o texto para ser copiado...")
  (setq s1 (entsel)
	s1_text (cdr (assoc 1 (entget (car s1))))
	new (cons 1 s1_text)
  )
  (prompt "\nSelecione os textos a serem alterados...")
  (setq s1 (ssget '((0 . "TEXT")))
	s1_n (sslength s1)
	counter 0)
  (repeat s1_n
    (setq s2 (ssname s1 counter))
    (entmod (subst new (assoc 1 (entget s2)) (entget s2)))
    (setq counter (1+ counter))
  )
  (princ)
)

;troca texto
(defun c:tct ()
  (prompt "\nSelecione o primeiro texto...")
  (setq s1 (entsel)
	s1_text (cdr (assoc 1 (entget (car s1))))
	new1 (cons 1 s1_text)
  )
  (prompt "\nSelecione o segundo texto...")
  (setq s2 (entsel)
	s2_text (cdr (assoc 1 (entget (car s2))))
	new2 (cons 1 s2_text)
  )
  (entmod (subst new2 (assoc 1 (entget (car s1))) (entget (car s1))))
  (entmod (subst new1 (assoc 1 (entget (car s2))) (entget (car s2))))
  (princ)
)



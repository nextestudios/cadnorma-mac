;*****************************************
;Desenho das Setas                        
;*****************************************
(defun prt_drw31_seta ()
  (cn7_verylayer "porta_seta" 1)
  (setq prt_seta (polar prt_porta4 prt_angbase (/ prt_larg 4.0))
	prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 7.5))
    )
  (command "._insert" (strcat cnp_root "/blocos/prt_seta") "_s" (/ prt_blkscl 1.25) "_non" prt_seta (* 180 (/ prt_angbase pi)))
)

;*****************************************
;Desenho das Portas                       
;*****************************************
(defun prt_drw31_porta ()
  (setq prt_porta0 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	prt_porta1 (polar prt_porta0 prt_angbase (/ prt_larg 4.0))
	prt_porta2 (polar prt_porta1 prt_angbase (/ prt_larg 2.0))
	prt_porta3 (polar prt_porta2 (+ pi prt_angortho) (* prt_fator (distof prt_pt31_poe)))
	prt_porta4 (polar prt_porta3 (+ pi prt_angbase) (/ prt_larg 2.0))
	prt_porta5 (polar prt_porta1 prt_angbase (/ prt_larg 4.0))
	prt_porta6 (polar prt_porta5 prt_angbase (/ prt_larg 2.0))
	prt_porta7 (polar prt_porta6 prt_angortho (* prt_fator (distof prt_pt31_poe)))
	prt_porta8 (polar prt_porta7 (+ pi prt_angbase) (/ prt_larg 2.0))
  )
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3  "_non" prt_porta4 "_c"
	   "._pline" "_non" prt_porta5 "_non" prt_porta6  "_non" prt_porta7  "_non" prt_porta8 "_c"
  )
)


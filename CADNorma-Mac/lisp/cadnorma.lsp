;desenha o eixo
(defun eixp_draw ()
  (setq colmo (getvar "cecolor"))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setq pt2 (getpoint pt1 "\nSegundo Ponto... "))
  (eixp_defradius)
  (cond
    ((= cn7_dwgunit 1) (setq pt3 (polar pt1 (angle pt1 pt2) (* 0.15 cn7_blkscl eixp_cric_rad))))
    ((= cn7_dwgunit 100) (setq pt3 (polar pt1 (angle pt1 pt2) (* 0.15 cn7_blkscl eixp_cric_rad))))
    ((= cn7_dwgunit 1000) (setq pt3 (polar pt1 (angle pt1 pt2) (* 0.15 cn7_blkscl eixp_cric_rad))))
  )
  (cn7_verylayer (strcat cn7_blk_prefixlay "Eixos_projeto") 7)
  (command "._circle" "_non" pt1 "_non" pt3
	   "._chprop" (entlast) "" "_c" (fix (distof eixp_circ_col)) ""
	   "._line" "_non" pt3 "_non" pt2 ""
	   "._chprop" (entlast) "" "_lt" (nth (fix (distof eixp_eixo_lty)) eixp_eixo_ltlist) "_c" (fix (distof eixp_eixo_col)) "")
  (setq psimb_txt pt1)
  (setq eixp_name (getstring "\nNome do Eixo...: "))
  (cn7_txsimb eixp_txstyle "_mc" eixp_name (fix (distof eixp_text_col)) (strcat cn7_blk_prefixlay "Eixos_projeto") 0)
  (command "._chprop" (entlast) "" "_c" (fix (distof eixp_text_col)) "")
)


;define o raio do círculo
(defun eixp_defradius ()
  (cond
    ((= eixp_text_sty "0") (setq eixp_cric_rad hf_r50 eixp_txstyle "r50"))
    ((= eixp_text_sty "1") (setq eixp_cric_rad hf_r60 eixp_txstyle "r60"))
    ((= eixp_text_sty "2") (setq eixp_cric_rad hf_r70 eixp_txstyle "r70"))
    ((= eixp_text_sty "3") (setq eixp_cric_rad hf_r80 eixp_txstyle "r80"))
    ((= eixp_text_sty "4") (setq eixp_cric_rad hf_r90 eixp_txstyle "r90"))
    ((= eixp_text_sty "5") (setq eixp_cric_rad hf_r100 eixp_txstyle "r100"))
    ((= eixp_text_sty "6") (setq eixp_cric_rad hf_r120 eixp_txstyle "r120"))
    ((= eixp_text_sty "7") (setq eixp_cric_rad hf_r140 eixp_txstyle "r140"))
    ((= eixp_text_sty "8") (setq eixp_cric_rad hf_r175 eixp_txstyle "r175"))
    ((= eixp_text_sty "9") (setq eixp_cric_rad hf_r200 eixp_txstyle "r200"))
    ((= eixp_text_sty "10") (setq eixp_cric_rad (distof t1_alt) eixp_txstyle "t1"))
    ((= eixp_text_sty "11") (setq eixp_cric_rad (distof t2_alt) eixp_txstyle "t2"))
    ((= eixp_text_sty "12") (setq eixp_cric_rad (distof t3_alt) eixp_txstyle "t3"))
    ((= eixp_text_sty "13") (setq eixp_cric_rad (distof t4_alt) eixp_txstyle "t4"))
    ((= eixp_text_sty "14") (setq eixp_cric_rad (distof t5_alt) eixp_txstyle "t5"))
    ((= eixp_text_sty "15") (setq eixp_cric_rad (distof t6_alt) eixp_txstyle "t6"))
    ((= eixp_text_sty "16") (setq eixp_cric_rad (distof t7_alt) eixp_txstyle "t7"))
  )
  (setq eixp_rad (* cn7_blkscl eixp_cric_rad))
)

				

;verifica se existe o arquivo de configuração e lê
(defun eixp_file ()
  (if (not (findfile (strcat cnp_root "/config/eixp.txt")))
    (progn
      (setq open_file (open (strcat cnp_root "/config/eixp.txt") "w" "utf8"))
      (write-line "7" open_file)
      (write-line "5" open_file)
      (write-line "8" open_file)
      (write-line "0" open_file)
      (write-line "8" open_file)
      (close open_file)
    )
  )
  (eixp_read_file)
)

;lê os dados do arquivo de configurações
(defun eixp_read_file()
  (setq open_file (open (strcat cnp_root "/config/eixp.txt") "r" "utf8")
	eixp_text_sty (read-line open_file)
	eixp_text_col (read-line open_file)
	eixp_circ_col (read-line open_file)
	eixp_eixo_lty (read-line open_file)
	eixp_eixo_col (read-line open_file)
  )
)

;escreve o arquivo de configurações
(defun eixp_write_file ()
  (setq open_file (open (strcat cnp_root "/config/eixp.txt") "w" "utf8"))
  (write-line eixp_text_sty open_file)
  (write-line eixp_text_col open_file)
  (write-line eixp_circ_col open_file)
  (write-line eixp_eixo_lty open_file)
  (write-line eixp_eixo_col open_file)
  (close open_file)
)  
    


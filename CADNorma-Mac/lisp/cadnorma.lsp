  (write-line scd12_layc_dvl file)
  (write-line scd12_layc_dvc file)
  (write-line scd12_layc_dpl file)
  (write-line scd12_layc_dpc file)
  (write-line scd12_layc_crl file)
  (write-line scd12_layc_crc file)
  (write-line scd12_layc_itl file)
  (write-line scd12_layc_itc file)
  (close file)
)

;clica em dois pontos = nova largura do degrau
(defun scd12_getdiai_button ()
  (scd12_last_writefile)
  (setq diai_dist nil
	pt1 (getpoint "\nPrimeiro ponto da diaiura... ")
	pt2 (getpoint pt1 "Segundo ponto da diaiura... ")
	diai_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* diai_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* diai_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* diai_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq scd12_var_diai (rtos new_dist 2 2))
      (scd12_last_writefile)
    )
  )
  (scd12_main)
)


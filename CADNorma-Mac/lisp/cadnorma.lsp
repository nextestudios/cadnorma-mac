;extrai de n (elemto da new_list) família, grupo e subgrupo
(defun rel_extract ()
  (setq rel_code (nth 0 n)
	cnqt_code rel_code
	rel_item (nth 1 n)
	rel_item (nth 2 n)
	rel_quant (nth 3 n)
	rel_unit (nth 4 n)
	rel_custo (nth 5 n)
	rel_total (nth 6 n)
	rel_familia (substr rel_code 1 6)
	rel_grupo (substr rel_code 7 2)
	rel_subgrupo (substr rel_code 9 2)
	rel_item (substr rel_code 11)
  )
  (setq open_file (open (strcat cnp_netroot "/quant/" rel_familia ".txt") "r" "utf8"))
  (repeat (1+ (fix (distof rel_grupo)))
    (setq grupo (read-line open_file))
  )
  (close open_file)
  (setq open_file (open (strcat cnp_netroot "/quant/" rel_familia rel_grupo ".txt") "r" "utf8"))
  (repeat (1+ (fix (distof rel_subgrupo)))
    (setq subgrupo (read-line open_file))
  )
  (close open_file)
  (setq open_file (open (strcat cnp_netroot "/quant/" rel_familia rel_grupo rel_subgrupo ".txt") "r" "utf8"))
  (repeat (1+ (fix (distof rel_item)))
    (setq item (read-line open_file))
  )
  (close open_file)
  (setq linha item)
  (cnqt_separa_dados)
)


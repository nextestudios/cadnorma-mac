;desenha sem elipse
(defun cha_action_draw1 ()
  (setq pt2 (getpoint pt1 "\nPonto final do arco... "))
  (command "._arc" pt1 "_e" pt2 "_d" pause)
  (setq arc (entget (entlast)))
  (setq ang1 (cdr (assoc 50 arc)))
  (setq ang2 (cdr (assoc 51 arc)))
  (setq cen (cdr (assoc 10 arc)))
  (setq ang1b (angle cen pt1))
  (setq ang2b (angle cen pt2))
  (setq val1 (angtos ang1 2 4))
  (setq val2 (angtos ang2 2 4))
  (setq val1b (angtos ang1b 2 4))
  (setq val2b (angtos ang2b 2 4))
  (if (= val1b val1)
    (progn
      (setq angc (+ (/ (* -90 pi) 180) ang1))
      (setq angf (+ (/ (* 90 pi) 180) ang2)))
    )
  (if (= val1b val2)
    (progn
      (setq angc (+ (/ (* 90 pi) 180) ang2))
      (setq angf (+ (/ (* -90 pi) 180) ang1)))
    )
  (setq cf "C")
  (if (= (strcase cf) "C")
    (progn
      (setq angs angc)
      (setq ps pt1) (setq pt pt2)
      ))
  (if (= (strcase cf) "F")
    (progn
      (setq angs angf)
      (setq ps pt2) (setq pt pt1)
      ))
  (setq rots (angtos (+ pi angs) 2 3))
  (cond
    ((= apo_sty "apo_closed") (command "_insert" (strcat cnp_root "/blocos/apo_closed") "_non" ps cn7_blkscl "" rots))
    ((= apo_sty "apo_open") (command "_insert" (strcat cnp_root "/blocos/apo_open") "_non" ps cn7_blkscl "" rots))
    ((= apo_sty "apo_dot") (command "_insert" (strcat cnp_root "/blocos/apo_dot") "_non" ps cn7_blkscl "" rots))
  )
)

;desenha com elipse
(defun cha_action_draw2 ()
  (setq pt2 (getpoint pt1 "\nSegundo ponto da Elipse... ")
	pt3 (polar pt1 (angle pt1 pt2) (/ (distance pt1 pt2) 2))
	pt3 (polar pt3 (+ (angle pt1 pt2) (/ pi 2)) (/ (distance pt1 pt2) 6))
  )
  (command "._ellipse" "_non" pt1 "_non" pt2 "_non" pt3)

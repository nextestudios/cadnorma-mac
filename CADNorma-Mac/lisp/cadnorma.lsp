  (jnl_cobo_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "jnl_cobo" dcl_id)) (exit))
  ;largura do vão (abertura)
  (set_tile  "jnl_cobo_vao" jnl_cobo_vao)

;escreve texto da fiação
(defun fnt_write_txt ()
  (if psimb_txt
    (setq psimb_txt (getpoint psimb_txt "\nPosicao do texto...<ENTER para terminar>... "))
    (setq psimb_txt (getpoint "\nPosicao do texto...<ENTER para terminar>... "))

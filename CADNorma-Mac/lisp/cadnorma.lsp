;procedimento inicial para escadas
(defun scd11_start ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (scd11_last_file)
  (scd11_layc_file)
  (cond
    ((= cn7_dwgunit 1) (setq scd11_fator 0.01 scd11_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq scd11_fator 1.0 scd11_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq scd11_fator 10.0 scd11_blkscl 1000.0))
  )
)

(defun c:sc3 () (scd12_main))

(defun scd12_main ()
  (scd12_start)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd12" dcl_id)) (exit))
  (set_tile "scd12_vis_radio" scd12_var_svis)
  (action_tile "scd12_vis_radio" "(scd12_radio)")
  ;slide
  (scd12_upslide)
  ;dados de  construção
  (set_tile "scd12_getdiae" scd12_var_diae)
  (action_tile "scd12_getdiae" "(scd12_getdiae_action)")
  (action_tile "scd12_pikdiae" "(done_dialog 2)")
  (set_tile "scd12_getdiai" scd12_var_diai)
  (action_tile "scd12_getdiai" "(scd12_getdiai_action)")
  (action_tile "scd12_pikdiai" "(done_dialog 3)")
;;;  ;toggles
  (set_tile "scd12_getcore" scd12_var_core)
  (action_tile "scd12_getcore" "(setq scd12_var_core $value)")
  (set_tile "scd12_getcori" scd12_var_cori)
  (action_tile "scd12_getcori" "(setq scd12_var_cori $value)")
;;;  ;cores e layers
  (action_tile "scd12_cfglayc" "(done_dialog 4)")
  ;comandos gerais
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq scd12_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 scd12_dcl_id) (scd12_ok_action))
  (if (= 2 scd12_dcl_id) (scd12_getdiae_button))
  (if (= 3 scd12_dcl_id) (scd12_getdiai_button))
  (if (= 4 scd12_dcl_id) (scd12_laycol_button))
)

;decide o tipo de escada que vai desenhar
(defun scd12_ok_action ()
  (scd12_last_writefile)
  (cond
    ((= scd12_var_svis "scd12_vis_01") (scd12_draw_01))
    ((= scd12_var_svis "scd12_vis_02") (scd12_draw_02))
    ((= scd12_var_svis "scd12_vis_03") (scd12_draw_03))
  )
)

;desenha escada em projeção
(defun scd12_draw_03 ()
  (command "._undo" "_m")
  (scd12_last_writefile)
  (setq scd12_pt0 (getpoint "\nClique no ponto central da escada... "))
  (setq scd12_pt1 (polar scd12_pt0 0 (* scd12_fator (/ (distof scd12_var_diai) 2)))
	scd12_pt2 (polar scd12_pt0 0 (* scd12_fator (/ (distof scd12_var_diae) 2)))
	scd12_pt3 (polar scd12_pt0 (/ (* 3 pi) 2) (* scd12_fator (/ (distof scd12_var_diae) 2)))
	scd12_pt4 (polar scd12_pt0 (/ (* 3 pi) 2) (* scd12_fator (/ (distof scd12_var_diai) 2)))
  )
  ;desenha os contornos
  (cn7_verylayer scd12_layc_dpl 7)
  (setvar "cecolor" scd12_layc_dpc)
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (command "._circle" "_non" scd12_pt0 "_non" scd12_pt1)
  (command "._circle" "_non" scd12_pt0 "_non" scd12_pt2)
  (command "._line" "_non" scd12_pt4 "_non" scd12_pt3 "")
  (command "._array" (entlast) "" "_p" "_non" scd12_pt0 8 360 "_y")
  (devolve)
  (prompt "\nDitite <UB> para retornar...")
  (princ)
)

;desenha a escada subindo
(defun scd12_draw_02 ()
  (command "._undo" "_m")
  (scd12_last_writefile)
  (setq scd12_pt0 (getpoint "\nClique no ponto central da escada... "))
  (setq scd12_pt1 (polar scd12_pt0 0 (* scd12_fator (/ (distof scd12_var_diai) 2)))

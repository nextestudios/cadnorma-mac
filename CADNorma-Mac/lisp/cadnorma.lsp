;função principal - abre a DCL para inserção de símbolos
(defun cnqt ()
  (cnqt_start_readfile)
  (setq cnqt_familist nil)
  ;lê as famíias existentes
  (setq open_file (open (strcat cnp_netroot "/quant/familias.txt") "r" "utf8"))
  (while (/= nil (setq linha (read-line open_file)))
    (setq cnqt_familist (append cnqt_familist (list linha)))
  )
  (close open_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn9_quant" dcl_id)) (exit))
  (start_list "cnqt_familia")
  (mapcar 'add_list cnqt_familist)
  (end_list)
  (set_tile "cnqt_familia" (rtos (fix (distof cnqt_familia)) 2 0))
  (action_tile "cnqt_familia" "(cnqt_familia_update)")
  (cnqt_updall)
  (action_tile "cnqt_group" "(cnqt_updsub)")
  (action_tile "cnqt_subgroup" "(cnqt_updlist)")
  (action_tile "cnqt_list" "(cnqt_selist)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cnqt_grp_new" "(done_dialog 2)")
  (action_tile "cnqt_grp_rename" "(done_dialog 3)")
  (action_tile "cnqt_sub_new" "(done_dialog 4)")
  (action_tile "cnqt_sub_rename" "(done_dialog 5)")
  (action_tile "cnqt_button_edit" "(done_dialog 6)")
  (action_tile "cnqt_button_new" "(done_dialog 7)")
  (action_tile "cnqt_codify" "(done_dialog 8)")
  (action_tile "cnqt_change" "(done_dialog 9)")
  (setq cnquant_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 cnquant_dialog) (cnqt_ok))
  (if (= 2 cnquant_dialog) (cnqt_grp_new))
  (if (= 3 cnquant_dialog) (cnqt_grp_rename))
  (if (= 4 cnquant_dialog) (cnqt_sub_new))
  (if (= 5 cnquant_dialog) (cnqt_sub_rename))
  (if (= 6 cnquant_dialog) (cnqt_item_edit))
  (if (= 7 cnquant_dialog) (cnqt_item_new))
  (if (= 8 cnquant_dialog) (cnqt_codify))
  (if (= 9 cnquant_dialog) (cnqt_change))
)

;decide o tipo de seleção a ser utilizado
(defun cnqt_codify ()
  (cnqt_write_lastcode)
  (setq attdia_mode (getvar "attdia"))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;  Escreve o azimute  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun c:azm ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (cn7_init)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setq osmo (getvar "osmode"))
  (setq hakr 0 KR 1)
  (setq zero 0.0)
  (initang)
  (setq escala cn7_blkscl)
  (cn7_verylayer (strcat cn7_prefixlay "Top_azimute") 2)
  (command "._color" "bylayer")
  (setvar "osmode" 33)
  (setq P1 (getpoint "\nPrimeiro ponto:"))
  (while
    (setq P2 (getpoint P1 "\nProximo ponto:"))
     (command P1 P2)
     (setq No (cadr P1))
     (setq Eo (car P1))
     (setq Nf (cadr P2))
     (setq Ef (car P2))
     (setq delta_e (- Ef Eo))
     (setq delta_n (- Nf No))
     (if (= delta_n zero)
       (setq AA "0.0000")
     )
     (if (/= delta_n zero)
       (progn
	 (setq angrad (/ delta_e delta_n))
	 (setq AA (angtos (atan angrad) 0 4))
       )
     )
     (setq angreal (distof AA 2))
     (if (and (>= delta_e zero) (>= delta_n zero))
           ;; 1o Quadrante
       (progn
	 (setq angreal (- 90 angreal))
	 (setq grau (fix angreal))
	 (setq temp (* 60 (- angreal grau)))
	 (setq minuto (fix temp))
	 (setq temp (* 60 (- temp minuto)))
	 (setq grau (rtos grau 2 0))
	 (setq minuto (rtos minuto 2 0))
	 (setq segundo (rtos temp 2 0))
	 (setq quadrante 1)
	  (setq AA (strcat "-> Az=" grau "%%D" minuto "'" segundo "\""))
     (resetang)
     (setq BB (angle P1 P2)
	   DS (distance P1 P2)
	   DS (/ DS KR)
	   P3 (polar P1 BB (/ DS 2.0))
	   P1 P2
     )
     (setq angulo BB)
     (if (or (= quadrante 3) (= quadrante 4))
       (setq angulo (+ angulo PI))
     )
       )
       (if (and (>= delta_e zero) (<= delta_n zero))
	 ;; 2o Quadrante
	 (progn
	   (setq angreal (- 270 angreal))
	   (setq grau (fix angreal))
	   (setq temp (* 60 (- angreal grau)))
	   (setq minuto (fix temp))
	   (setq temp (* 60 (- temp minuto)))
	   (setq grau (rtos grau 2 0))
	   (setq minuto (rtos minuto 2 0))
	   (setq segundo (rtos temp 2 0))
	   (setq quadrante 2)
	    (setq AA (strcat "-> Az=" grau "%%D" minuto "'" segundo "\""))
     (resetang)
     (setq BB (angle P1 P2)
	   DS (distance P1 P2)
	   DS (/ DS KR)
	   P3 (polar P1 BB (/ DS 2.0))
	   P1 P2
     )
     (setq angulo BB)
     (if (or (= quadrante 3) (= quadrante 4))
       (setq angulo (+ angulo PI))
     )
	 )
	 (if (and (<= delta_e zero) (<= delta_n zero))
	   ;; 3o Quadrante
	   (progn
	     (setq angreal (- 270 angreal))
	     (setq grau (fix angreal))
	     (setq temp (* 60 (- angreal grau)))	     (setq minuto (fix temp))
	     (setq temp (* 60 (- temp minuto)))
	     (setq grau (rtos grau 2 0))
	     (setq minuto (rtos minuto 2 0))
	     (setq segundo (rtos temp 2 0))
	     (setq quadrante 3)
	      (setq AA (strcat "<- Az=" grau "%%D" minuto "'" segundo "\""))
     (resetang)
     (setq BB (angle P1 P2)
	   DS (distance P1 P2)
	   DS (/ DS KR)
	   P3 (polar P1 BB (/ DS 2.0))
	   P1 P2
     )
     (setq angulo BB)
     (if (or (= quadrante 3) (= quadrante 4))
       (setq angulo (+ angulo PI))
     )
	   )
	   (if (and (<= delta_e zero) (>= delta_n zero))
	     ;; 4o Quadrante
	     (progn
	       (setq angreal (- 450 angreal))
	       (setq grau (fix angreal))
	       (setq temp (* 60 (- angreal grau)))
	       (setq minuto (fix temp))
	       (setq temp (* 60 (- temp minuto)))
	       (setq grau (rtos grau 2 0))
	       (setq minuto (rtos minuto 2 0))
	       (setq segundo (rtos temp 2 0))
	       (setq quadrante 4)
	        (setq AA (strcat "<- Az=" grau "%%D" minuto "'" segundo "\""))
     (resetang)
     (setq BB (angle P1 P2)
	   DS (distance P1 P2)
	   DS (/ DS KR)
	   P3 (polar P1 BB (/ DS 2.0))
	   P1 P2
     )
     (setq angulo BB)
     (if (or (= quadrante 3) (= quadrante 4))
       (setq angulo (+ angulo PI))
     )
	     )
	   )	 )
       )
     )
     (setvar "osmode" 0)
     (setq psimb_txt (polar P3 (rem (+ BB (/ PI 2.0)) (* PI 2.0)) (* 0.2 escala)))
     (cn7_txsimb "r80" "m" (rtos DS 2 3) 2 "Top_azimute" (rtd angulo))
     (setq psimb_txt (polar P3 (rem (+ BB (* PI 1.5)) (* PI 2.0)) (* 0.2 escala)))
     (cn7_txsimb "r80" "m" AA 2 "Top_azimute" (rtd angulo))
     (setvar "osmode" 33)
     (initang)
  )
  (resetang)
  (setvar "osmode" osmo)
  (devolve)
  (princ)
)

(defun initang ()
  (setvar "ANGBASE" (/ pi 2))
  (setvar "ANGDIR" 1)
  (setvar "AUNITS" 1)			; grau,minuto,segundo
  (setvar "AUPREC" 5)			; 
  (setvar "LUNITS" 2)			; decimal
  (setvar "LUPREC" 4)
)

	  (if (>= (cos angrad) 0)
	    (progn
	      (setq p3a (polar txt_point angrad (+ (/ (distance ll lr) 2) (* 0.35 cn7_blkscl)))
		    p3 (polar p3a (+ angrad  (/ pi 2)) (* 0.1 cn7_blkscl))

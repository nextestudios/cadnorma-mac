;abre a dcl e retorna a escala desejada
(defun cn7_vp_zxp ()
  (setq alert_resp nil v1 nil v2 nil)
  (cn7_verylocked)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_vwpesc" dcl_id)) (exit))
  (if cn7_vp_scale
    (set_tile "cn7_vwpesc_esc_atual" (strcat "Escala Atual = 1: " (rtos cn7_vp_scale 2 0)))
  )
  (mode_tile "cn7_vwpesc_esc" 2)
  (action_tile "cn7_vwpesc_esc" "(cn7_vwpesc_veryget)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq zxp_resp (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 zxp_resp)
    (progn
      (initget 1)
      (setq zxp_cenpt (getpoint "Clique no ponto de centralização da imagem..."))
      (if (and (/= curr_scale 1.25) (/= curr_scale 1.5) (/= curr_scale 12.5) (/= curr_scale 2.5) (/= curr_scale 7.5))
	(progn
	  (cond
	    ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt (strcat "1000/" (rtos curr_scale 2 0) "xp")))
	    ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt (strcat "10/" (rtos curr_scale 2 0) "xp")))
	    ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt (strcat "1/" (rtos curr_scale 2 0) "xp")))
	  )
	  (if (/= "14" (substr (getvar "acadver") 1 2)) (cn7_zxp_wishlock))
	)
	(progn
	  (cond
	    ((= curr_scale 1.25)
	     (cond
	       ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt "100000/125xp"))
	       ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt "1000/125xp"))
	       ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt "100/125xp"))
	     ))
	    ((= curr_scale 1.5)
	     (cond
	       ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt "10000/15xp"))
	       ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt "100/15xp"))
	       ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt "10/15xp"))
	     ))
	    ((= curr_scale 2.5)
	     (cond
	       ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt "10000/25xp"))
	       ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt "100/25xp"))
	       ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt "10/25xp"))
	     ))
	    ((= curr_scale 7.5)
	     (cond
	       ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt "10000/75xp"))
	       ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt "100/75xp"))
	       ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt "10/75xp"))
	     ))
	    ((= curr_scale 12.5)
	     (cond
	       ((= cn7_dwgunit 1) (command "._zoom" "_c" zxp_cenpt "10000/125xp"))
	       ((= cn7_dwgunit 100) (command "._zoom" "_c" zxp_cenpt "100/125xp"))
	       ((= cn7_dwgunit 1000) (command "._zoom" "_c" zxp_cenpt "10/125xp"))
	     ))
	  )
	  (if (/= "14" (substr (getvar "acadver") 1 2)) (cn7_zxp_wishlock))
	)
      )
    )
    (exit)
  )
)

(defun cn7_vwpesc_veryget ()
  (setq cn7_vwpesc $value)
  (if (not (distof cn7_vwpesc))
    (progn
      (cn7_alert_ok
	    "Entrada Inválida!"
	    "Digite um valor"
	    "Numérico...")
    )
    (progn
      (setq cn7_dzin (getvar "dimzin"))
      (setvar "dimzin" 1)
      (setq cn7_listmemb "n" alert_resp nil)
      (setq cn7_scalist
	 (list
	   "1.000" "10.000" "100.000" "1000.000" "10000.000" "100000.000" "1000000.000"
	   "1.250" "12.500" "125.000" "1250.000" "12500.000" "125000.000"
	   "1.500" "15.000" "150.000" "1500.000" "15000.000" "150000.000"
	   "2.000" "20.000" "200.000" "2000.000" "20000.000" "200000.000"
	   "2.500" "25.000" "250.000" "2500.000" "25000.000" "250000.000"
	   "3.000" "30.000" "300.000" "3000.000" "30000.000" "300000.000"
	   "4.000" "40.000" "400.000" "4000.000" "40000.000" "400000.000"
	   "5.000" "50.000" "500.000" "5000.000" "50000.000" "500000.000"
	   "7.500" "75.000" "750.000" "7500.000" "75000.000" "750000.000"))
      (setq cn7_vpscl_verify (distof cn7_vwpesc))
      (foreach n cn7_scalist
	(if (= (rtos cn7_vpscl_verify 2 3) n) (setq cn7_listmemb "s"))
      )
      (if (= cn7_listmemb "n")
	;se a escala da janela é irregular
	(progn
	  (cn7_alert_yes_no
	    "Esta escala não é padrão!"
	    (strcat "Escala atual = 1:" cn7_vwpesc)
	    "Deseja continuar mesmo assim?")
	  (if (= "no" alert_resp)
	    (done_dialog 0)
	    (progn
	      (setq curr_scale (distof cn7_vwpesc))
	    )
	  )
	);
	;se a escala da janela é regular
	(progn
	  (setq curr_scale (distof cn7_vwpesc))
	  )
	)
      )
    )
  )





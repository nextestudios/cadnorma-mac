;verifica se o texto está em um layer gráfico e muda para
(defun cve_uptxt_checklay ()
  (setq ent_layer (cdr (assoc 8 ent_list))
        n_oldlayer (strlen ent_layer) counter2 1 oldprefix "")
  (setq cve_uptxt_newlaycolor (cdr (assoc 62 (tblsearch "layer" ent_layer))))
  ;verifica se o texto contém um prefixo de escala (oldprefix)
  (while
    (and
      (/= "" (substr ent_layer counter2 1))
      (/= "-" (substr ent_layer counter2 1))
    )
    (setq oldprefix (strcat oldprefix (substr ent_layer counter2 1))
	  counter2 (1+ counter2)
    )
  )
  ;verifica se o prefixo pertence a uma escala regular
  (if (member oldprefix reg_scale_list)
    (progn
      (setq ent_laysufix (substr ent_layer (+ 2 (strlen oldprefix)))
	    cve_uptxt_newlayer (strcat cn7_blk_prefixlay ent_laysufix))
      (cn7_verylayer cve_uptxt_newlayer cve_uptxt_newlaycolor)
      (setq ent_list (entmod (subst (cons 8 cve_uptxt_newlayer) (assoc 8 ent_list) ent_list)))
    )
  )
)


;altera a altura e o layer do texto
(defun cve_txt_chgsty ()
  (setq ent_list
	 (entmod (subst
		   (cons 40
			 (cond
			   ((= cn7_dwgunit 1.0) (/ (* cn7_msscl new_txtheight) 1000.000))
			   ((= cn7_dwgunit 100.0) (/ (* cn7_msscl new_txtheight) 10.000))
			   ((= cn7_dwgunit 1000.0) (/ (* cn7_msscl new_txtheight) 1.000))
			  )
		   )
		   (assoc 40 ent_list)
		   ent_list))
  )
)


;conversão de cotas
(defun cve_updim ()
  (setq n_element (length cve_dimlist) counter 0 dimmo (getvar "dimstyle") dimscl (getvar "dimscale"))
  (setq s1_dim (ssadd)) 
  (repeat n_element
    (ssadd (nth counter cve_dimlist) s1_dim )
    (setq counter (1+ counter))
  )
  ;separa as cotas em 5 listas
  (setq counter 0 cve_dim1 (ssadd) cve_dim2 (ssadd) cve_dim3 (ssadd) cve_dim4 (ssadd) cve_dim5 (ssadd))
  (repeat n_element
    (setq s1_ent (nth counter cve_dimlist))
    ;determina o estilo da cota
    (setq ent_list (entget s1_ent)
	  ent_dimsty (strcase (cdr (assoc 3 ent_list)))
    )
    (cond
      ((= ent_dimsty "CADNORMA_DIM1") (ssadd (nth counter cve_dimlist) cve_dim1))
      ((= ent_dimsty "CADNORMA_DIM2") (ssadd (nth counter cve_dimlist) cve_dim2))
      ((= ent_dimsty "CADNORMA_DIM3") (ssadd (nth counter cve_dimlist) cve_dim3))
      ((= ent_dimsty "CADNORMA_DIM4") (ssadd (nth counter cve_dimlist) cve_dim4))
      ((= ent_dimsty "CADNORMA_DIM5") (ssadd (nth counter cve_dimlist) cve_dim5))
    )
    ;transforma o layer das cota
    (cve_uptxt_checklay)
    (setq counter (1+ counter))
  )
  ;agora vai atuar diferente no paper ou no model
  (if (/= 0 (sslength cve_dim1))
    (progn
      (command "._dimstyle" "_r" "CADNORMA_DIM1")
      (cve_updim_checkscale)
      (command "._dim1" "_update" cve_dim1 "")
    )
  )
  (if (/= 0 (sslength cve_dim2))
    (progn
      (command "._dimstyle" "_r" "CADNORMA_DIM2")
      (cve_updim_checkscale)
      (command "._dim1" "_update" cve_dim2 "")
    )
  )
  (if (/= 0 (sslength cve_dim3))
    (progn
      (command "._dimstyle" "_r" "CADNORMA_DIM3")
      (cve_updim_checkscale)
      (command "._dim1" "_update" cve_dim3 "")
    )
  )
  (if (/= 0 (sslength cve_dim4))
    (progn
      (command "._dimstyle" "_r" "CADNORMA_DIM4")
      (cve_updim_checkscale)
      (command "._dim1" "_update" cve_dim4 "")
    )
  )
  (if (/= 0 (sslength cve_dim5))
    (progn
      (command "._dimstyle" "_r" "CADNORMA_DIM5")
      (cve_updim_checkscale)
      (command "._dim1" "_update" cve_dim5 "")
    )
  )
  (command "._dimstyle" "_r" dimmo)
  (setvar "dimscale" dimscl)
  (princ)
)

;avalia o dimscale
(defun cve_updim_checkscale ()
  (if (= 1 (getvar "tilemode"));Model Space
    (cond
      ((= cn7_dwgunit 1.0) (setvar "dimscale" (/ cn7_msscl 1000.00)))
      ((= cn7_dwgunit 100.0) (setvar "dimscale" (/ cn7_msscl 10.00)))
      ((= cn7_dwgunit 1000.0) (setvar "dimscale" cn7_msscl))
     )
    (setvar "dimscale" 0.00)
  )
)

;função que corrige a escala dos blocos......
(defun cve_upblk ()
  (setq n_element (length cve_blklist) counter 0)
  (setq s1_blk (ssadd)
	cve_private_blk ; blocos privados
	 (list "cvg_ex1" "cvg_ex2" "cvg_ex3" "crt1_b1" "crt1_b2" "crt2_2"
	       "cvg_id1" "cvg_id2" "cvg_id3" "cvg_id4" "cvg_id5" "cvg_id6" "cvg_id7"
	       "cvg_id8" "cvg_id9" "cvg_id10" "cvg_id11" "cvg_id12" "cvg_id13" "cvg_id14"
	       "cvg_id15" "cvg_id16" "cvg_id17" "cvg_id18" "cvg_id19" "cvg_id20"
	       "tub_tcol1" "tub_tcol2" "idcol" "tp_loc_topog" "dsnv1"
	       "ele_circ_n" "ele_circ_f" "ele_circ_r" "ele_circ_t" "ele_circ_c" "cvg_incl"
	       "cvg_nvc2" "cvg_nvc2a" "cvg_nvp1" "cvg_nvp2" "cvg_tt1" "cvg_tt2" "cvg_tt3"
	       "cvg_tt4" "cvg_tt5" "cvg_tt6" "cvg_tt7" "cvg_tt8" "crt1_b1" "crt1_b2" "crt2_b2"
	       "cvg_ex1" "cvg_ex2" "cvg_ex3" "cvg_id1" "cvg_id2" "cvg_id3" "cvg_id4" "cvg_id5" "cvg_id6"
	       "cvg_id7" "cvg_id8" "cvg_id9" "cvg_id10" "cvg_id11" "cvg_id12" "cvg_id13" "cvg_id14" "cvg_id15" "cvg_id16")
  )
  ;o repeat abaixo separa os blocos gráficos
  (repeat n_element
    (setq s1_ent (nth counter cve_blklist))
    (setq ent_list (entget s1_ent)
	  ent_blkname (cdr (assoc 2 ent_list)))
    (if (member ent_blkname cve_private_blk);blocos privados
      (ssadd (nth counter cve_blklist) s1_blk)
      (progn
	(if (findfile (strcat cnp_root "/blocos/" ent_blkname ".dwg"))
	  (progn
	    (setq cve_blk_group_file (strcat cnp_root"/slides/" (substr ent_blkname 1 10) ".sgp"))
	    (if (findfile cve_blk_group_file)
	      (progn
		(setq cve_blk_group_open (open cve_blk_group_file "r" "utf8")
		      cve_blk_blktype (read-line cve_blk_group_open)
		      cve_blk_blkunit (read-line cve_blk_group_open)
		)
		(close cve_blk_group_open)
		(if (= "2" cve_blk_blktype);se o bloco for gráfico, vai para a lista
		  (ssadd (nth counter cve_blklist) s1_blk )
		)
	      )
	    )
	  );progn
	)
      )	  
    )
    (setq counter (1+ counter))
  );repeat
  ;altera a escala dos blocos
  (setq n_repeat (sslength s1_blk) counter 0)
  (repeat n_repeat
    (setq entname (ssname s1_blk counter)
	  ent_list (entget entname)
	  ent_scale (cdr (assoc 41 ent_list))
	  ent_layer (cdr (assoc 8 ent_list))
	  ent_layer_color (cdr (assoc 62 (tblsearch "layer" ent_layer))))
    (cve_blk_newlayer ent_layer)
    (setq new_layername (strcat cn7_blk_prefixlay layer_sufix))
    (cn7_verylayer new_layername ent_layer_color)
    (setq ent_list (entmod (subst (cons 8 new_layername) (assoc 8 ent_list) ent_list)))
    (command "._scale" entname "" "_non" (cdr (assoc 10 ent_list)) "_r" (abs ent_scale) cn7_blkscl)
    (setq counter (1+ counter))
  )
  ;altera o layer dos blocos
)

;acha o sufixo (layer_sufix) e o prefixo do layer (oldprefix)
(defun cve_blk_newlayer (layer_name)
  (setq n_oldlayer (strlen layer_name) counter2 1 oldprefix "" layer_sufix "")
  (while (/= "-" (substr layer_name counter2 1))
    (setq oldprefix (strcat oldprefix (substr layer_name counter2 1))
	  counter2 (1+ counter2)
    )
  )
  (if (member oldprefix reg_scale_list)
    (progn
      (setq counter2 (1+ counter2)
	    layer_sufix (substr layer_name counter2))
    )
    (progn
      (alert "\nEntidade não gráfica\nou layer inválido!")
      (quit)
    )
  )
)


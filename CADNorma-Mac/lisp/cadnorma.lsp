;Funcao m2: Seleciona um texto e poe m2 como sufixo ***********
;**************************************************************
(defun c:m2 ()
  (cn7_cfg_txarea_file)
  (prompt "\nSelecione o texto a ser acrescido...")
  (setq ent1 (entget (car (entsel))))
  (setq txt1 (cdr (assoc 1 ent1)))
  (cond
    ((= txarea_und "0") (setq newtxt (cons 1 (strcat txt1 "mm2"))))
    ((= txarea_und "1") (setq newtxt (cons 1 (strcat txt1 "cm2"))))
    ((= txarea_und "2") (setq newtxt (cons 1 (strcat txt1 "m2"))))
    ((= txarea_und "3") (setq newtxt (cons 1 (strcat txt1 "km2"))))
  )
  (setq old (assoc 1 ent1))
  (entmod (subst newtxt old ent1))
  (princ)
);defun


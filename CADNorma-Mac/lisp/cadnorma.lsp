(defun pfr_desnivel () (setq desnivel (getreal "\nEntre com o desnível entre as curvas...")))

(defun c:pfr ()
  (if (or
	(= nil pto_inicial)
	(= nil plot_scale2)
	(= nil vt_scale2)
	(= nil hz_scale2)
	(= nil vt_start)
	(= nil hz_start)
	(= nil vt_prof)
	(= nil hz_larg)
	(= nil hz_increm)
	(= nil vt_increm)
      )
    	(progn
	  (alert "
		  Você deve primeiro construir os eixos
	  	  coordenados para executar esse comando.
	  	  Vá em CADNorma -> Aplicativos -> Gráficos -> Eixos para
	  	  Defini-los...
		 "
	  )
	  (exit)
	);progn case T
    );if
  (if (= desnivel nil) (pfr_desnivel))
  (setq pfr_start_pto (getpoint "\nPonto de partida..."))
  (setq pfr_y_start (getreal "\nCota de Partida..."))
  (setq pfr_graf_start (polar pto_inicial (/ pi 2) (* (- pfr_y_start vt_start) (/ (float plot_scale2) (float vt_scale2)))))
  (command "._point" "_non" pfr_graf_start)
  (pfr_decide)
  (pfr_draw_first)
  (setq pfr_last_pto pfr_curr_pto)
  (pfr_keep1)
  (princ)
)

(defun pfr_decide ()
  (initget 1 "Sobe Desce Horizontal Abortar")
  (setq pfr_decision (getkword "\nPróxima direção.. <Sobe/Desce/Horizontal/Abortar> : "))
  (if (= pfr_decision "Abortar") (exit))
)


(defun pfr_draw_first ()
  (setq pfr_next_pto (getpoint "\nSegundo Ponto..."))
  (command "._point" "_non" pfr_next_pto)
  (setq pfr_curr_dist (abs (distance pfr_start_pto pfr_next_pto)))
  (setq pfr_gf_temp1 (polar pfr_graf_start 0 pfr_curr_dist))
  (setq x_curr_pto (nth 0 pfr_gf_temp1))
  (cond
	  ((= pfr_decision "Sobe")
		(setq y_curr_pto (nth 1 (polar pfr_gf_temp1 (/ pi 2) (* desnivel (/ (float plot_scale2) (float vt_scale2)))))))
	  ((= pfr_decision "Desce")		(setq y_curr_pto (nth 1 (polar pfr_gf_temp1 (* 3 (/ pi 2)) (* desnivel (/ (float plot_scale2) (float vt_scale2)))))))
	  ((= pfr_decision "Horizontal")
		(setq y_curr_pto (nth 1 pfr_gf_temp1)))
  );cond
  (setq pfr_curr_pto (list x_curr_pto y_curr_pto))
  (command "._point" "_non" pfr_curr_pto)
)


(defun pfr_keep1 ()
  (while (/= nil (setq pfr_next_pto (getpoint "\nPróximo cruzamento...")))
    	(command "._point" "_non" pfr_next_pto)
  	(setq pfr_curr_dist (abs (distance pfr_start_pto pfr_next_pto)))
  	(setq pfr_gf_temp1 (polar pfr_graf_start 0 pfr_curr_dist))
    	(setq x_curr_pto (nth 0 pfr_gf_temp1))
        (cond
	  ((= pfr_decision "Sobe")
		(setq y_curr_pto (nth 1 (polar pfr_last_pto (/ pi 2) (* desnivel (/ (float plot_scale2) (float vt_scale2)))))))
	  ((= pfr_decision "Desce")
		(setq y_curr_pto (nth 1 (polar pfr_last_pto (* 3 (/ pi 2)) (* desnivel (/ (float plot_scale2) (float vt_scale2)))))))
	  ((= pfr_decision "Horizontal")
		(setq y_curr_pto (nth 1 pfr_last_pto)))
	);cond
    	(setq pfr_curr_pto (list x_curr_pto y_curr_pto))
       	(command "._point" "_non" pfr_curr_pto)
	(setq pfr_last_pto pfr_curr_pto)
  )
  	(pfr_decide)
	(pfr_keep1)
)


;renomear subgrupo
(defun net_grp_sub_rename ()
  (setq sgp_chsubname_newname nil)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "grp_sub_rename" dcl_id)) (exit))
  (set_tile "sub_chsubname_edit" (nth (read lib_blksub) lib_sublist))
  (mode_tile "sub_chsubname_edit" 2)
  (action_tile "sub_chsubname_edit" "(setq sgp_chsubname_newname $value)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq sub_rename_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 sub_rename_dialog)
    (if (and (/= nil sgp_chsubname_newname) (/= "" sgp_chsubname_newname))
      (progn
	(setq n_ordem (read lib_blksub)
	      list_n (length lib_sublist)
	      counter 0
	      new_list (list "")
	)
	(repeat list_n
	  (if (= counter n_ordem)
	    (setq new_list (append new_list (list sgp_chsubname_newname)))
	    (setq new_list (append new_list (list (nth counter lib_sublist))))
	  )
	  (setq counter (1+ counter))
	);repeat
	(setq lib_sublist (cdr new_list))
	(setq open_file (open (strcat cnp_netroot "/slides/" lib_blkpfx lib_blkfam lib_blkgrp ".txt") "w" "utf8"))
	(foreach n lib_sublist
	  (write-line n open_file)
	)
	(close open_file)
	(net_lib_fillsub)
	(start_list "lib_sublist")
	(mapcar 'add_list lib_sublist)
	(end_list)
	(net_grp_buttons_off)
      )
    )
  )	      
)


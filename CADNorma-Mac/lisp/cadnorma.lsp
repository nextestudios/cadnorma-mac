;filtra a lista até encontrar a lista final arrumada
(defun tqs_filterlist ()
  (repeat s1_n
    (setq ent_name (ssname s1 counter)
	  ent_list (entget ent_name)
	  ent_y (nth 1 (cdr (assoc 10 ent_list)))
	  ent_x (nth 0 (cdr (assoc 10 ent_list)))
	  ent_temp_list (append (list ent_y ent_x ent_name) ent_temp_list)
    )
    (setq counter (1+ counter))
    (setq tqs_fullist (append (list ent_temp_list) tqs_fullist)
	  ent_temp_list (list)
    )
  )
  ;a seguinte lista é ordenada ela coordenada Y.
  ;nesta etapa os textos estão alinhados
  (setq tqs_fullist2 (vl-sort tqs_fullist
	   (function (lambda (e1 e2) (> (nth 0 e1) (nth 0 e2))))))
  ;agora é necessário ordenar dentro de cada linha. Para isso será
  ;gerada uma nova lista, contendo cada elemento correspondendo a uma linha (alinhados em Y)
  (setq tqs_fullist3 (list)
	counter 0
	tqs_fullist2_n (length tqs_fullist2)
	y_atual nil
	linha_lista (list)
  )
  (while (/= nil (nth counter tqs_fullist2))
    (setq y_atual (nth 0 (nth counter tqs_fullist2))
	  linha_lista (list y_atual)
    )
    (while
      (and
	(/= (nth counter tqs_fullist2) nil)
	;(= (rtos y_atual 2 0) (rtos (nth 0 (nth counter tqs_fullist2)) 2 0))
	(< (abs (-  y_atual (nth 0 (nth counter tqs_fullist2)))) tqs_txtfator)
      )
      (setq linha_lista (append  linha_lista (list (cdr (nth counter tqs_fullist2))))
	    counter(1+ counter)
      )
    )
    (setq tqs_fullist3 (append (list linha_lista) tqs_fullist3))
  )
  ;agora que separei cada linha, é preciso ordenar por x
  (setq tqs_fullist4 (list))
  (foreach n tqs_fullist3
    (setq x_ordenado (vl-sort (cdr n)
	   (function (lambda (e1 e2) (< (nth 0 e1) (nth 0 e2))))))
    (setq tqs_fullist4 (append (list x_ordenado) tqs_fullist4))
  )
  ;agora pecisa extrair a lista final, contendo apenas os nomes das entidades odenadas
  (setq tqs_fullist5 (list)
	tqs_fullist4_n (length tqs_fullist4)
	linha (list)
	counter 0
  )
  (repeat tqs_fullist4_n
    (setq elem (nth counter tqs_fullist4))
    (foreach n elem
      (setq linha (append linha (list (nth 1 n))))
    )
    (setq tqs_fullist5 (append tqs_fullist5 (list linha))
	  counter (1+ counter)
	  linha (list)
    )
  )
  ;agora elimina as linhas órfãs
  (setq tqs_fullist6 (list))
  (foreach n tqs_fullist5
    (if (= 6 (length n))
      (setq tqs_fullist6 (append tqs_fullist6 (list n)))
    )
  )
)


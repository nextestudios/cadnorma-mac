;*****************************************
;Desenho das Maçanetas                    
;*****************************************
(defun prt_drw14_maçaneta ()
  (setq prt_mac1 (polar prt_porta4 (+ prt_angbase pi) (* 7.0 prt_fator))
	prt_mac2 (polar prt_porta3 (+ prt_angbase pi) (* 7.0 prt_fator))
  )
  (cond
    ((= prt_pt14_mac "prt_14_mac_01") (setq prt_mac_blk "prt_mac01"))
    ((= prt_pt14_mac "prt_14_mac_02") (setq prt_mac_blk "prt_mac02"))
    ((= prt_pt14_mac "prt_14_mac_03") (setq prt_mac_blk "prt_mac03"))
    ((= prt_pt14_mac "prt_14_mac_04") (setq prt_mac_blk "prt_mac04"))
  )
  (cn7_verylayer prt_layc_mal 7)
  (if (= prt_code 1)
    (cond
      ((or (= prt_xcode 1) (= prt_xcode 3) (= prt_xcode 4))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl prt_blkscl "_non" prt_porta4
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl prt_blkscl "_non" prt_porta3
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
      ((= prt_xcode 2)
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl (- prt_blkscl) "_non" prt_porta4
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl (- prt_blkscl) "_non" prt_porta3
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
    )
    (cond
      ((or (= prt_xcode 1) (= prt_xcode 4))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl (- prt_blkscl) "_non" prt_porta4
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl (- prt_blkscl) "_non" prt_porta3
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
      ((or (= prt_xcode 2) (= prt_xcode 3))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl prt_blkscl "_non" prt_porta4
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl prt_blkscl "_non" prt_porta3
		"._explode" (entlast) "" "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
    )
  )
)


;Espessura por Pick Points
(defun prt_21_poe_button_act ()
  (prt_pt21_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")
	pt2 (getpoint pt1 "Segundo ponto da espessura da porta...: ")
	poe_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* poe_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* poe_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* poe_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq prt_pt21_poe (rtos new_dist 2 2))
      (prt_pt21_writefile)
    )
  )
  (prt_cfg_21)
)


;verifica se o valor de espessura entrado é válido
(defun prt_21_poe_edit_act ()
  (setq prt_var_newpoe $value)
  (if (distof prt_var_newpoe)
    (progn
      (setq prt_pt21_poe prt_var_newpoe)
      (prt_pt21_writefile)
    )
    (progn
      (alert "Valor Inválido!")
      (set_tile "prt_21_poe_edit" prt_pt21_poe)
      (mode_tile "prt_21_poe_edit" 2)
    )
  )
)  

;lê os dados iniciais da DCL no arquivo de dados
(defun prt_pt21_file ()
  (if (findfile (strcat cnp_root "/config/prt_pt21.txt"))
    (prt_pt21_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/prt_pt21.txt") "w" "utf8"))
      (write-line "3" file)
      (write-line "1" file)
      (write-line "1" file)      
      (write-line "1" file)
      (write-line "1" file)
      (write-line "prt_21_pos_01" file)
      (write-line "prt_21_cxi_01" file)
      (close file)
      (prt_pt21_readfile)
    )
  )
)


;função que lê o arquivo de dados
(defun prt_pt21_readfile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt21.txt") "r" "utf8"))
  (setq	prt_pt21_poe (read-line file))
  (setq	prt_pt21_soi (read-line file))
  (setq	prt_pt21_soe (read-line file))
  (setq	prt_pt21_ali (read-line file))
  (setq	prt_pt21_ale (read-line file))
  (setq	prt_pt21_pos (read-line file))
  (setq	prt_pt21_cxi (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun prt_pt21_writefile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt21.txt") "w" "utf8"))
  (write-line prt_pt21_poe file)
  (write-line prt_pt21_soi file)
  (write-line prt_pt21_soe file)
  (write-line prt_pt21_ali file)
  (write-line prt_pt21_ale file)
  (write-line prt_pt21_pos file)
  (write-line prt_pt21_cxi file)
  (close file)
)

;Desenha a porta
(defun prt_drw21 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt21_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_drw21_openfree)
  (if (= prt_pt21_pos "prt_21_pos_01")
    (prt_drw21a_caixilho)
    (prt_drw21b_caixilho)
  )
  (prt_drw21_porta)
  (prt_drw21_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw21_alisar)
  )
  (prt_drw21_seta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)

;*****************************************
;Desenho das Setas                        
;*****************************************
(defun prt_drw21_seta ()
  (cn7_verylayer "porta_seta" 1)
  (if (= prt_pt21_pos "prt_21_pos_01")
    (setq prt_seta (polar prt_porta2 prt_angbase (/ prt_larg 2.0))
	  prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 5))
    )
    (setq prt_seta (polar prt_porta1a prt_angbase (/ prt_larg 2.0))
	  prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 5))
    )
  )
  (command "._insert" (strcat cnp_root "/blocos/prt_seta") "_s" (/ prt_blkscl 1.25) "_non" prt_seta (* 180 (/ prt_angbase pi)))
)

;*****************************************
;Desenho das Alisares                     
;*****************************************
(defun prt_drw21_alisar ()
  (cn7_verylayer prt_layc_all 7)
  (setvar "cecolor" prt_layc_alc)
  ;alisares internos
  (if (= "1" prt_pt21_ali)
    (progn
      ;porta externa
      (if (= prt_pt21_pos "prt_21_pos_01")
	(progn
	  (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* 1.0 prt_fator))
		prt_ali_a2 (polar prt_ali_a1 prt_angortho (* (- (distof prt_pt21_poe) 1.0) prt_fator))
		prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* prt_fator 4.0))
		prt_ali_a4 (polar prt_brk1 (+ prt_angbase pi) (* prt_fator 5.0))
	  )
	  (command "._line" "_non" prt_cxi1 "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
	)
	;porta interna
	(progn
	  (if (= prt_pt21_cxi "prt_21_cxi_01")
	    ;caixiho simples
	    (progn
	      (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* prt_fator 1.0))
		    prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* prt_fator 1.0))
		    prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* prt_fator 5.0))
		    prt_ali_a4 (polar prt_ali_a3 prt_angortho (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
	      (setq prt_ali_b1 (polar prt_cxi3 prt_angbase (* prt_fator 1.0))
		    prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* prt_fator 1.0))
		    prt_ali_b3 (polar prt_ali_b2 prt_angbase (* prt_fator 5.0))
		    prt_ali_b4 (polar prt_ali_b3 prt_angortho (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
	    )
	    ;caixilho detalhado
	    (progn
	      (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* prt_fator 1.0))
		    prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* prt_fator 1.0))
		    prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* prt_fator 5.0))
		    prt_ali_a4 (polar prt_ali_a3 prt_angortho (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
	      (setq prt_ali_b1 (polar prt_cxi5 prt_angbase (* prt_fator 1.0))
		    prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* prt_fator 1.0))
		    prt_ali_b3 (polar prt_ali_b2 prt_angbase (* prt_fator 5.0))
		    prt_ali_b4 (polar prt_ali_b3 prt_angortho (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
	    )
	  )
	)
      )
    )
  )
  ;alisares externos
  (if (= "1" prt_pt21_ale)
    (progn
      ;porta externa
      (if (= prt_pt21_pos "prt_21_pos_01")
	;caixilho simples
	(if (= prt_pt21_cxi "prt_21_cxi_01")
	  (progn
	    (setq prt_ale_c1 (polar prt_cxi3 (+ prt_angbase pi) (* 1.0 prt_fator))
		  prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		  prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		  prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	    )
	    (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	    (setq prt_ale_d1 (polar prt_cxi5 prt_angbase (* 1.0 prt_fator))
		  prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		  prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		  prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	    )
	    (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	  )
	  ;caixilho detalhado
	  (progn
	    (setq prt_ale_c1 (polar prt_cxi5 (+ prt_angbase pi) (* 1.0 prt_fator))
		  prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		  prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		  prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	    )
	    (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	    (setq prt_ale_d1 (polar prt_cxi7 prt_angbase (* 1.0 prt_fator))
		  prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		  prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		  prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	    )
	    (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	  )
	)
	;porta interna
	(progn
	  (if (= prt_pt21_cxi "prt_21_cxi_01")
	    ;caixiho simples
	    (progn
	      (setq prt_ale_c1 (polar prt_cxi2 (+ prt_angbase pi) (* prt_fator 1.0))
		    prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		    prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		    prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	      (setq prt_ale_d1 (polar prt_cxi6 prt_angbase (* prt_fator 1.0))
		    prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		    prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		    prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	    )
	    ;caixilho detalhado
	    (progn
	      (setq prt_ale_c1 (polar prt_cxi4 (+ prt_angbase pi) (* prt_fator 1.0))
		    prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		    prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		    prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	      (setq prt_ale_d1 (polar prt_cxi8 prt_angbase (* prt_fator 1.0))
		    prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		    prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		    prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	      )
	      (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	    )
	  )
	)
      )
    )
  )
)



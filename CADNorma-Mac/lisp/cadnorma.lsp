;após inserir o símbolo, decidir se desenha ou não a chamada
;e se ela será em linha ou em arco
(defun chamada ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
	    "textstyle" "luprec" "osmode" ))
  (initget "Linha Arco Nenhum")
  (if (not chamada_atual)
    (progn
      (setq chamada_atual (getkword "\n<Linha>/Arco/Nenhum...: "))
      (if (= chamada_atual nil) (setq chamada_atual "Linha"))
    )
    (progn
      (cond
	((= chamada_atual "Linha")
	 (setq chamada_nova (getkword "\n<Linha>/Arco/Nenhum...: "))
	 (if (/= nil chamada_nova) (setq chamada_atual chamada_nova))
	)
	((= chamada_atual "Arco")
	 (setq chamada_nova (getkword "\nLinha/<Arco>/Nenhum...: "))
	 (if (/= nil chamada_nova) (setq chamada_atual chamada_nova))
	)
	((= chamada_atual "Nenhum")
	 (setq chamada_nova (getkword "\nLinha/Arco/<Nenhum>...: "))
	 (if (/= nil chamada_nova) (setq chamada_atual chamada_nova))
	)
      )
    )
  )
  (cond
    ((= chamada_atual "Arco") (cha_action))
    ((= chamada_atual "Linha")(chl_action))
;;;    (t (exit))
  )
  (princ)
)


;inicializa o gerenciador de blocos de fabricantes
(defun bib_main ()
  (setq lib_list (list))
  (setq file (open (strcat cnp_root "/fabricantes/fablib.txt") "r" "utf8"))
  (while (/= nil (setq linha (read-line file)))
    (setq lib_list (append lib_list (list linha)))
  )
  (close file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn8_lib" dcl_id)) (exit))
  (start_list "lib_grupos")
  (mapcar 'add_list lib_list)
  (end_list)
  (mode_tile "cn8_lib_btn_use" 1)
  (mode_tile "cn8_lib_btn_www" 1)
  (mode_tile "accept" 1)
  (action_tile "lib_grupos" "(cnlib_updinfo)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 2)")
  (action_tile  "cn8_lib_btn_add" "(done_dialog 3)")
  (action_tile  "cn8_lib_btn_www" "(done_dialog 4)")
;;;  (action_tile  "cn8_lib_btn_rmv" "(done_dialog 5)")
  (setq fablib_dialog (start_dialog))
  (unload_dialog dcl_id)
  (cond
    ((= 2 fablib_dialog) (cn8_lib_use))
    ((= 3 fablib_dialog) (cn8_lib_add))
    ((= 4 fablib_dialog) (cn8_lib_www))
  )
)



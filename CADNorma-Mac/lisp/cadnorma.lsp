;Desenha colunas
(defun c:descol ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
	    "textstyle" "luprec" "osmode" "dimzin"))
  (setvar "cmdecho" 0)
  (setvar "orthomode" 0)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cn7_verylayer (strcat cn7_blk_prefixlay "Tub_verticais") 3)
  ;coleta os dados
  (setq pt1 (getpoint "\nEixo da Tubulação: ")
	pt2 (getpoint pt1 "\nPosição do Texto: "))
  (if (= dt nil)
    (while (= dt nil)
      (setq dt (getreal "\nDiâmetro doTubo (em mm)..."))
    )
    (setq dt (getreal (strcat "\nDiâmetro do Tubo (em mm)... <" (rtos dt) ">: ")))
  )
  (if (= dt nil)
    (setq dt dt1)
    (setq dt1 dt)
  )
  (if (= "" (setq sg (getstring "\nSigla da Tubulação (AF, TQ, ...): "))) (exit))
  ;processa os dados
  (setq ang1 (angle pt1 pt2))
  (if (= dt nil) (quit))
  (cond
    ((= cn7_dwgunit 1.0)   (setq dt2 (/ dt 1000)))
    ((= cn7_dwgunit 100.0) (setq dt2 (/ dt 10)))
    ((= cn7_dwgunit 1000.0) (setq dt2 dt))
  )
  (setvar "osmode" 0)
  (if (= ang1 nil) (setq ang1 0.0))
  (setq ang (rtos (* ang1 (/ 180 pi))))
  (if (= ang nil) (setq ang "0"))
  (setq dist1 (polar pt1 ang1 (/ dt2 2)))

  ;decide o tipo de representação
  (initget "Sobe Desce Passa")
  (if (= nil descol_resp)
    (progn
      (setq descol_resp (getkword "\n<Sobe>/Desce/Passa...: "))
      (if (= nil descol_resp) (setq descol_resp "Sobe"))
    )
    (progn
      (cond
	((= descol_resp "Sobe")
	 (setq descol_resp (getkword "\n<Sobe>/Desce/Passa...: "))
	 (if (= nil descol_resp) (setq descol_resp "Sobe"))
	)
	((= descol_resp "Desce")
	 (setq descol_resp (getkword "\nSobe/<Desce>/Passa...: "))
	 (if (= nil descol_resp) (setq descol_resp "Desce"))
	)
	((= descol_resp "Passa")
	 (setq descol_resp (getkword "\nSobe/Desce/<Passa>...: "))
	 (if (= nil descol_resp) (setq descol_resp "Passa"))
	)
      )
    )
  )
  (cn7_verylayer (strcat cn7_prefixlay "Tub_verticais") 3)
  (cond
    ((= descol_resp "Sobe")
     (setq pt3 (polar pt2 (angle pt2 dist1) (* cn7_blkscl 0.35)))
     (command "._circle" "_non" pt1 "_d" "_non" dt2 "._pline" "_non" dist1 "_w" "0.0" "0.0" "_non" pt3 "_w" (* cn7_blkscl 0.1) "0.0" "_non" pt2 ""))
    ((= descol_resp "Desce")
     (setq pt3 (polar dist1 (angle dist1 pt2) (* cn7_blkscl 0.35)))
     (command "._circle" "_non" pt1 "_d" dt2 "._pline" "_non" pt2 "_w" "0.0" "0.0" "_non" pt3 "_w" (* cn7_blkscl 0.1) "0.0" dist1 ""))
    ((= descol_resp "Passa")
     (command "._circle" "_non" pt1 "_d" dt2 "._pline" "_non" dist1 "_non" pt2 ""))
  )
  (if (>= (cos ang1) 0)
    (setq bloco (strcat cnp_root "/blocos/tub_tcol1"))
    (setq bloco (strcat cnp_root "/blocos/tub_tcol2"))
  )
  (setq attdia_mode (getvar "attdia"))
  (setvar "attdia" 0)
  (setvar "dimzin" 8)
  (command "._insert" bloco "_non" pt2 cn7_blkscl "" 0 sg (strcat "%%c" (rtos dt)))
  (setvar "attdia" attdia_mode)
  (devolve)
  (princ)
)


(defun c:idcol ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setq osmo (getvar "osmode"))
  (setvar "osmode" 512)
  (setq
    p1 (getpoint "\nPonto de identificação...")
    p2 (getpoint p1 "\nPosição da Legenda...")
    angrad (angle p1 p2)
    angdeg (/ (* 180 angrad) pi)
    ttub (getstring "\nTipo de Tubulacao <ex. ES, AF, AQ...>...: ")
    dtub (strcat "%%c" (getstring "\nDiametro da Tubulacao <ex. 50>..."))
    p3 (polar p1 angrad (* cn7_blkscl 0.35))
    p4 (polar p2 (+ pi angrad) (* cn7_blkscl 0.95))
    p5 (polar p2 (+ pi angrad) (* cn7_blkscl 0.6))
    p6 (polar p2 angrad (* cn7_blkscl 0.6))
    p7 (polar p6 angrad (* cn7_blkscl 0.5))
  )
  (initget "Sobe Desce Passa")
  (if (= nil idcol_resp)
    (progn
      (setq idcol_resp (getkword "\n<Sobe>/Desce/Passa...: "))
      (if (= nil idcol_resp) (setq idcol_resp "Sobe"))
    )
    (progn
      (cond
	((= idcol_resp "Sobe")
	 (setq idcol_resp (getkword "\n<Sobe>/Desce/Passa...: "))
	 (if (= nil idcol_resp) (setq idcol_resp "Sobe"))
	)
	((= idcol_resp "Desce")
	 (setq idcol_resp (getkword "\nSobe/<Desce>/Passa...: "))
	 (if (= nil idcol_resp) (setq idcol_resp "Desce"))
	)
	((= idcol_resp "Passa")
	 (setq idcol_resp (getkword "\nSobe/Desce/<Passa>...: "))
	 (if (= nil idcol_resp) (setq idcol_resp "Passa"))
	)
      )
    )
  )
  (cn7_verylayer (strcat cn7_blk_prefixlay "Tub_verticais") 3)
  (setvar "osmode" 0)
  (cond
    ((= idcol_resp "Sobe") (command "._pline" p1 "_w" 0 0  p4 "_w" (* cn7_blkscl 0.1) 0 p5 ""))
    ((= idcol_resp "Desce") (command "._pline" p1 "_w" 0 (* cn7_blkscl 0.1)  p3 "_w" 0 0 p5 ""))
    ((= idcol_resp "Passa") (command "._pline" p1 p5 ""))
  )
  (command "._pline" p6 p7 "")
  (command "._insert" (strcat cnp_root "/blocos/idcol") "_s" cn7_blkscl p2 0 ttub dtub)
  (devolve)
  (princ)
)


(DEFUN c:TISO	(/ s1 p1 expert osmode)
  (SETVAR "CMDECHO" 0)
  ;; Desligar o echo dos comandos
  (IF ;; Se o ponto p1 for fornecido
      (SETQ
	p1 (GETPOINT
	     (STRCAT "\n-> Selecione o ponto base da "
		     "transformação de planta baixa em isométrico :  "
	     )
	   )
      )
    (PROGN ;; Então executar as expressões seguintes :
	   (SETQ expert	(GETVAR "EXPERT")
		 osmode	(GETVAR "OSMODE")
	   )
	   ;; Salvar valores das variáveis de ambiente, para
	   ;; posterior restauração...
	   (SETVAR "EXPERT" 5)
	   (SETVAR "OSMODE" 0)
	   ;; Ajustar estas variáveis para os valores
	   ;; adequados à rotina...
	   (PRINC "\n-> Selecione o objeto para virar isométrico : ")
	   ;; Informar ao usuário em PORTUGUÊS...
	   (SETQ s1 (SSGET))
	   ;; pois a mensagem de ssget é em inglês, pedindo ao
	   ;; usuário para selecionar entidades, que serão colocadas
	   ;; em vista isométrica em 2d e meio...
	   (IF s1
	     ;; Selecionou entidades? Então, prosseguir com a rotina...
	     (COMMAND "_.ROTATE"
		      s1
		      ""
		      p1
		      "-45"
		      "_.BLOCK"
		      "MY_TEMP_ISO"
		      p1
		      "_P"
		      ""
		      "_.INSERT"
		      "MY_TEMP_ISO"
		      p1
		      1.224744871391588
		      0.7071067811865475
		      ""
		      "_.EXPLODE"
		      (ENTLAST)
	     )
	     ;; Não selecionou, retornar 'nil' (ou nada)
	     nil
	   )
	   ;; Restaurar os valores originais das variáveis
	   ;; de sistema modificadas...
	   (SETVAR "EXPERT" expert)
	   (SETVAR "OSMODE" osmode)
    )
    ;; O ponto p1 não foi fornecido, então retornar 'nil'
    nil
  )
  ;; Limpar o prompt de qualquer retorno na saida e encerrar a rotina...
  (PRINC)
)


(defun leg_id15 ()
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cn7_verylayer (strcat cn7_blk_prefixlay "Legendas") 1)
  (setq pt1 (getpoint "\nPoto de inserção... ")
	pt2 (getpoint pt1 "\nDireção...")
	pt3 (polar pt1 (angle pt1 pt2) (* 0.4 cn7_blkscl))
	pt4 (polar pt1 (angle pt1 pt2) (* 0.8 cn7_blkscl))
	pt5 (polar pt1 (angle pt1 pt2) (* 1.2 cn7_blkscl))
	ang (angle pt1 pt2))
  (cond
    ((or (= ang 0) (= ang (/ pi 2)) (= ang pi) (= ang (* 3 (/ pi 2)))) (setq txang 0))
    ((and (> ang 0) (< ang pi)) (setq txang (/ (* 180 (- ang (/ pi 2))) pi)))
    ((and (> ang pi) (< ang (* 2 pi))) (setq txang (/ (* 180 (+ ang (/ pi 2))) pi)))
  )
  (setq txt1 (getstring "\nA: ")
	txt2 (getstring "\nB: ")
	txt3 (getstring "\nC: "))
  
  (if (not (findfile  (strcat cnp_root "/blocos/cvg_id15.dwg")))
    (progn
      (alert "Bloco não encontrado!")
      (exit)
    )
    (progn
      (command "._insert"  (strcat cnp_root "/blocos/cvg_id15") "_s" cn7_blkscl "_non" pt1 "_non" pt2 txt1 txt2 txt3)
      (setq ent1 (entlast))
      (while (/= "SEQEND" (cdr (assoc 0 (setq selent (entget (setq ent1 (entnext ent1)))))))
	(if (= "ATTRIB" (cdr (assoc 0 selent)))
	  (progn
	    (setq selent_name (cdr (assoc -1 selent)))
	    (command "._attedit" "_y" "" "" "" selent_name "_a" txang "")
	  )
	)
      )
    )
  )
)


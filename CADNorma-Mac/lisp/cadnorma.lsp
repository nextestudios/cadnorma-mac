;desenha a porta entre os batentes
(defun prt_draw34_porta ()
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (setq prt_porta0 (polar prt_bat1 prt_angbase (/ (/ prt_larg n_folhas) 2.0))
	prt_porta0a (polar prt_porta0 (+ prt_angbase (/ (* 3 pi) 4)) (/ (/ prt_larg n_folhas) 2.0))
	prt_porta0b (polar prt_porta0 (- prt_angbase (/ pi 4)) (/ (/ prt_larg n_folhas) 2.0))
	prt_porta1 (polar prt_porta0a (+ prt_angbase (* 5 (/ pi 4))) (/ (* prt_fator (distof prt_pt34_poe)) 2))
	prt_porta2 (polar prt_porta0a (+ prt_angbase (/ pi 4)) (/ (* prt_fator (distof prt_pt34_poe)) 2))
	prt_porta3 (polar prt_porta0b (+ prt_angbase (* 5 (/ pi 4))) (/ (* prt_fator (distof prt_pt34_poe)) 2))
	prt_porta4 (polar prt_porta0b (+ prt_angbase (/ pi 4)) (/ (* prt_fator (distof prt_pt34_poe)) 2))
  )
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2   "_non" prt_porta4  "_non" prt_porta3 "_c"
	   "._donut" 0.0 (/ (* prt_fator (distof prt_pt34_poe)) 2) "_non" prt_porta0 ""
  )
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (cn7_verylayer prt_layc_arl 7)
  (setvar "cecolor" prt_layc_arc)
  (command "._arc" "_non" prt_porta1 "_e" "_non" prt_bat1 "_a" "45"
	   "._arc" "_non" prt_porta4 "_e" "_non" prt_bat2 "_a" "45"
  )
  (setvar "celtype" "bylayer")
)


;*****************************************
;Desenho das Portas                       
;*****************************************
(defun prt_drw34_porta ()
  (setq n_folhas (fix (distof prt_pt34_qtd)))
  (if (= n_folhas 1)
    (progn
      (setq prt_bat1 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	    prt_bat2 (polar prt_cxi2 prt_angortho (/ prt_wall 2.0))
      )
      (prt_draw34_porta)
    )
    (progn
      (setq vao (/ prt_larg n_folhas)
	    prt_bat1 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	    prt_bat2 prt_bat1
      )
      (repeat (1- n_folhas)
	(setq prt_bat1 prt_bat2
	      prt_bat2  (polar prt_bat2 prt_angbase vao)
        )
	(prt_draw34_porta)
      );repeat
      (setq prt_bat1 prt_bat2
	    prt_bat2 (polar prt_bat2 prt_angbase vao)
      )
      (prt_draw34_porta)
     )	    
  )
)


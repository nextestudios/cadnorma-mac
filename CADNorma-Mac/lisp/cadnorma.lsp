;*******************************************
;desnível de piso
;*******************************************
(defun c:dsnv ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cmdecho" 0)
  (setq attmode (getvar "attdia"))
  (setvar "attdia"  0)
  (setq pt1 (getpoint "\nIndique o ponto do desnivel...")
	pt2 (getpoint pt1 "\nClique no lado mais alto...")
	rang (angle pt1 pt2)
	pt3 (polar pt1 (angle pt2 pt1) (distance pt2 pt1)))
  (setq altd (getstring "\nAltura do desnivel (em cm)? "))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cn7_verylayer (strcat cn7_blk_prefixlay "Desnível") 1)
  (if (or
	(and (>= rang 0) (<= rang (/ pi 2)))
	(and (>= rang (/ (* pi 3) 2)) (<= rang (* 2 pi))))
    (command "._insert" (strcat cnp_root "/blocos/dsnv1") "_non" pt1 cn7_blkscl "" pt2 altd)
    (command "._insert" (strcat cnp_root "/blocos/dsnv2") "_non" pt1 cn7_blkscl "" pt3 altd)
  )
  (devolve)
  (setvar "attdia"  attmode)
)

;*******************************************
;indicação de escada que sobe
;*******************************************
(defun c:sobe ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cmdecho" 0)
  (setq grp_type "2" grp_unit "100")
  (cn7_find_blkscl)
  (cn7_verylayer (strcat cn7_blk_prefixlay "Escada_sobe") 1)
  (setq pt1 (getpoint  "\nInício da subida......"))
  (setq psimb_txt pt1)
  (command "._insert" (strcat cnp_root "/blocos/escada_sobe") "_scale" cn7_blkscl "_non" pt1 "0" "._pline" "_non" "@")
  (while (/= nil (setq pt2 (getpoint pt1 "\nPróximo ponto...")))
    (setq ang (+ 180 (* 180 (/ (angle pt1 pt2) pi))))
    (command pt2)
    (setq pt1 pt2)
  )
  (command "" "insert" (strcat cnp_root "/blocos/util_st1") "_scale" cn7_blkscl "_non" "@" ang)
  (setq psimb_txt (getpoint psimb_txt "\nPosição do texto..."))
  (initget "Sobe Desce")
  (setq sobe_opt (getkword "Desce/<Sobe>: "))
  (if (= sobe_opt nil) (setq sobe_opt "Sobe"))
  (if (= sobe_opt "Sobe")
    (cn7_txsimb "r60" "_m" "S" 1 (strcat cn7_blk_prefixlay "Escada_sobe") 0)
    (cn7_txsimb "r60" "_m" "D" 1 (strcat cn7_blk_prefixlay "Escada_sobe") 0)
  )
  (devolve)
  (setq grp_type nil)
  (princ)
)








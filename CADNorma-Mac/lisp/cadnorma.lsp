;lâ a lista de alturas disponíveis
(defun prt_halt_readfile ()
  (setq file (open (strcat cnp_root "/config/prt_altura.txt") "r" "utf8"))
  (setq prt_halt_list (list))
  (while (/= nil (setq linha (read-line file)))
    (setq prt_halt_list (append prt_halt_list (list linha)))
  )
  (close file)
)

;escreve a lista de alturas disponíveis

;função principal - DCL de Dados
(defun cbt_main ()
  (cn7_init)
  ;abre a caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "coberturas" dcl_id)) (exit))
  (cbt_update_slides)
  ;atualiza o texto
  (cond
    ((= cbt_var_tipo "11") (set_tile "cbt_text_type" "Tipo Atual: Uma Água"))
    ((= cbt_var_tipo "12") (set_tile "cbt_text_type" "Tipo Atual: Duas Águas"))
    ((= cbt_var_tipo "13") (set_tile "cbt_text_type" "Tipo Atual: Três Águas"))
    ((= cbt_var_tipo "21") (set_tile "cbt_text_type" "Tipo Atual: Quatro Águas"))
    ((= cbt_var_tipo "22") (set_tile "cbt_text_type" "Tipo Atual: Seis Águas e 'L'"))
    ((= cbt_var_tipo "23") (set_tile "cbt_text_type" "Tipo Atual: Sete Águas em 'T'"))
  )
  ;hachuras
  (set_tile "cbt_tog_hch" cbt_var_dhch)
  (cbt_eval_hatch)
  (action_tile "cbt_tog_hch" "(cbt_hchtog_action)")
  (setq cbt_hch_list (list "ANSI" "TELHA 01" "TELHA 02" "TELHA 03" "TELHA 04"
			   "TELHA 05" "TELHA 06" "TELHA 07" )
  )
  (start_list "cbt_lst_hch")
  (mapcar 'add_list cbt_hch_list)
  (end_list)
  (set_tile "cbt_lst_hch" cbt_var_thch)
  (action_tile "cbt_lst_hch" "(cbt_lst_hchaction)")
  (cbt_upd_imghch)
  ;fator da hachura
  (set_tile "cbt_fat_hch" cbt_var_fhch)
  (action_tile "cbt_fat_hch" "(cb1_drw_evalfhch)")
  ;seta de caimento
  (set_tile "cbt_tog_set" cbt_var_dset)
  (cbt_eval_seta)
  (action_tile "cbt_tog_set" "(cbt_settog_action)")
  (setq cbt_set_list (list "SETA 01" "SETA 02" "SETA 03" "SETA 04"))
  (start_list "cbt_lst_set")
  (mapcar 'add_list cbt_set_list)
  (end_list)
  (set_tile "cbt_lst_set" cbt_var_tset)
  (action_tile "cbt_lst_set" "(cbt_lst_setaction)")
  (cbt_upd_imgset)
  ;fator da seta
  (set_tile "cbt_fat_set" cbt_var_fset)
  (action_tile "cbt_fat_set" "(cb1_drw_evalfset)")
  ;configuração de cores e layers
  (action_tile "cbt_cfg_laycol" "(done_dialog 2)")
  ;funções ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq cbt_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 cbt_dcl_id) (cbt_ok_action))
  (if (= 2 cbt_dcl_id) (cbt_laycol_button))
  (princ)
)


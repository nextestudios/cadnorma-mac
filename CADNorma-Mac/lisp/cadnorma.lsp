;função para inserir a inclinação de uma direção
(defun c:incl ()
  (if (= nil incl_dec) (setq incl_dec 1))
  (cvg_incl)
  (princ)
)

(defun cvg_incl ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
      "textstyle" "luprec" "osmode" ))
  (setq attdia_mo (getvar "attdia")
	dzin_mo (getvar "dimzin"))
 (initget 128)
 (setq pt1 (getpoint "\nDecimais/<Primeiro ponto>..."))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setq pt2 (getpoint pt1 "\nSegundo ponto...")
	   incl_ang (angle pt1 pt2)
	   pt3 (getpoint "Ponto onde inserir o símbolo...(ENTER=Primeiro ponto)... "))
     (if (= nil pt3) (setq pt3 pt1))
     (if (and (> incl_ang (/ pi 2)) (< incl_ang (/ (* 3 pi) 2)))
       (setq pt4 (polar pt3 (+ pi incl_ang) (distance pt1 pt2)))
       (setq pt4 (polar pt3 incl_ang (distance pt1 pt2)))
     )
     (setq inclina (abs (* 100 (/ (- (nth 1 pt2) (nth 1 pt1)) (- (nth 0 pt2) (nth 0 pt1))))))
     (setvar "dimzin" 0)
     (setq inclina_txt (strcat "i=" (rtos inclina 2 incl_dec) "%"))
     (setvar "dimzin" dzin_mo)
     (setvar "attdia" 0)
     (setq grp_type "2")
     (cn7_find_blkscl)
     (cn7_verylayer (strcat cn7_blk_prefixlay "Inclinações") 1)
     (if (and (> incl_ang (/ pi 2)) (< incl_ang (/ (* 3 pi) 2)))
       (command "._insert"  (strcat cnp_root "/blocos/cvg_incl2") "_non" pt3 cn7_blkscl "" "_non" pt4 inclina_txt)
       (command "._insert"  (strcat cnp_root "/blocos/cvg_incl") "_non" pt3 cn7_blkscl "" "_non" pt4 inclina_txt)
     )
     (setvar "attdia" attdia_mo)
    )
    ((= 'STR  (type pt1))
     (cond       
       ((= "D" (strcase pt1))
	(inclina_dec)
	(cvg_incl)
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto ou digite <R> para referência...")
	(cvg_incl)
       )
     )
   )
  );cond
  (devolve)
)

;define o número de decimais a usar
(defun inclina_dec ()
  (setq incl_dec (getint "\nNúmero de casas decimais...(ENTER=1)... "))
  (if (= nil incl_dec) (setq incl_dec 1))
)


;marcação de declividade
(defun c:decl ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
      "textstyle" "luprec" "osmode" ))
  (prompt "\nSelecione a linha no ponto superior da marcação...")
  (setq osmo (getvar "osmode"))
  (setvar "osmode" 512)
  (setq ent (entsel)
	entmanr (car ent)
	pt1 (nth 1 ent)
	pt2 (getpoint pt1 "\nPonto inferior... "))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cn7_verylayer (strcat cn7_blk_prefixlay "Inclinações") 1)
  (command "._line" "_nea" pt1 (setq pt3 (getvar "lastpoint")) ".x" "@" pt2 "")
  (setvar "osmode" osmo)
  (setq pt4 (getvar "lastpoint") l2 (entlast))
  (command "._line" "_non" pt2 "_non" pt4 "")
  (setq l1 (entlast))
  (if (or (= pt2 pt3) (= (nth 0 pt2) (nth 0 pt3)) (= (nth 1 pt2) (nth 1 pt3)))
    (progn
      (alert "Inpossível marcar linhas\norizontais ou Verticais!")
      (exit)
     )
  )
  (setq
    dx (- (nth 0 pt4) (nth 0 pt2))
    dy (- (nth 1 pt3) (nth 1 pt4))
    razao (rtos (abs (/ dy dx)) 2 2))
  (if (> (nth 0 pt4) (nth 0 pt2))
    (progn
      (setq pt5 (polar pt2 0 (/ (distance pt2 pt4) 2))
	    psimb_txt (polar pt5 (/ (* 3 pi) 2) (* 0.1 cn7_blkscl)))
      (cn7_txsimb "r60" "tc" "1" 1 "Inclinações" 0)
      (setq txt1 (entlast))
      (setq pt6 (polar pt4 (/ pi 2) (/ (distance pt4 pt3) 2))
	    psimb_txt (polar pt6 0 (* 0.1 cn7_blkscl)))
      (cn7_txsimb "r60" "ml" razao 1 "Inclinações" 0)
      (setq txt2 (entlast))
    )
    (progn
      (setq pt5 (polar pt4 0 (/ (distance pt2 pt4) 2))
	    psimb_txt (polar pt5 (/ (* 3 pi) 2) (* 0.1 cn7_blkscl)))
      (cn7_txsimb "r60" "tc" "1" 1 "Inclinações" 0)
      (setq txt1 (entlast))
      (setq pt6 (polar pt4 (/ pi 2) (/ (distance pt4 pt3) 2))
	    psimb_txt (polar pt6 pi (* 0.1 cn7_blkscl)))
      (cn7_txsimb "r60" "mr" razao 1 "Inclinações" 0)
      (setq txt2 (entlast))
    )
  )
  (initget "Sim Não")
  (setq resp (getkword "\nColocar a simbologia acima da linha <S/N>?...(ENTER=Não)... "))
  (if (= resp nil) (setq resp "Não"))
  (if (= resp "Sim")
    (progn
      (command "._mirror" l1 txt1 "" pt6 "_non" "@1,0" "_y")
      (command "._mirror" l2 txt2 "" pt5 "_non" "@0,1" "_y")
    )
  )
  (devolve)
  (princ)
)




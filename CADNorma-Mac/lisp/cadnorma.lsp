  (setq	scd12_layc_dvl (read-line file))
  (setq	scd12_layc_dvc (read-line file))
  (setq	scd12_layc_dpl (read-line file))
  (setq	scd12_layc_dpc (read-line file))
  (setq	scd12_layc_crl (read-line file))
  (setq	scd12_layc_crc (read-line file))
  (setq	scd12_layc_itl (read-line file))
  (setq	scd12_layc_itc (read-line file))
  (close file)
)

;função que escreve o arquivo de dados

;Desenha a porta
(defun prt_drw33 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt33_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_openfree 4.0)
  (prt_drw33_caixilho)
  (prt_drw33_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw33_alisar)
  )
  (prt_drw33_porta)
  (prt_drw33_seta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)

;*****************************************
;Desenho das Setas                        
;*****************************************
(defun prt_drw33_seta ()
  (cn7_verylayer "porta_seta" 1)
  (setq prt_seta (polar prt_porta15 prt_angbase (/ prt_larg 8.0))
	prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 7.5))
    )
  (command "._insert" (strcat cnp_root "/blocos/prt_seta") "_s" (/ prt_blkscl 1.25) "_non" prt_seta (* 180 (/ prt_angbase pi)))
  (setq prt_seta (polar prt_seta prt_angbase (/ prt_larg 2.0)))
  (command "._insert" (strcat cnp_root "/blocos/prt_seta") "_s" (/ prt_blkscl 1.25) "_non" prt_seta (* 180 (/ prt_angbase pi)))
)

;*****************************************
;Desenho das Portas                       
;*****************************************
(defun prt_drw33_porta ()
  (setq prt_porta0 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	prt_porta1 (polar prt_porta0 prt_angbase (* 5 (/ prt_larg 8.0)))
	prt_porta2 (polar prt_porta1 prt_angbase (/ prt_larg 4.0))
	prt_porta3 (polar prt_porta2 (+ pi prt_angortho) (* prt_fator (distof prt_pt33_poe)))
	prt_porta4 (polar prt_porta3 (+ pi prt_angbase) (/ prt_larg 4.0))
	prt_porta5 (polar prt_porta1 prt_angbase (/ prt_larg 8.0))
	prt_porta6 (polar prt_porta5 prt_angbase (/ prt_larg 4.0))
	prt_porta7 (polar prt_porta6 prt_angortho (* prt_fator (distof prt_pt33_poe)))
	prt_porta8 (polar prt_porta7 (+ pi prt_angbase) (/ prt_larg 4.0))
	prt_porta9 (polar prt_porta0 prt_angbase (/ prt_larg 4.0))
	prt_porta10 (polar prt_porta9 prt_angortho (* prt_fator (distof prt_pt33_poe)))
	prt_porta11 (polar prt_porta10 (+ pi prt_angbase) (/ prt_larg 4.0))
	prt_porta12 (polar prt_porta0 prt_angbase (/ prt_larg 8.0))
	prt_porta13 (polar prt_porta12 prt_angbase (/ prt_larg 4.0))
	prt_porta14 (polar prt_porta13 (+ pi prt_angortho) (* prt_fator (distof prt_pt33_poe)))
	prt_porta15 (polar prt_porta14 (+ pi prt_angbase) (/ prt_larg 4.0))
  )
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3  "_non" prt_porta4 "_c"
	   "._pline" "_non" prt_porta5 "_non" prt_porta6  "_non" prt_porta7  "_non" prt_porta8 "_c"
	   "._pline" "_non" prt_porta0 "_non" prt_porta9  "_non" prt_porta10  "_non" prt_porta11 "_c"
	   "._pline" "_non" prt_porta12 "_non" prt_porta13  "_non" prt_porta14  "_non" prt_porta15 "_c"
  )
)

;*****************************************
;Desenho das Alisares                     
;*****************************************
(defun prt_drw33_alisar ()
  (cn7_verylayer prt_layc_all 7)
  (setvar "cecolor" prt_layc_alc)
  ;internos
  (if (= "1" prt_pt33_ali)
    (progn
      (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* 1.0 prt_fator))
	    prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ali_a4 (polar prt_ali_a3 prt_angortho (* 1.0 prt_fator))
	    prt_ali_b1 (polar prt_cxi2 prt_angbase (* 1.0 prt_fator))
	    prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_b3 (polar prt_ali_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ali_b4 (polar prt_ali_b3 prt_angortho (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
      (command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
    )
  )
  (if (= "1" prt_pt33_ale)
    (progn
      (setq prt_ale_a1 (polar prt_cxi3 (+ prt_angbase pi) (* 1.0 prt_fator))
	    prt_ale_a2 (polar prt_ale_a1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_a3 (polar prt_ale_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ale_a4 (polar prt_ale_a3 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ale_b1 (polar prt_cxi4 prt_angbase (* 1.0 prt_fator))
	    prt_ale_b2 (polar prt_ale_b1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_b3 (polar prt_ale_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ale_b4 (polar prt_ale_b3 (+ prt_angortho pi) (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ale_a1 "_non" prt_ale_a2 "_non" prt_ale_a3 "_non" prt_ale_a4 "")
      (command "._line" "_non" prt_ale_b1 "_non" prt_ale_b2 "_non" prt_ale_b3 "_non" prt_ale_b4 "")
    )
  )
)



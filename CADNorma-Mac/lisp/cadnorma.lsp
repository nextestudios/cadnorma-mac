;define se é bloco do Cadnorma
(defun net_blkd_testnorma ();teste
  (setq counter nil)
  (if (and
	(= 14 (strlen ent_blkname))
	(findfile (strcat cnp_netroot "/slides/" (substr ent_blkname 1 12) ".txt"))
      )
    (progn
      (setq blkd_ordem (substr ent_blkname 13 2))
      (cond
	((= blkd_ordem "11") (setq counter 1))
	((= blkd_ordem "12") (setq counter 2))
	((= blkd_ordem "13") (setq counter 3))
	((= blkd_ordem "14") (setq counter 4))
	((= blkd_ordem "21") (setq counter 5))
	((= blkd_ordem "22") (setq counter 6))
	((= blkd_ordem "23") (setq counter 7))
	((= blkd_ordem "24") (setq counter 8))
	((= blkd_ordem "31") (setq counter 9))
	((= blkd_ordem "32") (setq counter 10))
	((= blkd_ordem "33") (setq counter 11))
	((= blkd_ordem "34") (setq counter 12))
	((= blkd_ordem "41") (setq counter 13))
	((= blkd_ordem "42") (setq counter 14))
	((= blkd_ordem "43") (setq counter 15))
	((= blkd_ordem "44") (setq counter 16))
    );cond
      (setq open_file (open (strcat cnp_netroot "/slides/" (substr ent_blkname 1 12) ".txt") "r" "utf8"))
      (repeat counter
	(setq blkd_descr (read-line open_file))
      )
      (close open_file)
      (cn7_alert_yes_no "Descrição do bloco:" blkd_descr "Deseja transcrever para o desenho?")
      (if (= alert_resp "yes")
	(progn
	  (setq curr_descr blkd_descr)
	  (net_lib_action_descript3)
	)
      );if
   );progn
   (alert "O bloco selecionado\nnão pertence à Biblioteca\ndo Cadnorma!"))
)



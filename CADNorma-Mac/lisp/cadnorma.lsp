 (setq len (sslength ent))                        ;number of entities
 (setq pt (getpoint "\nClique no lado a estender..."))  ;reference point for extend
 (command "._extend" bou "")                        ;command
 (repeat len
  (setq cou (1+ cou))
  (command (list (ssname ent cou) pt)) 
 )
 (command "")
 (setvar "CMDECHO" 1)
 (prin1)
)                                               ;defun



;* Phanthom extend--extend a line to a "phantom" line
;* which is not existing in drawing.
;* Kent M. Taylor 2/90
;*
(defun c:xte (/ p1 p2 e1 e2 d1)
  (prompt "\nDesenhe a Linha de Estensão: ")
  (setq p1 (getpoint))
  (setq p2 (getpoint p1))
  (command nil nil nil "._point" "@")
  (setq e1 (entlast))
  (entdel e1)
  (command "._line" "_non" p1 "_non" p2 "")
  (setq e2 (entnext e1))
   (while
    (setq d1 (entsel "\nSelecione objeto a estender: "))
    (command "._extend" e2 "" d1 "")
   );while
  (entdel e2)
  (command "._ortho" "_off")
 (princ)
)


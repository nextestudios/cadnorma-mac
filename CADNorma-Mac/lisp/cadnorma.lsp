;***********************************
;Porta Tipo 44                      
;Parte 01 - Configuração            
;***********************************
(defun prt_cfg_44 ()
  (prt_pt44_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "prt_cfg_p44" dcl_id)) (exit))
  (set_tile "prt_descr" "Porta dupla, de abrir para os dois lados")
  ;slide de tipo
  (setq x (dimx_tile "prt_44_slide")
	y (dimy_tile "prt_44_slide")
  )
  (start_image "prt_44_slide")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_" prt_var_tipo ".sld"))
  (end_image)
  ;espessura da porta
  (set_tile "prt_44_poe_edit" prt_pt44_poe)
  (action_tile "prt_44_poe_edit" "(prt_44_poe_edit_act)")
  (action_tile "prt_44_poe_pick" "(done_dialog 2)")
  ;soleira
  (if (= "1" prt_pt44_soi) (set_tile "prt_44_solint"  "1"))
  (action_tile "prt_44_solint"  "(setq prt_pt44_soi $value)")
  (if (= "1" prt_pt44_soe) (set_tile "prt_44_solext"  "1"))
  (action_tile "prt_44_solext"  "(setq prt_pt44_soe $value)")
  ;alisares
  (if (= "1" prt_pt44_ali) (set_tile "prt_44_aliint"  "1"))
  (action_tile "prt_44_aliint"  "(setq prt_pt44_ali $value)")
  (if (= "1" prt_pt44_ale) (set_tile "prt_44_aliext"  "1"))
  (action_tile "prt_44_aliext"  "(setq prt_pt44_ale $value)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq prt_44_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= prt_44_id 1) (prt_pt44_writefile))
  (if (= prt_44_id 2) (prt_44_poe_button_act))
)

;Espessura por Pick Points
(defun prt_44_poe_button_act ()
  (prt_pt44_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")
	pt2 (getpoint pt1 "Segundo ponto da espessura da porta...: ")
	poe_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* poe_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* poe_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* poe_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq prt_pt44_poe (rtos new_dist 2 2))
      (prt_pt44_writefile)
    )
  )
  (prt_cfg_44)
)

;verifica se o valor de espessura entrado é válido
(defun prt_44_poe_edit_act ()
  (setq prt_var_newpoe $value)
  (if (distof prt_var_newpoe)
    (progn
      (setq prt_pt44_poe prt_var_newpoe)
      (prt_pt44_writefile)
    )
    (progn
      (alert "Valor Inválido!")
      (set_tile "prt_44_poe_edit" prt_pt44_poe)
      (mode_tile "prt_44_poe_edit" 2)
    )
  )
)  


;lê os dados iniciais da DCL no arquivo de dados
(defun prt_pt44_file ()
  (if (findfile (strcat cnp_root "/config/prt_pt44.txt"))
    (prt_pt44_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/prt_pt44.txt") "w" "utf8"))
      (write-line "1" file)
      (write-line "1" file)      
      (write-line "1" file)
      (write-line "1" file)
      (write-line "3" file)
      (close file)
      (prt_pt44_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun prt_pt44_readfile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt44.txt") "r" "utf8"))
  (setq	prt_pt44_soi (read-line file))
  (setq	prt_pt44_soe (read-line file))
  (setq	prt_pt44_ali (read-line file))
  (setq	prt_pt44_ale (read-line file))
  (setq	prt_pt44_poe (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun prt_pt44_writefile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt44.txt") "w" "utf8"))
  (write-line prt_pt44_soi file)
  (write-line prt_pt44_soe file)
  (write-line prt_pt44_ali file)
  (write-line prt_pt44_ale file)
  (write-line prt_pt44_poe file)
  (close file)
)

;programa de portas
;Desenha a porta
(defun prt_drw44 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt44_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_openfree 2.0)
  (prt_drw44_caixilho)
  (prt_drw44_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw44_alisar)
  )
  (prt_drw44_porta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)

;*****************************************
;Desenho das Portas                       
;*****************************************
(defun prt_drw44_porta ()
  (setq prt_porta0 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0))
	prt_porta1 prt_porta0 
	prt_porta2 (polar prt_porta1 (+ prt_angbase (/ pi 4)) (/ prt_larg 2.0))
	prt_porta3 (polar prt_porta2 (- prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt44_poe)))
	prt_porta4 (polar prt_porta1 (- prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt44_poe)))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (setq s1 (ssadd))
  (command "._pline" "_non" prt_porta1 "_non" prt_porta2 "_non" prt_porta3 "_non" prt_porta4 "_c")
  (setq s1 (ssadd (entlast) s1))
  (command "._mirror" (entlast) "" "_non" prt_porta0 "_non" (polar prt_porta0 prt_angbase 1.0) "_n")
  (setq s1 (ssadd (entlast) s1))
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (command "._chprop" (entlast) "" "_c" prt_layc_arc "_lt" "hidden2" "")
  (setq prt_porta0a prt_porta0 
	prt_porta0b (polar prt_porta0a (+ prt_angbase (/ pi 4)) (* prt_fator (distof prt_pt44_poe)))
	prt_porta0c (polar prt_porta0b (- prt_angbase (/ pi 4)) (/ prt_larg 2.0))
	prt_porta0d (polar prt_porta0 prt_angbase (/ prt_larg 2.0))
  )
  (setvar "celtype" "hidden2")
  (cn7_verylayer prt_layc_arl 7)
  (setvar "cecolor" prt_layc_arc)
  (command "._arc" "_non" prt_porta0c "_non" prt_porta0d "_non" prt_porta3)
  (setq s1 (ssadd (entlast) s1))
  (setvar "celtype" "bylayer")
  (command "._mirror" s1 "" "_non" prt_mid1 "_non" prt_mid2 "_n")
)


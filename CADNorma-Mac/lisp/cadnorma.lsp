  	(prompt "\nSelecione um bloco exemplo...")
	(setq bk_name (cdr (assoc 2 (entget (car (entsel))))))
  	(setq sel_cond (cons 2 bk_name))
	(prompt "\nSelecione os blocos a serem reduzidos ou ampliados...")
	(setq s1 (ssget '((0 . "INSERT"))))
	(setq rot (getreal "\nFator de escala..."))
	(setq count_limit (sslength s1) counter 0)
	(repeat count_limit
		(setq ent1 (ssname s1 counter))
		(setq ent2 ent1)
		(if (= (cdr (assoc 2 (entget ent1))) bk_name)
			(progn
			  	(setq p0 (cdr (assoc 10 (entget ent1))))
			  	(command "._scale" ent1 "" "_non" p0 rot)
			)
		);if
		(setq counter (1+ counter))

;Espessura por Pick Points
(defun prt_11_poe_button_act ()
  (prt_pt11_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")
	pt2 (getpoint pt1 "Segundo ponto da espessura da porta...: ")
	poe_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* poe_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* poe_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* poe_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq prt_pt11_poe (rtos new_dist 2 2))
      (prt_pt11_writefile)
    )
  )
  (prt_cfg_11)
)


;verifica se o valor de espessura entrado é válido
(defun prt_11_poe_edit_act ()
  (setq prt_var_newpoe $value)
  (if (distof prt_var_newpoe)
    (progn
      (setq prt_pt11_poe prt_var_newpoe)
      (prt_pt11_writefile)
    )
    (progn
      (alert "Valor Inválido!")
      (set_tile "prt_11_poe_edit" prt_pt11_poe)
      (mode_tile "prt_11_poe_edit" 2)
    )
  )
)  

;lê os dados iniciais da DCL no arquivo de dados
(defun prt_pt11_file ()
  (if (findfile (strcat cnp_root "/config/prt_pt11.txt"))
    (prt_pt11_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/prt_pt11.txt") "w" "utf8"))
      (write-line "3" file)
      (write-line "1" file)
      (write-line "1" file)      
      (write-line "1" file)
      (write-line "1" file)
      (write-line "prt_11_arc_01" file)
      (write-line "prt_11_cxi_01" file)
      (write-line "prt_11_mac_01" file)
      (close file)
      (prt_pt11_readfile)
    )
  )
)


;função que lê o arquivo de dados
(defun prt_pt11_readfile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt11.txt") "r" "utf8"))
  (setq	prt_pt11_poe (read-line file))
  (setq	prt_pt11_soi (read-line file))
  (setq	prt_pt11_soe (read-line file))
  (setq	prt_pt11_ali (read-line file))
  (setq	prt_pt11_ale (read-line file))
  (setq	prt_pt11_arc (read-line file))
  (setq	prt_pt11_cxi (read-line file))
  (setq	prt_pt11_mac (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun prt_pt11_writefile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt11.txt") "w" "utf8"))
  (write-line prt_pt11_poe file)
  (write-line prt_pt11_soi file)
  (write-line prt_pt11_soe file)
  (write-line prt_pt11_ali file)
  (write-line prt_pt11_ale file)
  (write-line prt_pt11_arc file)
  (write-line prt_pt11_cxi file)
  (write-line prt_pt11_mac file)
  (close file)
)

;Desenha a porta

(defun prt_drw11 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt11_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_openfree 1.0)
  ;desenha o caixilho, se houver
  (prt_drw11_caixilho)
  (prt_drw11_porta)
  (prt_drw11_arco)
  (if (/= prt_pt11_mac "prt_11_mac_05")
    (prt_drw11_maçaneta)
  )
  (prt_drw11_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw11_alisar)
  )
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)


;*****************************************
;Desenho das Alisares                     
;*****************************************
(defun prt_drw11_alisar ()
  (cn7_verylayer prt_layc_all 7)
  (setvar "cecolor" prt_layc_alc)
  ;internos
  (if (= "1" prt_pt11_ali)
    (progn
      (if (= prt_pt11_cxi "prt_11_cxi_01")
	(setq prt_ali_b1 (polar prt_cxi2 prt_angbase (* 1.0 prt_fator)))
	(setq prt_ali_b1 (polar prt_cxi5 prt_angbase (* 1.0 prt_fator)))
      )
      (setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* 1.0 prt_fator))
	    prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ali_a4 (polar prt_ali_a3 prt_angortho (* 1.0 prt_fator))
	    prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ali_b3 (polar prt_ali_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ali_b4 (polar prt_ali_b3 prt_angortho (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
      (command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
    )
  )
  (if (= "1" prt_pt11_ale)
    (progn
      (if (= prt_pt11_cxi "prt_11_cxi_01")
	(progn
	  (setq prt_ale_a1 (polar prt_cxi3 (+ prt_angbase pi) (* 1.0 prt_fator)))
	  (setq prt_ale_b1 (polar prt_cxi4 prt_angbase (* 1.0 prt_fator)))
	)
	(progn
	  (setq prt_ale_a1 (polar prt_cxi4 (+ prt_angbase pi) (* 1.0 prt_fator)))
	  (setq prt_ale_b1 (polar prt_cxi8 prt_angbase (* 1.0 prt_fator)))
	)
      )
      (setq prt_ale_a2 (polar prt_ale_a1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_a3 (polar prt_ale_a2 (+ prt_angbase pi) (* 5.0 prt_fator))
	    prt_ale_a4 (polar prt_ale_a3 (+ prt_angortho pi) (* 1.0 prt_fator))
	    prt_ale_b2 (polar prt_ale_b1 prt_angortho (* 1.0 prt_fator))
	    prt_ale_b3 (polar prt_ale_b2 prt_angbase (* 5.0 prt_fator))
	    prt_ale_b4 (polar prt_ale_b3 (+ prt_angortho pi) (* 1.0 prt_fator))
      )
      (command "._line" "_non" prt_ale_a1 "_non" prt_ale_a2 "_non" prt_ale_a3 "_non" prt_ale_a4 "")
      (command "._line" "_non" prt_ale_b1 "_non" prt_ale_b2 "_non" prt_ale_b3 "_non" prt_ale_b4 "")
    )
  )
)



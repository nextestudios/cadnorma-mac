;desenha os caixihos
(defun prt_drw24_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
	    prt_cxi2 (polar prt_cxi1 prt_angbase prt_larg)
	    prt_cxi3 (polar prt_brk3 prt_angbase prt_caix)
	    prt_cxi4 (polar prt_cxi3 prt_angbase prt_larg)
      )
      (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi3 "_non" prt_brk3 "" ;"_c"
	       "._pline"  "_non" prt_brk2 "_non" prt_cxi2  "_non" prt_cxi4 "_non" prt_brk4 "" ;"_c"
      )
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_cxi1 prt_brk1
	    prt_cxi2 prt_brk2
	    prt_cxi3 prt_brk3
	    prt_cxi4 prt_brk4
      )
    )
  )
)



;*****************************************
;Abertura da parede                       
;*****************************************

;determina os pontos de 'break' das paredes
(defun prt_drw24_openfree (n)
  ;conversão de dados para numerais
  (prt_larg_file)
  (if (= prt_var_lrad "prt_larg_radio1")
    (setq prt_larg (* n (distof prt_pt24_qtd) prt_fator (distof (nth (fix (distof prt_var_larg)) prt_larg_list))))
    (setq prt_larg (* prt_fator (distof prt_var_lvao)))
  )
  (prt_halt_file)
  (setq prt_halt (* prt_fator (distof (nth (fix (distof prt_var_halt)) prt_halt_list)))
	prt_afas (* prt_fator (distof prt_var_afas))
	prt_wall (* prt_fator (distof prt_var_wall))
	prt_caix (* prt_fator (distof prt_var_caix))
  )
  ;clica na parede
  (prompt "\nSelecione a parede interna...")
  (setq prt_entsel (entsel)
	prt_ent1 (car prt_entsel)
	prt_ent1_type (cdr (assoc 0 (entget prt_ent1)))
	prt_pt0 (nth 0 (cdr prt_entsel))
	prt_ptt1 (cdr (assoc 10 (entget prt_ent1)))
	prt_ptt2 (cdr (assoc 11 (entget prt_ent1)))
	prt_wall_layer (cdr (assoc 8 (entget prt_ent1)))
  )
  (if (/= "LINE" prt_ent1_type)
    (progn
      (alert "A entidade Selecionada não é uma 'LINE'.\nPOLYLINES devem ser explodidas\npara usar este comando...")
      (prt_drw24_openfree 1.0)
    )
  )
  (if (<= (distance prt_pt0 prt_ptt1) (distance prt_pt0 prt_ptt2))
    (setq prt_pt1 prt_ptt1 prt_pt2 prt_ptt2 prt_code 1)
    (setq prt_pt1 prt_ptt2 prt_pt2 prt_ptt1 prt_code 2)
  )
  (setq prt_angbase (angle prt_pt1 prt_pt2))
  ;verifica o posicionamento para determinar os pontos de quebra
  (if (= prt_var_posi "prt_center")
    (setq prt_doll (/ (- (distance prt_pt1 prt_pt2) prt_larg (* 2 prt_caix)) 2))
    (setq prt_doll prt_afas)
  )
  (setq
	prt_brk1 (polar prt_pt1 prt_angbase prt_doll)
	prt_brk2 (polar prt_brk1 prt_angbase (+ prt_larg (* 2 prt_caix)))
  )
  (if (= prt_code 1)
    (setq prt_brk3a (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk3b (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
    )
    (setq prt_brk3a (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
  	  prt_brk3b (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
    )
  )
  (if (/= nil (ssget "_f" (list prt_brk3a prt_brk4a) (list (cons 8 prt_wall_layer))))
    (progn
      (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a prt_xcode 1)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 2)
	)
      )
    )
    (progn
      (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b prt_xcode 2)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 4)
	)
      )
    )
  )
  (setq colmo (getvar "cecolor"))
  (command "._undo" "_m")
  (command "._break" prt_ent1 "_non" prt_brk1 "_non" prt_brk2)
  (command "._break" (ssget "c" prt_brkm prt_brkm) "_non" prt_brk3 "_non" prt_brk4)
  (command "._layer" "_s" prt_wall_layer "")
  (command "._line" "_non" prt_brk1 "_non" prt_brk3 "" "._line" "_non" prt_brk2 "_non" prt_brk4 "")
  (setq prt_angortho (angle prt_brk1 prt_brk3))
)



;***********************************
;Porta Tipo 31                      
;Parte 01 - Configuração            
;***********************************
(defun prt_cfg_31 ()
  (prt_pt31_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "prt_cfg_p31" dcl_id)) (exit))
  (set_tile "prt_descr" "Porta de correr dupla, com uma folha fixa.")
  ;slide de tipo
  (setq x (dimx_tile "prt_31_slide")
	y (dimy_tile "prt_31_slide")
  )
  (start_image "prt_31_slide")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_" prt_var_tipo ".sld"))
  (end_image)
  ;espessura da porta
  (set_tile "prt_31_poe_edit" prt_pt31_poe)
  (action_tile "prt_31_poe_edit" "(prt_31_poe_edit_act)")
  (action_tile "prt_31_poe_pick" "(done_dialog 2)")
  ;soleira
  (if (= "1" prt_pt31_soi) (set_tile "prt_31_solint"  "1"))
  (action_tile "prt_31_solint"  "(setq prt_pt31_soi $value)")
  (if (= "1" prt_pt31_soe) (set_tile "prt_31_solext"  "1"))
  (action_tile "prt_31_solext"  "(setq prt_pt31_soe $value)")
  ;alisares
  (if (= "1" prt_pt31_ali) (set_tile "prt_31_aliint"  "1"))
  (action_tile "prt_31_aliint"  "(setq prt_pt31_ali $value)")
  (if (= "1" prt_pt31_ale) (set_tile "prt_31_aliext"  "1"))
  (action_tile "prt_31_aliext"  "(setq prt_pt31_ale $value)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq prt_31_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= prt_31_id 1) (prt_pt31_writefile))
  (if (= prt_31_id 2) (prt_31_poe_button_act))
)

;Espessura por Pick Points
(defun prt_31_poe_button_act ()
  (prt_pt31_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")

;*********************************************************************
;função que descobre a altura dos textos e prefixo de escala
;*********************************************************************
(defun cn7_text_height ()
  (if (= 1 (getvar "tilemode"))
    (progn       ;escrever no Model Space
      (if (= nil cn7_msscl) (cn7_esc))
      (prompt (strcat "\nEscala Atual = 1:" (rtos cn7_msscl 2 0)))
      (cond
	((= cn7_dwgunit 1) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 1000.0)))
	((= cn7_dwgunit 100) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 10.0)))
	((= cn7_dwgunit 1000) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 1.0)))
      )
      (setq cn7_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
    )
    (progn
      (if (= 1 (getvar "cvport"))
	(progn   ;escrever no Paper Space
	  (prompt "\nVocê está no Paper Space...")
	  (setq cn7_txth cn7_txthf)
	  (setq cn7_prefixlay "")
	  )
	(progn    ;escrever na Janela
	  (cn7_veryscale)
	  (cond
	    ((= cn7_dwgunit 1) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 1000.0)))
	    ((= cn7_dwgunit 100) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 10.0)))
	    ((= cn7_dwgunit 1000) (setq cn7_txth (/ (* cn7_txthf cn7_msscl) 1.0)))
	  )
	  (prompt (strcat "\nViewport -> Escala 1:" (rtos cn7_msscl 2 0)))
	  (setq cn7_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
	)
      );if
    );progn case F
  )
  (princ)
)


(defun jnl_cobo_radioaction ()
  (setq jnl_cobo_def $value)
  (jnl_cobo_radioaction2)
)

(defun jnl_cobo_radioaction2 ()
  (cond
    ((= jnl_cobo_def "jnl_cobo_radio1")
     (mode_tile "jnl_cobo_qtd" 0)
     (mode_tile "jnl_cobo_pct" 1)
     (set_tile "jnl_cobo_tx2" "% Livre:")
     (jnl_cobo_calc1)
     (set_tile "jnl_cobo_tx3" (strcat (rtos jnl_cobo_res_esp 2 1) "cm"))
     (set_tile "jnl_cobo_tx4" (strcat (rtos jnl_cobo_res_pct 2 1) "%"))
    )
    ((= jnl_cobo_def "jnl_cobo_radio2")
     (mode_tile "jnl_cobo_qtd" 1)
     (mode_tile "jnl_cobo_pct" 0)
     (set_tile "jnl_cobo_tx2" "Quant. Espaços:")
     (jnl_cobo_calc2)
     (set_tile "jnl_cobo_tx3" (strcat (rtos jnl_cobo_res_esp 2 1) "cm"))
     (set_tile "jnl_cobo_tx4" (rtos jnl_cobo_res_qtd 2 0))
    )
   )
)


;cálculo dando a espessura
(defun jnl_cobo_calc2 ()
  (setq jnl_cobo_res_fre (/ (* (distof jnl_var_larg) (distof jnl_cobo_pct)) 100.0)
	jnl_cobo_res_qtd (1+ (fix (/ jnl_cobo_res_fre (distof jnl_cobo_vao))))
	jnl_cobo_res_fre (* jnl_cobo_res_qtd (distof jnl_cobo_vao))
	jnl_cobo_res_esp (/ (- (distof jnl_var_larg) jnl_cobo_res_fre) (1- jnl_cobo_res_qtd))
  )  
)

;cálculo dando a quantidade de aberturas
(defun jnl_cobo_calc1 ()
  ;avalia o espaço livre necessário
  (setq jnl_cobo_res_fre (* (distof jnl_cobo_vao) (distof jnl_cobo_qtd)))
  (if (>= jnl_cobo_res_fre (distof jnl_var_larg))
    (progn
      (alert "Valor excede a largura disponível!\nReduza a abertura ou a quant. espaços.")
    )
    (progn
      (setq jnl_cobo_res_pct (* 100.0 (/ jnl_cobo_res_fre (distof jnl_var_larg)))
	    jnl_cobo_res_esp (/ (- (distof jnl_var_larg) jnl_cobo_res_fre) (1- (distof jnl_cobo_qtd)))
	    jnl_cobo_res_qtd (distof jnl_cobo_qtd)
      )
    )
  )
)

;clica em dois pontos = nova abertura
(defun jnl_cobo_pickvao ()
  (setq vao_dist nil
	pt1 (getpoint "\nPrimeiro ponto...: ")
	pt2 (getpoint pt1 "Segundo ponto... ")
	vao_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* vao_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* vao_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* vao_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq jnl_cobo_vao (rtos new_dist 2 2))
      (jnl_cobo_writefile)
    )
  )
  (jnl_drw44)
)


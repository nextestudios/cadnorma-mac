;Funcao MRT (Move-Rotate)
(defun c:mr (/ ss1 p1)
 (if (setq ss1 (ssget))
  (progn
   (setq p1 (getpoint "\nPonto base: "))
   (prompt "\nPonto destino: ")
   (command "._move" ss1 "" "_non" p1 "_non" p1 "._point" "_non" p1 "._move" ss1 (entlast) "" "_non" p1 pause)
   (prompt "\nÂngulo de rotação: ")

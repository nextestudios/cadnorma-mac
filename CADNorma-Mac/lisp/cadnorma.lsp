;*****************************************
;Desenho de Caixilho                      
;*****************************************

;desenha os caixihos
(defun prt_drw14_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (if (= prt_pt14_cxi "prt_14_cxi_01")
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_cxi1 prt_angbase prt_larg)
		prt_cxi3 (polar prt_brk3 prt_angbase prt_caix)
		prt_cxi4 (polar prt_cxi3 prt_angbase prt_larg)
		)
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi3 "_non" prt_brk3 "" ;"_c"
		   "._pline"  "_non" prt_brk2 "_non" prt_cxi2  "_non" prt_cxi4 "_non" prt_brk4 "" ;"_c"
          )
	  (setq prt_arcstart prt_cxi2)
	)
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_cxi1 prt_angortho (* prt_fator (distof prt_pt14_poe)) )
		prt_cxi3 (polar prt_cxi2 prt_angbase (* prt_fator 2.0))
		prt_cxi4 (polar prt_brk3 prt_angbase (+ prt_caix (* prt_fator 2.0)))
		)
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2 "_non" prt_cxi3 "_non" prt_cxi4 "_non" prt_brk3 "");"_c")
	  (setq prt_cxi5 (polar prt_cxi1 prt_angbase prt_larg)
		prt_cxi6 (polar prt_cxi5 prt_angortho (* prt_fator (distof prt_pt14_poe)))
		prt_cxi7 (polar prt_cxi6 (+ pi prt_angbase) (* prt_fator 2.0))
		prt_cxi8 (polar prt_brk4 (+ pi prt_angbase) (+ prt_caix (* prt_fator 2.0)))
		)
	  (command "._pline"  "_non" prt_brk2 "_non" prt_cxi5  "_non" prt_cxi6 "_non" prt_cxi7 "_non" prt_cxi8 "_non" prt_brk4 "");"_c")
	  (setq prt_arcstart prt_cxi5)
        )
      )
      (setq prt_porta1 prt_cxi1)
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_cxi1 prt_brk1
	    prt_cxi2 prt_brk2
	    prt_cxi3 prt_brk3
	    prt_cxi5 prt_brk2
	    prt_cxi8 prt_brk4
	    prt_arcstart prt_cxi2
	    prt_porta1 prt_cxi1
      )
      (if (= prt_pt14_cxi "prt_14_cxi_01")
	(setq prt_cxi4 prt_brk4)
	(setq prt_cxi4 prt_brk3)
      )
    )
  )
)



;***********************************
;Porta Tipo 21                      
;Parte 01 - Configuração            
;***********************************
(defun prt_cfg_21 ()
  (prt_pt21_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "prt_cfg_p21" dcl_id)) (exit))
  (set_tile "prt_descr" "Porta Deslizante Simples ('de Correr')")
  ;slide de tipo
  (setq x (dimx_tile "prt_21_slide")
	y (dimy_tile "prt_21_slide")
  )
  (start_image "prt_21_slide")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_" prt_var_tipo ".sld"))
  (end_image)
  ;espessura da porta
  (set_tile "prt_21_poe_edit" prt_pt21_poe)
  (action_tile "prt_21_poe_edit" "(prt_21_poe_edit_act)")
  (action_tile "prt_21_poe_pick" "(done_dialog 2)")
  ;soleira
  (if (= "1" prt_pt21_soi) (set_tile "prt_21_solint"  "1"))
  (action_tile "prt_21_solint"  "(setq prt_pt21_soi $value)")
  (if (= "1" prt_pt21_soe) (set_tile "prt_21_solext"  "1"))
  (action_tile "prt_21_solext"  "(setq prt_pt21_soe $value)")
  ;alisares
  (if (= "1" prt_pt21_ali) (set_tile "prt_21_aliint"  "1"))
  (action_tile "prt_21_aliint"  "(setq prt_pt21_ali $value)")
  (if (= "1" prt_pt21_ale) (set_tile "prt_21_aliext"  "1"))
  (action_tile "prt_21_aliext"  "(setq prt_pt21_ale $value)")
  ;tipo de posicionamento (interna ou externa)
  (setq x (dimx_tile "prt_21_possld_01")
	y (dimy_tile "prt_21_possld_01")
  )
  (start_image "prt_21_possld_01")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_pos_2101.sld"))
  (end_image)
  (setq x (dimx_tile "prt_21_possld_02")
	y (dimy_tile "prt_21_possld_02")
  )
  (start_image "prt_21_possld_02")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_pos_2102.sld"))
  (end_image)
  (action_tile "prt_21_possld_01" "(prt_21_possld_act)")
  (action_tile "prt_21_possld_02" "(prt_21_possld_act)")
  (cond
    ((= prt_pt21_pos "prt_21_pos_01") (set_tile "prt_21_pos_01" "1"))
    ((= prt_pt21_pos "prt_21_pos_02") (set_tile "prt_21_pos_02" "1"))
  )
  (action_tile "prt_21_pos_01" "(prt_21_pos_act)")
  (action_tile "prt_21_pos_02" "(prt_21_pos_act)")
  ;tipo de caixilho
  (setq x (dimx_tile "prt_21_cxisld_01")
	y (dimy_tile "prt_21_cxisld_01")
  )
  (start_image "prt_21_cxisld_01")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_cxi_01.sld"))
  (end_image)
  (setq x (dimx_tile "prt_21_cxisld_02")
	y (dimy_tile "prt_21_cxisld_02")
  )
  (start_image "prt_21_cxisld_02")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_cxi_02.sld"))
  (end_image)
  (action_tile "prt_21_cxisld_01" "(prt_21_cxisld_act)")
  (action_tile "prt_21_cxisld_02" "(prt_21_cxisld_act)")
  (cond
    ((= prt_pt21_cxi "prt_21_cxi_01") (set_tile "prt_21_cxi_01" "1"))
    ((= prt_pt21_cxi "prt_21_cxi_02") (set_tile "prt_21_cxi_02" "1"))
  )
  (action_tile "prt_21_cxi_01" "(prt_21_cxi_act)")
  (action_tile "prt_21_cxi_02" "(prt_21_cxi_act)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq prt_21_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= prt_21_id 1) (prt_pt21_writefile))
  (if (= prt_21_id 2) (prt_21_poe_button_act))
)


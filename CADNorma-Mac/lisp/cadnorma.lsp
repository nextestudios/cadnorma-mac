;***********************************************
;Somar áreas
;***********************************************
(defun c:somarea (/ cext ss1 count emax pt1 lprec tarea1 tarea)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
	    "textstyle" "luprec" "osmode" ))
  (setvar "cmdecho" 0)
  (while
    (not (setq cext
           (entsel "\nSelecione o contorno externo: "))))
  (prompt "\nSelecione os contornos a adicionar...")      
  (setq ss1 (ssget))
  (if (/= ss1 nil)
    (progn
      (ssdel (car cext) ss1)                          
      (command "._area" "_a" "_e" cext "" "_a" "_e")   
      (setq count 0                                    
            emax (sslength ss1)                        
      )
      (while (< count emax)                             
        (command (ssname ss1 count))                    
        (setq count (1+ count))
                         
      )
    )
    (command "_.area" "_e" cext)
  )
  (command "" "")
  (area_text)
  (devolve)
  (princ)
)

;***********************************************
;Subtrair áreas
;***********************************************
(defun c:subarea (/ cext ss1 count emax pt1 lprec tarea1 tarea)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
	    "textstyle" "luprec" "osmode" ))
  (setvar "cmdecho" 0)
  (while
    (not (setq cext
           (entsel "\nSelecione o contorno externo: "))))
  (prompt "\nSelecione os contornos a subtrair...")      
  (setq ss1 (ssget))
  (if (/= ss1 nil)
    (progn
      (ssdel (car cext) ss1)                          
      (command "_.area" "_a" "_e" cext "" "_s" "_e")   
      (setq count 0                                    
            emax (sslength ss1)                        
      )
      (while (< count emax)                             
        (command (ssname ss1 count))                    
        (setq count (1+ count))
                         
      )
    )
    (command "_.area" "_e" cext)
  )
  (command "" "")
  (area_text)
  (devolve)
  (princ)
)

;Mede a última polilinha e escreve sua área *************************
(defun c:plarea ()
  (if (and (/= "LWPOLYLINE" (cdr (assoc 0 (setq last_ent (entget (entlast))))))
	   (/= "POLYLINE" (cdr (assoc 0 (setq last_ent (entget (entlast))))))
      );and
    (progn
      (alert "A última entidade não é uma polyline...")
      (exit)
    )
    (progn
	(command "._area" "_o" (entlast))
	(area_text)
    )
  );if
  (princ)
);defun



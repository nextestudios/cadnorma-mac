;cnp_21_c

;progama de geração de escadas
;iniciado em 11/02/11
;Denio Guimarães
;www.cadnorma.com.br
(defun c:scd ()
  (scd_start)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd" dcl_id)) (exit))
  ;atualiza os slides
  (setq x (dimx_tile "scd_slide1")
	y (dimy_tile "scd_slide1"))
  (start_image "scd_slide1")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/sc1.sld"))
  (end_image)
  (setq x (dimx_tile "scd_slide2")
	y (dimy_tile "scd_slide2"))
  (start_image "scd_slide2")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/sc2.sld"))
  (end_image)
  (setq x (dimx_tile "scd_slide3")
	y (dimy_tile "scd_slide3"))
  (start_image "scd_slide3")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/sc3.sld"))
  (end_image)
  ;atualização do texto
  (cond
    ((= scd_type "1") (set_tile "scd_text" "Escada Reta em Planta Baixa"))
    ((= scd_type "2") (set_tile "scd_text" "Escada Reta em Vista"))
    ((= scd_type "3") (set_tile "scd_text" "Escada Circular em Planta Baixa"))
  )
  ;ações dos botões
  (action_tile "scd_slide1" "(scd_uptext1)")
  (action_tile "scd_slide2" "(scd_uptext2)")
  (action_tile "scd_slide3" "(scd_uptext3)")
  ;comandos gerais
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq scd_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 scd_dcl_id) (scd_ok))
)

;direciona para a escada escolhida
(defun scd_ok ()
  (scd_last_writefile)
  (cond
    ((= scd_type "1") (scd11_main))
    ((= scd_type "2") (scd13_main))
    ((= scd_type "3") (scd12_main))
  )
)

;ao selecionar o slide1
(defun scd_uptext1 ()
  (setq scd_type "1")
  (set_tile "scd_text" "Escada Reta em Planta Baixa")
)

;ao selecionar o slide2
(defun scd_uptext2 ()
  (setq scd_type "2")
  (set_tile "scd_text" "Escada Reta em Vista")
)
;ao selecionar o slide1
(defun scd_uptext3 ()
  (setq scd_type "3")
  (set_tile "scd_text" "Escada Circular em Planta Baixa")
)

;lê os dados iniciais da DCL no arquivo de dados
(defun scd_last_file ()
  (if (findfile (strcat cnp_root "/config/scd_last.txt"))
    (scd_last_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/scd_last.txt") "w" "utf8"))
      (write-line "1" file)
      (close file)
      (scd_last_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun scd_last_readfile ()
  (setq	file (open (strcat cnp_root "/config/scd_last.txt") "r" "utf8"))
  (setq	scd_type (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun scd_last_writefile ()
  (setq	file (open (strcat cnp_root "/config/scd_last.txt") "w" "utf8"))
  (write-line scd_type file)
  (close file)
)


;procedimento inicial para escadas
(defun scd_start ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (scd_last_file)
  (cond
    ((= cn7_dwgunit 1) (setq scd_fator 0.01 scd_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq scd_fator 1.0 scd_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq scd_fator 10.0 scd_blkscl 1000.0))
  )
)

;desenho de escada simples
(defun c:sc1 () (scd11_main))

(defun scd11_main ()
  (scd11_start)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd11" dcl_id)) (exit))
  (set_tile "scd11_vis_radio" scd11_var_svis)
  (action_tile "scd11_vis_radio" "(scd11_radio)")
  ;slide
  (scd11_upslide)
  ;dados de  construção
  (set_tile "scd11_getlarg" scd11_var_larg)
  (action_tile "scd11_getlarg" "(scd11_getlarg_action)")
  (action_tile "scd11_piklarg" "(done_dialog 2)")
  (set_tile "scd11_getndeg" scd11_var_ndeg)
  (action_tile "scd11_getndeg" "(scd11_getndeg_action)")
  (set_tile "scd11_getldeg" scd11_var_ldeg)
  (action_tile "scd11_getldeg" "(scd11_getldeg_action)")
  (action_tile "scd11_pikldeg" "(done_dialog 3)")
  ;toggles
  (set_tile "scd11_getlind" scd11_var_lind)
  (action_tile "scd11_getlind" "(setq scd11_var_lind $value)")
  (set_tile "scd11_getline" scd11_var_line)
  (action_tile "scd11_getline" "(setq scd11_var_line $value)")
  (set_tile "scd11_getcord" scd11_var_cord)
  (action_tile "scd11_getcord" "(setq scd11_var_cord $value)")
  (set_tile "scd11_getcore" scd11_var_core)
  (action_tile "scd11_getcore" "(setq scd11_var_core $value)")
  ;cores e layers
  (action_tile "scd11_cfglayc" "(done_dialog 4)")
  ;comandos gerais
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq scd11_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 scd11_dcl_id) (scd11_ok_action))
  (if (= 2 scd11_dcl_id) (scd11_getlarg_button))
  (if (= 3 scd11_dcl_id) (scd11_getldeg_button))
  (if (= 4 scd11_dcl_id) (scd11_laycol_button))
)

;decide o tipo de escada que vai desenhar
(defun scd11_ok_action ()
  (cond
    ((= scd11_var_svis "scd11_vis_01") (scd11_draw_01))
    ((= scd11_var_svis "scd11_vis_02") (scd11_draw_02))
    ((= scd11_var_svis "scd11_vis_03") (scd11_draw_03))
  )
)

;desenha a escada totalmente em projeção
(defun scd11_draw_03 ()
  (command "._undo" "_m")
  (cn7_verylayer scd11_layc_dpl 7)
  (setvar "cecolor" scd11_layc_dpc)
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (scd11_last_writefile)
  (setq scd11_pt0 (getpoint "\nClique no ponto inicial...")
	scd11_angbase (getangle scd11_pt0 "\nDireção da escada...")
        scd11_angorto (+ scd11_angbase (/ pi 2))
	pt1 scd11_pt0
	pt2 (polar pt1 scd11_angorto (* scd11_fator (distof scd11_var_larg)))
	cord_pt1 (polar pt1 scd11_angorto (* scd11_fator 5.0))
	core_pt1 (polar pt2 (+ scd11_angorto pi) (* scd11_fator 5.0))
  )
  (command "._line" "_non" pt1 "_non" pt2 "")
  (setq lind_pt1 pt1
	line_pt1 pt2
  )
  ;desenha os degraus
  (repeat (1- (fix (distof scd11_var_ndeg)))
    (setq pt1 (polar pt1 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	  pt2 (polar pt2 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
    )
    (command "._line" "_non" pt1 "_non" pt2 "")
  )
  ;desenha os corrimãos
  (setq cord_pt2 (polar pt1 scd11_angorto (* scd11_fator 5.0))
	core_pt2 (polar pt2 (+ scd11_angorto pi) (* scd11_fator 5.0))
  )
  (if (= scd11_var_cord "1")
    (command "._line" "_non" cord_pt1 "_non" cord_pt2 "")
  )
  (if (= scd11_var_core "1")
    (command "._line" "_non" core_pt1 "_non" core_pt2 "")
  )
  ;desenha as linhas laterais
  (setq lind_pt2 pt1
	line_pt2 pt2
  )
  (if (= scd11_var_lind "1")
    (command "._line" "_non" lind_pt1 "_non" lind_pt2 "")
  )
  (if (= scd11_var_line "1")
    (command "._line" "_non" line_pt1 "_non" line_pt2 "")
  )
  (devolve)
  (prompt "\nDitite <UB> para retornar...")
  (princ)
)

;dese ha a escada interrompida (meio vista, meio rojeção)
(defun scd11_draw_02 ()
  (command "._undo" "_m")
  (scd11_last_writefile)
  (setq scd11_pt0 (getpoint "\nClique no ponto inicial...")
	scd11_angbase (getangle scd11_pt0 "\nDireção da escada...")
        scd11_angorto (+ scd11_angbase (/ pi 2))
	pt1 scd11_pt0
	pt2 (polar pt1 scd11_angorto (* scd11_fator (distof scd11_var_larg)))
	cord_pt1 (polar pt1 scd11_angorto (* scd11_fator 5.0))
	core_pt1 (polar pt2 (+ scd11_angorto pi) (* scd11_fator 5.0))
  )
  ;desenha os degraus em vista
  (cn7_verylayer scd11_layc_dvl 7)
  (setvar "cecolor" scd11_layc_dvc)
  (setvar "celtype" "bylayer")
  (command "._line" "_non" pt1 "_non" pt2 "")
  (setq lind_pt1 pt1
	line_pt1 pt2
  )
  (setq n (1- (fix (/ (distof scd11_var_ndeg) 2))))
  (repeat n
    (setq pt1 (polar pt1 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	  pt2 (polar pt2 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
    )
    (command "._line" "_non" pt1 "_non" pt2 "")
  )
  ;define os pontos iniciais de interrupção e corrimão
  (setq pti1 pt1
	ptca (polar pt1 scd11_angorto (* 5 scd11_fator))
	ptc1 (polar ptca scd11_angbase (* scd11_fator (/ (* 10 (distof scd11_var_ldeg)) (distof scd11_var_larg))))
  )
  ;desenha o degrau de transição
  (setq pt1 (polar pt1 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	pt2 (polar pt2 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	ptm (polar pt1 (angle pt1 pt2) (/ (distance pt1 pt2) 2))
  )
  (command "._line" "_non" pt2 "_non" ptm "")
  ;desenha os degraus em projeção
  (cn7_verylayer scd11_layc_dpl 7)
  (setvar "cecolor" scd11_layc_dpc)
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (command "._line" "_non" pt1 "_non" ptm "")
  (setq pt1 (polar pt1 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	pt2 (polar pt2 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	pti2 pt2
	ptcb (polar pt2 (+ scd11_angorto pi) (* 5 scd11_fator))
	ptc2 (polar ptcb (+ scd11_angbase pi) (* scd11_fator (/ (* 10 (distof scd11_var_ldeg)) (distof scd11_var_larg))))
  )
  (command "._line" "_non" pt1 "_non" pt2 "")
  (repeat (1- n)
    (setq pt1 (polar pt1 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
	  pt2 (polar pt2 scd11_angbase (* scd11_fator (distof scd11_var_ldeg)))
    )
    (command "._line" "_non" pt1 "_non" pt2 "")
  )
  ;desenha a linha de interrupção
  (cn7_verylayer scd11_layc_itl 7)
  (setvar "cecolor" scd11_layc_itc)
  (if (not (tblsearch "ltype" "interrup"))
    (command "._linetype" "_l" "interrup" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "interrup" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "interrup")
  (command "._line" "_non" pti1 "_non" pti2 "")
  ;desenha os corrimãos
  (setq cord_pt2 (polar pt1 scd11_angorto (* scd11_fator 5.0))
	core_pt2 (polar pt2 (+ scd11_angorto pi) (* scd11_fator 5.0))
  )
  (if (= scd11_var_cord "1")
    (progn
      (cn7_verylayer scd11_layc_crl 7)
      (setvar "cecolor" scd11_layc_crc)
      (setvar "celtype" "bylayer")
      (command "._line" "_non" cord_pt1 "_non" ptc1 "")
      (cn7_verylayer scd11_layc_dpl 7)
      (setvar "cecolor" scd11_layc_dpc)
      (if (not (tblsearch "ltype" "hidden2"))
	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
      )
      (setvar "celtype" "hidden2")
      (command "._line" "_non" ptc1 "_non" cord_pt2 "")
    )
  )
  (if (= scd11_var_core "1")
    (progn
      (cn7_verylayer scd11_layc_crl 7)

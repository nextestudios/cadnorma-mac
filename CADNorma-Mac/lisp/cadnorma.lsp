;multiplicação de textos
(defun c:mult ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq cn7_dzin (getvar "dimzin"))
  (prompt "\nSelecione os textos a serem multiplicados...")
  (setq s1 (ssget '((0 . "TEXT"))))
  (setq txt_dec (getint "\nNúmero de casas decimais do resultado...<Enter = 0>..."))
  (if (= nil txt_dec) (setq txt_dec 0))
  (setvar "dimzin" 1)
  (setq s1_len (sslength s1) counter 0 txt_mult 1.00)
  (repeat s1_len
    (setq curr_ent (ssname s1 counter))
    (if (distof (cdr (assoc 1 (entget curr_ent))))
      (progn
	(setq txt_mult (* txt_mult (distof (cdr (assoc 1 (entget curr_ent))))))
	(setq counter (1+ counter))
      )
      (setq counter (1+ counter))
    )
  );repeat
  (prompt (strcat "Produto = " (rtos txt_mult 2 2)))
  (initget 1 "Escrever Modificar")
  (setq resp (getkword "\nEscrever ou Modificar texto existente ? <E ou M> "))
  (if (= resp "Escrever")
    (progn
      (cn7_getstyle)
      (cn7_text_hfinal)
      (cn7_text_height)
      (setq psimb_txt (getpoint "\nPonto de Inserção..."))
      (cn7_txsimb cn7_txtsty "bl" (rtos txt_mult 2 txt_dec) getsty_col getsty_lay 0)
    );progn
    (progn
      (princ "Selecione o texto a receber o resultado...")
      (setq ent2 (entsel))
      (setq new (cons 1 (rtos txt_mult 2 txt_dec)))
      (entmod (subst new (assoc 1 (entget (car ent2))) (entget (car ent2))))
    );progn
  );if
  (devolve)
  (princ)
)

;divisão de textos
(defun c:divi ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq cn7_dzin (getvar "dimzin"))
  ;dividendo
  (setq dividendo (entsel "\nSelecione o primeiro texto (Dividendo)..."))
  (if (= nil dividendo) (exit))
  (if (/= "TEXT" (cdr (assoc 0 (entget (car dividendo)))))
    (progn
      (alert "\nObjeto selecionado não é um texto...")
      (exit)
    )
    (progn
      (if (not (distof (cdr (assoc 1 (entget (car dividendo))))))
	(progn
	  (alert "\nO texto selecionado não corresponde a um número...")
	  (exit)
	)
      )
    )
  )
  (setq txt_dividendo (distof (cdr (assoc 1 (entget (car dividendo))))))

  ;divisor
  (setq divisor (entsel "\nSelecione o segundo texto (Divisor)..."))
  (if (= nil divisor) (exit))
  (if (/= "TEXT" (cdr (assoc 0 (entget (car divisor)))))
    (progn
      (alert "\nObjeto selecionado não é um texto...")
      (exit)
    )
    (progn
      (if (not (distof (cdr (assoc 1 (entget (car divisor))))))
	(progn
	  (alert "\nO texto selecionado não corresponde a um número...")
	  (exit)
	)
      )
    )
  )
  (setq txt_divisor (distof (cdr (assoc 1 (entget (car divisor))))))
  (setq txt_dec (getint "\nNúmero de casas decimais do resultado...<Enter = 0>..."))
  (if (= nil txt_dec) (setq txt_dec 0))
  (setvar "dimzin" 1)
  (setq txt_quociente (/ txt_dividendo txt_divisor))
  (prompt (strcat "Quociente = " (rtos txt_quociente 2 2)))
  (initget 1 "Escrever Modificar")
  (setq resp (getkword "\nEscrever ou Modificar texto existente ? <E ou M> "))
  (if (= resp "Escrever")
    (progn
      (cn7_getstyle)
      (cn7_text_hfinal)
      (cn7_text_height)
      (setq psimb_txt (getpoint "\nPonto de Inserção..."))
      (cn7_txsimb cn7_txtsty "bl" (rtos txt_quociente 2 txt_dec) getsty_col getsty_lay 0)
    );progn
    (progn
      (princ "Selecione o texto a receber o resultado...")
      (setq ent2 (entsel))
      (setq new (cons 1 (rtos txt_quociente 2 txt_dec)))
      (entmod (subst new (assoc 1 (entget (car ent2))) (entget (car ent2))))
    );progn
  );if
  (devolve)
  (princ)
)

;solicita mum estilo e veryfica se é válido
(defun cn7_getstyle ()
  (setq cn7_txtsty (strcase (getstring "\nEstilo de Texto...<ENTER=R80>...")))
  (if (or (= "" cn7_txtsty) (= nil cn7_txtsty)) (setq cn7_txtsty "r80"))
  (if (not (tblsearch "style" cn7_txtsty))
    (progn
      (alert "Estilo escolhido não existe!\nVerifique a digitação ou\nDigite <CFG> para criá-lo...")
      (exit)
    )
  )
  (cn7_altext_readfile)
  (cond
    ((= cn7_txtsty "R50") (setq getsty_lay "txt_r50" getsty_col 1))
    ((= cn7_txtsty "R60") (setq getsty_lay "txt_r60" getsty_col 1))
    ((= cn7_txtsty "R70") (setq getsty_lay "txt_r70" getsty_col 2))
    ((= cn7_txtsty "R80") (setq getsty_lay "txt_r80" getsty_col 2))
    ((= cn7_txtsty "R90") (setq getsty_lay "txt_r90" getsty_col 3))
    ((= cn7_txtsty "R100") (setq getsty_lay "txt_r100" getsty_col 3))
    ((= cn7_txtsty "R120") (setq getsty_lay "txt_r100" getsty_col 4))
    ((= cn7_txtsty "R140") (setq getsty_lay "txt_r100" getsty_col 5))
    ((= cn7_txtsty "R175") (setq getsty_lay "txt_r100" getsty_col 6))
    ((= cn7_txtsty "R200") (setq getsty_lay "txt_r100" getsty_col 6))
    ((= cn7_txtsty "T1") (setq getsty_lay "txt_t1" getsty_col (fix (distof t1_col))))
    ((= cn7_txtsty "T2") (setq getsty_lay "txt_t2" getsty_col (fix (distof t2_col))))
    ((= cn7_txtsty "T3") (setq getsty_lay "txt_t3" getsty_col (fix (distof t3_col))))
    ((= cn7_txtsty "T4") (setq getsty_lay "txt_t4" getsty_col (fix (distof t4_col))))
    ((= cn7_txtsty "T5") (setq getsty_lay "txt_t5" getsty_col (fix (distof t5_col))))
    ((= cn7_txtsty "T6") (setq getsty_lay "txt_t6" getsty_col (fix (distof t6_col))))
    ((= cn7_txtsty "T7") (setq getsty_lay "txt_t7" getsty_col (fix (distof t7_col))))
    (t (setq getsty_lay "txt_r80" getsty_col 2))
  )
)
  

  (write-line cbt_layc_cbc file)
  (write-line cbt_layc_edl file)
  (write-line cbt_layc_edc file)
  (write-line cbt_layc_hcl file)
  (write-line cbt_layc_hcc file)
  (write-line cbt_layc_stl file)
  (write-line cbt_layc_stc file)
  (close file)
)



    );progn case F
  );if
  (setvar "osmode" osmo)
  (setvar "clayer" laymo)
);defun


;eletrodutos verticais
(defun c:eldv ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setvar "osmode" 0)
  (setq
    p1 (getpoint "\nPrimeiro ponto...")
    p2 (getpoint p1 "\nDireção...")
    angrad (angle p1 p2)
  )
  (initget "Sobe Desce Passa")
  (if (= nil eldv_resp)
    (progn
      (setq eldv_resp (getkword "\n<Sobe>/Desce/Passa...: "))
      (if (= nil eldv_resp) (setq eldv_resp "Sobe"))
    )
    (progn
      (cond
	((= eldv_resp "Sobe")
	 (setq eldv_resp (getkword "\n<Sobe>/Desce/Passa...: "))
	 (if (= nil eldv_resp) (setq eldv_resp "Sobe"))
	)
	((= eldv_resp "Desce")
	 (setq eldv_resp (getkword "\nSobe/<Desce>/Passa...: "))
	 (if (= nil eldv_resp) (setq eldv_resp "Desce"))
	)
	((= eldv_resp "Passa")
	 (setq eldv_resp (getkword "\nSobe/Desce/<Passa>...: "))
	 (if (= nil eldv_resp) (setq eldv_resp "Passa"))
	)
      )
    )
  )
  (cn7_verylayer (strcat cn7_prefixlay "Ele_verticais") 2)
  (cond
    ((= eldv_resp "Sobe")
     (setq p3 (polar p1 angrad (* cn7_blkscl 0.03))
	   p4 (polar p3 angrad (* cn7_blkscl 0.50))
	   p5 (polar p3 angrad (* cn7_blkscl 0.80)))
     (command "._circle" p1 (* cn7_blkscl 0.03)
	      "._pline" p3 "_w" "0.0" "0.0" p4 "_w" (* cn7_blkscl 0.1) "0.0" p5 ""))
    ((= eldv_resp "Desce")
     (setq p3 (polar p1 angrad (* cn7_blkscl 0.03))
	   p4 (polar p3 angrad (* cn7_blkscl 0.30))
	   p5 (polar p3 angrad (* cn7_blkscl 0.80)))
     (command "._circle" p1 (* cn7_blkscl 0.03)
	      "._pline" p3 "_w" "0.0" (* cn7_blkscl 0.1) p4 "_w" "0.0" "0.0" p5 ""))
    ((= eldv_resp "Passa")
     (setq p3 (polar p1 angrad (* cn7_blkscl 0.03))
	   p4 (polar p3 angrad (* cn7_blkscl 0.80))
	   p5 (polar p3 angrad (* cn7_blkscl 1.10))
	   p6 (polar p3 angrad (* cn7_blkscl 0.30)))
     (command "._circle" p1 (* cn7_blkscl 0.03)
	      "._pline" p3 "_w" "0.0" (* cn7_blkscl 0.1) p6 "_w" "0.0" "0.0" p4 "_w" (* cn7_blkscl 0.1) "0.0" p5 ""))
  )
  (devolve)
  (princ)
)

;diâmetro de tubos
(defun c:diatub ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setq osmo (getvar "osmode")
	laymo (getvar "clayer"))
  (setvar "osmode" 512)
  (setq
    p1 (getpoint "\nPonto de identificação...")
    p2 (getpoint p1 "\nSentido do Fluxo (Direção do Texto)...")
    angrad (angle p1 p2)
    angdeg (/ (* 180 angrad) pi)
    txt1 (getstring "\nDiâmetro (ENTER = nenhum)...: ")
  )
  (setvar "osmode" osmo)
  (if (/= txt1 "")
    (if (>= (cos angrad) 0)
      (progn
	(setq psimb_txt (polar p1 (+ angrad  (/ pi 2)) (* 0.15 cn7_blkscl)))
	(cn7_txsimb "r80" "c" (strcat "%%c" txt1) 3 "Tub_identificação" angdeg)
      )
      (progn
	(setq psimb_txt (polar p1 (- angrad  (/ pi 2)) (* 0.15 cn7_blkscl)))

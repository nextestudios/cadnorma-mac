;adiciona um item à biblioteca
(defun cn8_lib_add ()
  (setq arq1 (getfiled "Selecione uma nova biblioteca" (strcat cnp_root "/fabricantes/") "cnl" 8))
  (setq open_file (open arq1 "r" "utf8"))
  (repeat 6 (setq linha (read-line open_file)))
  (setq cn8_lib_access (read-line open_file))
  (close open_file)
  (setq lib_list (list))
  (setq arq2 (open (strcat cnp_root "/fabricantes/fablib.txt") "r" "utf8"))
  (while (/= nil (setq linha (read-line arq2)))
    (if (/= cn8_lib_access linha)
      (setq lib_list (append (list linha) lib_list))
      (progn
	(cn7_alert_ok
	  "Esta Biblioteca já está"
	  "Instalada em seu computador"
	  "Impossível instalar novamente..."
	)
	(close arq2)
	(exit)
      )
    )
  )
  (close arq2)
  (setq lib_list (append lib_list (list cn8_lib_access)))
  (setq arq3 (open (strcat cnp_root "/fabricantes/fablib.txt") "w" "utf8"))
  (foreach n lib_list
    (write-line n arq3)
  )
  (close arq3)
;;;  (cn8_libload)
  (bib_main)
)


;acessar a bilioteca escolhida
(defun cn8_lib_use ()
  (load (strcat cnp_root "/fabricantes/" cn8_lib_access ".lsp"))
)


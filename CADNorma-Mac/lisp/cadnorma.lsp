  (if (/= nil nogcfg_newnotcol) (setq nogcfg_notcol (rtos nogcfg_newnotcol 2 0)))
  (start_image "nog_cfg_notcol")
  (fill_image  0  0
    (dimx_tile "nog_cfg_notcol")
    (dimy_tile "nog_cfg_notcol")
    (fix (distof nogcfg_notcol))
  )
  (end_image)
)

;escolher cor do título
(defun nogcfg_titcol_action ()
  (setq nogcfg_newtitcol (acad_colordlg (fix (distof nogcfg_titcol))))
  (if (/= nil nogcfg_newtitcol) (setq nogcfg_titcol (rtos nogcfg_newtitcol 2 0)))
  (start_image "nog_cfg_titcol")

(defun c:pka () (pka_action)(princ))

;calcula a área e dá prosseguimento...
(defun pka_action ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
      "textstyle" "luprec" "osmode" ))
  (setq osmo (getvar "osmode"))
  (setq colmo (getvar "cecolor"))
  (initget 128)
  (setq pt1 (getpoint "\nSelecione polyline/Marcar pontos/<Clique em um ponto interno>..."))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setvar "cecolor" "214")
     (command "._boundary" "_non" pt1 ""  "._area" "_e" (entlast))
     (setvar "cecolor" colmo)
     (initget "Sim Não")
     (setq resp (getkword (strcat "\nÁrea=<" (rtos (getvar "area") 2 2) ">...Confirma área selecionada? <S/N>...(ENTER=Sim)... ")))
     (if (or (= resp "Sim") (= resp nil))
       (progn
	 (command "._erase" (entlast) "")
	 (area_text)
       )
       (progn
	 (command "._erase" (entlast) "")
	 (devolve)
	 (pka_action)
       )
     );if
    )
    ;se digitar uma letra
    ((= 'STR  (type pt1))
     (cond       
       ((= "S" (strcase pt1))
        (prompt "\nSelecione a Polyline a ser medida...")
	(setq ent1 (entsel))
	(if ent1 (setq ent1_name (car ent1)))
	(command "_area" "_e" ent1_name)
	(princ (strcat "\nÁrea=<" (rtos (getvar "area") 2 2) ">"))
	(area_text)
       )
       ((= "M" (strcase pt1))
	(setq pt1 (getpoint "\nPrimeiro ponto... ")
	      pt2 (getpoint "\nSegundo ponto... ")
	      pt3 (getpoint "\nTerceiro ponto... ")
	)
	(setq pt_list (list pt1 pt2 pt3))
	(while (/= nil (setq pt_next (getpoint "\nPróximo ponto... ")))
	  (setq pt_list (append pt_list (list pt_next)))
	)
	(command "._area")
	(foreach n pt_list
	  (command n)
	)
	(command "")
	(princ (strcat "\nÁrea=<" (rtos (getvar "area") 2 2) ">"))
	(area_text)
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto ou digite <S> para selecionar...")
	(pka_action)
       )
     )
   )
  );cond
  (devolve)
)

;função que decide sobre o texto
(defun area_text ()
  (cn7_cfg_txarea_file)
  (initget 128)
  (setq pt1 (getpoint "\nEditar existente/Formatar texto/<Ponto do texto>..."))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (area_find_text)
     (area_writext)
    )
    ((= 'STR  (type pt1))
     (cond       
       ((= "E" (strcase pt1))
	(prompt "\nSelecione o texto a ser editado... ")
	(setq s2 (entsel))
	(area_find_text)
	(entmod (subst (cons 1 area_txt) (assoc 1 (entget (car s2))) (entget (car s2))))
       )
       ((= "F" (strcase pt1))
	(cn7_cfgmain_txarea)
	(area_text)
       )
       (t
	(prompt "\nOpção inválida... ")
	(devolve)
	(pka_action)
       )
     )
    )
    (t (exit))
  );cond
)

;encontra o texto exato
(defun area_find_text ()
  ;decimais
  (setq area_dec (fix (distof txarea_dec)))
  ;valor
  (setq area_num (getvar "area"))
  (cond
    ;se a unidade de desenho é metos
    ((= cn7_dwgunit 1.0)
     (cond
       ((= txarea_und "0") (setq area_value (* area_num 1e6) area_sufix "mm2"))
       ((= txarea_und "1") (setq area_value (* area_num 1e4) area_sufix "cm2"))
       ((= txarea_und "2") (setq area_value (* area_num 1.0) area_sufix "m2"))
       ((= txarea_und "3") (setq area_value (/ area_num 1e6) area_sufix "km2"))
     )
    )
    ;se a unidade de desenho é centímetos
    ((= cn7_dwgunit 100.0)
     (cond
       ((= txarea_und "0") (setq area_value (* area_num 1e2) area_sufix "mm2"))
       ((= txarea_und "1") (setq area_value (* area_num 1.0) area_sufix "cm2"))
       ((= txarea_und "2") (setq area_value (/ area_num 1e4) area_sufix "m2"))
       ((= txarea_und "3") (setq area_value (/ area_num 1e10) area_sufix "km2"))
     )
    )
    ;se a unidade de desenho é milímetos
    ((= cn7_dwgunit 1000.0)
     (cond
       ((= txarea_und "0") (setq area_value (* area_num 1.0) area_sufix "mm2"))
       ((= txarea_und "1") (setq area_value (/ area_num 1e2) area_sufix "cm2"))
       ((= txarea_und "2") (setq area_value (/ area_num 1e6) area_sufix "m2"))
       ((= txarea_und "3") (setq area_value (/ area_num 1e12) area_sufix "km2"))
     )
    )
  );cond
  ;texto final
  (if (= txarea_wrt "0")
    (setq area_txt (rtos area_value 2 area_dec))
    (if (= txarea_spc "0")
      (setq area_txt (strcat (rtos area_value 2 area_dec) area_sufix))
      (setq area_txt (strcat (rtos area_value 2 area_dec) " " area_sufix))
    )
  )
)

;escreve, efetivamente, o texto
(defun area_writext ()
  ;ponto de inserção
  (setq psimb_txt pt1)
  ;estilo
  (setq txarea_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (setq area_sty (nth (fix (distof txarea_sty)) txarea_stylist))
  (setq area_angulo (getangle pt1 "\nÂngulo do texto...(ENTER = 0)... "))
  (if (= nil area_angulo)
    (progn
      (setq area_angulo 0.0)
      (setq area_ang 0.0)
    )
    (setq area_ang (/ (* 180.0 area_angulo) pi))
  )
  (cn7_txsimb area_sty "c" area_txt (fix (distof txarea_col)) "Áreas" area_ang)
  (initget "Sim Não")
  (setq resp (getkword "\nAcrescentar nome do Ambiente? <S>/N: "))
  (if (or (= resp nil) (= resp "Sim")) (area_write_place))
)

;escreve o nomedo cômodo
(defun area_write_place ()
  (setq psimb_txt (polar psimb_txt (+ area_angulo (/ pi 2)) (* 1.7 cn7_txth)))
  (setq amb_sty (nth (fix (distof txamb_sty)) txarea_stylist))
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn9_getplace" dcl_id)) (exit))
  (if getplace (set_tile "area_getplace" getplace))
  (mode_tile "area_getplace" 2)
  (action_tile "area_getplace" "(setq getplace $value)")
  (setq cn_txarea_getplace (start_dialog))
  (unload_dialog dcl_id)
  (cn7_txsimb amb_sty "c" getplace (fix (distof txamb_col)) "Ambientes_nomes" area_ang)
)

;***********************************************
;formatação do texto para áreas
;***********************************************
(defun c:txarea () (cn7_cfgmain_txarea)(princ))

;distribuidor
(defun cn7_cfgmain_txarea ()
  (cn7_cfg_txarea_file)
  (cn7_cfg_txarea)
  (if (= cn7_cfgmain_return 1) (cn7_cfg_main))
)

;lê os dados iniciais da DCL no arquivo de dados
(defun cn7_cfg_txarea_file ()
  (if (findfile (strcat cnp_root "/config/txarea.txt"))
    (cn7_txarea_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/txarea.txt") "w" "utf8"))
      (write-line "3" file)
      (write-line "2" file)
      (write-line "2" file)
      (write-line "1" file)
      (write-line "2" file)
      (write-line "0" file)
      (write-line "4" file)
      (write-line "3" file)
      (close file)
      (cn7_txarea_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun cn7_txarea_readfile ()
  (setq	file (open (strcat cnp_root "/config/txarea.txt") "r" "utf8"))
  (setq	txarea_sty (read-line file))
  (setq	txarea_dec (read-line file))
  (setq	txarea_und (read-line file))
  (setq	txarea_wrt (read-line file))
  (setq	txarea_col (read-line file))
  (setq	txarea_spc (read-line file))
  (setq	txamb_sty (read-line file))
  (setq	txamb_col (read-line file))
  (close file)
)

(defun cn7_cfg_txarea ()
;abre a dcl
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_txarea" dcl_id)) (exit))
  ;estilo
  (setq txarea_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (start_list "txarea_style")
  (mapcar 'add_list txarea_stylist)
  (end_list)
  (set_tile "txarea_style" txarea_sty)
  (action_tile "txarea_style" "(setq txarea_sty $value)")
  ;decimais
  (setq txarea_declist (list "0" "0.0" "0.00" "0.000" "0.0000" "0.00000"
			     "0.000000" "0.0000000" "0.00000000"))
  (start_list "txarea_decimals")
  (mapcar 'add_list txarea_declist)
  (end_list)
  (set_tile "txarea_decimals" txarea_dec)
  (action_tile "txarea_decimals" "(setq txarea_dec $value)")
  ;unidades
  (setq txarea_untlist (list "mm2" "cm2" "m2" "km2"))
  (start_list "txarea_unit")
  (mapcar 'add_list txarea_untlist)
  (end_list)
  (set_tile "txarea_unit" txarea_und)
  (action_tile "txarea_unit" "(setq txarea_und $value)")
  ;cor do texto
  (start_image "txarea_color")
  (fill_image  0  0
    (dimx_tile "txarea_color")
    (dimy_tile "txarea_color")
    (fix (distof txarea_col))
  )
  (end_image)
  (action_tile "txarea_color" "(txarea_txcol)")
  ;toggle espaço entre o texto e a unidade
  (set_tile "txarea_space" txarea_spc)
  (action_tile "txarea_space" "(setq txarea_spc $value)")
  ;tobble escrever ou não
  (set_tile "txarea_write" txarea_wrt)
  (if (= txarea_wrt "0") (mode_tile "txarea_space" 1))
  (action_tile "txarea_write" "(txa_writexxt)")
  ;estilo do texto de Ambiente
  (start_list "txamb_style")
  (mapcar 'add_list txarea_stylist)
  (end_list)
  (set_tile "txamb_style" txamb_sty)
  (action_tile "txamb_style" "(setq txamb_sty $value)")
  ;Cor do texto do ambiente
  (start_image "txamb_color")
  (fill_image  0  0
    (dimx_tile "txamb_color")
    (dimy_tile "txamb_color")
    (fix (distof txamb_col))
  )
  (end_image)
  (action_tile "txamb_color" "(txamb_txcol)")
  ;ações
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq cn_txarea_dialog (start_dialog))
  (unload_dialog dcl_id)
;o que fazer depois
  (if (= 1 cn_txarea_dialog) (cn7_txarea_ok))
)


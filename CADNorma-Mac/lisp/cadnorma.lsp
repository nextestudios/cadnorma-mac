;organiza a lista, eliminando repetições e somando quantidades
(defun rel_orglist ()
  (setq counter 0 new_list nil)
  (while (< counter (length full_list))
    (setq e1 (nth counter full_list))
    (if (nth (1+ counter) full_list)
      (progn
	(setq e2 (nth (1+ counter) full_list))
	(rel_testa)
      )
      (progn
	(setq new_list (append new_list (list e1)))
	(setq counter (1+ counter))
      )
    )
  )
  (while (not (equal full_list new_list))
  (setq full_list new_list counter 0 new_list nil)
  (while (< counter (length full_list))
    (setq e1 (nth counter full_list))
    (if (nth (1+ counter) full_list)
      (progn
	(setq e2 (nth (1+ counter) full_list))
	(rel_testa)
      )
      (progn
	(setq new_list (append new_list (list e1)))
	(setq counter (1+ counter))
      )
    )
  )
  )
)

;verifica se acabou a lista
(defun rel_testa ()
  (if (/= (nth 0 e1) (nth 0 e2))
    (progn
      (setq new_list (append new_list (list e1)))
      (setq counter (1+ counter))
    )
    (progn
      (setq new_quant (rtos (+ (distof (nth 1 e1)) (distof (nth 1 e2))) 2 2)
	    new_element (list (nth 0 e1) new_quant)
	    new_list (append new_list (list new_element))
      )
      (setq counter (+ 2 counter))
    )
  )
)


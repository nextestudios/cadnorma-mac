  (if (/= "" nog_linha1)
    (progn
      (command "._text" "_s" nog_notas_style  "_non" pt1 nog_notas_heigth "0" nog_linha1)
      (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
    )
  )
  (if (/= "" nog_linha2)
    (progn
      (command "._text" "_s" nog_notas_style  "_non" pt1 nog_notas_heigth "0" nog_linha2)
      (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
    )
  )
  (if (/= "" nog_linha3)
    (progn
      (command "._text" "_s" nog_notas_style  "_non" pt1 nog_notas_heigth "0" nog_linha3)
      (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
    )
  )
  (if (/= "" nog_linha4)
    (progn
      (command "._text" "_s" nog_notas_style  "_non" pt1 nog_notas_heigth "0" nog_linha4)
      (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
    )
  )
  (if (/= "" nog_linha5)
    (progn
      (command "._text" "_s" nog_notas_style  "_non" pt1 nog_notas_heigth "0" nog_linha5)
      (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
    )
  )
  (setq pt1 (polar pt1 (/ (* 3 pi) 2) (* nog_notas_heigth 1.6)))
  (setvar "cecolor" colmo)
  (devolve)
  (setq resp (getstring "\nPressione <ENTER> para continuar ou <ESC> para terminar... "))
  (if (or (= nil resp) (= "" resp))    
    (nog_action)
  )
)

;abre a dcl de controle e inserção de notas
(defun nog_action ()
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "nog" dcl_id)) (exit))
  ;lista da pop_list
  (setq nog_family_list (list"Geral" "Arquitetura" "Paisagismo" "Urbanismo" "Elétrica" "Telefone"
			"Rede Lógica" "Água" "Esgoto" "Incêndio" "Aterramento" "Ar Condicionado"
			"Concreto" "Metálica" "Gás" "Automação" "Alarme" "CFTV" "Som"
			"Topografia" "User_01" "User_02" "User_03")
  )
  (start_list "nog_pop")
  (mapcar 'add_list nog_family_list)
  (end_list)
  ;define o status dos botões
  (mode_tile "nog_prev" 1)
  (mode_tile "nog_next" 1)
  ;define a nota atual
  (if (= nil nog_family)
    (setq nog_family "0" nog_famcode "00")
  )
  (set_tile "nog_pop" nog_family)
  (nog_conta_notas)
  (nog_nextprev)
  ;define o arquivo atual, próximo e anterior
  (if (= nil nog_register) (setq nog_register "1"))
  (setq nog_file (strcat cnp_netroot "/notas/cnng" nog_famcode nog_register ".txt"))
  (nog_read_file)
  (nog_updlines)
  (set_tile "nog_current_note" nog_register)
  (action_tile "nog_pop" "(nog_pop_action)")
  (action_tile "nog_linha1" "(setq nog_linha1 $value)")
  (action_tile "nog_linha2" "(setq nog_linha2 $value)")
  (action_tile "nog_linha3" "(setq nog_linha3 $value)")
  (action_tile "nog_linha4" "(setq nog_linha4 $value)")
  (action_tile "nog_linha5" "(setq nog_linha5 $value)")
  (action_tile "nog_prev" "(nog_prev_action)")
  (action_tile "nog_next" "(nog_next_action)")
  (action_tile "nog_new" "(nog_new_action)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "nog_config" "(done_dialog 2)")
  (action_tile "nog_insert" "(done_dialog 3)")
  (action_tile "nog_tit" "(done_dialog 4)")
  (action_tile "nog_pick1" "(done_dialog 5)")
  (action_tile "nog_pick2" "(done_dialog 6)")
  (action_tile "nog_pick3" "(done_dialog 7)")
  (action_tile "nog_pick4" "(done_dialog 8)")
  (action_tile "nog_pick5" "(done_dialog 9)")
  (setq nog_dcl (start_dialog))
  (unload_dialog dcl_id)
  (if (= nog_dcl 1) (nog_ok))
  (if (= nog_dcl 2) (nog_cfg_action))
  (if (= nog_dcl 3) (nog_insert))
  (if (= nog_dcl 4) (nog_instit))
  (if (= nog_dcl 5) (nog_pick_action 1))
  (if (= nog_dcl 6) (nog_pick_action 2))
  (if (= nog_dcl 7) (nog_pick_action 3))
  (if (= nog_dcl 8) (nog_pick_action 4))
  (if (= nog_dcl 9) (nog_pick_action 5))
)

;captura o texto na tela
(defun nog_pick_action (ng_line)
  (prompt "\nSelecione um texto para copiar seu conteúdo...")
  (setq ent1 (car (entsel))
	ent1_type (cdr (assoc 0 (entget ent1)))
  )
  (if (/= "TEXT" ent1_type)
    (progn
      (alert "Seleção inválida!\nClique em um texto\npara copiar o conteúdo...")
      (nog_pick1_action)
    )
  )
  (cond
    ((= ng_line 1) (setq nog_linha1 (cdr (assoc 1 (entget ent1)))))
    ((= ng_line 2) (setq nog_linha2 (cdr (assoc 1 (entget ent1)))))
    ((= ng_line 3) (setq nog_linha3 (cdr (assoc 1 (entget ent1)))))
    ((= ng_line 4) (setq nog_linha4 (cdr (assoc 1 (entget ent1)))))
    ((= ng_line 5) (setq nog_linha5 (cdr (assoc 1 (entget ent1)))))
  )
  (nog_save_file)
  (nog_action)
)


;botão ok
(defun nog_ok ()
  (nog_save_file)
  (nog_read_file)
)


;processa os dados da lista final (tqs_fullist6), separando a soma de todas as ferragens
(defun tqs_procesdata ()
  (setq soma_4 0.0 soma_5 0.0 soma_6 0.0 soma_8 0.0
	soma_10 0.0 soma_12 0.0 soma_16 0.0
	soma_20 0.0 soma_22 0.0 soma_25 0.0 soma_32 0.0 soma_40 0.0
	peso_total_50 0.0 peso_total_60 0.0
  )
  ;analisa a lista total e soma cada bitola
  (foreach n tqs_fullist6
    (setq bitola_ent (nth 2 n)
	  bitola_list (entget bitola_ent)
	  bitola_valor (cdr (assoc 1 bitola_list))
	  total_ent (nth 5 n)
	  total_list (entget total_ent)
	  total_valor (cdr (assoc 1 total_list))
    )
    (cond
      ((= 4.2 (distof bitola_valor)) (setq soma_4 (+ soma_4 (distof total_valor))))
      ((= 5.0 (distof bitola_valor)) (setq soma_5 (+ soma_5 (distof total_valor))))
      ((= 6.3 (distof bitola_valor)) (setq soma_6 (+ soma_6 (distof total_valor))))
      ((= 8.0 (distof bitola_valor)) (setq soma_8 (+ soma_8 (distof total_valor))))
      ((= 10.0 (distof bitola_valor)) (setq soma_10 (+ soma_10 (distof total_valor))))
      ((= 12.5 (distof bitola_valor)) (setq soma_12 (+ soma_12 (distof total_valor))))
      ((= 16.0 (distof bitola_valor)) (setq soma_16 (+ soma_16 (distof total_valor))))
      ((= 20.0 (distof bitola_valor)) (setq soma_20 (+ soma_20 (distof total_valor))))
      ((= 22.0 (distof bitola_valor)) (setq soma_22 (+ soma_22 (distof total_valor))))
      ((= 25.0 (distof bitola_valor)) (setq soma_25 (+ soma_25 (distof total_valor))))
      ((= 32.0 (distof bitola_valor)) (setq soma_32 (+ soma_32 (distof total_valor))))
      ((= 40.0 (distof bitola_valor)) (setq soma_40 (+ soma_40 (distof total_valor))))
    )
  )
  (setq tqs_mensagem "Resumo de Ferragens\n"
	tqs_finalist (list)
  )
  (if (/= 0.0 soma_4)
    (setq peso_total_60 (+ peso_total_60 (* soma_4 0.109))
	  tqs_mensagem (strcat tqs_mensagem "\nFerro 4.2: " (rtos (/ soma_4 100.0) 2 0) "m / " (rtos (* (/ soma_4 100.0) 0.109) 2 0) "kg")
	  tqs_finalist (append tqs_finalist (list (list "60B" "5" (rtos (/ soma_4 100.0) 2 0) (rtos (* (/ soma_4 100.0) 0.109) 2 0))))
    )
  )
  (if (/= 0.0 soma_5)
    (setq peso_total_60 (+ peso_total_60 (* (/ soma_5 100.0) 0.154))
	  tqs_mensagem (strcat tqs_mensagem "\nFerro 5.0: " (rtos (/ soma_5 100.0) 2 0) "m / " (rtos (* (/ soma_5 100.0) 0.154) 2 0) "kg")
	  tqs_finalist (append tqs_finalist (list (list "60B" "5" (rtos (/ soma_5 100.0) 2 0) (rtos (* (/ soma_5 100.0) 0.154) 2 0))))
    )
  )
  (if (/= 0.0 soma_6)
    (setq peso_total_50 (+ peso_total_50 (* (/ soma_6 100.0) 0.245))
	  tqs_mensagem (strcat tqs_mensagem "\nFerro 6.3: " (rtos (/ soma_6 100.0) 2 0) "m / " (rtos (* (/ soma_6 100.0) 0.245) 2 0) "kg")
	  tqs_finalist (append tqs_finalist (list (list "50A" "6.3" (rtos (/ soma_6 100.0) 2 0) (rtos (* (/ soma_6 100.0) 0.245) 2 0))))
    )
  )

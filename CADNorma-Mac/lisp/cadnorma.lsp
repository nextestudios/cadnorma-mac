;função que restaura o backup
(defun c:qrst ()
  (setq file1 (open (strcat cnp_netroot "/quant/qdate.txt") "r" "utf8")
	data1 (read-line file1)
	file2 (open (strcat cnp_netroot "/quant_backup/qdate.txt") "r" "utf8")
	data2 (read-line file2)
	data1_text (strcat (substr data1 7 2) "/" (substr data1 5 2) "/" (substr data1 1 4) " - "
			   (substr data1 10 2) ":" (substr data1 12 2) " h")
	data2_text (strcat (substr data2 7 2) "/" (substr data2 5 2) "/" (substr data2 1 4) " - "
			   (substr data2 10 2) ":" (substr data2 12 2) " h")
  )
  (close file1)
  (close file2)
  (setq alert_resp nil)
  (cn7_alert_yes_no
    (strcat "Última Modificação = " data1_text)
    (strcat "Último Backup Feito = " data2_text)
    "Deseja realmente restaurar o backup?"
  )
  (if (= alert_resp "yes")
    (cnp:copy-dir (strcat cnp_netroot "/quant_backup") (strcat cnp_netroot "/quant"))
  )
)


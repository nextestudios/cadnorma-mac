;encontrar o número de páginas de um subgrupo
(defun lib_findpages ()
  (setq lib_currpage 1)
  (lib_findpages_findnext)
  (while (findfile lib_nextpage_file)
      (setq lib_currpage (1+ lib_currpage))
      (lib_findpages_findnext)
  )
  (setq lib_numpaginas (rtos lib_currpage 2 0))

      (progn
	(setq new_list2 (append new_list2 (list (nth (1+ counter) prt_halt_list))))
	(setq new_list2 (append new_list2 (list (nth counter prt_halt_list))))
	(setq counter (+ 2 counter))
      )
      (progn
	(setq new_list2 (append new_list2 (list (nth counter prt_halt_list))))
	(setq counter (1+ counter))
      )
    )
  )
  (setq prt_halt_list new_list2)
  (start_list "prt_cfghalt_list")
  (mapcar 'add_list prt_halt_list)
  (end_list)
  (setq prt_cfghalt_sel (rtos (1- (fix (distof prt_cfghalt_sel))) 2 0))
  (set_tile "prt_cfghalt_list" prt_cfghalt_sel)
  (cond

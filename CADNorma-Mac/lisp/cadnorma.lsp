;símbologia de níveis
(defun c:nvp ()
  (if (= nil nv_enchimento) (nv_enchim))
  (niv_planta)
  (princ)
)
  
(defun niv_planta (/ culayer cota1 cota2 dist dist1)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq dzin_mo (getvar "dimzin"))
  (if (= nil nv_enchimento) (nv_enchim))
  (setvar "cmdecho" 0)
  (initget 128)
  (setq pt1 (getpoint "\nEnchimento/<Ponto de inserção>... "))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setq cota1 (getreal "\nNível Acabado: ")
	   cota2 (- cota1 nv_enchimento))
     (setvar "dimzin" 0)
     (cond
       ((>= cota1 0.0) (setq cota1_txt (strcat "+" (rtos cota1 2 2))))
       (t (setq cota1_txt (rtos cota1 2 1)))
     )
     (cond
       ((= cota2 0.0) (setq cota2_txt "0.00"))
       ((>= cota2 0.0) (setq cota2_txt (strcat "+" (rtos cota2 2 2))))
       (t (setq cota2_txt (rtos cota2 2 2)))
     )
     (setq grp_type "2")
     (cn7_find_blkscl)
     (cn7_verylayer (strcat cn7_blk_prefixlay "Níveis") 1)
     (setq attdia_mode (getvar "attdia"))
     (setvar "attdia" 0)
     
     (if (= nv_enchimento 0.0)
       (command "._insert"  (strcat cnp_root "/blocos/cvg_nvp2") "_scale" cn7_blkscl "_non" pt1 "0" cota1_txt "")
       (command "._insert"  (strcat cnp_root "/blocos/cvg_nvp2") "_scale" cn7_blkscl "_non" pt1 "0" cota1_txt cota2_txt)
     )
     (setvar "attdia" attdia_mode)
     (setq dist (rtos (* cn7_blkscl 0.20)))
     (setq dist1 (strcat "@" dist ",0"))
     (prompt "\nDesenhe a linha: ")
     (setvar "orthomode" 1)
     (command "._line" "_non" dist1 pause "")
     (setvar "dimzin" dzin_mo))
    ((= 'STR  (type pt1))
     (cond
       ((= "E" (strcase pt1))
	(nv_enchim)
	(niv_planta)
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto ou digite <E> para enchimento...")
	(niv_planta)
       )
     )
    )
  );cond
  (devolve)
  (setq grp_type nil)
  (princ)
)


;níveis em corte tipo 1
(defun c:nvc1 ()
  (setq nvc_type 1)
  (if (= nil nv_enchimento) (nv_enchim))
  (if (= nil nv_prefix) (setq nv_prefix "Sim"))
  (if (or (= nil nv_pt0) (= nil nv_relativo)) (cvg_nv_def))
  (cvg_nivel)
  (princ)
)

;níveis em corte tipo 2
(defun c:nvc2 ()
  (setq nvc_type 2)
  (if (= nil nv_enchimento) (nv_enchim))
  (if (= nil nv_prefix) (setq nv_prefix "Sim"))
  (if (or (= nil nv_pt0) (= nil nv_relativo)) (cvg_nv_def))
  (cvg_nivel)
  (princ)
)

(defun cvg_nivel ()
  (setq niv_invert (ssadd))
  (setvar "mirrtext" 0)
  (if (= nil nv_enchimento) (nv_enchim))
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
      "textstyle" "luprec" "osmode" ))
  (initget 128)
  (setq nv_pt1 (getpoint "\nPrefixo/Referência/Enchimento/<Ponto a identificar>..."))
  (setq attdia_mode (getvar "attdia"))
  (setvar "attdia" 0)
  (setvar "orthomode" 1)
  (cond
    ;se clicar num ponto
    ((= 'LIST (type nv_pt1))
     (setq nv_ptinsert (getpoint nv_pt1 "\nPosição do símbolo..."))
     (setq nv_y1_pt1 (nth 1 nv_pt1)
	   y1_pt1 (+ (- nv_y1_pt1 nv_y_pt0) nv_relativo)
	   y2_pt1 (- y1_pt1 nv_enchimento))
     (setq grp_type "2")
     (cn7_find_blkscl)
     (cn7_verylayer (strcat cn7_blk_prefixlay "Níveis") 1)
     (if (= nvc_type 2)
       (command ".insert"  (strcat cnp_root "/blocos/util_st1") "_non" nv_pt1 cn7_blkscl "" "_non" nv_ptinsert)
       (command ".insert"  (strcat cnp_root "/blocos/cvg_nvc2") "_non" nv_pt1 cn7_blkscl "" "_non" nv_ptinsert)
     )
     (setq niv_invert (ssadd (entlast) niv_invert))
     (command "._line" "_non" nv_pt1 "_non" nv_ptinsert "")
     (setq niv_invert (ssadd (entlast) niv_invert))
     ;se é positivo, coloca "+"
     (setq dzin_mo (getvar "dimzin"))
     (setvar "dimzin" 0)
     (if (>= y1_pt1 0)
       (setq txt1 (strcat "+" (rtos y1_pt1 2 2)))
       (setq txt1 (rtos y1_pt1 2 2))
     )
     (if (> y2_pt1 0)
       (setq txt2 (strcat "+" (rtos y2_pt1 2 2)))
       (setq txt2 (rtos y2_pt1 2 2))
     )
     (if (= nv_prefix "Sim") (setq txt1 (strcat "PA:" txt1)
				   txt2 (strcat "PO:" txt2)))    
     (setvar "dimzin" dzin_mo)
     (if (/= 0 nv_enchimento)
       (if (= nvc_type 2)
	 (command "._insert"  (strcat cnp_root "/blocos/cvg_nvp2") "_non" nv_ptinsert cn7_blkscl "" 0 txt1 txt2)
	 (command "._insert"  (strcat cnp_root "/blocos/cvg_nvc2a") "_non" nv_ptinsert cn7_blkscl "" 0 txt1 txt2)
       )
       (if (= nvc_type 2)
	 (command "._insert"  (strcat cnp_root "/blocos/cvg_nvp2") "_non" nv_ptinsert cn7_blkscl "" 0 txt1 "")
	 (command "._insert"  (strcat cnp_root "/blocos/cvg_nvc2a") "_non" nv_ptinsert cn7_blkscl "" 0 txt1 "")
       )
     )
     (setq niv_invert (ssadd (entlast) niv_invert))
     (setvar "mirrtext" 0)
     (setq dist (rtos (* cn7_blkscl 0.20)))
     (setq dist1 (strcat "@" dist ",0"))
     (setvar "orthomode" 1)
     (prompt "\nDesenhe a linha...: ")
     (command "._line" "_non" dist1 "_non" pause "")
     (setq niv_invert (ssadd (entlast) niv_invert))
     (setvar "mirrtext" 0)
     (command "._layer" "_s" culayer "")
     (initget "Sim Não")
     (setq resp (getkword "\nDeseja inverter o símbolo? (S / <N>): "))
     (if (= nil resp) (setq resp "Não"))
     (if (= resp "Sim")
       (command "._mirror" niv_invert "" "_non" nv_pt1 "_non" "@0,1" "y")
     )
     (princ)
    )
    ;se digitar uma letra
    ((= 'STR  (type nv_pt1))
     (cond
       ((= "R" (strcase nv_pt1))
	(cvg_nv_def)
	(cvg_nivel)
       )
       ((= "E" (strcase nv_pt1))
	(nv_enchim)
	(cvg_nivel)
       )
       ((= "P" (strcase nv_pt1))
	(nv_prefixo)
	(cvg_nivel)
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto ou digite <R> para referência...")
	(cvg_nivel)
       )
     )
    )
  )
  (setvar "attdia" attdia_mode)
  (devolve)
)


;***********  Interpolação de 1 curva no meio de outras duas   *************
(defun c:it1 ()
  (setq osmo (getvar "osmode"))
  (setq laymo (getvar "clayer"))
  (cn7_verylayer "Top_curvas_interpoladas" 1)
  (setvar "osmode" 512)
  (setq pt1 (getpoint "\nPrimeiro ponto..."))
  (setq next_pto (getpoint pt1 "\nPróximo ponto..."))
  (setq pt0 (polar pt1 (angle pt1 next_pto) (/ (distance pt1 next_pto) 2)))
  (command "._pline" "_non" pt0)
  (keep)
  (decide)
  (princ)
)


(defun keep ()
	(while (/= nil (setq pt1 (getpoint "\nPrimeiro ponto...")))
	    (progn
  		(setq next_pto (getpoint pt1 "\nPróximo ponto..."))
  		(setq pt0 (polar pt1 (angle pt1 next_pto) (/ (distance pt1 next_pto) 2)))
	  	(command "_non" pt0)
	    );progn
	);while
  	(decide)
);defun


(defun decide ()
  (initget 1 "Undo eXit Continue")
  (setq resp (getkword "\neXit/Undo/Continue <X/U/C>: "))
  (if (= "EXIT" (strcase resp))
    (progn
      (command "")
      (setvar "osmode" osmo)
      (setvar "clayer" laymo)
      (command "._cmdecho" 0)
      (devolve)
      (exit)
      )
    (progn
      (if (= "UNDO" (strcase resp))
	(progn
	  (command "_u")
	  (keep)
	  )
	(keep)
      )
    )
  )
)



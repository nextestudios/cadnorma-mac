	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
      )
      (setvar "celtype" "hidden2")
    )
  )
)

;estabelece os pontos principais para construção das janelas
(defun jnl_openfree_mark ()
  (command "._undo" "_m")
  ;conversão de dados para numerais
  (if (= jnl_var_lrad "jnl_larg_radio1")
    (setq jnl_larg (* jnl_fator (distof jnl_var_larg)))
    (setq jnl_larg (* jnl_fator (distof jnl_var_diam)))
  )
  (jnl_halt_file)
  (setq jnl_halt (* jnl_fator (distof (nth (fix (distof jnl_var_halt)) jnl_halt_list)))
	jnl_afas (* jnl_fator (distof jnl_var_afas))
	jnl_wall (* jnl_fator (distof jnl_var_wall))
	jnl_caix (* jnl_fator (distof jnl_var_caix))
  )
  ;clica na parede
  (prompt "\nSelecione a parede interna...")
  (setq jnl_entsel (entsel)
	jnl_ent1 (car jnl_entsel)
	jnl_ent1_type (cdr (assoc 0 (entget jnl_ent1)))
	jnl_pt0 (nth 0 (cdr jnl_entsel))
	jnl_ptt1 (cdr (assoc 10 (entget jnl_ent1)))
	jnl_ptt2 (cdr (assoc 11 (entget jnl_ent1)))
	jnl_wall_layer (cdr (assoc 8 (entget jnl_ent1)))
  )
  (if (/= "LINE" jnl_ent1_type)
    (progn
      (alert "A entidade Selecionada não é uma 'LINE'.\nPOLYLINES devem ser explodidas\npara usar este comando...")
      (jnl_openfree_mark)
    )
  )
  (if (<= (distance jnl_pt0 jnl_ptt1) (distance jnl_pt0 jnl_ptt2))
    (setq jnl_pt1 jnl_ptt1 jnl_pt2 jnl_ptt2 jnl_code 1)
    (setq jnl_pt1 jnl_ptt2 jnl_pt2 jnl_ptt1 jnl_code 2)
  )
  (setq jnl_angbase (angle jnl_pt1 jnl_pt2))
  ;verifica o posicionamento para determinar os pontos de quebra
  (if (= jnl_var_posi "jnl_center")
    (setq jnl_doll (/ (- (distance jnl_pt1 jnl_pt2) jnl_larg (* 2 jnl_caix)) 2))
    (setq jnl_doll jnl_afas)
  )
  (setq
	jnl_brk1 (polar jnl_pt1 jnl_angbase jnl_doll)
	jnl_brk2 (polar jnl_brk1 jnl_angbase (+ jnl_larg (* 2 jnl_caix)))
  )
  (if (= jnl_code 1)
    (setq jnl_brk3a (polar jnl_brk1 (- jnl_angbase (/ pi 2)) jnl_wall)
	  jnl_brk3b (polar jnl_brk1 (+ jnl_angbase (/ pi 2)) jnl_wall)
	  jnl_brk4a (polar jnl_brk2 (- jnl_angbase (/ pi 2)) jnl_wall)
	  jnl_brk4b (polar jnl_brk2 (+ jnl_angbase (/ pi 2)) jnl_wall)
    )
    (setq jnl_brk3a (polar jnl_brk1 (+ jnl_angbase (/ pi 2)) jnl_wall)
  	  jnl_brk3b (polar jnl_brk1 (- jnl_angbase (/ pi 2)) jnl_wall)
	  jnl_brk4a (polar jnl_brk2 (+ jnl_angbase (/ pi 2)) jnl_wall)
	  jnl_brk4b (polar jnl_brk2 (- jnl_angbase (/ pi 2)) jnl_wall)
    )
  )
  (if (/= nil (ssget "_f" (list jnl_brk3a jnl_brk4a) (list (cons 8 jnl_wall_layer))))
    (progn
      (setq jnl_brk3 jnl_brk3a jnl_brk4 jnl_brk4a jnl_xcode 1)
      (setq jnl_brkm (polar jnl_brk3 (angle jnl_brk3 jnl_brk4) (/ (distance jnl_brk3 jnl_brk4) 2)))
      (if (= nil (ssget "c" jnl_brkm jnl_brkm))
	(progn
	  (setq jnl_brk3 jnl_brk3b jnl_brk4 jnl_brk4b)
	  (setq jnl_brkm (polar jnl_brk3 (angle jnl_brk3 jnl_brk4) (/ (distance jnl_brk3 jnl_brk4) 2))
		jnl_xcode 2)
	)
      )
    )
    (progn
      (setq jnl_brk3 jnl_brk3b jnl_brk4 jnl_brk4b jnl_xcode 2)
      (setq jnl_brkm (polar jnl_brk3 (angle jnl_brk3 jnl_brk4) (/ (distance jnl_brk3 jnl_brk4) 2)))
      (if (= nil (ssget "c" jnl_brkm jnl_brkm))
	(progn
	  (setq jnl_brk3 jnl_brk3a jnl_brk4 jnl_brk4a)
	  (setq jnl_brkm (polar jnl_brk3 (angle jnl_brk3 jnl_brk4) (/ (distance jnl_brk3 jnl_brk4) 2))
		jnl_xcode 4)
	)
      )
    )
  )
  (setq jnl_angortho (angle jnl_brk1 jnl_brk3))
  (setq jnl_mid1 (polar jnl_brk1 jnl_angbase (/ (distance jnl_brk1 jnl_brk2) 2.0))
	jnl_mid2 (polar jnl_brk3 jnl_angbase (/ (distance jnl_brk3 jnl_brk4) 2.0))
  )

)


)


;Escreve a área medida com fator de correção **********************************
(defun c:ea_fator () (ea_fact) (princ))

(defun ea_fact ()
  	(setq laymo (getvar "clayer"))
  	(if (= nil area_fator) (aa_fator))
	(area_verify)
  	(if (= "SIM" (strcase area_m2))
	  (setq area_text (strcat (rtos (* (getvar "AREA") area_fator) 2 area_dec) " m2"))
	  (setq area_text (rtos (* (getvar "AREA") area_fator) 2 area_dec))
	)
	(setq p1 (getpoint "\n Escolha o ponto central do texto... "))
	(command "._layer" "_m" area_layer "" "._text" "_s" area_style "_c" "_non" p1 0 area_text "._chprop" "._last" "" "_c" area_color "")
	(setvar "clayer" laymo)
)

;\transcreve a área medida com fator de correção **********************************
(defun c:ta_fator ()
  	(setq laymo (getvar "clayer"))
  	(if (= nil area_fator) (aa_fator))
	(area_verify)
        (if (= "SIM" (strcase area_m2))
    		(setq new (cons 1 (strcat (rtos (* (getvar "area") area_fator) 2 area_dec) " m2")))
      		(setq new (cons 1 (rtos (* (getvar "area") area_fator) 2 area_dec)))
    	)
    	(prompt "\nSelecione o texto a ser modificado...")
    	(setq ent2 (entget (car (entsel))))
    	(entmod (subst new (assoc 1 ent2) ent2))
  (princ)
)




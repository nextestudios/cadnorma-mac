  )
  ;decide o tipo de bloco usado na cota
  (setvar "dimtsz" 0)
  (setvar "dimsah" 0)
  (setvar "dimblk" "_archtick")
  (setvar "dimblk1" "_archtick")
  (setvar "dimblk2" "_archtick")
  (setvar "dimldrblk" ".")
  (setvar "dimasz" 1.2)
  ;diferenciado da apresentação
  (setvar "DIMSD1" 0)
  (setvar "DIMSD2" 0)
  (setvar "DIMJUST" 0)
  ;dimlfac para unidade de cota / unidade do desenho
  (setvar "dimlfac"  (/ cn7_dimunit cn7_dwgunit))
  ;dimdsep -> separador de decimais
  (setvar "dimdsep" ".")
  ;cores da cota
  (setvar "dimclrd" 1)
  (setvar "dimclre" 1)
  (setvar "dimclrt" 2)
  ;******** Configuraçòes comuns ************
  (setvar "dimatfit" 	0)
  (setvar "dimalt" 	0)
  (setvar "dimaltd"   	2)
  (setvar "dimlunit" 2)
  (setvar "dimaltf"   	25.4)
  (setvar "dimpost" 	"")
  ;(setvar "dimassoc" 	1)
  (setvar "dimcen" 	-1)
  (setvar "dimdle" 	1)
  (setvar "dimdli" 	5.0)
  (setvar "dimexe"    	1)
  (setvar "dimexo"    	2.5)
  (setvar "dimgap"    	0.60)
  (setvar "dimlim"    	0)
  (setvar "dimrnd"    	0.0)
  (setvar "dimse1"    	0)
  (setvar "dimse2"    	0)
  (setvar "dimsho"    	1)
  (setvar "dimsoxd"   	0)
  (setvar "dimtad"    	1)
  (setvar "dimtfac"   	1)
  (setvar "dimtih"    	0)
  (setvar "dimtix"    	1)
  (setvar "dimtm" 	0.0)
  (setvar "dimtofl"   	1)
  (setvar "dimtoh"    	0)
  (setvar "dimtol"    	0)
  (setvar "dimtp" 	0.0)
  (setvar "dimaunit" 	1)
  (setvar "dimadec" 	2)

(defun cn9_xchgcolor ()
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn9_trcolor" dcl_id)) (exit))
  (if (/= nil trcolor_from)
    (progn
      (start_image "trcolor_from_col")
      (fill_image  0  0
	(dimx_tile "trcolor_from_col")
	(dimy_tile "trcolor_from_col")
	trcolor_from
      )
      (end_image)
      (cond
	((= 0 trcolor_from) (set_tile "trcolor_txt_from" (strcat "Cor selecionada: " "byblock")))
	((= 256 trcolor_from) (set_tile "trcolor_txt_from" (strcat "Cor selecionada: " "bylayer")))
	(t (set_tile "trcolor_txt_from" (strcat "Cor selecionada: " (rtos trcolor_from 2 0))))
      )
    )
  )
  (if (/= nil trcolor_to)
    (progn
      (start_image "trcolor_to_col")
      (fill_image  0  0
	(dimx_tile "trcolor_to_col")
	(dimy_tile "trcolor_to_col")
	trcolor_to
      )
      (end_image)
      (cond
	((= 0 trcolor_to) (set_tile "trcolor_txt_to" (strcat "Cor selecionada: " "byblock")))
	((= 256 trcolor_to) (set_tile "trcolor_txt_to" (strcat "Cor selecionada: " "bylayer")))
	(t (set_tile "trcolor_txt_to" (strcat "Cor selecionada: " (rtos trcolor_to 2 0))))
      )
    )
  )
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "trcolor_from_sel" "(done_dialog 2)")
  (action_tile "trcolor_from_pick" "(done_dialog 3)")
  (action_tile "trcolor_to_sel" "(done_dialog 4)")
  (action_tile "trcolor_to_pick" "(done_dialog 5)")
  (setq cn9_trcolor_dcl (start_dialog))
  (unload_dialog dcl_id)
  (if (= cn9_trcolor_dcl 0) (exit))
  (if (= cn9_trcolor_dcl 1) (cn9_trocacor))
  (if (= cn9_trcolor_dcl 2) (cn9_trcolor_from_sel))
  (if (= cn9_trcolor_dcl 3) (cn9_trcolor_from_pick))
  (if (= cn9_trcolor_dcl 4) (cn9_trcolor_to_sel))
  (if (= cn9_trcolor_dcl 5) (cn9_trcolor_to_pick))
)

(defun cn9_trcolor_from_sel ()
  (setq trcolor_from (acad_colordlg 7))
  (cn9_xchgcolor)
)


;*****************************************************************
;Funcao Para Interpolar Pontos 3D
;*****************************************************************

(defun c:ip3 ()
  (if (= nil desnivel) (setq desnivel (getreal "Intervalo entre as curvas...<m>...")))
  (setq incr_z desnivel)
  (setq osmo (getvar "osmode"))
  (setq laymo (getvar "clayer"))
  (setvar "osmode" 8)
  (setq p1 (getpoint "\nEntre com o ponto base..."))
  (setq p2 (getpoint "\nEntre com um segundo ponto..."))
  (cn7_verylayer "Top_pontos_interpolados" 7)
  (setq pbase p2)
  (coord)
  (princ)
)

;********************************************************************
;Funcao coord - separa as cordenadas dos pontos p1 e p2
(defun coord ()
  (setq xp1 (nth 0 p1))
  (setq yp1 (nth 1 p1))
  (setq zp1 (nth 2 p1))
  (setq xp2 (nth 0 p2))
  (setq yp2 (nth 1 p2))
  (setq zp2 (nth 2 p2))
  (verif)
)

;Funcao que verifica se ha interpolacao entre dois pontos escolhidos
(defun verif ()
  (if (< zp2 zp1)
    (progn
      (setq compl (- zp2 (* incr_z (fix (/ zp2 incr_z)))))
      (setq zp3 (+ zp2 (- incr_z compl)))
      (if (<= zp3 zp1)
	(setq resp "t")
	(setq resp "f")
      )
    )
    (progn
      (setq compl (- zp1 (* incr_z (fix (/ zp1 incr_z)))))
      (setq zp3 (+ zp1 (- incr_z compl)))
      (if (>= zp3 zp2)
	(setq resp "f")
	(setq resp "t")
      )
    )
  )
  (if (= resp "t")
    (interpol)
    (goon)
  )
)

;********************************************************************
;Funcao de interpolação dos pontos 
;********************************************************************
(defun interpol ()
  (setq xp3 (+ xp1 (/ (* (- xp2 xp1) (- zp3 zp1)) (- zp2 zp1))))
  (setq yp3 (+ yp1 (/ (* (- yp2 yp1) (- zp3 zp1)) (- zp2 zp1))))
  (setq p3 (list xp3 yp3 zp3))
  (command "._point" "_non" p3)
  (if (< zp1 zp2)
    (setq p1 p3)
    (setq p2 p3)
  )
  (coord)
)

;********************************************************************
;Funcao looping
;********************************************************************(defun goon ()
(defun goon ()
    	(setq p1 pbase)
    	(if (> zp2 zp1) (setq p1 p2))
	(setq p2 (getpoint "\nEntre com o segundo ponto..."))
	(setq pbase p2)
	(coord)
)





;função que escreve o arquivo de dados
(defun cn7_limit_ok ()
  ;escreve o arquivo
  (setq	file (open (strcat cnp_root "/config/limites.txt") "w" "utf8"))
  (write-line cn7_cfg_limits_largura file)
  (write-line	cn7_cfg_limits_altura file)
  (write-line cn7_cfg_limits_x0 file)
  (write-line cn7_cfg_limits_y0 file)
  (close file)
  (if (= 1 cn7_cfgmain_return) (cn7_cfg_main) (cn7_dwg_limits))
)


;altera o valor dos limites, de acordo com o arquivo de dados
(defun cn7_dwg_limits ()
  (cn7_limits_readfile)
  (setq pt1 (list (distof cn7_cfg_limits_x0) (distof cn7_cfg_limits_y0))
	pt2 (list
	      (+ (distof cn7_cfg_limits_x0) (distof cn7_cfg_limits_largura))
	      (+ (distof cn7_cfg_limits_y0) (distof cn7_cfg_limits_altura))
	    )
  )
  (command "._limits" "_non" pt1 "_non" pt2)
  (command "._zoom" "_non" pt1 "_non" pt2 "._zoom" ".9x")
)


;***********************************************************
;Botão OK - CARBURADOR
;***********************************************************
(defun cn7_cfgmain_ok ()
  (cnp:require-vars '("REGENMODE" "DIMLUNIT" "DIMSHO" "DIMASSOC"))
  (setvar "regenmode" 0)
  (setvar "cmdecho" 0)
  (setvar "mirrtext" 0)
  (cn7_cfgmain_savecfg)
  ;define a unidade de desenho  
  (cond
    ((= cfgdata_dwgunit "0") (setq cn7_dwgunit 1.0) (setvar "userr5" 1.0));metros
    ((= cfgdata_dwgunit "1") (setq cn7_dwgunit 100.0) (setvar "userr5" 100.0));centimetros
    ((= cfgdata_dwgunit "2") (setq cn7_dwgunit 1000.0) (setvar "userr5" 1000.0));milimetros
  )
  ;define a unidade de cota 
  (cond
    ((= cfgdata_dimunit "0") (setq cn7_dimunit 1.0)  (setvar "userr4" 1.0));m
    ((= cfgdata_dimunit "1") (setq cn7_dimunit 100.0)  (setq cn7_dimunit 100.0) (setvar "userr4" 100.0));cm
    ((= cfgdata_dimunit "2") (setq cn7_dimunit 1000.0) (setvar "userr4" 1000.0));mm
  )
  ;configuração de espaço
  (setvar "useri3" (fix (distof cfgdata_app_space)))
  ;configurações de texto
  (cn7_config_text)
  (cn7_dwg_altext)
  ;configurações de cotas
  (cn7_dwg_dim)
  (cn7_dwg_aldim)
  ;configurações de layers
  (cn7_dwg_allayer)
  ;configurações de limites (se clicado)
  (if (= cfgdata_app_limits "1") (cn7_dwg_limits))
  ;solicita escala para o model space
  (cn7_esc)
  (command "._dimstyle" "_restore" "cadnorma_dim1")
  (command "._regen")
)




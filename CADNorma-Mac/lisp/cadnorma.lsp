;ao escolher um radio_button
(defun scd12_radio ()
  (setq scd12_var_svis $value)
  (scd12_upslide)
)

;atualização do Slide pelo radio_button escolhido
(defun scd12_upslide ()
  (cond
    ((= scd12_var_svis "scd12_vis_01")
     (setq scd12_type 1)
     (setq x (dimx_tile "scd_12_slide")
	   y (dimy_tile "scd_12_slide"))
     (start_image "scd_12_slide")
     (fill_image 0 0 x y -2)
     (slide_image 0 0 x y (strcat cnp_root "/slides/scd2_11.sld"))
     (end_image)
    )
    ((= scd12_var_svis "scd12_vis_02")
     (setq scd12_type 2)
     (setq x (dimx_tile "scd_12_slide")
	   y (dimy_tile "scd_12_slide"))
     (start_image "scd_12_slide")
     (fill_image 0 0 x y -2)
     (slide_image 0 0 x y (strcat cnp_root "/slides/scd2_12.sld"))
     (end_image)
    )
    ((= scd12_var_svis "scd12_vis_03")
     (setq scd12_type 3)
     (setq x (dimx_tile "scd_12_slide")
	   y (dimy_tile "scd_12_slide"))
     (start_image "scd_12_slide")
     (fill_image 0 0 x y -2)
     (slide_image 0 0 x y (strcat cnp_root "/slides/scd2_13.sld"))
     (end_image)
    )
  )
)   

;***********************************
;Configuração de Cores e Layers     
;***********************************
(defun scd12_laycol_button ()
  (scd12_last_writefile)
  (scd12_layc_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd12_cfglayc" dcl_id)) (exit))
  ;degraus em vista
  (set_tile "scd12_layc_dvl" scd12_layc_dvl)
  (action_tile "scd12_layc_dvl" "(setq scd12_layc_dvl $value)")
  (start_image "scd12_layc_dvc")
  (fill_image  0  0
    (dimx_tile "scd12_layc_dvc")
    (dimy_tile "scd12_layc_dvc")
    (fix (distof scd12_layc_dvc))
  )
  (end_image)
  (action_tile "scd12_layc_dvc" "(scd12_layc_dvc_color)")
  ;degraus em projeção
  (set_tile "scd12_layc_dpl" scd12_layc_dpl)
  (action_tile "scd12_layc_dpl" "(setq scd12_layc_dpl $value)")
  (start_image "scd12_layc_dpc")
  (fill_image  0  0
    (dimx_tile "scd12_layc_dpc")
    (dimy_tile "scd12_layc_dpc")
    (fix (distof scd12_layc_dpc))
  )
  (end_image)
  (action_tile "scd12_layc_dpc" "(scd12_layc_dpc_color)")
  ;Corrimão
  (set_tile "scd12_layc_crl" scd12_layc_crl)
  (action_tile "scd12_layc_crl" "(setq scd12_layc_crl $value)")
  (start_image "scd12_layc_crc")
  (fill_image  0  0
    (dimx_tile "scd12_layc_crc")
    (dimy_tile "scd12_layc_crc")
    (fix (distof scd12_layc_crc))
  )
  (end_image)
  (action_tile "scd12_layc_crc" "(scd12_layc_crc_color)")
  ;Interrupção
  (set_tile "scd12_layc_itl" scd12_layc_itl)
  (action_tile "scd12_layc_itl" "(setq scd12_layc_itl $value)")
  (start_image "scd12_layc_itc")
  (fill_image  0  0
    (dimx_tile "scd12_layc_itc")
    (dimy_tile "scd12_layc_itc")
    (fix (distof scd12_layc_itc))
  )
  (end_image)
  (action_tile "scd12_layc_itc" "(scd12_layc_itc_color)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq scd12_layc_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= scd12_layc_id 1)
    (progn
      (scd12_layc_writefile)
      (scd12_main)
    )
  )
  (if (= scd12_layc_id 0) (scd12_main))
)


;atualiza o arquivo de descrições da página
(defun net_lib_chg_descript ()
  (setq counter 0 lib_newpaglist (list))
  (repeat 16
    (if (= counter n_descr)
      (setq lib_newpaglist (append lib_newpaglist (list cn7_new_descr)))
      (setq lib_newpaglist (append lib_newpaglist (list (nth counter lib_paglist))))
    )
    (setq counter (1+ counter))
    (setq open_file (open (strcat cnp_netroot "/slides/" lib_blkpfx lib_blkfam lib_blkgrp lib_blksub lib_blkpag ".txt") "w" "utf8"))
    (foreach n lib_newpaglist
      (write-line n open_file)
    )
    (close open_file)
  )
)



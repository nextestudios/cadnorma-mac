;Unitária em previous
(defun cnqt_selmode_p1 ()
  (if (= nil cnqt_repet)
    (progn
      (setq cnqt_repet 1)
      (setq cnqt_repet_str "1")
    )
  )
  (setq s1 (ssget "_P"))
  (sssetfirst gripset s1)
  (initget "Sim Não")
  (setq alert_resp (getkword "\nConcorda com a seleção? <S>/N: "))
  (if (= nil alert_resp) (setq alert_resp "Sim"))
  (if (= alert_resp "Sim")
    (progn
      (command "._undo" "_m")
      (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
      (if (not (new_dialog "cnqt_get_repet" dcl_id)) (exit))
      (set_tile "cnqt_getrep_repet" (rtos cnqt_repet 2 0))
      (mode_tile "cnqt_getrep_repet" 2)
      (action_tile "cnqt_getrep_repet" "(cnqt_getrep_very)")
      (action_tile "accept" "(done_dialog 1)")
      (action_tile "cancel" "(done_dialog 0)")
      (setq cnqt_h_dcl (start_dialog))
      (unload_dialog dcl_id)
      (cn7_find_blkscl)
      (cn7_verylayer "cnqt" 7)
      (setq s1_n (sslength s1) counter 0)
      (repeat s1_n
	(setq ent (ssname s1 counter)
	      ent_list (entget ent)
	      ent_type (cdr (assoc 0 ent_list)))
	(cond
	  ((= (strcase ent_type) "LINE")
	   (setq pt0 (cdr (assoc 10 ent_list))
		 pt2 (cdr (assoc 11 ent_list))
		 pt1 (polar pt0 (angle pt0 pt2) (/ (distance pt0 pt2) 2)))
	   (command "._insert" (strcat cnp_netroot "/quant/cnqt_ponto") "_s" cn7_blkscl "_non" pt1 0 cnqt_code cnqt_repet_str)
	  )
	  ((= (strcase ent_type) "ARC")
	   (setq pt1 (polar (cdr (assoc 10 ent_list)) (cdr (assoc 50 ent_list)) (cdr (assoc 40 ent_list))))
	   (command "._insert" (strcat cnp_netroot "/quant/cnqt_ponto") "_s" cn7_blkscl "_non" pt1 0 cnqt_code cnqt_repet_str)
	  )
	  ((= (strcase ent_type) "LWPOLYLINE")
	   (cnqt_lwpline)
	   (setq counter2 0)
	   (repeat (1- (length lwpline_list))
	     (setq pt0 (nth counter2 lwpline_list)
		   pt2 (nth (1+ counter2) lwpline_list)
		   pt1 (polar pt0 (angle pt0 pt2) (/ (distance pt0 pt2) 2))
		   counter2 (1+ counter2)
             )
	     (command "._insert" (strcat cnp_netroot "/quant/cnqt_ponto") "_s" cn7_blkscl "_non" pt1 0 cnqt_code cnqt_repet_str)
	   )
	   (if (= 1 (cdr (assoc 70 ent_list)))
	     (progn
	       (setq pt0 (nth counter2 lwpline_list)
		     pt2 (nth 0 lwpline_list)

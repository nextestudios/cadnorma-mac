;Congela escala selecionada na Viewport
(defun c:fzv ()
  ;veryfica se está na Viewport
  (if (or
	(= (getvar "tilemode") 1)
	(and (= (getvar "tilemode") 0) (= (getvar "cvport") 1))
      )
    (progn
      (alert "Operação só permitida\nna Viewport!")
      (quit)
    )
  )
  (setq esc nil ent nil)
  (prompt "\nSelecione uma entidade base ou <ENTER> para digitar escala...")
  (setq ent (entsel))
  (if (= nil ent)
    ;se pressiona <ENTER>
    (progn
      (setq esc (getint "\nEntre com a escala a congelar..."))
      (if (/= nil esc)
	(progn
	  (fzv_blk_newlayer (getvar "clayer"))
	  (if (= (rtos esc 2 0) oldprefix)
	    ;se o layer atual pertence à escala a ser congelada
	    (progn
	      (cn7_alert_ok
		"O layer atual pertence à escala a ser congelada!"
		"Selecione uma entidade para tornar seu layer atual"
		"e congelar a escala desejada..."
	      )
	      (setq ent (entsel))
	      (if (= nil ent)
		(exit)
		(progn
		  (setq ent_list (entget (car ent))
			ent_layer (cdr (assoc 8 ent_list))
		  )
		  (setvar "clayer" ent_layer)
		  (command "._vplayer" "_f" (strcat oldprefix "-*") "" "")
		  )
		);if
	      );progn T
	    ;se layer atual Não tem problema
	    (progn
	      (setvar "clayer" ent_layer)
	      (command "._vplayer" "_f" (strcat (rtos esc 2 0) "-*") "" "")
	    );progn F
	  )
	)
      );progn para o caso T, escala digitada
    )
    ;caso a escala a congelar seja definida por seleção de uma entidade
    (progn
      (setq ent_list (entget (car ent))
	    ent_layer (cdr (assoc 8 ent_list)))
      (fzv_verylayer)
      (if (member oldprefix reg_scale_list) (setq cve_xxxlist (append cve_xxxlist (list s1_ent))))
      (fzv_blk_newlayer ent_layer)
      (if (= oldprefix (substr (getvar "clayer") 1 (strlen oldprefix)))
	(progn
	  (cn7_alert_ok
		"O layer atual pertence à escala a ser congelada!"
		"Selecione uma entidade para tornar seu layer atual"
		"e congelar a escala desejada..."
	  )
	  (setq ent (entsel))
	  (if (= nil ent)
	    (exit)
	    (progn
	      (setq ent_list (entget (car ent))
		    ent_layer (cdr (assoc 8 ent_list))
		    )
	      (setvar "clayer" ent_layer)
	      (command "._vplayer" "_f" (strcat oldprefix "-*") "" "")
	      )
	    );if
	 );progn
	(progn
	  (command "._vplayer" "_f" (strcat oldprefix "-*") "" "")
	)
      );if
    );progn
  );if
  (princ)
);defun

;verifica se o layer desejado como current é válido.
(defun fzv_verylayer ()
  (setq counter2 1 oldprefix "")
  (while (and
	   (/= "-" (substr ent_layer counter2 1))
	   (/= ""  (substr ent_layer counter2 1))
	 );and
    (setq oldprefix (strcat oldprefix (substr ent_layer counter2 1))
	  counter2 (1+ counter2)
    )
  )
  (if (member oldprefix reg_scale_list)
    (progn
      (setq counter2 (1+ counter2)
	    layer_sufix (substr ent_layer counter2))
    )
    (progn
      (alert "\nEntidade não gráfica\nou layer inválido!")
      (quit)
    )
  )
  (princ)
)

;auxiliar para encontrar o prefixo do layer
(defun fzv_blk_newlayer (layer_name)
  (setq n_oldlayer (strlen layer_name) counter2 1 oldprefix "" layer_sufix "")
  (while (/= "-" (substr layer_name counter2 1))
    (setq oldprefix (strcat oldprefix (substr layer_name counter2 1))
	  counter2 (1+ counter2)
    )
  )
  (if (member oldprefix reg_scale_list)
    (progn
      (setq counter2 (1+ counter2)
	    layer_sufix (substr layer_name counter2))
    )
    (progn
      (alert "Escala não regular!")
      (quit)
    )
  )
  (princ)
)
  

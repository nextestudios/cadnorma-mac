    ((= ent_family "02") (set_tile "cnqt_show_family" "Instalações Elétricas"))
  )
  (set_tile "cnqt_show_code" ent_code)
  (set_tile "cnqt_show_grupo" grupo)
  (set_tile "cnqt_show_subgrupo" subgrupo)
  (set_tile "cnqt_show_item" item_text)
  (cond
    ((= item_type "1") (set_tile "cnqt_show_type" "Unitário"))
    ((= item_type "2") (set_tile "cnqt_show_type" "Linear"))
    ((= item_type "3") (set_tile "cnqt_show_type" "Área"))
    ((= item_type "4") (set_tile "cnqt_show_type" "Volume"))
  )
  (set_tile "cnqt_show_quant1" ent_quant)
  (set_tile "cnqt_show_quant2" item_custo)
  (cond
    ((= cnqt_show_type 1)
     (set_tile "cnqt_show_unit1" "Unid.")
     (set_tile "cnqt_show_unit2" "(R$ / unid.)")
    )
    ((= cnqt_show_type 2)
     (set_tile "cnqt_show_unit1" "m")
     (set_tile "cnqt_show_unit2" "(R$ / m)")
    )
    ((= cnqt_show_type 3)
     (set_tile "cnqt_show_unit1" "m2")
     (set_tile "cnqt_show_unit2" "(R$ / m2)")
    )
    ((= cnqt_show_type 4)
     (set_tile "cnqt_show_unit1" "m3")
     (set_tile "cnqt_show_unit2" "(R$ / m3)")
    )
  )
  (setq cnqt_show_dcl (start_dialog))
  (unload_dialog dcl_id)
)

;extrai os dados a partir de um código fornecido : ent / ent_list
(defun cd_extract ()
  (while (/= "SEQEND" (cdr (assoc 0 (setq selent (entget (setq ent (entnext ent)))))))
    (if (= "ATTRIB" (cdr (assoc 0 selent)))
      (cond
	((= "QUANT" (cdr (assoc 2 selent))) (setq ent_quant (cdr (assoc 1 selent))))
	((= "CNQT" (cdr (assoc 2 selent))) (setq ent_code (cdr (assoc 1 selent))))
      )
    )
  )
  (setq ent_family (substr ent_code 5 2)
	ent_code_grupo (substr ent_code 1 6)
	ent_code_subgrupo (substr ent_code 7 2)
	ent_code_itemlist (substr ent_code 9 2)
	ent_code_item (substr ent_code 11)
	ent_code_grupo_n (1+ (fix (distof ent_code_subgrupo)))
	ent_code_subgrupo_n (1+ (fix (distof ent_code_itemlist)))
	ent_code_item_n (1+ (fix (distof ent_code_item)))
  )
  ;extrai o grupo
  (setq open_file (open (strcat cnp_netroot "/quant/" ent_code_grupo ".txt") "r" "utf8"))
  (repeat ent_code_grupo_n
    (setq grupo (read-line open_file))
  )
  (close open_file)
  ;extrai o subgrupo
  (setq open_file (open (strcat cnp_netroot "/quant/" ent_code_grupo ent_code_subgrupo ".txt") "r" "utf8"))
  (repeat ent_code_subgrupo_n
    (setq subgrupo (read-line open_file))
  )
  (close open_file)
  ;extrai o item
  (setq open_file (open (strcat cnp_netroot "/quant/" ent_code_grupo ent_code_subgrupo ent_code_itemlist ".txt") "r" "utf8"))
  (repeat ent_code_item_n
    (setq item (read-line open_file))
  )
  (close open_file)
  (setq linha item)
  (cnqt_separa_dados)
)


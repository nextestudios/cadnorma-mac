;;;;;;;;;;;;;;;;;;;;;;;;;;;MALHA DE COORDENADAS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun c:malha ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (command "._undo" "_m")	
  (cn7_init)
  (setq grp_type "2")
  (cn7_find_blkscl)	
  (setq txtmo (getvar "textstyle")
	laymo (getvar "clayer")
	osmo (getvar "osmode")
	colmo (getvar "cecolor")
  )
  (setq amplitude (getint "\nAmplitude da malha..."))
  (setq pt1 (getpoint "\nPonto inferior esquerdo...")
	pt2 (getcorner pt1 "\nPonto superior direito...")
	xpt1 (nth 0 pt1)
	ypt1 (nth 1 pt1)
	xpt2 (nth 0 pt2)
	ypt2 (nth 1 pt2)
	xrpt1 (* amplitude (fix (/ (nth 0 pt1) amplitude)))
	yrpt1 (* amplitude (1- (fix (/ (nth 1 pt1) amplitude))))
	xrpt2 (* amplitude (1+ (fix (/ (nth 0 pt2) amplitude))))
	yrpt2 (* amplitude (1+ (fix (/ (nth 1 pt2) amplitude))))
	pm1 (polar (list xrpt1 yrpt1) pi (* 1.5 cn7_blkscl))
	pm2 (polar pm1 0 (+ (- xrpt2 xrpt1) (* 2 1.5 cn7_blkscl)))
	pm3 (polar (list xrpt1 yrpt1) (/ (* 3 pi) 2) (* 1.5 cn7_blkscl))
	pm4 (polar pm3 (/ pi 2) (+ (- yrpt2 yrpt1) (* 2 1.5 cn7_blkscl)))
	nx (1+ (/ (- xrpt2 xrpt1) amplitude))
	ny (1+ (/ (- yrpt2 yrpt1) amplitude))
  )
  (cn7_verylayer "Top_malha_coord" 2)
  (setvar "cecolor" "bylayer")
  (setvar "osmode" 0)
  (command "._line" pm1 pm2 "")
  (command "._array" (entlast) "" "_r" ny 1 amplitude)
  (command "._line" pm3 pm4 "")
  (command "._array" (entlast) "" "_r" 1 nx amplitude)
  (wtm_malha)
  (setvar "textstyle" txtmo)
  (setvar "clayer" laymo)
  (setvar "osmode" osmo)
  (setvar "cecolor" colmo)
  (devolve)
  (princ)
)

(defun wtm_malha ()
  (setq inicio xrpt1
	quant nx
	psimb_txt (polar pm3 pi (* 0.05 cn7_blkscl))
	dist amplitude
	ang_txt 90
	ang_dir 0
	increm amplitude
  )
  (wtm_malha_escreve)
  (setq inicio yrpt1
	quant ny
	psimb_txt (polar pm1 (/ pi 2) (* 0.05 cn7_blkscl))
	dist amplitude
	ang_txt 0
	ang_dir (/ pi 2)
	increm amplitude
  )
  (wtm_malha_escreve)
)

(defun wtm_malha_escreve ()

(defun c:allay () (setq cn7_cfgmain_return 0) (cn7_cfgmain_layer) (princ))

;distribuidor
(defun cn7_cfgmain_layer ()
  (cn7_cfg_allayer_files)
  (cn7_cfg_allayer)
  (if (= cn7_cfgmain_return 1) (cn7_cfg_main))
)

;lê os dados iniciais da DCL no arquivo de dados
(defun cn7_cfg_allayer_files ()
  (if (not (findfile (strcat cnp_root "/config/allayer.txt")))
    (progn
      (setq file (open (strcat cnp_root "/config/allayer.txt") "w" "utf8"))
      (write-line "0" file);allayer_create
      (write-line "0" file);allayer_project
      (write-line "1" file);allayer_cdn_txtlay
      (write-line "1" file);allayer_cus_txtlay
      (write-line "1" file);allayer_cdn_dimlay
      (write-line "1" file);allayer_cus_dimlay
      (close file)
    )
  )
  ;procura o valor padrão
  (setq	file (open (strcat cnp_root "/config/allayer.txt") "r" "utf8"))
  (setq allayer_create (read-line file))
  (setq allayer_project (read-line file))
  (setq allayer_cdn_txtlay (read-line file))
  (setq allayer_cus_txtlay (read-line file))
  (setq allayer_cdn_dimlay (read-line file))
  (setq allayer_cus_dimlay (read-line file))
  (close file)
)

;função principal
(defun cn7_cfg_allayer ()
;abre a dcl(write-line allayer_project file)
  (setq allayer_projlist
	 (list"Geral" "Arquitetura" "Paisagismo"
	      "Urbanismo" "Elétrica" "Telefone"
	      "Rede Lógica" "Água" "Esgoto"
	      "Incêndio" "Aterramento" "Ar Condicionado"
	      "Concreto" "Metálica" "Gás"
	      "Automação" "Alarme" "CFTV"
	      "Som" "Topografia" "User_01"
	      "User_02" "User_03"))
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_layers" dcl_id)) (exit))
  ;preenche a lista de projetos disponíveis
  (start_list "allayer_modelos")
  (mapcar 'add_list allayer_projlist)
  (end_list)
  (action_tile "allayer_modelos" "(setq allayer_project $value)")
  ;toggle create
  (if (= "0" allayer_create)
    (progn
      (set_tile "allay_create" "0")
      (mode_tile "allayer_modelos" 1)
    )
    (progn
      (set_tile "allay_create" "1")
      (mode_tile "allayer_modelos" 0)
      (set_tile "allayer_modelos" allayer_project)
    )

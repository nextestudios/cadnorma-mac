    (fix (distof jnl_layc_vic))
  )
  (end_image)
  (action_tile "jnl_layc_vic" "(jnl_layc_vic_color)")
  ;Projeção
  (set_tile "jnl_layc_prl" jnl_layc_prl)
  (action_tile "jnl_layc_prl" "(setq jnl_layc_prl $value)")
  (start_image "jnl_layc_prc")
  (fill_image  0  0
    (dimx_tile "jnl_layc_prc")
    (dimy_tile "jnl_layc_prc")
    (fix (distof jnl_layc_prc))
  )
  (end_image)
  (action_tile "jnl_layc_prc" "(jnl_layc_prc_color)")
  ;Parapeito
  (set_tile "jnl_layc_ppl" jnl_layc_ppl)
  (action_tile "jnl_layc_ppl" "(setq jnl_layc_ppl $value)")
  (start_image "jnl_layc_ppc")
  (fill_image  0  0
    (dimx_tile "jnl_layc_ppc")
    (dimy_tile "jnl_layc_ppc")
    (fix (distof jnl_layc_ppc))
  )
  (end_image)
  (action_tile "jnl_layc_ppc" "(jnl_layc_ppc_color)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq jnl_layc_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= jnl_layc_id 1)
    (progn
      (jnl_layc_writefile)
      (jnl_main)
    )
  )
  (if (= jnl_layc_id 0) (jnl_main))
)


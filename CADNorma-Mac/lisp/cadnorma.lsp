;somente com o botão "ok"
(defun cn7_alert_ok (msg1 msg2 msg3)
  (setq alert_resp nil)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_msg_ok" dcl_id)) (exit))
  (set_tile "msg_text1" msg1)
  (set_tile "msg_text2" msg2)
  (set_tile "msg_text3" msg3)
  (action_tile "accept" " (done_dialog 1)")
  (setq msg_resp (start_dialog))
  (unload_dialog dcl_id)
  (princ)
)


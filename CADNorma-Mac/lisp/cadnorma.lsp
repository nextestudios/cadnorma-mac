;configuração de cotas custom
(defun cn7_dwg_aldim ()
  (command "._dimstyle" "_r" "cadnorma_dim1")
  ;coleta os parâmetros de configuração no arquivo de dados
  (cn7_cfg_aldim_file)
  ;habilita movimentação dos textos
  (setvar "dimtmove" 2)
  ;decide o tipo de bloco usado na cota
  (setvar "dimblk1" ".")
  (setvar "dimblk2" ".")
  (cond
    ((= aldim_blk1 "0") (setvar "dimblk" "_archtick") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk1 "1") (setvar "dimblk" "_dot") (setvar "dimtsz" 0) (setvar "dimasz" 1.0))
    ((= aldim_blk1 "2") (setvar "dimblk" "_open30") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk1 "3") (setvar "dimblk" "_open90") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk1 "4") (setvar "dimblk" ".") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk1 "5") (setvar "dimblk" ".") (setvar "dimtsz" 0.6) (setvar "dimasz" 1.2))
  )
  ;dimlfac para unidade de cota / unidade do desenho
  (setvar "dimlfac"  (/ cn7_dimunit cn7_dwgunit))
  ;dimdsep -> separador de decimais
  (if (= aldim_dsep "0") (setvar "dimdsep" ".") (setvar "dimdsep" ","))
  ;define as cores da cota
  (setvar "dimclrd" 	(fix (distof aldim_dcol)))
  (setvar "dimclre" 	(fix (distof aldim_dcol)))
  (setvar "dimclrt" 	(fix (distof aldim_tcol)))
  ;definição de casas decimais
  (setvar "dimdec" (fix (distof aldim_ddec)))
  ;supressão de zeros
  ;*****************************************************
  (cond
    ((= aldim_dzin "0") (setvar "dimzin" 4))
    ((= aldim_dzin "1") (setvar "dimzin" 8))
    ((= aldim_dzin "2") (setvar "dimzin" 12))
    ((= aldim_dzin "3") (setvar "dimzin" 0))
  )

  ;estilo selecionado
  (setq aldim_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (setvar "dimtxsty" (nth (fix (distof aldim_txst)) aldim_stylist))
  ;define a altura do texto
  (cond
    ((= (strcase (getvar "dimtxsty") t) "r50") (setvar "dimtxt" hf_r50))
    ((= (strcase (getvar "dimtxsty") t) "r60") (setvar "dimtxt" hf_r60))
    ((= (strcase (getvar "dimtxsty") t) "r70") (setvar "dimtxt" hf_r70))
    ((= (strcase (getvar "dimtxsty") t) "r80") (setvar "dimtxt" hf_r80))
    ((= (strcase (getvar "dimtxsty") t) "r90") (setvar "dimtxt" hf_r90))
    ((= (strcase (getvar "dimtxsty") t) "r100") (setvar "dimtxt" hf_r100))
    ((= (strcase (getvar "dimtxsty") t) "r120") (setvar "dimtxt" hf_r120))
    ((= (strcase (getvar "dimtxsty") t) "r140") (setvar "dimtxt" hf_r140))
    ((= (strcase (getvar "dimtxsty") t) "r175") (setvar "dimtxt" hf_r175))
    ((= (strcase (getvar "dimtxsty") t) "r200") (setvar "dimtxt" hf_r200))
    ((= (strcase (getvar "dimtxsty") t) "t1") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t1_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t2") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t2_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t3") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t3_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t4") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t4_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t5") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t5_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t6") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t6_alt)))
    ((= (strcase (getvar "dimtxsty") t) "t7") (cn7_cfg_altext_file) (setvar "dimtxt" (distof t7_alt)))
    (t (setvar "dimtxt" 2.0))
  )
  (setvar "dimscale" 0) 
  (if (tblsearch "dimstyle" "cadnorma_dim4")
    (command "._dimstyle" "_s" "cadnorma_dim4" "_y")
    (command "._dimstyle" "_s" "cadnorma_dim4")
  )
  (cond
    ((= aldim_blk2 "0") (setvar "dimblk" "_archtick") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk2 "1") (setvar "dimblk" "_dot") (setvar "dimtsz" 0) (setvar "dimasz" 1.0))
    ((= aldim_blk2 "2") (setvar "dimblk" "_open30") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk2 "3") (setvar "dimblk" "_open90") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk2 "4") (setvar "dimblk" ".") (setvar "dimtsz" 0) (setvar "dimasz" 1.2))
    ((= aldim_blk2 "5") (setvar "dimblk" ".") (setvar "dimtsz" 0.6))
  )
  (setvar "dimldrblk" (getvar "dimblk"))
  ;dimleader em dot (variar para a próxima versão)
  (if (tblsearch "dimstyle" "cadnorma_dim5")
    (command "._dimstyle" "_s" "cadnorma_dim5" "_y")
    (command "._dimstyle" "_s" "cadnorma_dim5")
  )
)

;*********************************************************************
;funções de erro
;*********************************************************************
(defun guarda (VS / VI value)
  (setq err_temp *ERROR*)
  (setq *error* armadilha)
  (setq restlist '())
   (while VS
      (setq VI (car VS)
            value (getvar VI)
            restlist (append restlist (list (list VI value)))
            VS (cdr VS)
      )
   )
)

(defun devolve ()  
  (setq *error* err_temp)
  (while restlist
     (setq VI (car (car restlist))
           value (car (cdr (car restlist)))
     )
     (setvar VI value)
     (setq restlist (cdr restlist))
  )
)


(defun armadilha (errmsg) 
  (command nil nil nil)
  (if (not
	(member errmsg
	   '("console break" "Function Cancelled"))
      )
    (princ (strcat "\nError: " errmsg))
)
(princ)
(terpri)
(setq *error* err_temp)
(princ)
)

;*********************************************************************
;função que encontra a escala da janela
;*********************************************************************
(defun cn7_vport_scl ()
  (setq cn7_ddzin (getvar "dimzin"))
  (setvar "dimzin" 1)
  (if (not (and (= 0 (getvar "tilemode")) (= 1 (getvar "cvport"))))
    (setq scl_list (assoc (getvar "cvport") (setq all_views (vports)))
	  scl_delta (-  (nth 1 (nth 2 scl_list)) (nth 1 (nth 1 scl_list)))
	  cn7_vp_scale (/ (* 1000 (/ (getvar "viewsize") scl_delta)) cn7_dwgunit);next->
    )
    (alert "não está na janela")
  )
  (setvar "dimzin" cn7_ddzin)
  (setq cn10_vp_scale (* 1000 (/ (getvar "viewsize") scl_delta)))
)

;***********************************************************************
;verifica se a escala da janela é válida -> retorna: cn7_msscl -> userr3
;***********************************************************************
(defun cn7_veryscale ()
  (setq cn7_dzin (getvar "dimzin"))
  (setvar "dimzin" 1)
  (cn7_vport_scl)
  (setq cn7_listmemb "n" alert_resp nil)
  (setq cn7_scalist
	 (list
	   "1.000" "10.000" "100.000" "1000.000" "10000.000" "100000.000" "1000000.000"
	   "1.250" "12.500" "125.000" "1250.000" "12500.000" "125000.000"
	   "1.500" "15.000" "150.000" "1500.000" "15000.000" "150000.000"
	   "2.000" "20.000" "200.000" "2000.000" "20000.000" "200000.000"
	   "2.500" "25.000" "250.000" "2500.000" "25000.000" "250000.000"
	   "3.000" "30.000" "300.000" "3000.000" "30000.000" "300000.000"
	   "4.000" "40.000" "400.000" "4000.000" "40000.000" "400000.000"
	   "5.000" "50.000" "500.000" "5000.000" "50000.000" "500000.000"
	   "7.500" "75.000" "750.000" "7500.000" "75000.000" "750000.000"))
  ;next->
  (setq cn7_vpscl_verify cn7_vp_scale)
  (foreach n cn7_scalist
    (if (= (rtos cn7_vpscl_verify 2 3) n) (setq cn7_listmemb "s"))
  )
  (setvar "dimzin" cn7_dzin)
  (if (= cn7_listmemb "n")
    ;se a escala da janela é irregular
    (progn
      (cn7_alert_yes_no
	"A escala dessa Viewport não é padrão!"
	(strcat "Escala atual = 1:" (rtos cn7_vpscl_verify 2 3))
	"Deseja continuar mesmo assim?")
      (if (= "no" alert_resp)
	(exit)
	(progn
	  (setq cn7_msscl cn7_vp_scale)
	  (setvar "userr3" cn7_msscl)
	)
      )
    );
    ;se a escala da janela é regular
    (progn
      (setq cn7_msscl cn7_vp_scale)
      (setvar "userr3" cn7_msscl)
    )
  );if
  (princ)
)




;********************************
;Cobertura Tipo - Coleta de Dados
;********************************
(defun c:cob () (cbt_getdata))

(defun cbt_getdata ()
  (cbt_draw_file)
  ;abre a caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cbt_draw" dcl_id)) (exit))
  ;atualiza o slide
  (setq x (dimx_tile "cbt_draw_img")
	y (dimy_tile "cbt_draw_img"))
  (start_image "cbt_draw_img")
  (cond
    ((= cbt_var_tipo "11") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_11.sld")))
    ((= cbt_var_tipo "12") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_12.sld")))
    ((= cbt_var_tipo "13") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_13.sld")))
    ((= cbt_var_tipo "21") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_21.sld")))
    ((= cbt_var_tipo "22") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_22.sld")))
    ((= cbt_var_tipo "23") (slide_image 0 0 x y (strcat cnp_root "/slides/cbt_draw_23.sld")))
  )
  (end_image)
  ;beiral
  (set_tile "cbt_draw_getp" cbt_drw_p)
  (action_tile "cbt_draw_getp" "(cbt_draw_evalget_p)")
  (action_tile "cbt_draw_pikp" "(done_dialog 8)")
  ;atualiza as medidas
  (set_tile "cbt_draw_geta" cbt_drw_a)
  (set_tile "cbt_draw_getb" cbt_drw_b)
  (set_tile "cbt_draw_getc" cbt_drw_c)
  (set_tile "cbt_draw_getd" cbt_drw_d)
  (set_tile "cbt_draw_gete" cbt_drw_e)
  (set_tile "cbt_draw_getf" cbt_drw_f)
  ;edit_boxes
  (action_tile "cbt_draw_geta" "(cbt_draw_evalget_a)")
  (action_tile "cbt_draw_getb" "(cbt_draw_evalget_b)")
  (action_tile "cbt_draw_getc" "(cbt_draw_evalget_c)")
  (action_tile "cbt_draw_getd" "(cbt_draw_evalget_d)")
  (action_tile "cbt_draw_gete" "(cbt_draw_evalget_e)")
  (action_tile "cbt_draw_getf" "(cbt_draw_evalget_f)")
  ;pick buttons
  (action_tile "cbt_draw_pika" "(done_dialog 2)")
  (action_tile "cbt_draw_pikb" "(done_dialog 3)")
  (action_tile "cbt_draw_pikc" "(done_dialog 4)")
  (action_tile "cbt_draw_pikd" "(done_dialog 5)")
  (action_tile "cbt_draw_pike" "(done_dialog 6)")
  (action_tile "cbt_draw_pikf" "(done_dialog 7)")
  ;mode_tile nas medidas
  (cond
    ((or (= cbt_var_tipo "11") (= cbt_var_tipo "12")
	 (= cbt_var_tipo "13") (= cbt_var_tipo "21")
     )
     (mode_tile "cbt_draw_geta" 0)
     (mode_tile "cbt_draw_getb" 0)
     (mode_tile "cbt_draw_getc" 1)
     (mode_tile "cbt_draw_getd" 1)
     (mode_tile "cbt_draw_gete" 1)
     (mode_tile "cbt_draw_getf" 1)
     (mode_tile "cbt_draw_pika" 0)
     (mode_tile "cbt_draw_pikb" 0)
     (mode_tile "cbt_draw_pikc" 1)
     (mode_tile "cbt_draw_pikd" 1)
     (mode_tile "cbt_draw_pike" 1)
     (mode_tile "cbt_draw_pikf" 1)
    )
    ((= cbt_var_tipo "22")
     (mode_tile "cbt_draw_geta" 0)
     (mode_tile "cbt_draw_getb" 0)
     (mode_tile "cbt_draw_getc" 0)
     (mode_tile "cbt_draw_getd" 0)
     (mode_tile "cbt_draw_gete" 1)
     (mode_tile "cbt_draw_getf" 1)
     (mode_tile "cbt_draw_pika" 0)
     (mode_tile "cbt_draw_pikb" 0)
     (mode_tile "cbt_draw_pikc" 0)
     (mode_tile "cbt_draw_pikd" 0)
     (mode_tile "cbt_draw_pike" 1)
     (mode_tile "cbt_draw_pikf" 1)
    )
    ((= cbt_var_tipo "23")
     (mode_tile "cbt_draw_geta" 0)
     (mode_tile "cbt_draw_getb" 0)
     (mode_tile "cbt_draw_getc" 0)
     (mode_tile "cbt_draw_getd" 0)
     (mode_tile "cbt_draw_gete" 0)
     (mode_tile "cbt_draw_getf" 1)
     (mode_tile "cbt_draw_pika" 0)
     (mode_tile "cbt_draw_pikb" 0)
     (mode_tile "cbt_draw_pikc" 0)
     (mode_tile "cbt_draw_pikd" 0)
     (mode_tile "cbt_draw_pike" 0)
     (mode_tile "cbt_draw_pikf" 1)
    )
  )
  ;funções ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq cbt_drw_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 cbt_drw_dcl_id) (cbt_draw_ok_action))
  (if (= 2 cbt_drw_dcl_id) (cbt_drw_pik_a))
  (if (= 3 cbt_drw_dcl_id) (cbt_drw_pik_b))
  (if (= 4 cbt_drw_dcl_id) (cbt_drw_pik_c))
  (if (= 5 cbt_drw_dcl_id) (cbt_drw_pik_d))
  (if (= 6 cbt_drw_dcl_id) (cbt_drw_pik_e))
  (if (= 7 cbt_drw_dcl_id) (cbt_drw_pik_f))
  (if (= 8 cbt_drw_dcl_id) (cbt_drw_pik_p))
  (princ)
)

(defun cbt_draw_ok_action ()
  (cbt_draw_writefile)
  (cond
    ((= cn7_dwgunit 1) (setq cbt_fator 0.01 cbt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq cbt_fator 1.0 cbt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq cbt_fator 10.0 cbt_blkscl 1000.0))
  )
  (cond
    ((= cbt_var_tipo "11") (cbt_draw_01))
    ((= cbt_var_tipo "12") (cbt_draw_02))
    ((= cbt_var_tipo "13") (cbt_draw_03))
    ((= cbt_var_tipo "21") (cbt_draw_04))
    ((= cbt_var_tipo "22") (cbt_draw_05))
    ((= cbt_var_tipo "23") (cbt_draw_06))
  )
)


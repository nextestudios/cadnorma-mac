;Desenho de Portas                        
;*****************************************
(defun prt_drw21_porta ()
  (setq prt_porta2 (polar prt_porta1 (+ prt_angortho pi) (* prt_fator (distof prt_pt21_poe)))
	prt_porta3 (polar prt_porta2 prt_angbase prt_larg)
	prt_porta4 (polar prt_porta1 prt_angbase prt_larg)
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline"  "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3 "_non" prt_porta4 "_c")
)


;*****************************************
;Desenho de Caixilho                      
;*****************************************

;caso 01 - porta externa
(defun prt_drw21a_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (if (= prt_pt21_cxi "prt_21_cxi_01")
	(progn
	  (setq prt_cxi1 (polar prt_brk1 (+ prt_angortho pi) (* prt_fator (distof prt_pt21_poe)))
		prt_cxi2 (polar prt_cxi1 prt_angbase prt_caix)
		prt_cxi3 (polar prt_brk3 prt_angbase prt_caix)
		prt_cxi4 (polar prt_brk2 (+ pi prt_angbase) prt_caix)
		prt_cxi5 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
		)
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2  "_non" prt_cxi3  "_non" prt_brk3 ""
		   "._pline"  "_non" prt_brk2 "_non" prt_cxi4  "_non" prt_cxi5 "_non" prt_brk4 ""
          )
	  (setq prt_porta1 (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
		prt_sol_i1 (polar prt_brk1 prt_angbase prt_caix)
		prt_sol_i2 prt_porta1
		prt_sol_e1 prt_cxi3
		prt_sol_e2 prt_cxi5
	  )
	)
	(progn
	  (setq prt_cxi1 (polar prt_brk1 (+ prt_angortho pi) (* prt_fator (distof prt_pt21_poe)))
		prt_cxi2 (polar prt_cxi1 prt_angbase prt_caix)
		prt_cxi3 (polar prt_cxi2 prt_angortho (* prt_fator (distof prt_pt21_poe)))
		prt_cxi4 (polar prt_cxi3 prt_angbase (* prt_fator 2.0))
		prt_cxi5 (polar prt_brk3 prt_angbase (+ prt_caix (* prt_fator 2.0)))
	  )
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2 "_non" prt_cxi3 "_non" prt_cxi4
		   "_non" prt_cxi5 "_non" prt_brk3 "")
	  (setq prt_cxi6 (polar prt_brk2 (+ pi prt_angbase) prt_caix)
		prt_cxi7 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
	  )
	  (command "._pline"  "_non" prt_brk2 "_non" prt_cxi6 "_non" prt_cxi7 "_non" prt_brk4 "")
	  (setq prt_porta1 (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
		prt_sol_i1 prt_cxi4
		prt_sol_i2 prt_porta1
		prt_sol_e1 prt_cxi5
		prt_sol_e2 prt_cxi7
	  )
        )
      )
    )
    ;se o caixilho for nulo
    (progn
	(setq prt_porta1 (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
	      prt_sol_i1 prt_brk1
	      prt_sol_i2 prt_porta1
	      prt_sol_e1 prt_brk3
	      prt_sol_e2 prt_brk4
	)
    )
  )
)

;caixilho para porta interna
(defun prt_drw21b_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (if (= prt_pt21_cxi "prt_21_cxi_01")
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_brk3 prt_angbase prt_caix)
		prt_cxi3 (polar prt_brk5 (+ pi prt_angbase) prt_caix)
		prt_cxi4 (polar prt_brk6 (+ pi prt_angbase) prt_caix)
		prt_cxi5 (polar prt_brk7 (+ pi prt_angbase) prt_caix)
		prt_cxi6 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
		)
	  (command "._pline" "_non" prt_brk1 "_non" prt_cxi1 "_non" prt_cxi2 "_non" prt_brk3 ""
		   "._pline" "_non" prt_brk5 "_non" prt_cxi3 "_non" prt_cxi4 ""
		   "._pline" "_non" prt_brk7 "_non" prt_cxi5 "_non" prt_cxi6 "_non" prt_brk4 ""
          )
	  (setq prt_porta1a (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
		prt_porta1 (polar prt_porta1a prt_angortho (* prt_fator (distof prt_pt21_poe)))
		prt_sol_i1 prt_cxi1
		prt_sol_i2 prt_porta1a
		prt_sol_i3 (polar prt_porta1a prt_angbase prt_larg)
		prt_sol_i4 prt_cxi3
		prt_sol_e1 prt_cxi2
		prt_sol_e2 prt_cxi6
	  )
	)
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_cxi1 prt_angortho (* prt_fator (+ 1.5 (distof prt_pt21_poe))))
		prt_cxi3 (polar prt_cxi2 prt_angbase (* prt_fator 2.0))
		prt_cxi4 (polar prt_brk3 prt_angbase (+ prt_caix (* prt_fator 2.0)))
	  )
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2 "_non" prt_cxi3 "_non" prt_cxi4
		   "_non" prt_brk3 "")
	  (setq prt_cxi5 (polar prt_brk5 (+ pi prt_angbase) prt_caix)
		prt_cxi6 (polar prt_brk6 (+ pi prt_angbase) prt_caix)
		prt_cxi7 (polar prt_brk7 (+ pi prt_angbase) prt_caix)
		prt_cxi8 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
		)
	  (command "._pline" "_non" prt_brk5 "_non" prt_cxi5 "_non" prt_cxi6 ""
		   "._pline" "_non" prt_brk7 "_non" prt_cxi7 "_non" prt_cxi8 "_non" prt_brk4 ""
          )
	  (setq prt_porta1a (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
		prt_porta1 (polar prt_porta1a prt_angortho (* prt_fator (distof prt_pt21_poe)))
		prt_sol_i1 prt_cxi1
		prt_sol_i2 prt_porta1a
		prt_sol_i3 (polar prt_porta1a prt_angbase prt_larg)
		prt_sol_i4 prt_cxi5
		prt_sol_e1 prt_cxi4
		prt_sol_e2 prt_cxi8
	  )
        )
      )
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_porta1a (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
	    prt_porta1 (polar prt_porta1a prt_angortho (* prt_fator (distof prt_pt21_poe)))
	    prt_sol_i1 prt_brk1
	    prt_sol_i2 prt_porta1a
	    prt_sol_i3 (polar prt_porta1a prt_angbase prt_larg)
	    prt_sol_i4 prt_brk5
	    prt_sol_e1 prt_brk3
	    prt_sol_e2 prt_brk4
	  )
    )
  )
)

;openfree especial para porta 21
(defun prt_drw21_openfree ()
  ;conversão de dados para numerais
  (prt_larg_file)
;;;  (setq prt_larg (* prt_fator (distof (nth (fix (distof prt_var_larg)) prt_larg_list))))
  (if (= prt_var_lrad "prt_larg_radio1")
    (setq prt_larg (* prt_fator (distof (nth (fix (distof prt_var_larg)) prt_larg_list))))
    (setq prt_larg (* prt_fator (distof prt_var_lvao)))
  )
  (prt_halt_file)
  (setq prt_halt (* prt_fator (distof (nth (fix (distof prt_var_halt)) prt_halt_list)))
	prt_afas (* prt_fator (distof prt_var_afas))
	prt_wall (* prt_fator (distof prt_var_wall))
	prt_caix (* prt_fator (distof prt_var_caix))
  )
  ;clica na parede
  (prompt "\nSelecione a parede interna...")
  (setq prt_entsel (entsel)
	prt_ent1 (car prt_entsel)
	prt_ent1_type (cdr (assoc 0 (entget prt_ent1)))
	prt_pt0 (nth 0 (cdr prt_entsel))
	prt_ptt1 (cdr (assoc 10 (entget prt_ent1)))
	prt_ptt2 (cdr (assoc 11 (entget prt_ent1)))
	prt_wall_layer (cdr (assoc 8 (entget prt_ent1)))
  )
  (if (/= "LINE" prt_ent1_type)
    (progn
      (alert "A entidade Selecionada não é uma 'LINE'.\nPOLYLINES devem ser explodidas\npara usar este comando...")
      (prt_drw21_openfree)
    )
  )
  (if (<= (distance prt_pt0 prt_ptt1) (distance prt_pt0 prt_ptt2))
    (setq prt_pt1 prt_ptt1 prt_pt2 prt_ptt2 prt_code 1)
    (setq prt_pt1 prt_ptt2 prt_pt2 prt_ptt1 prt_code 2)
  )
  (setq prt_angbase (angle prt_pt1 prt_pt2))
  ;verifica o posicionamento para determinar os pontos de quebra
  (if (= prt_var_posi "prt_center")
    (setq prt_doll (/ (- (distance prt_pt1 prt_pt2) prt_larg (* 2 prt_caix)) 2))
    (setq prt_doll prt_afas)
  )
  (setq
	prt_brk1 (polar prt_pt1 prt_angbase prt_doll)
	prt_brk2 (polar prt_brk1 prt_angbase (+ prt_larg (* 2 prt_caix)))
  )
  (if (= prt_code 1)
    (setq prt_brk3a (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk3b (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
    )
    (setq prt_brk3a (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
  	  prt_brk3b (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
    )
  )
  (if (/= nil (ssget "_f" (list prt_brk3a prt_brk4a) (list (cons 8 prt_wall_layer))))
    (progn
      (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a prt_xcode 1)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 2)
	)
      )
    )
    (progn
      (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b prt_xcode 2)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 4)
	)
      )
    )
  )
  (setq prt_angortho (angle prt_brk1 prt_brk3))
  (command "._undo" "_m")
  (setq colmo (getvar "cecolor"))
  (if (= prt_pt21_pos "prt_21_pos_01")
    (progn
      (command "._break" prt_ent1 "_non" prt_brk1 "_non" prt_brk2)
      (command "._break" (ssget "c" prt_brkm prt_brkm) "_non" prt_brk3 "_non" prt_brk4)
      (command "._layer" "_s" prt_wall_layer "")
      (command "._line" "_non" prt_brk1 "_non" prt_brk3 ""
	       "._line" "_non" prt_brk2 "_non" prt_brk4 "")
    )
    (progn
      (setq prt_brk5 (polar prt_brk2 prt_angbase (+ prt_larg (* 2.0 prt_caix)))
	    prt_brk6 (polar prt_brk5 prt_angortho (* prt_fator (+ 1.5 (distof prt_pt21_poe))))
	    prt_brk7 (polar prt_brk6 (+ prt_angbase pi) (+ prt_larg (* 2.0 prt_caix)))
      )
      (command "._break" prt_ent1 "_non" prt_brk1 "_non" prt_brk5)
      (command "._break" (ssget "c" prt_brkm prt_brkm) "_non" prt_brk3 "_non" prt_brk4)
      (command "._layer" "_s" prt_wall_layer "")
      (command "._line" "_non" prt_brk1 "_non" prt_brk3 ""
	       "._line" "_non" prt_brk5 "_non" prt_brk6 "_non" prt_brk7 "_non" prt_brk4 "")
    )
  )
)



;***********************************
;Porta Tipo 22                      
;Parte 01 - Configuração            
;***********************************
(defun prt_cfg_22 ()
  (prt_pt22_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "prt_cfg_p22" dcl_id)) (exit))
  (set_tile "prt_descr" "Porta Deslizante Dupla ('de Correr')")
  ;slide de tipo
  (setq x (dimx_tile "prt_22_slide")
	y (dimy_tile "prt_22_slide")
  )
  (start_image "prt_22_slide")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_" prt_var_tipo ".sld"))
  (end_image)
  ;espessura da porta
  (set_tile "prt_22_poe_edit" prt_pt22_poe)
  (action_tile "prt_22_poe_edit" "(prt_22_poe_edit_act)")
  (action_tile "prt_22_poe_pick" "(done_dialog 2)")
  ;soleira
  (if (= "1" prt_pt22_soi) (set_tile "prt_22_solint"  "1"))
  (action_tile "prt_22_solint"  "(setq prt_pt22_soi $value)")
  (if (= "1" prt_pt22_soe) (set_tile "prt_22_solext"  "1"))
  (action_tile "prt_22_solext"  "(setq prt_pt22_soe $value)")
  ;alisares
  (if (= "1" prt_pt22_ali) (set_tile "prt_22_aliint"  "1"))
  (action_tile "prt_22_aliint"  "(setq prt_pt22_ali $value)")
  (if (= "1" prt_pt22_ale) (set_tile "prt_22_aliext"  "1"))
  (action_tile "prt_22_aliext"  "(setq prt_pt22_ale $value)")
  ;tipo de posicionamento (interna ou externa)
  (setq x (dimx_tile "prt_22_possld_01")
	y (dimy_tile "prt_22_possld_01")
  )
  (start_image "prt_22_possld_01")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_pos_2201.sld"))
  (end_image)
  (setq x (dimx_tile "prt_22_possld_02")
	y (dimy_tile "prt_22_possld_02")
  )
  (start_image "prt_22_possld_02")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_pos_2202.sld"))
  (end_image)
  (action_tile "prt_22_possld_01" "(prt_22_possld_act)")
  (action_tile "prt_22_possld_02" "(prt_22_possld_act)")
  (cond
    ((= prt_pt22_pos "prt_22_pos_01") (set_tile "prt_22_pos_01" "1"))
    ((= prt_pt22_pos "prt_22_pos_02") (set_tile "prt_22_pos_02" "1"))
  )
  (action_tile "prt_22_pos_01" "(prt_22_pos_act)")
  (action_tile "prt_22_pos_02" "(prt_22_pos_act)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq prt_22_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= prt_22_id 1) (prt_pt22_writefile))
  (if (= prt_22_id 2) (prt_22_poe_button_act))
)

;radio_buttons para posicionamento
(defun prt_22_pos_act ()
  (setq prt_pt22_pos $key)
  (cond
    ((= prt_pt22_pos "prt_22_pos_01")
     (set_tile "prt_22_pos_01" "1")
     (set_tile "prt_22_pos_02" "0")
    )
    ((= prt_pt22_pos "prt_22_pos_02")
     (set_tile "prt_22_pos_01" "0")
     (set_tile "prt_22_pos_02" "1")
    )
  )
)

;slides de tipo de posicionamento
(defun prt_22_possld_act ()
  (setq prt_pt22_possld $key)
  (cond
    ((= prt_pt22_possld "prt_22_possld_01")
     (setq prt_pt22_pos "prt_22_pos_01")
     (set_tile "prt_22_pos_01" "1")
     (set_tile "prt_22_pos_02" "0")
    )
    ((= prt_pt22_possld "prt_22_possld_02")
     (setq prt_pt22_pos "prt_22_pos_02")
     (set_tile "prt_22_pos_01" "0")
     (set_tile "prt_22_pos_02" "1")
    )
  )
)


;Espessura por Pick Points
(defun prt_22_poe_button_act ()
  (prt_pt22_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")
	pt2 (getpoint pt1 "Segundo ponto da espessura da porta...: ")
	poe_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* poe_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* poe_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* poe_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq prt_pt22_poe (rtos new_dist 2 2))
      (prt_pt22_writefile)
    )
  )
  (prt_cfg_22)
)


;verifica se o valor de espessura entrado é válido
(defun prt_22_poe_edit_act ()
  (setq prt_var_newpoe $value)
  (if (distof prt_var_newpoe)
    (progn
      (setq prt_pt22_poe prt_var_newpoe)
      (prt_pt22_writefile)
    )
    (progn
      (alert "Valor Inválido!")
      (set_tile "prt_22_poe_edit" prt_pt22_poe)
      (mode_tile "prt_22_poe_edit" 2)
    )
  )
)  

;lê os dados iniciais da DCL no arquivo de dados
(defun prt_pt22_file ()
  (if (findfile (strcat cnp_root "/config/prt_pt22.txt"))
    (prt_pt22_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/prt_pt22.txt") "w" "utf8"))
      (write-line "3" file)
      (write-line "1" file)
      (write-line "1" file)      
      (write-line "1" file)
      (write-line "1" file)
      (write-line "prt_22_pos_01" file)
      (close file)
      (prt_pt22_readfile)
    )
  )
)


;função que lê o arquivo de dados
(defun prt_pt22_readfile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt22.txt") "r" "utf8"))
  (setq	prt_pt22_poe (read-line file))
  (setq	prt_pt22_soi (read-line file))
  (setq	prt_pt22_soe (read-line file))
  (setq	prt_pt22_ali (read-line file))
  (setq	prt_pt22_ale (read-line file))
  (setq	prt_pt22_pos (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun prt_pt22_writefile ()
  (setq	file (open (strcat cnp_root "/config/prt_pt22.txt") "w" "utf8"))
  (write-line prt_pt22_poe file)
  (write-line prt_pt22_soi file)
  (write-line prt_pt22_soe file)
  (write-line prt_pt22_ali file)
  (write-line prt_pt22_ale file)
  (write-line prt_pt22_pos file)
  (close file)
)

;Desenha a porta
(defun prt_drw22 ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (prt_pt22_file)
  (prt_last_file)
  (prt_layc_file)
  (prt_iden_file)
  (cond
    ((= cn7_dwgunit 1) (setq prt_fator 0.01 prt_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq prt_fator 1.0 prt_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq prt_fator 10.0 prt_blkscl 1000.0))
  )
  ;abre o espaço
  (prt_drw22_openfree)
  (if (= prt_pt22_pos "prt_22_pos_01")
    (prt_drw22a_caixilho)
    (prt_drw22b_caixilho)
  )
  (prt_drw22_porta)
  (prt_drw22_soleira)
  (if (/= 0.0 prt_caix)
    (prt_drw22_alisar)
  )
  (prt_drw22_seta)
  (devolve)
  (prompt "\nUse o comando <UB> para retornar... ")
)

;*****************************************
;Desenho das Setas                        
;*****************************************
(defun prt_drw22_seta ()
  (cn7_verylayer "porta_seta" 1)
  (if (= prt_pt22_pos "prt_22_pos_01")
    (setq prt_seta (polar prt_porta2 prt_angbase (/ prt_larg 2.0))
	  prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 5))
    )
    (setq prt_seta (polar prt_porta1a prt_angbase (/ prt_larg 2.0))
	  prt_seta (polar prt_seta (+ pi prt_angortho) (* prt_fator 5))
    )
  )
  (command "._insert" (strcat cnp_root "/blocos/prt_seta") "_s" prt_blkscl "_non" prt_seta (* 180 (/ prt_angbase pi))
	   "._mirror" (entlast) "" "_non" prt_mid1 "_non" prt_p12_mid2 "_n")
)

;*****************************************
;Desenho das Alisares                     
;*****************************************
(defun prt_drw22_alisar ()
  (cn7_verylayer prt_layc_all 7)
  (setvar "cecolor" prt_layc_alc)
  ;alisares internos
  (if (= "1" prt_pt22_ali)
    ;porta externa
    (if (= prt_pt22_pos "prt_22_pos_02")
      (progn
	(setq prt_ali_a1 (polar prt_cxi1 (+ prt_angbase pi) (* prt_fator 1.0))
	      prt_ali_a2 (polar prt_ali_a1 (+ prt_angortho pi) (* prt_fator 1.0))
	      prt_ali_a3 (polar prt_ali_a2 (+ prt_angbase pi) (* prt_fator 5.0))
	      prt_ali_a4 (polar prt_ali_a3 prt_angortho (* prt_fator 1.0))
	)
	(command "._line" "_non" prt_ali_a1 "_non" prt_ali_a2 "_non" prt_ali_a3 "_non" prt_ali_a4 "")
	(setq prt_ali_b1 (polar prt_cxi5 prt_angbase (* prt_fator 1.0))
	      prt_ali_b2 (polar prt_ali_b1 (+ prt_angortho pi) (* prt_fator 1.0))
	      prt_ali_b3 (polar prt_ali_b2 prt_angbase (* prt_fator 5.0))
	      prt_ali_b4 (polar prt_ali_b3 prt_angortho (* prt_fator 1.0))
	)
	(command "._line" "_non" prt_ali_b1 "_non" prt_ali_b2 "_non" prt_ali_b3 "_non" prt_ali_b4 "")
      )
    )
  )
  ;alisares externos
  (if (= "1" prt_pt22_ale)
      ;porta externa
      (if (= prt_pt22_pos "prt_22_pos_01")
	(progn
	  (setq prt_ale_c1 (polar prt_cxi2 (+ prt_angbase pi) (* 1.0 prt_fator))
		prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	  )
	  (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	  (setq prt_ale_d1 (polar prt_cxi4 prt_angbase (* 1.0 prt_fator))
		prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	  )
	  (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	)
	;porta interna
	(progn
	  (setq prt_ale_c1 (polar prt_cxi4 (+ prt_angbase pi) (* prt_fator 1.0))
		prt_ale_c2 (polar prt_ale_c1 prt_angortho (* prt_fator 1.0))
		prt_ale_c3 (polar prt_ale_c2 (+ prt_angbase pi) (* prt_fator 5.0))
		prt_ale_c4 (polar prt_ale_c3 (+ prt_angortho pi) (* prt_fator 1.0))
	  )
	  (command "._line" "_non" prt_ale_c1 "_non" prt_ale_c2 "_non" prt_ale_c3 "_non" prt_ale_c4 "")
	  (setq prt_ale_d1 (polar prt_cxi8 prt_angbase (* prt_fator 1.0))
		prt_ale_d2 (polar prt_ale_d1 prt_angortho (* prt_fator 1.0))
		prt_ale_d3 (polar prt_ale_d2 prt_angbase (* prt_fator 5.0))
		prt_ale_d4 (polar prt_ale_d3 (+ prt_angortho pi) (* prt_fator 1.0))
	  )
	  (command "._line" "_non" prt_ale_d1 "_non" prt_ale_d2 "_non" prt_ale_d3 "_non" prt_ale_d4 "")
	)
      )
  )
)



;clica em dois pontos = nova largura do degrau
(defun scd13_gethdeg_button ()
  (scd13_last_writefile)
  (setq hdeg_dist nil
	pt1 (getpoint "\nPrimeiro ponto da hdegura... ")
	pt2 (getpoint pt1 "Segundo ponto da hdegura... ")
	hdeg_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* hdeg_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* hdeg_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* hdeg_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq scd13_var_hdeg (rtos new_dist 2 2))
      (scd13_last_writefile)
    )
  )
  (scd13_main)
)


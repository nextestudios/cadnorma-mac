;***********************************
;Porta Tipo 32                      
;Parte 01 - Configuração            
;***********************************
(defun prt_cfg_32 ()
  (prt_pt32_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "prt_cfg_p32" dcl_id)) (exit))
  (set_tile "prt_descr" "Porta de correr tripla, com duas bandeiras fixas.")
  ;slide de tipo
  (setq x (dimx_tile "prt_32_slide")
	y (dimy_tile "prt_32_slide")
  )
  (start_image "prt_32_slide")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/prt_" prt_var_tipo ".sld"))
  (end_image)
  ;espessura da porta
  (set_tile "prt_32_poe_edit" prt_pt32_poe)
  (action_tile "prt_32_poe_edit" "(prt_32_poe_edit_act)")
  (action_tile "prt_32_poe_pick" "(done_dialog 2)")
  ;soleira
  (if (= "1" prt_pt32_soi) (set_tile "prt_32_solint"  "1"))
  (action_tile "prt_32_solint"  "(setq prt_pt32_soi $value)")
  (if (= "1" prt_pt32_soe) (set_tile "prt_32_solext"  "1"))
  (action_tile "prt_32_solext"  "(setq prt_pt32_soe $value)")
  ;alisares
  (if (= "1" prt_pt32_ali) (set_tile "prt_32_aliint"  "1"))
  (action_tile "prt_32_aliint"  "(setq prt_pt32_ali $value)")
  (if (= "1" prt_pt32_ale) (set_tile "prt_32_aliext"  "1"))
  (action_tile "prt_32_aliext"  "(setq prt_pt32_ale $value)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq prt_32_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= prt_32_id 1) (prt_pt32_writefile))
  (if (= prt_32_id 2) (prt_32_poe_button_act))
)

;Espessura por Pick Points
(defun prt_32_poe_button_act ()
  (prt_pt32_writefile)
  (setq poe_dist nil
	pt1 (getpoint "\nPrimeiro ponto da espessura da porta...: ")
	pt2 (getpoint pt1 "Segundo ponto da espessura da porta...: ")
	poe_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* poe_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* poe_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* poe_dist 0.1)))
  )
  (if new_dist
    (progn
      (setq prt_pt32_poe (rtos new_dist 2 2))
      (prt_pt32_writefile)
    )
  )
  (prt_cfg_32)
)


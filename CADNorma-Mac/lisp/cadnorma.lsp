(defun C:TALUDE	(/ Qj)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (cn7_init)
  (cn7_verylayer "Top_talude" 1)
  (setvar "osmode" 0)
  (PRINC
    "\nTipo do talude (R/L/E/A): Rocha sã/rocha aLterada/Escavação/<Aterro>: "
  )
  (SETQ Qj (STRCASE (GETSTRING)))
  (IF (= Qj "")
    (SETQ Qj "A")
  )
  (COND	((= Qj "A") (Q@ "ATERRO"))
	((= Qj "R") (Q@ "ROCHAS"))
	((= Qj "L") (Q@ "ROCHAL"))
	((= Qj "E") (Q@ "ESCAVA"))
	(T (PRINC "\Erro na informação do tipo!"))
  )
  (devolve)
  (PRINC)
)

(DEFUN Q@ (QQ	/    Ql	  Q&   Q1   Q#	 Q0   Q$   QO	Q|   Q%	  Q?j
	   Qjj	Q@j  QQj  Qlj  Q&j  Q1j	 Q#j  Q0j  Q$j	QOj  Q|j  Q%j
	   Q?@	Qj@  Q@@  QQ@  Ql@  Q&@	 Q1@  Q#@
	  )
  (DEFUN Q0@ ()
    (DEFUN Q$@ (QO@) (= (/ (FIX QO@) 2) (/ QO@ 2.0)))
    (COMMAND "._ucs"
	     "_e"
	     Q#@
	     "._line"
	     Q&j
	     Q1j
	     ""
	     "._extend"
	     Q@@
	     ""
	     (LIST (SETQ Ql (ENTLAST)) Q1j)
	     ""
    )
    (SETQ Q& (TRANS (CDR (ASSOC 11 (ENTGET Ql))) 0 1))
    (IF	(AND (/= QQ "ATERRO") (NOT (EQUAL Q1j Q& (* QOj Q?@))))
      (PROGN (SETQ Q1  (POLAR Q& (/ PI -2) (* Q?@ (* 0.5 QOj)))
		   Q#  (POLAR Q& (/ PI -2) (* Q?@ QOj))
		   Q@j (/ Q?@ (ABS Q?@))
		   Q?j (+ (ATAN 0.5) (* Q@j (/ PI 2)))
		   Qjj (+ (- (ATAN 0.5)) (* Q@j (/ PI 2)))
		   Q0  (POLAR Q# Q?j (ABS (* Q?@ (* 2 QOj))))
		   QO  (POLAR Q# Qjj (ABS (* Q?@ (* 2 QOj))))
	     )
	     (command "._line" Q0 Q# "")
	     (SETQ Q% (ENTLAST))
	     (command "._line"
		      QO
		      Q#
		      ""
		      "._trim"
		      (SETQ QQj (ENTLAST))
		      Q@@
		      ""
		      (LIST Ql Q1)
		      (LIST Q% Q0)
		      (LIST QQj QO)
		      ""
	     )
	     (SETQ Q$ (TRANS (CDR (ASSOC 10 (ENTGET Q%))) 0 1))
	     (SETQ Q| (TRANS (CDR (ASSOC 10 (ENTGET QQj))) 0 1))
	     (IF (EQUAL Q0 Q$ 1e-6)
	       (PROGN (PRINC "\nAjustando angulo ")
		      (PRINC Q1@)
		      (SETQ Q?j	(+ (ATAN 0.2) (* Q@j (/ PI 2)))
			    Q0	(POLAR Q# Q?j (ABS (* Q?@ (* 2 QOj))))
		      )
		      (COMMAND "._erase"
			       Q%
			       ""
			       "._line"
			       Q0
			       Q#
			       ""
			       "._trim"
			       Q@@
			       ""
			       (LIST (SETQ Q% (ENTLAST)) Q0)
			       ""
		      )
		      (SETQ Q0 (TRANS (CDR (ASSOC 10 (ENTGET Q%))) 0 1))
	       )
	       (SETQ Q0 Q$)
	     )
	     (IF (EQUAL QO Q| 1e-6)
	       (PROGN (PRINC " Ajustando angulo ")
		      (PRINC Q1@)
		      (SETQ Qjj	(+ (- (ATAN 0.2)) (* Q@j (/ PI 2)))
			    QO	(POLAR Q# Qjj (ABS (* Q?@ (* 2 QOj))))
		      )
		      (COMMAND "._erase"
			       QQj
			       ""
			       "._line"
			       QO
			       Q#
			       ""
			       "._trim"
			       Q@@
			       ""
			       (LIST (SETQ QQj (ENTLAST)) QO)
			       ""
		      )
		      (SETQ QO (TRANS (CDR (ASSOC 10 (ENTGET QQj))) 0 1))
	       )
	       (SETQ QO Q|)
	     )
	     (IF (OR (= QQ "ROCHAS") (AND (= QQ "ROCHAL") (Q$@ Q1@)))
	       (COMMAND "._erase" Q% "" "._solid" Q0 QO Q# "" "")
	     )
      )
    )
    (IF	(Q$@ Q1@)
      (PROGN (SETQ Qlj (LIST 0 (/ (CADR Q&) 2)))
	     (command "._line" (POLAR Qlj 0 -1) (POLAR Qlj 0 1) "")
	     (IF (= QQ "ATERRO")
	       (COMMAND "._trim" (ENTLAST) "" (LIST Ql Q&) "")
	       (IF (NOT (EQUAL Q1j Q& (ABS (* Q?@ 2 QOj))))
		 (COMMAND "._trim" (ENTLAST) "" (LIST Ql (quote (0 0))) "")
	       )
	     )
	     (COMMAND "._erase" (ENTLAST) "")
      )
    )
  )
  (DEFUN Q|@ ()
    (SETQ Q&j (quote (0 0 0))
	  Q1j (POLAR Q&j (* (/ Q?@ (ABS Q?@)) (/ PI 2)) 0.001)
    )
    (command "._line" Q&j Q1j "" "._block" Q%j)
    (IF	(TBLSEARCH "BLOCK" Q%j)
      (COMMAND "_y")
    )
    (COMMAND Q&j (ENTLAST) "")
  )
  (SETQ	Q#j (GETVAR "cmdecho")
	Q0j (GETVAR "blipmode")
  )
  (SETVAR "cmdecho" 0)
  (COMMAND "._undo" "_g" "._ucs" "_d"	"ucsatual" "._ucs" "_s" "ucsatual")
  (SETVAR "blipmode" 0)
  (SETQ	QOj 2
	Q|j (* QOj 3)
	QQ  (STRCASE QQ)
	Q%j "$$$ca$$$"
  )
  (IF (NOT Q%@)
    (SETQ Q%@ 1.0)
  )
  (PRINC "\nFator de escala <")
  (PRINC (ABS Q%@))
  (SETQ Q?@ (GETREAL ">: "))
  (IF (NOT Q?@)
    (SETQ Q?@ Q%@)
    (SETQ Q%@ Q?@)
  )
  (IF (= QQ "ATERRO")
    (SETQ Qj@ (ENTSEL "\nLinha de topo do aterro: ")
	  Q@@ (CAR (ENTSEL "\nLinha de saia do aterro: "))
    )
    (SETQ Q@@ (CAR (ENTSEL "\nLinha de topo do corte: "))
	  Qj@ (ENTSEL "\nLinha de pe' do corte: ")
    )
  )
  (IF (AND Q@@ Qj@)
    (PROGN (SETQ QQ@ (CAR Qj@))
	   (Q|@)
	   (COMMAND "._MEASURE" Qj@ "_B" Q%j "_y" (* Q|j (ABS Q?@)))
	   (SETQ Ql@ (SSGET "p")
		 Q&@ (SSLENGTH Ql@)
		 Q1@ 0
	   )
	   (SETQ Q#@ (SSNAME Ql@ 0))
	   (COMMAND "._undo"
		    "_m"
		    "._ucs"
		    "_e"
		    Q#@
		    "._line"
		    Q&j
		    Q1j
		    ""
		    "._extend"
		    Q@@
		    ""
		    (LIST (SETQ Ql (ENTLAST)) Q1j)
		    ""
	   )
	   (SETQ Q& (TRANS (CDR (ASSOC 11 (ENTGET Ql))) 0 1))
	   (IF (EQUAL Q1j Q& 1e-6)
	     (PROGN (PRINC " Invertendo direcao...")
		    (SETQ Q?@ (* -1 Q?@)
			  Q%@ Q?@
		    )
		    (Q|@)
	     )
	   )
	   (COMMAND "._undo" "_b")
	   (REPEAT Q&@	     (SETQ Q#@ (SSNAME Ql@ Q1@))
	     (Q0@)
	     (SETQ Q1@ (1+ Q1@))
	   )
	   (COMMAND "._erase"   Ql@	""	  "._redraw"  "._ucs"
		    "_r"	      "ucsatual"	  "._ucs"	    "_d"
		    "ucsatual"		"._undo"	  "_e"		   )
    )
    (PRINC
      "\nUma ou ambas as linhas de referência não foram definidas!"
    )
  )
  (SETVAR "blipmode" Q0j)
  (SETVAR "cmdecho" Q#j)
  (PRINC)
)


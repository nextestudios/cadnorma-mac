  (cond
    ((= item_type "1") (cnqt_codify_unit))
    ((= item_type "2") (cnqt_codify_linear))
    ((= item_type "3") (cnqt_codify_area))
    ((= item_type "4") (cnqt_codify_volume))
  )
  (setvar "attdia" attdia_mode)
)


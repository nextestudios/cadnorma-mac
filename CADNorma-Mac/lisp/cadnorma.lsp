;lê os dados iniciais da DCL no arquivo de dados
(defun scd12_last_file ()
  (if (findfile (strcat cnp_root "/config/scd12_last.txt"))
    (scd12_last_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/scd12_last.txt") "w" "utf8"))
      (write-line "100" file)
      (write-line "10" file)
      (write-line "1" file)
      (write-line "1" file)
      (write-line "scd12_vis_02" file)
      (close file)
      (scd12_last_readfile)
    )
  )
)

;função que lê o arquivo de dados

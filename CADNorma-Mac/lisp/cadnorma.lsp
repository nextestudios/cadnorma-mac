  (close open_file)
  ;extrai o subgrupo
  (setq open_file (open (strcat cnp_netroot "/quant/" cnqt_code_grupo cnqt_code_subgrupo ".txt") "r" "utf8"))
  (repeat cnqt_code_subgrupo_n
    (setq subgrupo (read-line open_file))
  )
  (close open_file)
  ;extrai o item
  (setq open_file (open (strcat cnp_netroot "/quant/" cnqt_code_grupo cnqt_code_subgrupo cnqt_code_itemlist ".txt") "r" "utf8"))
  (repeat cnqt_code_item_n
    (setq linha (read-line open_file))
  )
  (close open_file)
  (cnqt_separa_dados)
)


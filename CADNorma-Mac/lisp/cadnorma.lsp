;função Scale - Circle
(defun c:scc ()
  (setq s1 (ssget '((0 . "CIRCLE")))
	s1_len (sslength s1)
	counter 0)
  (initget 128)
  (setq scc_txfactor (getstring "\nReferência/<Fator de Escala>... "))
  (if (not (setq scc_factor (distof scc_txfactor)))
    (progn
      (if (= "R" (strcase scc_txfactor))
	(setq scc_refdist (getdist "\nValor de Referência...: ")
	      scc_newdist (getdist "\nNovo Valor...: ")
	      scc_factor (/ scc_refdist scc_newdist))
	(progn
	  (alert "Valor inválido!\nEntre com o fator de escala,\nou digite 'R' para referência!")
	  (exit)
	)
      )
     )
  )
  (repeat s1_len
    (setq e1 (ssname s1 counter)
	  e1_list (entget e1)
	  e1_radius (cdr (assoc 40 e1_list))
	  e1_list (entmod (subst (cons 40 (* e1_radius scc_factor)) (assoc 40 e1_list) e1_list)))
    (setq counter (1+ counter))
  )
  (princ)
)


;desenho da cobertura tipo 01
;duas águas simples
(defun c:cb1 () (cbt_draw_01))

(defun cbt_draw_01 ()
  (setq ss_hatch (ssadd))
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (cbt_layc_readfile)
  (setq cb1_pt0 (getpoint "\nClique no ponto base...")
	cb1_angbase (getangle cb1_pt0 "\nÂngulo para desenho...")
	cb1_pt1 (polar cb1_pt0 cb1_angbase (* cbt_fator (distof cbt_drw_a)))
	cb1_pt2 (polar cb1_pt1 (+ cb1_angbase (/ pi 2)) (* cbt_fator (distof cbt_drw_b)))
	cb1_pt3 (polar cb1_pt0 (+ cb1_angbase (/ pi 2)) (* cbt_fator (distof cbt_drw_b)))
	cb1_pt3a (polar cb1_pt0 (- cb1_angbase (/ pi 2)) (* cbt_fator (distof cbt_drw_p)))
	cb1_pt4 (polar cb1_pt3a (+ cb1_angbase pi) (* cbt_fator (distof cbt_drw_p)))
	cb1_pt5 (polar cb1_pt4 cb1_angbase (+ (* cbt_fator (distof cbt_drw_a)) (* 2.0 cbt_fator (distof cbt_drw_p))))
	cb1_pt6 (polar cb1_pt5 (+ cb1_angbase (/ pi 2))
		       (+ (* cbt_fator (distof cbt_drw_b)) (* 2.0 cbt_fator (distof cbt_drw_p))))
	cb1_pt7 (polar cb1_pt4 (+ cb1_angbase (/ pi 2))
		       (+ (* cbt_fator (distof cbt_drw_b)) (* 2.0 cbt_fator (distof cbt_drw_p))))
	cb1_pt0a (polar cb1_pt0 cb1_angbase (/ (distance cb1_pt0 cb1_pt1) 2.0))
	cb1_pt8 (polar cb1_pt0a (+ cb1_angbase (/ pi 2)) (* 0.5 cbt_fator (distof cbt_drw_b)))			
  )
  (setq grp_type "2")
  (cn7_find_blkscl)
  ;Desenha a Projeção da Edificação
  (cn7_verylayer cbt_layc_edl 7)
  (setvar "cecolor" cbt_layc_edc)
  (if (not (tblsearch "ltype" "hidden2"))
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
  )
  (setvar "celtype" "hidden2")
  (command "._pline" "_non" cb1_pt0 "_non" cb1_pt1 "_non" cb1_pt2 "_non" cb1_pt3 "_c")
  (cn7_verylayer cbt_layc_cbl 7)
  (setvar "cecolor" cbt_layc_cbc)
  (setvar "celtype" "bylayer")
  (command "._pline" "_non" cb1_pt4 "_non" cb1_pt5 "_non" cb1_pt6 "_non" cb1_pt7 "_c")
  (setq ss_hatch (ssadd (entlast) ss_hatch))
  ;insere a seta
  (if (= cbt_var_dset "1")
    (progn
      (setq cb1_setang (/ (* cb1_angbase 180) pi))
      (command "._insert" (strcat cnp_root "/blocos/cbt_seta_" cbt_var_tset ".dwg")
	       "_s" (* cbt_blkscl (distof cbt_var_fset)) "_non" cb1_pt8 cb1_setang)
      (setq ss_hatch (ssadd (entlast) ss_hatch))
    )
  )
  ;desenha a hachura
  (if (= cbt_var_dhch "1")
    (progn
      (cond
	((= cbt_var_thch "0")
	 (setvar "hpname" "ansi31")
	 (setq cb1_hch_maisang 45
	       cb1_hch_scale 0.25
	 )
	)
	((= cbt_var_thch "1")
	 (setvar "hpname" "telha1")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "2")
	 (setvar "hpname" "telha2")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "3")
	 (setvar "hpname" "telha3")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "4")
	 (setvar "hpname" "telha4")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "5")
	 (setvar "hpname" "telha5")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "6")
	 (setvar "hpname" "telha6")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
	((= cbt_var_thch "7")
	 (setvar "hpname" "telha7")
	 (setq cb1_hch_maisang 0
	       cb1_hch_scale 1.0
	 )
	)
      )
      (cn7_verylayer cbt_layc_hcl 7)
      (setvar "cecolor" cbt_layc_hcc)
      (setvar "celtype" "bylayer")
      (command "._bhatch" "_s" ss_hatch "" "_p" ""
	       (* (distof cbt_var_fhch) cn7_blkscl cb1_hch_scale) ;escala
	       (+ (+ cb1_hch_maisang (/ (* cb1_angbase 180.0) pi)) 90) ; ângulo
	       "_a" "_s" "_o" "" ""
      )
    )
  )
  (devolve)
  (princ)
)


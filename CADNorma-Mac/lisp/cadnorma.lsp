;procedimento inicial para escadas
(defun scd12_start ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setvar "cecolor" "bylayer")
  (scd12_last_file)
  (scd12_layc_file)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cond
    ((= cn7_dwgunit 1) (setq scd12_fator 0.01 scd12_blkscl 1.0))
    ((= cn7_dwgunit 100) (setq scd12_fator 1.0 scd12_blkscl 100.0))
    ((= cn7_dwgunit 1000) (setq scd12_fator 10.0 scd12_blkscl 1000.0))
  )
)

;protótipo: desenho de escada simples
(defun c:sc2 () (scd13_main))

(defun scd13_main ()
  (scd13_start)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd13" dcl_id)) (exit))
  (set_tile "scd13_vis_radio" scd13_var_svis)
  (action_tile "scd13_vis_radio" "(scd13_radio)")
;;;  ;slide
  (scd13_upslide)
  ;largura dos degraus
  (set_tile "scd13_getldeg" scd13_var_ldeg)
  (action_tile "scd13_getldeg" "(scd13_getldeg_action)")
  (action_tile "scd13_pikldeg" "(done_dialog 2)")
  ;altura dos degraus
  (set_tile "scd13_gethdeg" scd13_var_hdeg)
  (action_tile "scd13_gethdeg" "(scd13_gethdeg_action)")
  (action_tile "scd13_pikhdeg" "(done_dialog 3)")
  ;quantidade de degraus
  (set_tile "scd13_getndeg" scd13_var_ndeg)
  (action_tile "scd13_getndeg" "(scd13_getndeg_action)")
  ;espessura da laje
  (set_tile "scd13_getllaj" scd13_var_llaj)
  (action_tile "scd13_getllaj" "(scd13_getllaj_action)")
  (action_tile "scd13_pikllaj" "(done_dialog 4)")
  ;corrimão
  (set_tile "scd13_tog_core" scd13_var_dcor)
  (set_tile "scd13_gethcor" scd13_var_hcor)
  (if (= "0" scd13_var_dcor) (mode_tile "scd13_gethcor" 1))
  (action_tile "scd13_tog_core" "(scd13_togcore_action)")
  (action_tile "scd13_gethcor" "(scd13_gethcor_action)")
  (action_tile "scd13_pikhcor" "(done_dialog 5)")
  ;cores e layers
  (action_tile "scd13_cfglayc" "(done_dialog 6)")
  ;comandos gerais
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;ativação da DCL
  (setq scd13_dcl_id (start_dialog))
  (unload_dialog dcl_id)
  ;ações dos botões
  (if (= 1 scd13_dcl_id) (scd13_ok_action))
  (if (= 2 scd13_dcl_id) (scd13_getldeg_button))
  (if (= 3 scd13_dcl_id) (scd13_gethdeg_button))
  (if (= 4 scd13_dcl_id) (scd13_getllaj_button))
  (if (= 5 scd13_dcl_id) (scd13_gethcor_button))
  (if (= 6 scd13_dcl_id) (scd13_laycol_button))

)


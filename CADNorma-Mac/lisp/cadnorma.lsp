;avalia se o fator entrado é válido para fator de seta
(defun cb1_drw_evalfset ()
  (setq cbt_var_newfset $value)
  (if (distof cbt_var_newfset)
    (setq cbt_var_fset cbt_var_newfset)
    (progn
      (alert "Valor Inválido!\nDigite um número Real.")
      (set_tile "cbt_fat_set" cbt_var_fset)
      (mode_tile "cbt_fat_set" 2)
    )
  )
)


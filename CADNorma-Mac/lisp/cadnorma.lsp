(defun jnl_cobo_drwprj ()
  (if (= jnl_cobo_def "jnl_cobo_radio1")
    (setq jnl_cobo_truqtd (distof jnl_cobo_qtd))
    (setq jnl_cobo_truqtd jnl_cobo_res_qtd)
  )
  (setq jnl_cobo_truesp (* jnl_fator jnl_cobo_res_esp)
	jnl_cobo_truvao (* jnl_fator (distof jnl_cobo_vao))
        jnl_cobo_pt1 jnl_brk1
	jnl_cobo_pt4 jnl_brk3
	jnl_cobo_end1 jnl_brk2
	jnl_cobo_end2 jnl_brk4
  )
  (jnl_test_visible)
  (command "._line" "_non" jnl_brk1 "_non" jnl_brk3 "" "._chprop" (entlast) "" "_s" 0.5 "")
  (command "._line" "_non" jnl_brk2 "_non" jnl_brk4 "" "._chprop" (entlast) "" "_s" 0.5 "")
  (repeat (1- (fix jnl_cobo_truqtd))
    (setq jnl_cobo_pt2 (polar jnl_cobo_pt1 jnl_angbase jnl_cobo_truvao)
	  jnl_cobo_pt3 (polar jnl_cobo_pt2 jnl_angbase jnl_cobo_truesp)
	  jnl_cobo_pt5 (polar jnl_cobo_pt4 jnl_angbase jnl_cobo_truvao)
	  jnl_cobo_pt6 (polar jnl_cobo_pt5 jnl_angbase jnl_cobo_truesp)
    )
    (command "._line" "_non" jnl_cobo_pt2 "_non" jnl_cobo_pt5 "" "._chprop" (entlast) "" "_s" 0.5 "")
    (command "._line" "_non" jnl_cobo_pt3 "_non" jnl_cobo_pt6 "" "._chprop" (entlast) "" "_s" 0.5 "")
    (command "._line" "_non" jnl_cobo_pt1 "_non" jnl_cobo_pt5 "" "._chprop" (entlast) "" "_s" 0.5 "")
    (command "._line" "_non" jnl_cobo_pt4 "_non" jnl_cobo_pt2 "" "._chprop" (entlast) "" "_s" 0.5 "")
    (setq jnl_cobo_pt1 jnl_cobo_pt3
	  jnl_cobo_pt4 jnl_cobo_pt6
    )
  )
  (command "._line" "_non" jnl_cobo_pt6 "_non" jnl_brk2 "" "._chprop" (entlast) "" "_s" 0.5 "")
  (command "._line" "_non" jnl_cobo_pt3 "_non" jnl_brk4 "" "._chprop" (entlast) "" "_s" 0.5 "")
)


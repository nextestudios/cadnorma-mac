;Soma Textos
(defun c:soma ()
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq cn7_dzin (getvar "dimzin"))
  (prompt "\nSelecione os textos a serem somados...")
  (setq s1 (ssget '((0 . "TEXT"))))
  (if (not txt_dec)
    (progn
      (setq txt_dec (getint "\nNúmero de casas decimais do resultado...< 0 >..."))
      (if (= nil txt_dec) (setq txt_dec 0))
    )
    (progn
      (setq txt_dec_new (getint (strcat "\nNúmero de casas decimais do resultado...< " (rtos txt_dec 2 0) " >...")))
      (if (/= txt_dec_new nil) (setq txt_dec txt_dec_new))
    )
  )
  (setvar "dimzin" 1)
  (setq s1_len (sslength s1) counter 0 txt_soma 0.00)
  (repeat s1_len
    (setq curr_ent (ssname s1 counter))
    (if (distof (cdr (assoc 1 (entget curr_ent))))
      (progn
	(setq txt_soma (+ txt_soma (distof (cdr (assoc 1 (entget curr_ent))))))
	(setq counter (1+ counter))
      )
      (setq counter (1+ counter))
    )
  );repeat
  (prompt (strcat "Soma = " (rtos txt_soma 2 2)))
  (initget 1 "Escrever Modificar")
  (setq resp (getkword "\nEscrever ou Modificar texto existente ? <E ou M> "))
  (if (= resp "Escrever")
    (progn
      (cn7_getstyle)
      (cn7_text_hfinal)
      (cn7_text_height)
      (setq psimb_txt (getpoint "\nPonto de Inserção..."))
      (cn7_txsimb cn7_txtsty "_bl" (rtos txt_soma 2 txt_dec) getsty_col getsty_lay 0)
    );progn
    (progn
      (princ "Selecione o texto a receber o resultado...")
      (setq ent2 (entsel))
      (setq new (cons 1 (rtos txt_soma 2 txt_dec)))
      (entmod (subst new (assoc 1 (entget (car ent2))) (entget (car ent2))))
    );progn
  );if
  (devolve)
  (princ)
)


;contar blocos
(defun c:bkc ()
  (prompt "\nSelecione o bloco de referência...")
  (setq ent (car (entsel))
	ent_list (entget ent)
	ent_type (cdr (assoc 0 ent_list))
  )
  (if (/= "INSERT" ent_type)
    (progn
      (alert "A entidade selecionada não é um bloco!")
      (quit)
    )
    (progn
      (setq blk_name (cdr (assoc 2 ent_list))
	    s1 (ssget "_x" '((0 . "INSERT")))
	    s1_len (sslength s1)
	    counter 0
      )
      (setq s2 (ssadd)
	    s3 (ssadd)
	    s4 (ssadd)
      )
      (repeat s1_len
	(setq ent (ssname s1 counter)
	      ent_blkname (cdr (assoc 2 (entget ent)))
	)
	(if (= ent_blkname blk_name)
	  (setq s2 (ssadd ent s2))
	)
	(setq counter (1+ counter))
      )
    )
  )
  (setq s2_len (sslength s2))
  (cn7_alert_yes_no
    "Número total de blocos no desenho:"
    (rtos s2_len 2 0)
    "Deseja quantificar uma área específica?"
  )
  (if (= alert_resp "yes")
    (progn
      (prompt "\nSelecione a área a quantificar...")
      (setq s3 (ssget '((0 . "INSERT")))
	    s3_len (sslength s3)
	    counter 0
      )
      (repeat s3_len
	(setq ent (ssname s3 counter)
	      ent_blkname (cdr (assoc 2 (entget ent)))
	)
	(if (= ent_blkname blk_name)
	  (setq s4 (ssadd ent s4))
	)
	(setq counter (1+ counter))
      )
      (setq s4_len (sslength s4))
      (cn7_alert_ok
	(strcat "Total de blocos no desenho: " (rtos s2_len 2 0))
	""
	(strcat "Número de blocos na área selecionada: " (rtos s4_len 2 0))
      )
    )
  )
  (princ)
)


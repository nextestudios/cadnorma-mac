;dado o código (cnqt_code), separa os dados discriminados
(defun cnqt_define_data ()
  (setq cnqt_code_grupo (substr cnqt_code 1 6)
	cnqt_code_subgrupo (substr cnqt_code 7 2)
	cnqt_code_itemlist (substr cnqt_code 9 2)
	cnqt_code_item (substr cnqt_code 11)
	cnqt_code_grupo_n (1+ (fix (distof cnqt_code_subgrupo)))
	cnqt_code_subgrupo_n (1+ (fix (distof cnqt_code_itemlist)))
	cnqt_code_item_n (1+ (fix (distof cnqt_code_item)))
  )
  ;extrai o grupo
  (setq open_file (open (strcat cnp_netroot "/quant/" cnqt_code_grupo ".txt") "r" "utf8"))

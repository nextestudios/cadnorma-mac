)

(defun cn7_wrtext ()
  (if (not (tblsearch "style" cn7_txtsty))
    (progn
      (cn7_alert_ok
	"O estilo solicitado não existe!"
	"Digite <CFG> para configurar o desenho!"
	"")
      (exit)
    )
    (cn7_do_writext)
  )
)

;escreve efetivamente o texto
(defun cn7_do_writext ()
  (cond
    ((= cn7_txtsty "r50") (setq cn7_txlay (strcat cn7_prefixlay "txt_r50") cn7_txcol 1))
    ((= cn7_txtsty "r60") (setq cn7_txlay (strcat cn7_prefixlay "txt_r60") cn7_txcol 1))
    ((= cn7_txtsty "r70") (setq cn7_txlay (strcat cn7_prefixlay "txt_r70") cn7_txcol 2))
    ((= cn7_txtsty "r80") (setq cn7_txlay (strcat cn7_prefixlay "txt_r80") cn7_txcol 2))
    ((= cn7_txtsty "r90") (setq cn7_txlay (strcat cn7_prefixlay "txt_r90") cn7_txcol 3))
    ((= cn7_txtsty "r100") (setq cn7_txlay (strcat cn7_prefixlay "txt_r100") cn7_txcol 3))
    ((= cn7_txtsty "r120") (setq cn7_txlay (strcat cn7_prefixlay "txt_r120") cn7_txcol 4))
    ((= cn7_txtsty "r140") (setq cn7_txlay (strcat cn7_prefixlay "txt_r140") cn7_txcol 5))
    ((= cn7_txtsty "r175") (setq cn7_txlay (strcat cn7_prefixlay "txt_r175") cn7_txcol 6))
    ((= cn7_txtsty "r200") (setq cn7_txlay (strcat cn7_prefixlay "txt_r200") cn7_txcol 6))
  )
  (prompt "\nMarque o ponto inicial do texto...")
  (if (= cdn_txt 1)
    (cn7_verylayer cn7_txlay cn7_txcol)
  )	
  (txt_final_write)
)
    
(defun txt_final_write ()
  (initget 128)
  (setq resp (getpoint "\nCenter/Middle/Right/<Marque o Ponto>: "))
  (cond
    ((= 'LIST (type resp))
     (command "._dtext" "_s" cn7_txtsty "_non" resp cn7_txth))
    ((= 'STR  (type resp))
     (cond
       ((= "C" (strcase resp))
	(setq ptx (getpoint "\nMarque o ponto Central do texto..."))
	(command "._dtext" "_s" cn7_txtsty "c" "_non" ptx cn7_txth))
       ((= "M" (strcase resp))
	(setq ptx (getpoint "\nMarque o ponto Middle do texto..."))
	(command "._dtext" "_s" cn7_txtsty "m" "_non" ptx cn7_txth))
       ((= "R" (strcase resp))
	(setq ptx (getpoint "\nMarque o ponto Central do texto..."))
	(command "._dtext" "_s" cn7_txtsty "r" "_non" ptx cn7_txth))
       (t
	(prompt "Opção inválida! Escolha um ponto ou um alinhamento válido...")
	(exit))
     );cond
   )
  )
  (princ)
)



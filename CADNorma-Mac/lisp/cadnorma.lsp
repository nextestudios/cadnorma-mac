;ao clicar no toggle de corrimão
(defun scd13_togcore_action ()
  (setq scd13_var_dcor $value)
  (if (= "0" scd13_var_dcor)
    (mode_tile "scd13_gethcor" 1)
    (progn
      (mode_tile "scd13_gethcor" 0)
      (mode_tile "scd13_gethcor" 2)
    )
  )
)

;desenha a escada descendo
(defun scd13_draw_01 ()
  (command "._undo" "_m")
  (scd13_last_writefile)
  (setvar "orthomode" 1)
  (setq scd13_pt0 (getpoint "\nClique no ponto inicial da escada... ")
	scd13_dir (getangle scd13_pt0 "\nLado para desenhar...")
  )
  ;calcula o deslocamento do ponto na laje
  (setq hip (sqrt (+ (expt (* scd13_fator (distof scd13_var_ldeg)) 2)
		     (expt (* scd13_fator (distof scd13_var_hdeg)) 2)))
	dx (/ (* scd13_fator (distof scd13_var_llaj) hip)
	      (* scd13_fator (distof scd13_var_hdeg))
	  )
  )
  ;desenha o primeiro degrau
  (setq scd13_pt1 scd13_pt0
	scd13_pt2 (polar scd13_pt1 (/ pi 2) (* scd13_fator (distof scd13_var_hdeg)))
	scd13_pt3 (polar scd13_pt2 scd13_dir (* scd13_fator (distof scd13_var_ldeg)))
	scd13_pc1 (polar scd13_pt2 scd13_dir (* scd13_fator 5.0))
	scd13_pl1 (polar scd13_pt1 scd13_dir dx)
  )
  ;atualiza o layer,para vista e projeção
  (if (= "scd13_vis_01" scd13_var_svis)
    (progn
      (cn7_verylayer scd13_layc_dvl 7)
      (setvar "cecolor" scd13_layc_dvc)
      (setvar "celtype" "bylayer")
    )
    (progn
      (cn7_verylayer scd13_layc_dpl 7)
      (setvar "cecolor" scd13_layc_dpc)
      (if (not (tblsearch "ltype" "hidden2"))
	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
	(command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
      )
      (setvar "celtype" "hidden2")
    )
  )
  (command "._line" "_non" scd13_pt1 "_non" scd13_pt2 "_non" scd13_pt3 "")
  (repeat (- (fix (distof scd13_var_ndeg)) 2)
    (setq scd13_pt1 scd13_pt3
	  scd13_pt2 (polar scd13_pt1 (/ pi 2) (* scd13_fator (distof scd13_var_hdeg)))
	  scd13_pt3 (polar scd13_pt2 scd13_dir (* scd13_fator (distof scd13_var_ldeg)))
    )
    (command "._line" "_non" scd13_pt1 "_non" scd13_pt2 "_non" scd13_pt3 "")
  )
  (setq scd13_pt1 scd13_pt3
	scd13_pt2 (polar scd13_pt1 (/ pi 2) (* scd13_fator (distof scd13_var_hdeg)))
	scd13_pt3 (polar scd13_pt2 scd13_dir (* scd13_fator (distof scd13_var_ldeg)))
  )
  (command "._line" "_non" scd13_pt1 "_non" scd13_pt2 "")
  (setq scd13_pl2 (polar scd13_pt1 scd13_dir dx))
  (command "._line" "_non" scd13_pl1 "_non" scd13_pl2 "")
  ;desenha o corrimão
  (if (= scd13_var_dcor "1")
    (progn
      (setq scd13_pc2 (polar scd13_pt2 scd13_dir (* scd13_fator 5.0))
	    scd13_pc3 (polar scd13_pc1 (/ pi 2) (* scd13_fator (distof scd13_var_hcor)))
	    scd13_pc4 (polar scd13_pc2 (/ pi 2) (* scd13_fator (distof scd13_var_hcor)))
      )
      (if (= "scd13_vis_01" scd13_var_svis)
        (progn
          (cn7_verylayer scd13_layc_crl 7)
          (setvar "cecolor" scd13_layc_crc)
          (setvar "celtype" "bylayer")
        )
        (progn
          (cn7_verylayer scd13_layc_dpl 7)
          (setvar "cecolor" scd13_layc_dpc)
          (if (not (tblsearch "ltype" "hidden2"))
	    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "")
	    (command "._linetype" "_l" "hidden2" (strcat cnp_root "/modelos/cadnorma.lin") "_y" "")
          )
          (setvar "celtype" "hidden2")
        )
      )
      (command "._line" "_non" scd13_pc1 "_non" scd13_pc3 "_non" scd13_pc4 "_non" scd13_pc2 "")
    )
  )
  (devolve)
  (prompt "\nDitite <UB> para retornar...")
  (princ)
)

;ao escolher um radio_button
(defun scd13_radio ()
  (setq scd13_var_svis $value)
  (scd13_upslide)
)

;atualização do Slide pelo radio_button escolhido
(defun scd13_upslide ()
  (cond
    ((= scd13_var_svis "scd13_vis_01")
     (setq scd13_type 1)
     (setq x (dimx_tile "scd_13_slide")
	   y (dimy_tile "scd_13_slide"))
     (start_image "scd_13_slide")
     (fill_image 0 0 x y -2)
     (slide_image 0 0 x y (strcat cnp_root "/slides/scd3_11.sld"))
     (end_image)
    )
    ((= scd13_var_svis "scd13_vis_02")
     (setq scd13_type 2)
     (setq x (dimx_tile "scd_13_slide")
	   y (dimy_tile "scd_13_slide"))
     (start_image "scd_13_slide")
     (fill_image 0 0 x y -2)
     (slide_image 0 0 x y (strcat cnp_root "/slides/scd3_12.sld"))
     (end_image)
    )
  )
)   

;***********************************
;Configuração de Cores e Layers     
;***********************************
(defun scd13_laycol_button ()
  (scd13_last_writefile)
  (scd13_layc_file)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "scd13_cfglayc" dcl_id)) (exit))
  ;degraus em vista
  (set_tile "scd13_layc_dvl" scd13_layc_dvl)
  (action_tile "scd13_layc_dvl" "(setq scd13_layc_dvl $value)")
  (start_image "scd13_layc_dvc")
  (fill_image  0  0
    (dimx_tile "scd13_layc_dvc")
    (dimy_tile "scd13_layc_dvc")
    (fix (distof scd13_layc_dvc))
  )
  (end_image)
  (action_tile "scd13_layc_dvc" "(scd13_layc_dvc_color)")
  ;degraus em projeção
  (set_tile "scd13_layc_dpl" scd13_layc_dpl)
  (action_tile "scd13_layc_dpl" "(setq scd13_layc_dpl $value)")
  (start_image "scd13_layc_dpc")
  (fill_image  0  0
    (dimx_tile "scd13_layc_dpc")
    (dimy_tile "scd13_layc_dpc")
    (fix (distof scd13_layc_dpc))
  )
  (end_image)
  (action_tile "scd13_layc_dpc" "(scd13_layc_dpc_color)")
  ;Corrimão
  (set_tile "scd13_layc_crl" scd13_layc_crl)
  (action_tile "scd13_layc_crl" "(setq scd13_layc_crl $value)")
  (start_image "scd13_layc_crc")
  (fill_image  0  0
    (dimx_tile "scd13_layc_crc")
    (dimy_tile "scd13_layc_crc")
    (fix (distof scd13_layc_crc))
  )
  (end_image)
  (action_tile "scd13_layc_crc" "(scd13_layc_crc_color)")
  ;ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  ;start_dialog
  (setq scd13_layc_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= scd13_layc_id 1)
    (progn
      (scd13_layc_writefile)
      (scd13_main)
    )
  )
  (if (= scd13_layc_id 0) (scd13_main))
)


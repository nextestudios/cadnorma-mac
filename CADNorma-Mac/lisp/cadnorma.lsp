;lê os dados iniciais da DCL no arquivo de dados
(defun jnl_cobo_file ()
  (if (findfile (strcat cnp_root "/config/jnl_cobo.txt"))
    (jnl_cobo_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/jnl_cobo.txt") "w" "utf8"))
      (write-line "10" file)
      (write-line "jnl_cobo_radio1" file)
      (write-line "10" file)
      (write-line "50" file)
      (write-line "jnl_cobo_vista" file)
      (close file)
      (jnl_cobo_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun jnl_cobo_readfile ()
  (setq	file (open (strcat cnp_root "/config/jnl_cobo.txt") "r" "utf8"))
  (setq	jnl_cobo_vao (read-line file))
  (setq	jnl_cobo_def (read-line file))
  (setq	jnl_cobo_qtd (read-line file))
  (setq	jnl_cobo_pct (read-line file))
  (setq	jnl_cobo_vis (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun jnl_cobo_writefile ()
  (setq	file (open (strcat cnp_root "/config/jnl_cobo.txt") "w" "utf8"))
  (write-line jnl_cobo_vao file)
  (write-line jnl_cobo_def file)
  (write-line jnl_cobo_qtd file)
  (write-line jnl_cobo_pct file)
  (write-line jnl_cobo_vis file)
  (close file)
)


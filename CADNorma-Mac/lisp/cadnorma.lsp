;arquivo de configurações das notas
(defun nog_cfg_file ()
  (if (findfile (strcat cnp_root "/config/nog_cfgn.txt"))
    (nog_cfg_readfile)
    (progn
      (setq file (open (strcat cnp_netroot "/config/nog_cfgn.txt") "w" "utf8"))
      (write-line "Notas_gerais" file)
      (write-line "NOTAS GERAIS" file)
      (write-line "7" file)
      (write-line "6" file)
      (write-line "5" file)
      (write-line "3" file)
      (close file)
      (nog_cfg_readfile)
    )
  )
)


;escreve o arquivo de dados
(defun nog_cfg_writefile ()
  (setq file (open (strcat cnp_root "/config/nog_cfgn.txt") "w" "utf8"))
  (write-line nogcfg_alllay file)
  (write-line nogcfg_tittxt file)
  (write-line nogcfg_titsty file)
  (write-line nogcfg_titcol file)
  (write-line nogcfg_notsty file)
  (write-line nogcfg_notcol file)
  (close file)
)


;função que lê o arquivo de dados
(defun nog_cfg_readfile ()
  (setq	file (open (strcat cnp_root "/config/nog_cfgn.txt") "r" "utf8"))
  (setq	nogcfg_alllay (read-line file))
  (setq	nogcfg_tittxt (read-line file))
  (setq	nogcfg_titsty (read-line file))
  (setq	nogcfg_titcol (read-line file))
  (setq	nogcfg_notsty (read-line file))
  (setq	nogcfg_notcol (read-line file))
  (close file)
)

;botão 'Nova' - cria mais uma nota
(defun nog_new_action ()
  (setq nog_register (rtos (+ 1 (distof nog_totnotes)) 2 0)
	nog_linha1 (strcat "NOTA " nog_register)
	nog_linha2 ""
	nog_linha3 ""
	nog_linha4 ""
	nog_linha5 ""
  )
  (setq nog_file (strcat cnp_netroot "/notas/cnng" nog_famcode nog_register ".txt"))
  (nog_save_file)
  (nog_conta_notas)
  (nog_read_file)
  (nog_updlines)
  (set_tile "nog_current_note" nog_register)
  (nog_nextprev)
)


;verifica se é o último ou ou primeiro registro
(defun nog_nextprev ()
  (if (= "1" nog_register)
    (mode_tile "nog_prev" 1)
    (mode_tile "nog_prev" 0)
  )
  (if (= nog_totnotes nog_register)
    (mode_tile "nog_next" 1)
    (mode_tile "nog_next" 0)
  )
)

;ação do botão 'Próxima'
(defun nog_next_action ()
  (nog_save_file)
  (setq nog_register (rtos (+ 1 (distof nog_register)) 2 0))
  (setq nog_file (strcat cnp_netroot "/notas/cnng" nog_famcode nog_register ".txt"))
  (nog_read_file)
  (nog_updlines)
  (set_tile "nog_current_note" nog_register)
  (nog_nextprev)
)

;ação do botão 'Anterior'
(defun nog_prev_action ()
  (nog_save_file)
  (setq nog_register (rtos (- (distof nog_register) 1) 2 0))
  (setq nog_file (strcat cnp_netroot "/notas/cnng" nog_famcode nog_register ".txt"))
  (nog_read_file)
  (nog_updlines)
  (set_tile "nog_current_note" nog_register)
  (nog_nextprev)
)


;conta a quantidade de notas existentes para a família selecionada
(defun nog_conta_notas ()
  (setq counter 1)
  (while (findfile (strcat cnp_netroot "/notas/cnng" nog_famcode (rtos counter 2 0) ".txt"))
    (setq counter (1+ counter))
  )
  (setq counter (1- counter)
	nog_totnotes (rtos counter 2 0)
  )
  (set_tile "nog_total_notes" (rtos counter 2 0))
)


;atualiza as linhas da nota atual
(defun nog_updlines ()
  (set_tile "nog_linha1" nog_linha1)
  (set_tile "nog_linha2" nog_linha2)
  (set_tile "nog_linha3" nog_linha3)
  (set_tile "nog_linha4" nog_linha4)
  (set_tile "nog_linha5" nog_linha5)
)


;grava o arquivo de notas atual
(defun nog_save_file ()
  (setq open_nog_file (open nog_file "w" "utf8"))
  (write-line nog_linha1 open_nog_file)
  (write-line nog_linha2 open_nog_file)
  (write-line nog_linha3 open_nog_file)
  (write-line nog_linha4 open_nog_file)
  (write-line nog_linha5 open_nog_file)
  (close open_nog_file)
)

;lê o arquivo de notas atual
(defun nog_read_file ()
  (if (findfile nog_file)
    (setq open_nog_file (open nog_file "r" "utf8")
	  nog_linha1 (read-line open_nog_file)
	  nog_linha2 (read-line open_nog_file)
	  nog_linha3 (read-line open_nog_file)
	  nog_linha4 (read-line open_nog_file)
	  nog_linha5 (read-line open_nog_file)
    )
    (close open_nog_file)
  )
)

;define o código da família
(defun nog_pop_action ()
  (nog_save_file)
  (setq nog_family $value)
  (setq nog_register "1")
  (if (= 1 (strlen nog_family))
    (setq nog_famcode (strcat "0" nog_family))
    (setq nog_famcode nog_family)
  )
  (setq nog_file (strcat cnp_netroot "/notas/cnng" nog_famcode nog_register ".txt"))
  (nog_read_file)
  (nog_updlines)
  (nog_conta_notas)
  (nog_nextprev)
  (set_tile "nog_current_note" nog_register)
)



;escrita de texto - Carburador
(defun cn7_wrtext1 (n)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq cn7_txtsty n)
  (cn7_text_hfinal)
  (cn7_text_height)
  (cn7_wrtext)

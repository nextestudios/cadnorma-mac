;escalas blocos
(defun c:blks ()
  (prompt "\nAplicar 'Scale' nos blocos selecionados...")
  (initget "Exemplo Nome Todos")
  (setq resp (getkword "\nSelecionar blocos por Exemplo/Nome/Todos...<E/N/T>..."))
  (cond
    ((= resp "Exemplo") (scl_blk_sample))
    ((= resp "Nome") (scl_blk_name))
    ((= resp "Todos") (scl_blk_all))
  )
  (princ)
)

;***** Seleciona por um exemplo

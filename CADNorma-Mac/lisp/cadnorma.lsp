;converter escala
(defun c:cve ()
  (command "._undo" "_m")
  (setq key "convert")
  (cve_init)
  (prompt "\nDigite <UB> para voltar...")
  (princ)
)

;copiar para escala
(defun c:cpe ()
  (command "._undo" "_m")
  (setq cts_newscale nil)
  (if (= (getvar "tilemode") 0)
    (progn
      (alert "Operação só permitida\nno Model Space!")
      (quit)
    )
  )
  (setq cts_newscale (getint "\nEscala para cópia = 1: "))
  (if (= nil cts_newscale) (quit))
  (setq key "copy")
  (cve_init)
  (prompt "\nDigite <UB> para voltar...")
  (princ)
)

  

;conversão de escalas
;só permitida na viewport e no Model Pleno, não no Paper
(defun cve_init ()
  (if (and (= (getvar "tilemode") 0) (= (getvar "cvport") 1))
    (progn
      (alert "Operação só permitida\nno Model Space ou na Viewport!")
      (quit)
    )
  )
  (setq cn7_upscale_id nil)
  (cn7_init)
  ;define a escala final de conversão
  (if (= (getvar "tilemode") 1);se está no Model
    (progn
      (setq grp_type "2")
      (cn7_find_blkscl)
      (if (= nil cn7_msscl) (cn7_esc))
    )
    (progn			;se está na Viewport
      (cn7_vport_scl)
      (setq cn7_msscl cn7_vp_scale)
    )
  )
  (setq cve_newscl cn7_msscl)


  ;abre a caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_upscale" dcl_id)) (exit))

  ;define Model ou Viewport. Edit_box em grayout
  (if (= key "convert")
    (set_tile "cn7_cve_newscl" (strcat "Convertendo para Escala 1: "  (rtos cve_newscl 2 0)))
    (set_tile "cn7_cve_newscl" (strcat "Copiando para Escala 1: "  (rtos cts_newscale 2 0)))
  )
  (setq upscale_txt "1")
  (set_tile "cn7_upscale_txt" "1")
  (action_tile "cn7_upscale_txt" "(setq upscale_txt $value)")
  (setq upscale_dim "1")
  (set_tile "cn7_upscale_dim" "1")
  (action_tile "cn7_upscale_dim" "(setq upscale_dim $value)")
  (setq upscale_blk "1")
  (set_tile "cn7_upscale_blk" "1")
  (action_tile "cn7_upscale_blk" "(setq upscale_blk $value)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq cn7_upscale_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= cn7_upscale_id 1)
    (progn
      (cn7_cve_seleciona)
      (if (/= nil cve_sel)
	(if (= key "convert")
	  (progn
	    (cn7_cve_separa)
	    (cn7_cve_heart)
	  )
	  (progn
	    (setq old_msscl cn7_msscl)
	    (setq cn7_msscl cts_newscale)
	    (cn7_cve_separa)
	    (cts_select)
	    (command "._copy" cts_selection "" "_non" "0,0,0" "")
	    (cn7_cve_heart)
	    (setq cn7_msscl old_msscl)
	  )
	)
      )
    )
  )
  (princ)
)


;seleciona as entidades a serem copiadas para outra escala
(defun cts_select ()
  (setq counter 0 cts_selection (ssadd))
  (if (/= nil cve_txtlist)
    (progn
      (setq n_list (length cve_txtlist))
      (repeat n_list
	(ssadd (nth counter cve_txtlist) cts_selection)
	(setq counter (1+ counter))
      )
    )
  )
  (setq counter 0)
  (if (/= nil cve_dimlist)
    (progn
      (setq n_list (length cve_dimlist))
      (repeat n_list
	(ssadd (nth counter cve_dimlist) cts_selection)
	(setq counter (1+ counter))
      )
    )
  )
  (setq counter 0)
  (if (/= nil cve_blklist)
    (progn
      (setq n_list (length cve_blklist))
      (repeat n_list
	(ssadd (nth counter cve_blklist) cts_selection)
	(setq counter (1+ counter))
      )
    )
  )
  (setq counter 0)
  (if (/= nil cve_xxxlist)
    (progn
      (setq n_list (length cve_xxxlist))
      (repeat n_list
	(ssadd (nth counter cve_xxxlist) cts_selection)
	(setq counter (1+ counter))
      )
    )
  )
)

;seleção de entidades
(defun cn7_cve_seleciona ()
  (prompt "\nSelecione o trecho do desenho a ser convertido...")
  (setq cve_sel (ssget))
)

;cria 03 listas, com textos, cotas e blocos separados
(defun cn7_cve_separa ()
  (setq cve_txtlist (list " ")
	cve_dimlist (list " ")
	cve_blklist (list " ")
	cve_xxxlist (list " ")
	n_element (sslength cve_sel)
	counter 0)
  (repeat n_element
    (setq s1_ent (ssname cve_sel counter))
    (setq ent_list (entget s1_ent))
    (if	(= (strcase (cdr (assoc 0 ent_list))) "TEXT")
      (setq cve_txtlist (append cve_txtlist (list s1_ent)))
      (if (= (strcase (cdr (assoc 0 ent_list))) "DIMENSION")
	(setq cve_dimlist (append cve_dimlist (list s1_ent)))
	(if (= (strcase (cdr (assoc 0 ent_list))) "INSERT")
	  (setq cve_blklist (append cve_blklist (list s1_ent)))
	  (cve_ent_verylayer)
        )
      )
    )
    (setq counter (1+ counter))
  )
  (setq cve_txtlist (cdr cve_txtlist)
	cve_dimlist (cdr cve_dimlist)
	cve_blklist (cdr cve_blklist)
	cve_xxxlist (cdr cve_xxxlist)
  )
)



;lê os dados iniciais da DCL no arquivo de dados
(defun scd12_layc_file ()
  (if (findfile (strcat cnp_root "/config/scd12_layc.txt"))
    (scd12_layc_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/scd12_layc.txt") "w" "utf8"))
      (write-line "Escada" file)
      (write-line "3" file)
      (write-line "Escada" file)
      (write-line "3" file)
      (write-line "Escada" file)
      (write-line "1" file)
      (write-line "Escada" file)
      (write-line "1" file)
      (close file)
      (scd12_layc_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun scd12_layc_readfile ()

;lê o arquivo com a última escala utilizada para desenhos novos
;e escalas não definidas
(defun cn7_esc_file ()
  (if (not (findfile (strcat cnp_root "/config/esc_last.txt")))
    (progn
      (setq open_file (open (strcat cnp_root "/config/esc_last.txt") "w" "utf8"))
      (write-line "100" open_file)
    )
  )
  (setq open_file (open (strcat cnp_root "/config/esc_last.txt") "r" "utf8")
	cn7_get_msscl (read-line open_file)
  )
  (close open_file)
  (if (= nil cn7_get_msscl)
    (setq cn7_get_msscl "50.00"
	  cn7_msscl (distof cn7_get_msscl)
    )
  )
  (if (distof cn7_get_msscl)
    (setq cn7_msscl (distof cn7_get_msscl))
    (progn
      (setq cn7_msscl 50.00
	    cn7_get_msscl "50.00"
      )
    )
  )
  (setvar "userr3" cn7_msscl)
  (setq cn7_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
)

;Mostra e/ou altera a escala do model
(defun cn7_esc ()
  (setq cn7_get_msscl nil)
  (if (= 0 (getvar "tilemode"));(and (= 0 (getvar "tilemode")) (= (getvar "cvport") 1))
    (progn
      (alert "Esta operação só é permitida\nno Model Space!")
      (exit)
    )
  )
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_defesc" dcl_id)) (exit))
  (if (or (= 0.0 cn7_msscl) (= nil cn7_msscl))
    (cn7_esc_file)    
  )
  (set_tile "cn7_defesc_esc_atual" (strcat "Escala Atual = 1: " (rtos cn7_msscl 2 2)))
  (set_tile "cn7_defesc_esc_nova" (rtos cn7_msscl 2 2))
  (mode_tile "cn7_defesc_esc_nova" 2)
  (action_tile "cn7_defesc_esc_nova" "(cn7_defesc_veryget)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq cn7_esc_resp (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 cn7_esc_resp)
    (if (/= nil cn7_get_msscl)
      (progn
	(setq cn7_msscl (distof cn7_get_msscl))
	(setvar "userr3" cn7_msscl)
	(setq cn7_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
	(if (= (getvar "useri3") 1)
	  (setvar "ltscale" 10.0)
	  (setvar "ltscale" (/ (* (getvar "userr5") cn7_msscl) 100.0))
	)
	(setq open_file (open (strcat cnp_root "/config/esc_last.txt") "w" "utf8"))
	(write-line cn7_get_msscl open_file)
      )
      (progn
	(alert "Nenhuma escala escolhida!\nTente novamente...")
	(cn7_esc)
      )
    )
  )
  (princ)
)

;verifica se a entrada é válida
(defun cn7_defesc_veryget ()
  (setq cn7_get_msscl $value
	esc_complist (list))
  (if (not (distof cn7_get_msscl))
    (progn
      (cn7_alert_ok
	    "Entrada Inválida!"
	    "Digite um valor"
	    "Numérico...")
      (done_dialog 0)
    )
    (progn
      (setq cn7_dzin (getvar "dimzin"))
      (setvar "dimzin" 1)
      (setq cn7_listmemb "n" alert_resp nil)
      (foreach n reg_scale_list
	(setq esc_complist (append (list (rtos (distof n) 2 3)) esc_complist))
      )
      (setq cn7_vpscl_verify (distof cn7_get_msscl))
      (foreach n esc_complist
	(if (= (rtos cn7_vpscl_verify 2 3) n) (setq cn7_listmemb "s"))
      )
      (if (= cn7_listmemb "n")
	;se a escala da janela é irregular
	(progn
	  (cn7_alert_yes_no
	    "Esta escala não é padrão!"
	    (strcat "Escala atual = 1:" cn7_get_msscl)
	    "Deseja continuar mesmo assim?")
	  (if (= "no" alert_resp)
	    (cn7_esc)
	    (progn
	      (setq cn7_msscl (distof cn7_get_msscl))
	      (setvar "userr3" cn7_msscl)
	      (done_dialog 3)
	    )
	  )
	);
	;se a escala da janela é regular
	(progn
	  (setq cn7_msscl (distof cn7_get_msscl))
	  (setvar "userr3" cn7_msscl)
        )
      )
    )
  )
)

;*********************************************************************
;*********************************************************************
;encontra a escala dos blocos para inserção, conforme seja tipo gráfico ou real
;*********************************************************************
;*********************************************************************
(defun cn7_find_blkscl ()
  (if (= "1" grp_type)
    ;blocos do tipo Real obedecem sempre à mesma regra...
    ;se está no Paper Space, dá o ALERTA!
    (if (and (= 0 (getvar "tilemode")) (= 1 (getvar "cvport")))
      (progn	(cn7_alert_yes_no
	  "Os blocos do tipo 'Real' não"
	  "devem ser inseridos no Paper Space!"
	  "Deseja prosseguir mesmo assim?")
	(if (= alert_resp "yes")
	  (progn
	    (setq cn7_blkscl 1)
	    (setq cn7_blk_prefixlay "")
	  )
	  (progn
	    (alert "Ative uma Viewport e tente novamente!")
	    (exit)
	  )
	)
      )
      (progn
	(setq cn7_blkscl (/ cn7_dwgunit (distof grp_unit)))
	(setq cn7_blk_prefixlay "")
      )
    )
    ;blocos do tipo Gráfico variam...
    (progn
      (if (= (getvar "tilemode") 1) ;status atual = model pleno
	(progn
	  (prompt (strcat "\nEscala Atual = 1:" (rtos cn7_msscl 2 0)))
	  (setq cn7_blk_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
	  (setq cn7_blkscl (/ (* cn7_msscl cn7_dwgunit) 100.0))
	  )
	(if (= 1 (getvar "cvport")) ;se está no paper space, a escala é sempre 10 (testar!!!)
	  (progn
	    (setq cn7_blkscl 10.0)
	    (setq cn7_blk_prefixlay "")
	  )
	  (progn                    ; se está na viewport
	    (cn7_veryscale)
	    (setq cn7_blk_prefixlay (strcat (rtos cn7_msscl 2 0) "-"))
	    (setq cn7_blkscl (/ (* cn7_dwgunit cn7_msscl) 100.0))
	    )
	  )
	)
      );progn
    )
  (princ)
)


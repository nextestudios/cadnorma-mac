(defun net_lib_action_descript3 ()
  (setq psimb_txt nil pt1 nil)
  (net_lib_descr_readfile)
  (initget 128)
  (setq pt1 (getpoint "\nModel Space/Layout/Formatar texto/Editar Texto/<Ponto de inserção do texto...> "))
  (cond
    ((= 'LIST (type pt1))
     (setq psimb_txt pt1)
     (net_lib_descr_writext)
     )
    ((= 'STR  (type pt1))
     (cond
       ((= "F" (strcase pt1))
	(net_lib_descr_format)
	(net_lib_action_descript2))
       ((= "E" (strcase pt1))
	(net_lib_descr_modify))
       ((= "M" (strcase pt1))
	(command "._tilemode" "1")
	(net_lib_action_descript2))
       ((= "L" (strcase pt1))
	(command "._tilemode" "0" "._pspace")
	(net_lib_action_descript2))
       (t
	(prompt "\nOpção inválida! Digite F, E, M, L ou Clique no ponto de Inserção...")
	(net_lib_action_descript2))
      );cond
     )
   );cond
)

;modifica texto existente
(defun net_lib_descr_modify ()
  (prompt "\nSelecione um texto para receber a descrição... ")
  (setq ent2 (entsel)
	ent2_list (entget (car ent2))
	ent2_type (cdr (assoc 0 ent2_list)))
  (if (/= "TEXT" (strcase ent2_type))
    (progn
      (alert "Entidade não é um texto!")

  )
)

;*****************************************
;Desenho de Portas                        
;*****************************************
(defun prt_drw23_porta ()
  (setq prt_deltax (/ (- (/ prt_larg 2.0) (* prt_fator 5.0)) 7.0)
	prt_deltay (- prt_wall (/ prt_wall 4))
	prt_length (sqrt (+ (expt prt_deltax 2) (expt prt_deltay 2)))
	prt_angulo (atan (/ prt_deltay prt_deltax))
	prt_porta2 (polar prt_porta1 prt_angbase (* 5.0 prt_fator))
	prt_pti (polar prt_cxi1 prt_angortho (/ prt_wall 8.0))
	prt_pte (polar prt_cxi3 (+ prt_angortho pi) (/ prt_wall 8.0))
	prt_porta3 (polar prt_porta2 (+ prt_angbase prt_angulo) (/ prt_length 2.0))
	prt_porta4 (polar prt_porta3 (- prt_angbase prt_angulo) prt_length)
	prt_porta5 (polar prt_porta4 (+ prt_angbase prt_angulo) prt_length)
	prt_porta6 (polar prt_porta5 (- prt_angbase prt_angulo) prt_length)
	prt_porta7 (polar prt_porta6 (+ prt_angbase prt_angulo) prt_length)
	prt_porta8 (polar prt_porta7 (- prt_angbase prt_angulo) prt_length)
	prt_porta9 (polar prt_porta8 (+ prt_angbase prt_angulo) (/ prt_length 2.0))
	prt_porta10 (polar prt_porta9 prt_angbase (* 5.0 prt_fator))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline"  "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3  "_non" prt_porta4  "_non" prt_porta5
	     "_non" prt_porta6  "_non" prt_porta7  "_non" prt_porta8  "_non" prt_porta9  "_non" prt_porta10 ""
  )
)

;*****************************************
;Desenho de Caixilho                      
;*****************************************

;desenha os caixihos
(defun prt_drw23_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
	    prt_cxi2 (polar prt_cxi1 prt_angbase prt_larg)
	    prt_cxi3 (polar prt_brk3 prt_angbase prt_caix)
	    prt_cxi4 (polar prt_cxi3 prt_angbase prt_larg)
      )
      (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi3 "_non" prt_brk3 "" ;"_c"
	       "._pline"  "_non" prt_brk2 "_non" prt_cxi2  "_non" prt_cxi4 "_non" prt_brk4 "" ;"_c"
      )
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_cxi1 prt_brk1
	    prt_cxi2 prt_brk2
	    prt_cxi3 prt_brk3
	    prt_cxi4 prt_brk4
      )
    )
  )
  (setq prt_porta1 (polar prt_cxi1 prt_angortho (/ prt_wall 2.0)))
)




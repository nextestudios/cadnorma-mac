;*********************************************************************
;seleciona um conjunto de dimensions e separa por estilos
;*********************************************************************
(defun cn10_seldim ()
  (setq s1 (ssget (list (cons 0 "DIMENSION")))
	s1_len (sslength s1)
	dim0_sel (ssadd)
	dim1_sel (ssadd)
	dim2_sel (ssadd)
	dim3_sel (ssadd)
	dim4_sel (ssadd)
	dim5_sel (ssadd)
	counter 0
  )
  (repeat s1_len
    (setq ent (ssname s1 counter)
	  ent_list (entget ent)
	  ent_dimtype (cdr (assoc 3 ent_list)))
    (cond
      ((= (strcase ent_dimtype t) "cadnorma_dim1") (setq dim1_sel (ssadd ent dim1_sel)))
      ((= (strcase ent_dimtype t) "cadnorma_dim2") (setq dim2_sel (ssadd ent dim2_sel)))
      ((= (strcase ent_dimtype t) "cadnorma_dim3") (setq dim3_sel (ssadd ent dim3_sel)))
      ((= (strcase ent_dimtype t) "cadnorma_dim4") (setq dim4_sel (ssadd ent dim4_sel)))
      ((= (strcase ent_dimtype t) "cadnorma_dim5") (setq dim5_sel (ssadd ent dim5_sel)))
      (t (setq dim0_sel (ssadd ent dim0_sel)))
    )
    (setq counter (1+ counter))
  )
  (if (or
	(not (tblsearch "dimstyle" "cadnorma_dim1"))
	(not (tblsearch "dimstyle" "cadnorma_dim2"))
	(not (tblsearch "dimstyle" "cadnorma_dim3"))
	(not (tblsearch "dimstyle" "cadnorma_dim4"))
	(not (tblsearch "dimstyle" "cadnorma_dim5"))
      )
    (progn
      (alert "Estilo de cota inexistente...\nUse o comando 'CFG' para criá-los...")
      (exit)
    )
  )
)


;comando Split : offest para os dois lados (modificado por bricscad)
(defun c:split (/ ang end1 ent pt test)
  (setvar "cmdecho" 0)
  (if (= nil ds)
    (progn
      (setq ds (getreal "\nDistância (offset)... "))
      (if (= nil ds) (exit))
    )
    (progn
      (setq ds1 (getreal (strcat "\nDistância (offset)...<" (rtos ds 2 2) ">... ")))
      (if (/= nil ds1) (setq ds ds1))
    )
  )
  (while (setq ent (entsel "\nSelecione a linha:  "))
     (setq end1 (osnap (cadr ent) "end"))
     (setq ang (angle end1 (cadr ent)))
     (initget "center,c CENTER,C")
     (setq pt (getpoint "\nLado do offset/<Centro>:  "))
     (setq pt (if pt pt "C"))
     (command "._offset")
     (if (listp pt)
        (command ds ent "_non" pt "")
        (progn
           (command (/ ds 2) ent "_non" (polar (cadr ent) (+ ang (/ pi 2)) ds)
                             ent "_non" (polar (cadr ent) (- ang (/ pi 2)) ds)
                             ""
           )
           (entdel (car ent))
  ) ) )
  (princ)
)


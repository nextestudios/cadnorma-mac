;Alinhar Textos
(defun c:txa ()
  (setq counter 0)
  (prompt "\nSelecione os Textos a alinhar...")
  (setq s1 (ssget '((0 . "TEXT"))))
  (if (= nil s1) (exit))
  (initget "Vertical Horizontal")
  (setq resp (getkword "\nHorizontal/<Vertical>..."))
  (if (= nil resp) (setq resp "Vertical"))
  (initget "Left Center Right")
  (setq resp2 (getkword "\nTipo de alinhamento...Right/Center/<Left>..."))
  (if (= nil resp2) (setq resp2 "Left"))
  (setq txa_pto (getpoint "\nPonto de alinhamento...")
	txa_xpto (nth 0 txa_pto)
	txa_ypto (nth 1 txa_pto)
  )  
  (setq	s1_len (sslength s1))
  (cond
    ((= resp2 "Left") (setq txa_ali 0))
    ((= resp2 "Center") (setq txa_ali 1))
    ((= resp2 "Right") (setq txa_ali 2))
  )
  (repeat s1_len
    (setq txt_list (entget (ssname s1 counter))
	  txt_xpto (nth 1 (assoc 10 txt_list))
	  txt_ypto (nth 2 (assoc 10 txt_list))
	  txt_zpto (nth 3 (assoc 10 txt_list))
	  txt_list (entmod (subst (cons 72 txa_ali) (assoc 72 txt_list) txt_list))
    )
    (if (= resp "Vertical")
        (command "._change" (ssname s1 counter) "" "" "_non" (list txa_xpto txt_ypto txt_zpto) "" "" "" "")
        (command "._change" (ssname s1 counter) "" "" "_non" (list txt_xpto txa_ypto txt_zpto) "" "" "" "")
    )
    
    (setq counter (1+ counter))
  )
  (princ)
)
;Funcao RTX - Roda Textos
(defun c:rtx ()
  (setq laymo (getvar "clayer"))
  (setq osmo (getvar "osmode"))
  (setvar "osmode" 0)
  (prompt "\nSelecione os textos a serem rodados...")
  (setq s1 (ssget '((0 . "TEXT"))))
  (setq rot (getreal "\nAngulo de rotação (em graus): "))
  (setq count_limit (sslength s1) counter 0)
  (command "._undo" "_m")
  (repeat count_limit
    (setq ent1 (ssname s1 counter))
    (setq ent2 ent1)
    (setq p0 (cdr (assoc 10 (entget ent1))))
    (command "._rotate" ent1 "" p0 rot)
    (setq counter (1+ counter))
  );repeat
  (setvar "clayer" laymo)
  (setvar "osmode" osmo)
  (prompt "\nUse o comando <UB> para retornar... ")
  (princ)
)

;direção de textos
(defun c:dtx ()
  (prompt "\nSelecione os textos a serem rotacionados...")
  (setq s1 (ssget '((0 . "TEXT"))))
  (initget 128)
  (setq pt1 (getpoint "\nAngulo de rotação / <Primeiro ponto>..."))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setq pt2 (getpoint pt1 "\nSegundo ponto para alinhamento...")
	   angrad (angle pt1 pt2)
     )
    )
    ((= 'STR  (type pt1))
     (cond
       ((= "A" (strcase pt1))
	(setq angdeg (getreal "\nEntre com o ângulo de rotação em graus...")
	      angrad (/ (* angdeg pi) 180))
       )
       (t
	(prompt "\nOpção inválida... Marque o primeiro ponto ou digite <A> para entrar com o ângulo...")
	(quit)
       )
     )
    )
  )
  (setq count_limit (sslength s1) counter 0)
  (repeat count_limit
    (setq ent1 (ssname s1 counter)
	  ent1_list (entget ent1)
	  ent1_list (entmod (subst (cons 50 angrad) (assoc 50 ent1_list) ent1_list))
	  counter (1+ counter)
    )
  );repeat
  (princ)
)

;igualar rotação de textos
(defun c:trot ()
  (prompt "\nSelecione o texto de referência...")
  (setq ent1 (entsel)
	ent1_list (entget (car ent1))
	ent1_type (cdr (assoc 0 ent1_list))
  )
  (if (/= ent1_type "TEXT")
    (progn
      (prompt "\nA entidade selecionada não é um texto!")
      (quit)
    )
    (progn
      (setq tx_rot (cdr (assoc 50 ent1_list)))
      (prompt "\nSelecione os textos para igualar a rotação...")
      (setq s1 (ssget '((0 . "TEXT")))
	    s1_len (sslength s1)
	    counter 0
      )
      (repeat s1_len
	(setq ent2 (ssname s1 counter)
	      ent2_list (entget ent2)
	      ent2_list (entmod (subst (cons 50 tx_rot) (assoc 50 ent2_list) ent2_list))
	      counter (1+ counter)
	)
      )
    )
  )
  (princ)
)


;caixa em volta do texto
(defun c:tbox ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
        "textstyle" "luprec" "osmode" ))
  (setq textent (car (entsel "\nSelecione o texto : ")))
  (if textent
    (setq textent_lay (cdr (assoc 8 (entget textent))))
  )
  (setvar "osmode" 0)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (command "._ucs" "_entity" textent)
  (setq tb (textbox (list (cons -1 textent)))
        ll (car tb)
        ur (cadr tb)
        ul (list (car ll) (cadr ur))
        lr (list (car ur) (cadr ll))
        os (polar ll (angle lr ll) (* 0.075 cn7_blkscl))
  )
  (command "._layer" "_s" textent_lay "" "._pline" ll lr ur ul "_close")
  (setq tbox_last (entlast))
  (command "._offset" "_t" tbox_last os "")
  (command "._erase" tbox_last "")
  (command "._ucs" "_p" )
  (initget "Sim Não")
  (setq resp (getkword "\nDeseja uma hachura sólida com a cor 9 no texto (S / <N>)? "))
  (if (= resp nil) (setq resp "Não"))
  (if (= resp "Sim")
    (command "._hatch" "_Solid" (entlast) "" "._chprop" (entlast) "" "_p" "_c" "9" "" "._draworder" (entlast) "" "_b")
  )
  (devolve)
  (princ)
)

;caixa em volta do parágrafo
(defun c:pbox ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setq s1 (ssget '((0 . "TEXT")))
	s1_len (sslength s1)
	counter 0
	xmin nil ymin nil xmax nil ymax nil)
  (repeat s1_len
    (setq ent (ssname s1 counter))
    (command "._ucs" "_entity" ent)
    (setq
	  ent_list (entget ent)
	  tb (textbox ent_list)
	  ll (trans (car tb) 1 0);lower left
	  x_ll (nth 0 ll)
	  y_ll (nth 1 ll)
	  ur (trans (cadr tb) 1 0);upper rigth
	  x_ur (nth 0 ur)
	  y_ur (nth 1 ur)
	  text_lay (cdr (assoc 8 ent_list))
    )
    (if (or (= xmin nil) (<= x_ll xmin)) (setq xmin x_ll))
    (if (or (= ymin nil) (<= y_ll ymin)) (setq ymin y_ll))
    (if (or (= xmax nil) (>= x_ur xmax)) (setq xmax x_ur))
    (if (or (= ymax nil) (>= y_ur ymax)) (setq ymax y_ur))
    (setq counter (1+ counter))
  )
  (setq p_ll (list xmin ymin 0.0)
	p_ur (list xmax ymax 0.0)
	p_lr (list xmax ymin 0.0)
	p_ul (list xmin ymax 0.0)
	os (polar p_ll pi (* 0.1 cn7_blkscl))
  )
  (command "._ucs" "_w" "._layer" "_s" text_lay "" "._pline" "_non" p_ll "_non" p_lr "_non" p_ur "_non" p_ul "_c")
  (setq tbox_last (entlast))
  (command "._offset" "_t" tbox_last "_non" os "")
  (command "._erase" tbox_last "")
  (initget "Sim Não")
  (setq resp (getkword "\nDeseja uma hachura sólida com a cor 9 no parágrafo? (S / <N>)? "))
  (if (= resp nil) (setq resp "Não"))
  (if (= resp "Sim")
    (command "._hatch" "_Solid" (entlast) "" "._chprop" (entlast) "" "_p" "_c" "9" "" "._draworder" (entlast) "" "_b")
  )
  (devolve)
  (princ)
)


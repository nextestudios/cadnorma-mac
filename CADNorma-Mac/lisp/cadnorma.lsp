)


;desenvolvimento
;escalas gráficas
(defun c:scg ()
  (prompt "\nInserção de Escala Gráfica")
  (if (and (= 0 (getvar "tilemode")) (= 1 (getvar "cvport")))
    (progn
      (cn7_alert_ok
	"Comando permitido apenas no Model"
	"ou em uma Viewport ativa!"
	"Ative uma Viewport ou o Model e reinicie o comando.")
      (quit)
    )
    (progn
      (if (= 1 (getvar "tilemode"))	;se está no Model
	(setq scg_scale cn7_msscl)
	(progn				;se está em uma viewport
	  (cn7_vport_scl)
	  (setq scg_scale cn7_vp_scale)
	)
      )
    )
  )
  (cond
    ((= scg_scale 1.25) (setq scg_blkname  (strcat cnp_root "/blocos/esc_graf_1_25")))
    ((= scg_scale 1.5)  (setq scg_blkname  (strcat cnp_root "/blocos/esc_graf_1_5")))
    ((= scg_scale 2.5)  (setq scg_blkname  (strcat cnp_root "/blocos/esc_graf_2_5")))
    ((= scg_scale 7.5)  (setq scg_blkname  (strcat cnp_root "/blocos/esc_graf_7_5")))
    ((= scg_scale 12.5) (setq scg_blkname  (strcat cnp_root "/blocos/esc_graf_12_5")))
    (t (setq scg_blkname (strcat  (strcat cnp_root "/blocos/esc_graf_" (rtos scg_scale 2 0)))))
  )
  (prompt "\nClique no ponto de inserção... ")
  (if (not (findfile (strcat scg_blkname ".dwg")))
    (progn
      (alert "Escala Gráfica não definida!\nAjuste a escala antes de usar este comando.")
      (quit)
    )
    (command "._insert" scg_blkname "_s" cn7_dwgunit pause 0.0)
  )
  (princ)
)
   


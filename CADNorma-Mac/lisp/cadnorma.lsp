;encontrar o número de páginas de um subgrupo
(defun net_lib_findpages ()
  (setq lib_currpage 1)
  (lib_findpages_findnext)
  (while (findfile lib_nextpage_file)
      (setq lib_currpage (1+ lib_currpage))
      (lib_findpages_findnext)
  )
  (setq lib_numpaginas (rtos lib_currpage 2 0))
  (if (= 1 (strlen lib_numpaginas)) (setq lib_numpaginas (strcat "0" lib_numpaginas)))
)

;encontra o nome do próximo arquivo de página
(defun net_lib_findpages_findnext ()
  (setq	lib_nextpage (1+ lib_currpage)
	lib_nextpage_str (rtos lib_nextpage 2 0))
  (if (= 1 (strlen lib_nextpage_str)) (setq lib_nextpage_str (strcat "0" lib_nextpage_str)))
  (setq lib_nextpage_file (strcat cnp_netroot "/slides/" lib_blkpfx lib_blkfam lib_blkgrp lib_blksub lib_nextpage_str ".txt"))
)


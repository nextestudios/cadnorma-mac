  (prt_halt_writefile)
  (prt_main)
)

;botão Excluir
(defun prt_cfghalt_delete ()
  (setq counter 0
	halt_list_len (length prt_halt_list)
	new_list (list)
  )
  (repeat halt_list_len
    (if (/= counter (fix (distof prt_cfghalt_sel)))
      (setq new_list (append new_list (list (nth counter prt_halt_list))))
    )
    (setq counter (1+ counter))
  )
  (setq prt_halt_list new_list)
  (start_list "prt_cfghalt_list")
  (mapcar 'add_list prt_halt_list)
  (end_list)
  (set_tile "prt_cfghalt_list" prt_cfghalt_sel)
)
	    


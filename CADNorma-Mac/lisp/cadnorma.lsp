;ação ao escolher o typo de porta
(defun jnl_deftype ()
  ;determina o tipo
  (setq jnl_var_type $key
	jnl_var_tipo (substr jnl_var_type 5 2)
	x (dimx_tile "jnl_slide_type")
	y (dimy_tile "jnl_slide_type")
  )
  ;atualiza o slide
  (start_image "jnl_slide_type")
  (fill_image 0 0 x y -2)
  (slide_image 0 0 x y (strcat cnp_root "/slides/jnl_" jnl_var_tipo ".sld"))
  (end_image)
  ;avalia o botão ~Detalhes do Tipo"
)

;lê os dados iniciais da DCL no arquivo de dados
(defun jnl_last_file ()
  (if (findfile (strcat cnp_root "/config/jnl_last.txt"))
    (jnl_last_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/jnl_last.txt") "w" "utf8"))
      (write-line "11" file)
      (write-line "120" file)
      (write-line "0" file)
      (write-line "jnl_center" file)
      (write-line "5" file)
      (write-line "15" file)
      (write-line "2" file)
      (write-line "1" file)
      (write-line "jnl_larg_radio1" file)
      (write-line "80" file)
      (close file)
      (jnl_last_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun jnl_last_readfile ()
  (setq	file (open (strcat cnp_root "/config/jnl_last.txt") "r" "utf8"))
  (setq	jnl_var_tipo (read-line file))
  (setq	jnl_var_larg (read-line file))
  (setq	jnl_var_halt (read-line file))
  (setq	jnl_var_posi (read-line file))
  (setq	jnl_var_afas (read-line file))
  (setq	jnl_var_wall (read-line file))
  (setq	jnl_var_caix (read-line file))
  (setq	jnl_var_iden (read-line file))
  (setq	jnl_var_lrad (read-line file))
  (setq	jnl_var_diam (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun jnl_last_writefile ()
  (setq	file (open (strcat cnp_root "/config/jnl_last.txt") "w" "utf8"))
  (write-line jnl_var_tipo file)
  (write-line jnl_var_larg file)
  (write-line jnl_var_halt file)
  (write-line jnl_var_posi file)
  (write-line jnl_var_afas file)
  (write-line jnl_var_wall file)
  (write-line jnl_var_caix file)
  (write-line jnl_var_iden file)
  (write-line jnl_var_lrad file)
  (write-line jnl_var_diam file)
  (close file)
)



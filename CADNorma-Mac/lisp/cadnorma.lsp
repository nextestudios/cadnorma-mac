;çlica em dois pontos para confirmar as medidas
(defun cbt_getdist_button ()
  (cbt_draw_writefile)
  (setq get_dist nil
	pt1 (getpoint "\nPrimeiro ponto para definir a medida...: ")
	pt2 (getpoint pt1 "Segundo ponto para definir a medida...: ")
	get_dist (distance pt1 pt2)
  )
  (cond
    ((= cn7_dwgunit 1.0) (setq new_dist (* get_dist 100.0)))
    ((= cn7_dwgunit 100.0) (setq new_dist (* get_dist 1.0)))
    ((= cn7_dwgunit 1000.0) (setq new_dist (* get_dist 0.1)))
  )
)


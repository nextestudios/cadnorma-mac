(defun cn9_trocacor ()
  (prompt "\nselecione as entidades para tocar a cor...")
  (setq s1 (ssget)
	s1_n (sslength s1)
	counter 0
	new_list (cons 62 trcolor_to)
  )
  (if (/= 256 trcolor_from)
    (repeat s1_n
      (setq ent (entget (ssname s1 counter)))
      (if (= (cdr (assoc 62 ent)) trcolor_from)
	(cond
	  ((= 0 trcolor_to) (command "._chprop" (ssname s1 counter) "" "_c" "byblock" ""))
	  ((= 256 trcolor_to) (command "._chprop" (ssname s1 counter) "" "_c" "bylayer" ""))
	  (t (command "._chprop" (ssname s1 counter) "" "_c" trcolor_to ""))
        )
      )
      (setq counter (1+ counter))
    )
    (repeat s1_n
      (setq ent (entget (ssname s1 counter)))
      (if (not (cdr (assoc 62 ent)))
	(cond
	  ((= 0 trcolor_to) (command "._chprop" (ssname s1 counter) "" "_c" "byblock" ""))
	  ((= 256 trcolor_to) (command "._chprop" (ssname s1 counter) "" "_c" "bylayer" ""))
	  (t (command "._chprop" (ssname s1 counter) "" "_c" trcolor_to ""))
        )
      )
      (setq counter (1+ counter))
    )
  )
)


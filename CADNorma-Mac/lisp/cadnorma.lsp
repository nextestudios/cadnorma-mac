;*****************************************
;Desenho das Maçanetas                    
;*****************************************
(defun prt_drw12_maçaneta ()
  (setq prt_mac1 (polar prt_porta4 prt_angortho (* 7.0 prt_fator))
	prt_mac2 (polar prt_porta3 prt_angortho (* 7.0 prt_fator))
  )
  (cond
    ((= prt_pt12_mac "prt_12_mac_01") (setq prt_mac_blk "prt_mac01"))
    ((= prt_pt12_mac "prt_12_mac_02") (setq prt_mac_blk "prt_mac02"))
    ((= prt_pt12_mac "prt_12_mac_03") (setq prt_mac_blk "prt_mac03"))
    ((= prt_pt12_mac "prt_12_mac_04") (setq prt_mac_blk "prt_mac04"))
  )
  (cn7_verylayer prt_layc_mal 7)
  (if (= prt_code 1)
    (cond
      ((or (= prt_xcode 1) (= prt_xcode 3) (= prt_xcode 4))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl prt_blkscl "_non" prt_porta4
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl prt_blkscl "_non" prt_porta3
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
      ((= prt_xcode 2)
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl (- prt_blkscl) "_non" prt_porta4
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl (- prt_blkscl) "_non" prt_porta3
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
    )
    (cond
      ((or (= prt_xcode 1) (= prt_xcode 4))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl (- prt_blkscl) "_non" prt_porta4
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl (- prt_blkscl) "_non" prt_porta3
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
      ((or (= prt_xcode 2) (= prt_xcode 3))
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "a.dwg") "_non" prt_mac1 prt_blkscl prt_blkscl "_non" prt_porta4
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
       (command "._insert" (strcat cnp_root "/blocos/" prt_mac_blk "b.dwg") "_non" prt_mac2 prt_blkscl prt_blkscl "_non" prt_porta3
		"._explode" (entlast) "._chprop" "_p" "" "_p" "_c" prt_layc_mac "_la" prt_layc_mal "")
      )
    )
  )
)

;*****************************************
;Desenho de Arcos                         
;*****************************************
(defun prt_drw12_arco ()
  (cn7_verylayer prt_layc_arl 7)
  (setvar "cecolor" prt_layc_arc)
  (setq prt_arcstart prt_mid1)
  (cond
    ((= prt_pt12_arc "prt_12_arc_01")
     (setq prt_arctang (polar prt_arcstart (+ prt_angortho pi) prt_larg))
     (command "._arc" "_non" prt_arcstart "_e" "_non" prt_porta3 "_d" "_non" prt_arctang
	      "._mirror" (entlast) "" "_non" prt_mid1 "_non" prt_mid2 "")
    )
    ((= prt_pt12_arc "prt_12_arc_02")
     (command "._line" "_non" prt_arcstart "_non" prt_porta3 ""
	      "._mirror" (entlast) "" "_non" prt_mid1 "_non" prt_mid2 "")
    )
   )
)


;*****************************************
;Desenho de Portas                        
;*****************************************
(defun prt_drw12_porta ()
  (setq prt_porta2 (polar prt_porta1 prt_angbase (* prt_fator (distof prt_pt12_poe)))
	prt_porta3 (polar prt_porta2 (+ prt_angortho pi) (/ prt_larg 2.0))
	prt_porta4 (polar prt_porta1 (+ prt_angortho pi) (/ prt_larg 2.0))
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline"  "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3 "_non" prt_porta4 "_c")
  (command "._mirror" (entlast) "" "_non" prt_mid1 "_non" prt_mid2 "")
)


;*****************************************
;Desenho de Caixilho                      
;*****************************************

;desenha os caixihos
(defun prt_drw12_caixilho ()
  (setq prt_mid1 (polar prt_brk1 prt_angbase (/ (distance prt_brk1 prt_brk2) 2.0))
	prt_mid2 (polar prt_brk3 prt_angbase (/ (distance prt_brk3 prt_brk4) 2.0))
  )
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (if (= prt_pt12_cxi "prt_12_cxi_01")
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_cxi1 prt_angbase prt_larg)
		prt_cxi3 (polar prt_brk3 prt_angbase prt_caix)
		prt_cxi4 (polar prt_cxi3 prt_angbase prt_larg)
		)
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi3 "_non" prt_brk3 "" ;"_c"
		   "._pline"  "_non" prt_brk2 "_non" prt_cxi2  "_non" prt_cxi4 "_non" prt_brk4 "" ;"_c"
          )
	  (setq prt_arcstart prt_cxi2)
	)
	(progn
	  (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
		prt_cxi2 (polar prt_cxi1 prt_angortho (* prt_fator (distof prt_pt12_poe)) )
		prt_cxi3 (polar prt_cxi2 prt_angbase (* prt_fator 2.0))
		prt_cxi4 (polar prt_brk3 prt_angbase (+ prt_caix (* prt_fator 2.0)))
		)
	  (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2 "_non" prt_cxi3 "_non" prt_cxi4 "_non" prt_brk3 "");"_c")
	  (setq prt_cxi5 (polar prt_cxi1 prt_angbase prt_larg)
		prt_cxi6 (polar prt_cxi5 prt_angortho (* prt_fator (distof prt_pt12_poe)))
		prt_cxi7 (polar prt_cxi6 (+ pi prt_angbase) (* prt_fator 2.0))
		prt_cxi8 (polar prt_brk4 (+ pi prt_angbase) (+ prt_caix (* prt_fator 2.0)))
		)
	  (command "._pline"  "_non" prt_brk2 "_non" prt_cxi5  "_non" prt_cxi6 "_non" prt_cxi7 "_non" prt_cxi8 "_non" prt_brk4 "");"_c")
	  (setq prt_arcstart prt_cxi5)
        )
      )
      (setq prt_porta1 prt_cxi1)
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_cxi1 prt_brk1
	    prt_cxi2 prt_brk2
	    prt_cxi3 prt_brk3
            prt_cxi4 prt_brk4
	    prt_arcstart prt_cxi2
	    prt_porta1 prt_cxi1
      )
    )
  )
)




;criação de eixos tipo2
(defun c:ex2 (/ om culayer dire ang numdes numprancha pt1 dist dist1)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
	    "textstyle" "luprec" "osmode" ))

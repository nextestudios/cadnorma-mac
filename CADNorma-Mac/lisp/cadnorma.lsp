(defun lib_updblk_update ()
  (setq dwg_blk (strcat lib_blkpfx lib_blkfam lib_blkgrp lib_blksub lib_blkpag lib_blkblk))
  (setq dwg_blk_file (strcat cnp_root "/blocos/" dwg_blk ".dwg"))
  (if (not (tblsearch "block" dwg_blk))
    (alert "\nNao existem definições desse bloco no desenho...")
    (progn
      (setq counter 1)
      (find_next_temp)
      (command "._rename" "_b" dwg_blk curr_temp)
      (if (= lib_blkupdt_action "blk_updt_update")
	(progn
	  (command "._insert" dwg_blk_file "_non" "0,0" "" "" "")
	  (command "._explode" (entlast))
	  (command "._block" curr_temp "_y" "0,0" "_p" "")
	  (command "._rename" "_b" dwg_blk next_temp)
	  (command "._rename" "_b" curr_temp dwg_blk)
	  (command "._rename" "_b" next_temp curr_temp)
	  (cn7_alert_ok
	    "O Cadnorma renomeou o bloco antigo para"
	    curr_temp
	    "Use o comando <PURGE> para eliminá-lo...")
        );progn case T
	(progn
	  (cn7_alert_ok
	    "O Cadnorma renomeou o bloco antigo para"
	    curr_temp
	    "Insira normalmente o novo bloco...")
	  (lib_dcl)
	);progn case F
      );if
    );progn
  );if
);defun

(defun find_next_temp ()
  (setq curr_temp (strcat "Renomeado_" (rtos counter 2 0)))
  (if (tblsearch "block" curr_temp)
    (progn
      (setq counter (1+ counter))
      (find_next_temp)
    );progn
    (setq next_temp (strcat "Renomeado_" (rtos (1+ counter) 2 0)))
  );if
);defun


  
;botão 'Substituir'
(defun lib_action_exchange ()
;;;  (lib_save_lastlib)
  (if (not (findfile lib_currdwg))
    (progn
      (cn7_alert_ok
	"Impossível operar substituição"
	"de blocos com ícones vazios!"
	"Selecione um ícone ocupado...")
      (lib_dcl)
    )
    (progn
      (prompt "\nSelecione um dos blocos que deseja substituir... ")
      (setq lib_blkproto (entsel)
	    lib_blkproto_type (cdr (assoc 0 (entget (car lib_blkproto)))))
      (if (/= "INSERT" lib_blkproto_type)
	(progn
	  (alert "Objeto selecionado\nnão é um bloco!\nTente novamente...")
	  (lib_action_exchange)
	  )
	(progn
	  (setq lib_blkproto_list (entget (car lib_blkproto))
		lib_blkproto_name (cdr (assoc 2 lib_blkproto_list))
		lib_blkproto_xscl (cdr (assoc 41 lib_blkproto_list))
;;;		lib_blkproto_yscl (cdr (assoc 42 lib_blkproto_list))
;;;		lib_blkproto_zscl (cdr (assoc 43 lib_blkproto_list))
	  )
	  (prompt "Selecione os objetos ou área para substituir os blocos...<ENTER> para anterior... ")
	  (setq exchange_sel (ssget '((0 . "INSERT"))))
	  (if (= nil exchange_sel)
	    (progn
	      (setq exchange_sel (ssadd))
	      (setq exchange_sel (ssadd (car lib_blkproto) exchange_sel))
	    )
	  )
	  (setq exchange_sel_n (sslength exchange_sel)
		counter 0)
	  (repeat exchange_sel_n
	    (setq entname (ssname exchange_sel counter)
		  ent_blkname (cdr (assoc 2 (entget entname)))
		  ent_insert (cdr (assoc 10 (entget entname)))
		  ent_scale (cdr (assoc 41 (entget entname)))
		  ent_rotation (cdr (assoc 50 (entget entname)))
		  angdeg (/ (* 180 ent_rotation) pi))
	    (if (= lib_blkproto_name ent_blkname)
	      (progn
		(command "._erase" entname "")
		(cn7_find_blkscl);***
		(setq pt1 ent_insert);(cn7_insert_point);***
		(cn7_verylayer (strcat cn7_blk_prefixlay lib_currsgp_layname) (fix (distof lib_currsgp_laycol)));***
		(command "._insert" lib_currdwg "_scale" ent_scale ;|cn7_blkscl|; "_non" pt1 angdeg);***
		)
	      )
	    (setq counter (1+ counter))
	    )
	  )
	)
    )
  )
)


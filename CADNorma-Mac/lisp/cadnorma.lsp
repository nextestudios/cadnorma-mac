;Analisa a lista, item por item, extrai os dados e forma a lista de itens: qtable_list
(defun q_rel_final_table ()
  (setq counter 1
	qtable_list nil
  )
  (foreach n new_list
    (setq cnqt_code (nth 0 n)
	  cnqt_quant (nth 1 n)
    )
    (cnqt_define_data)
    (cond
      ((= item_type "1") (setq cnqt_unit "unid."))
      ((= item_type "2") (setq cnqt_unit "m"))
      ((= item_type "3") (setq cnqt_unit "m2"))
      ((= item_type "4") (setq cnqt_unit "m3"))
    )
    (setq cnqt_custotal (rtos (* (distof cnqt_quant) (distof item_custo)) 2 2))
    (if (= q_rel_tabletype "q_rel_table1")
      (setq item_list (list cnqt_code (rtos counter 2 0) item_text cnqt_quant cnqt_unit))
      (setq item_list (list cnqt_code (rtos counter 2 0) item_text cnqt_quant cnqt_unit item_custo cnqt_custotal))
    )
    (setq qtable_list (append qtable_list (list item_list)))
    (setq counter (1+ counter))
  )
)



;com os botões "Sim", "Não" e Cancela
(defun cn7_alert_yes_no_cancel (msg1 msg2 msg3)
  (setq alert_resp nil)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_msg_yes_no_cancel" dcl_id)) (exit))
  (set_tile "msg_text1" msg1)
  (set_tile "msg_text2" msg2)
  (set_tile "msg_text3" msg3)
  (action_tile "yes" "(done_dialog 1)")
  (action_tile "no" "(done_dialog 2)")
  (setq msg_resp (start_dialog))
  (unload_dialog dcl_id)
  (if (= msg_resp 1)
    (setq alert_resp "yes")
    (progn
      (if (= msg_resp 2)
	(setq alert_resp "no")
	(setq alert_resp "cancel")
      )
    )
  )
  (princ)
)

;*********************************************************************
;pergunta a configuração
;*********************************************************************
(defun c:?cfg ()
  (cn7_init)
  (setq cn7_dzin (getvar "dimzin"))
  (setvar "dimzin" 1)
  (if (= 0 (getvar "tilemode"))
    (if (= 1 (getvar "cvport"))
      (setq msg5 "Operando no Paper Space")
      (progn
	(cn7_vport_scl)
	(cond
	  ((= cn7_dwgunit 1000.0) (setq msg5_scale cn7_vp_scale))
	  ((= cn7_dwgunit 100.0) (setq msg5_scale cn7_vp_scale))
	  ((= cn7_dwgunit 1.0) (setq msg5_scale cn7_vp_scale))
	  )
	(setq msg5 (strcat "Escala da Viewport = 1:" (rtos msg5_scale 2 2)))
	)
    )
    (if cn7_msscl
      (setq msg5 (strcat "Model Space, escala 1: " (rtos cn7_msscl 2 0)))
      (setq msg5 "Desenho não configurado!")
    )
  )
  (cond
    ((= "1.00" (rtos cn7_dwgunit 2 2))  (setq msg3 "Desenhando em : metros..."))
    ((= "100.00" (rtos cn7_dwgunit 2 2))  (setq msg3 "Desenhando em : centímetros..."))
    ((= "1000.00" (rtos cn7_dwgunit 2 2))  (setq msg3 "Desenhando em : milímetros..."))
  )
  (cond
    ((= "1.00" (rtos cn7_dimunit 2 2))  (setq msg4 "Cotando em : metros..."))
    ((= "100.00" (rtos cn7_dimunit 2 2))  (setq msg4 "Cotando em : centímetros..."))
    ((= "1000.00" (rtos cn7_dimunit 2 2))  (setq msg4 "Cotando em : milímetros..."))
  )
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_msg_cfg" dcl_id)) (exit))
  (set_tile "msg_text3" msg3)
  (set_tile "msg_text4" msg4)
  (set_tile "msg_text5" msg5)
  (action_tile "accept" " (done_dialog 1)")
  (setq msg_resp (start_dialog))
  (unload_dialog dcl_id)
  (setvar "dimzin" cn7_dzin)
  (princ)
)
;*********************************************************************
;determina a altura final dos textos
;*********************************************************************
(defun cn7_text_hfinal ()
  (cond
    ;case romans
    ((= (strcase cn7_txtsty t) "r50") (setq cn7_txthf 1.25))
    ((= (strcase cn7_txtsty t) "r60") (setq cn7_txthf 1.50))
    ((= (strcase cn7_txtsty t) "r70") (setq cn7_txthf 1.75))
    ((= (strcase cn7_txtsty t) "r80") (setq cn7_txthf 2.00))
    ((= (strcase cn7_txtsty t) "r90") (setq cn7_txthf 2.25))
    ((= (strcase cn7_txtsty t) "r100") (setq cn7_txthf 2.50))
    ((= (strcase cn7_txtsty t) "r120") (setq cn7_txthf 3.00))
    ((= (strcase cn7_txtsty t) "r140") (setq cn7_txthf 3.50))
    ((= (strcase cn7_txtsty t) "r175") (setq cn7_txthf 4.375))
    ((= (strcase cn7_txtsty t) "r200") (setq cn7_txthf 5.0))
    ((= (strcase cn7_txtsty t) "t1") (setq cn7_txthf (distof t1_alt)))
    ((= (strcase cn7_txtsty t) "t2") (setq cn7_txthf (distof t2_alt)))
    ((= (strcase cn7_txtsty t) "t3") (setq cn7_txthf (distof t3_alt)))
    ((= (strcase cn7_txtsty t) "t4") (setq cn7_txthf (distof t4_alt)))
    ((= (strcase cn7_txtsty t) "t5") (setq cn7_txthf (distof t5_alt)))
    ((= (strcase cn7_txtsty t) "t6") (setq cn7_txthf (distof t6_alt)))
    ((= (strcase cn7_txtsty t) "t7") (setq cn7_txthf (distof t7_alt)))
  )
)

  (cond
    ((= sgp_subunit "1") (set_tile "sgp_chunit_radio" "sub_chunit_0"))
    ((= sgp_subunit "100") (set_tile "sgp_chunit_radio" "sub_chunit_1"))
    ((= sgp_subunit "1000") (set_tile "sgp_chunit_radio" "sub_chunit_2"))
  )
  (action_tile "sgp_chunit_radio" "(setq sgp_chunit_newunit $value)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq sub_changeunit_dialog (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 sub_changeunit_dialog);se clica em 'ok' 
    (progn
      (if (/= nil sgp_chunit_newunit);se algum tipo foi clicado
	(progn
	  (cond
	    ((= sgp_chunit_newunit "sub_chunit_0") (setq sgp_subunit "1") (set_tile "lib_blkunit" "Unidade: Metros"))
	    ((= sgp_chunit_newunit "sub_chunit_1") (setq sgp_subunit "100") (set_tile "lib_blkunit" "Unidade: Centímetros"))
	    ((= sgp_chunit_newunit "sub_chunit_2") (setq sgp_subunit "1000") (set_tile "lib_blkunit" "Unidade: Milímetros"))
	  )	  	    
	  (grp_sgp_resave)
	)
      )
    )
  )
)


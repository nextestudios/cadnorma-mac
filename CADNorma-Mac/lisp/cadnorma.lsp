  (setq inicio (getint "\nPrimeiro Termo...(ENTER = 1)...")
	quant (getint "\nNumero de elementos...")
	psimb_txt (getpoint "\nPonto inicial..."))
  (if (= nil inicio) (setq inicio 1))

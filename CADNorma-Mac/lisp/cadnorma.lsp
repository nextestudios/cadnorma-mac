  (cond
    ((= k3_frm "0")
     (setq k3-txt (strcat k3_pfx (rtos cont-k3 2 0) k3_sfx))
    )
    ((= k3_frm "1")
     (if (= 1 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "0" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 2 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx (rtos cont-k3 2 0) k3_sfx)))
    )
    ((= k3_frm "2")
     (if (= 1 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "00" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 2 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "0" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 3 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx (rtos cont-k3 2 0) k3_sfx)))
    )
    ((= k3_frm "3")
     (if (= 1 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "000" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 2 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "00" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 3 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx "0" (rtos cont-k3 2 0) k3_sfx)))
     (if (= 4 (strlen (rtos cont-k3 2 0))) (setq k3-txt (strcat k3_pfx (rtos cont-k3 2 0) k3_sfx)))
    )
  )
  ;definição do estilo de texto
  (setq k3_txsty (nth (fix (distof k3_sty)) k3_stylist))
  (cond
    ((= k3_ali "0") (setq k3_txali "_l"))
    ((= k3_ali "1") (setq k3_txali "_c"))
    ((= k3_ali "2") (setq k3_txali "_m"))
    ((= k3_ali "3") (setq k3_txali "_r"))
  )
  (cn7_txsimb k3_txsty k3_txali k3-txt (fix (distof k3_col)) "Contador3" ang)
)


;execução do comando
(defun k3_action ()
  (prompt (strcat "\nPróximo item = " (rtos cont-k3 2 0) "."))
  (initget 128)
  (setq pt1 (getpoint "\nFomatar/Atualizar/<Ponto de Inserção>... "))
  (cond
    ((= 'LIST (type pt1))
     (k3_wrtext)
     )
    ((= 'STR  (type pt1))
     (cond
       ((= "F" (strcase pt1))
	(cn7_cfg_k3)
	(k3_action)
       )
       ((= "A" (strcase pt1))
	(initget 1)
	(setq cont-k3 (getint "\nPróxima numeração ...<número inteiro>..."))
	(k3_action)
       )
     )
    );cond
    (t (alert "Opção inválida...\nTente novamente!") (k3_action))
  );cond
)


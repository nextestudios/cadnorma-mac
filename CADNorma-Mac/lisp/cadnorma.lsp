(defun graf_capture ()
  (prompt "\nSelecione o traço oblíquo na origem dos eixos do gráfico a identificar...")
  (setq ent1 (car (entsel)))
  (if (and
	(= (strcase (cdr (assoc 0 (entget ent1)))) "INSERT")
	(= (strcase (cdr (assoc 2 (entget ent1)))) "GRAF_CAPT")
      );and
    (progn
      (graf_extract_data)
      (setq vt_factor (/ (distof drweixo_hz_scal) (distof (nth (fix (distof drweixo_vt_scal)) reg_scale_list))))
      (prompt "\nDados Extraídos com sucesso! Agora você já pode operar neste gráfico.")
    )
    (progn
      (alert "\nO objeto selecionado não contém os dados requeridos...")
      (quit)
    );progn case F
  );if
);defun


(defun graf_extract_data ()
  (setq pto_inicial (cdr (assoc 10 (entget ent1)))
	gf_x0 (nth 0 pto_inicial)
	gf_y0 (nth 1 pto_inicial)
	pt0_x gf_x0
	pt0_y gf_y0
  )
;;;  (while (/= nil (setq ent1 (entnext ent1)))
  (while (/= "SEQEND" (strcase (cdr (assoc 0 (entget (setq ent1 (entnext ent1)))))) )
    (if
      (= "ATTRIB" (strcase (cdr (assoc 0 (entget ent1)))))
      (graf_extract_cond)
    )
  )
)

(defun graf_extract_cond ()
  (cond
    ((= "HZ_SCALE" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_hz_scal (cdr (assoc 1 (entget ent1))))
    )
    ((= "HZ_XMIN" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_hz_xmin (cdr (assoc 1 (entget ent1))))
    )
    ((= "HZ_XMAX" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_hz_xmax (cdr (assoc 1 (entget ent1))))
    )
    ((= "HZ_GAP" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_hz_xgap (cdr (assoc 1 (entget ent1))))
    )
    ((= "VT_SCALE" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_vt_scal (cdr (assoc 1 (entget ent1))))
    )
    ((= "VT_YMIN" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_vt_ymin (cdr (assoc 1 (entget ent1))))
    )
    ((= "VT_YMAX" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_vt_ymax (cdr (assoc 1 (entget ent1))))
    )
    ((= "VT_GAP" (strcase (cdr (assoc 2 (entget ent1)))))
     (setq drweixo_vt_ygap (cdr (assoc 1 (entget ent1))))
    )
  )
)





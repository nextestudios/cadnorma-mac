;Arquivos de configuração de alturas
(defun jnl_halt_file ()
  (if (findfile (strcat cnp_root "/config/jnl_altura.txt"))
    (jnl_halt_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/jnl_altura.txt") "w" "utf8"))

;o que fazer com o resultado dos cálculos
(defun tqs_whatdonext ()
  ;constrói a lista para a DCL
  (setq tqs_lista_ferros (list)); "Aço     Diâm. (mm)   Compr(m)   Peso(kg)" ))
  (foreach n tqs_finalist
    (setq linha "")
    (foreach n1 n
      (setq linha (strcat linha "\t" n1))
    )
    (setq tqs_lista_ferros (append tqs_lista_ferros (list linha)))
  )
  ;abre a caixa de diálogo
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "tqs_somaferro" dcl_id)) (exit))
  (start_list "tqs_ferro_list")
  (mapcar 'add_list tqs_lista_ferros)
  (end_list)
  (action_tile "tqs_ferro_list" "(tqs_ferro_list_action)")
  (if (= nil tqs_list_selitem)
    (progn
      (mode_tile "tqs_ferro_btncomp" 1)
      (mode_tile "tqs_ferro_btnpeso" 1)
    )
    (progn
      (set_tile "tqs_ferro_list" tqs_list_selitem)
      (set_tile "tqs_ferro_txtcomp" tqs_list_selcomp)
      (set_tile "tqs_ferro_txtpeso" tqs_list_selpeso)
    )
  )
  (set_tile "tqs_ferro_60txt" (rtos peso_total_60 2 0))
  (set_tile "tqs_ferro_50txt" (rtos peso_total_50 2 0))
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "tqs_ferro_btncomp" "(done_dialog 2)")
  (action_tile "tqs_ferro_btnpeso" "(done_dialog 3)")
  (action_tile "tqs_ferro_60btn" "(done_dialog 4)")
  (action_tile "tqs_ferro_50btn" "(done_dialog 5)")
  (setq tqs_somaferro_dcl (start_dialog))
  (unload_dialog dcl_id)
  (cond
    ((= tqs_somaferro_dcl 2) (tqs_substext 2))
    ((= tqs_somaferro_dcl 3) (tqs_substext 3))
    ((= tqs_somaferro_dcl 4) (tqs_substext 4))
    ((= tqs_somaferro_dcl 5) (tqs_substext 5))
  )
  (princ)
)

;clique no texto para substitui-lo
(defun tqs_substext (tqs_substext_code)
  (cond
    ((= tqs_substext_code 2) (setq new_text tqs_list_selcomp))
    ((= tqs_substext_code 3) (setq new_text tqs_list_selpeso))
    ((= tqs_substext_code 4) (setq new_text (strcat (rtos peso_total_60 2 0) " kg")))
    ((= tqs_substext_code 5) (setq new_text (strcat (rtos peso_total_50 2 0) " kg")))
  )
  (prompt "\nSelecione o texto a substituir...")
  (setq ent (entsel)
	ent_name (car ent)
	ent_list (entget ent_name)
	ent_txlen (strlen (cdr (assoc 1 ent_list)))
	ent_list (entmod (subst (cons 1 new_text) (assoc 1 ent_list) ent_list))
	dif_txt (- ent_txlen (strlen new_text))
  )
;;;  (setq dif_txt (- ent_txlen (strlen new_text)))
  (repeat dif_txt
    (setq new_text (strcat " " new_text)
	  ent_list (entmod (subst (cons 1 new_text) (assoc 1 ent_list) ent_list))
    )
  )
  (setq resp (getstring "\nTecle <ENTER> para retornar ou qualquer tecla para terminar..."))
  (if (= resp "")
    (tqs_whatdonext)
    (exit)
  )
)	


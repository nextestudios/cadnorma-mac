  (set_tile "jnl_cobo_qtd" jnl_cobo_qtd)
  (action_tile "jnl_cobo_qtd" "(jnl_cobo_getqtd)")
  (set_tile "jnl_cobo_pct" jnl_cobo_pct)
  (action_tile "jnl_cobo_pct" "(jnl_cobo_getpct)")
  (jnl_cobo_radioaction2)
  (action_tile "jnl_cobo_radio" "(jnl_cobo_radioaction)")
  ;visibilidade
  (set_tile "jnl_cobo_visib" jnl_cobo_vis)
  (action_tile "jnl_cobo_visib" "(setq jnl_cobo_vis $value)")
  ;ações ok_cancel
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq jnl_cobo_id (start_dialog))
  (unload_dialog dcl_id)
  (if (= 0 jnl_cobo_id) (exit))
  (if (= 1 jnl_cobo_id) (jnl_cobo_ok))
  (if (= 2 jnl_cobo_id) (jnl_cobo_pickvao))
)


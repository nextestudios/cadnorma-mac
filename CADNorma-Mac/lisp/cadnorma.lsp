;Seleção e separação de objetos: new_list
(defun q_rel_select ()
  (prompt "\nSelecione o trecho que deseja quantificar... ")
  (setq s1 (ssget '((0 . "INSERT")))
	s1_len (sslength s1)
	counter 0
	rel_selist (ssadd)
	full_list nil
	ent_quant nil
  )
  ;analisa cada elemento selecionado e constroi a lista geral
  (while (< counter s1_len)
    (setq e1 (ssname s1 counter)
	  e1_list (entget e1)
	  e1_blkname (cdr (assoc 2 e1_list)))
    (if (or (= (strcase e1_blkname t) "cnqt_ponto")
	    (= (strcase e1_blkname t) "cnqt_area")
	    (= (strcase e1_blkname t) "cnqt_vertical")
	    (= (strcase e1_blkname t) "cnqt_linha")
	    (= (strcase e1_blkname t) "cnqt_areav")
	    (= (strcase e1_blkname t) "cnqt_volume")
	 )
      (progn
	(setq rel_selist (ssadd e1 rel_selist))
	(while (/= "SEQEND" (cdr (assoc 0 (setq selent (entget (setq e1 (entnext e1)))))))
	  (if (= "ATTRIB" (cdr (assoc 0 selent)))
	    (cond
	      ((= "QUANT" (cdr (assoc 2 selent))) (setq ent_quant (cdr (assoc 1 selent))))
	      ((= "CNQT" (cdr (assoc 2 selent))) (setq ent_code (cdr (assoc 1 selent))))
	    )
	  )
	)
	(setq temp_list (list ent_code ent_quant)
	      full_list (append (list temp_list) full_list)
	)
      )
    )
    (setq counter (1+ counter))
  );while
  (setq full_list2 full_list)  
  (setq full_list (vl-sort full_list
	   (function (lambda (e1 e2) (< (nth 0 e1) (nth 0 e2))))))
  (sssetfirst gripset rel_selist)
  (rel_orglist)
  (sssetfirst nil)
)

;Desenha tabela só de quantitativos;;;;;   denio
(defun q_rel_drawtable ()
  (setq grupo nil subgrupo nil grupo_last nil subgrupo_last nil)
  (if (not (tblsearch "style" "quantnorma_text"))
    (command  "._style" "quantnorma_text"  "romans" "0" "" "" "" "" "")
    (setvar "textstyle" "quantnorma_text")
  )
  (setq item_counter 1)
  (initget 128)
  (setq p0 (getpoint "\nPonto superior esquerdo da tabela... <L> para migrar para o Layout..."))
  (cond      
    ((= 'STR  (type p0))
      (cond
         ((= "L" (strcase p0))
	   (if (= 0 (getvar "tilemode"))
	    (command "._pspace")
	    (progn
	      (command "._tilemode" "0")
	      (command "._pspace")
	    )
	   )
	   (initget 1)
	   (setq p0 (getpoint "\nClique no ponto superior esquerdo da tabela..."))
	 )
	 (t
	  (prompt "\nOpção inválida! Digite 'L' ou marque o primeiro ponto...")
	  (q_rel_drawtable)
	 )
       )
     )
  )
  (cn7_find_blkscl)
  (cn7_verylayer "cnqt" 7)
  (rel_draw_cabeçalho)
  (setq rel_grupo nil
	rel_subgrupo nil
  )	
  (foreach n qtable_list
    (if grupo (setq grupo_last grupo))
    (if subgrupo (setq subgrupo_last subgrupo))
    (rel_extract)
    (if (/= grupo_last grupo)
      (progn
	(rel_draw_grupo)
	(rel_draw_subgrupo)
	(rel_draw_cabitem)
      )
      (if (/= subgrupo_last subgrupo)
	(progn
	  (rel_draw_subgrupo)
	)
      )
    )
    (rel_draw_item)
    (rel_close_sub)
    (rel_close_table)
    (setq item_counter (1+ item_counter))
  )
)


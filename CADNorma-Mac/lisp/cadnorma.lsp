    (dimx_tile "jnl_layc_cxc")
    (dimy_tile "jnl_layc_cxc")
    (fix (distof jnl_layc_cxc))
  )
  (end_image)
  (action_tile "jnl_layc_cxc" "(jnl_layc_cxc_color)")
  ;Vista

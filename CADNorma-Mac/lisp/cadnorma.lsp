;coleção de escalas regulares
(defun reg_scale ()
  (if (not (findfile (strcat cnp_root "/config/reg_scale.txt")))
    (progn
      (setq reg_scale_list
	 (list
	   "1" "10" "100" "1000" "10000" "100000" "1000000"
	   "12.5" "125" "1250" "12500" "125000"
	   "1.5" "15" "150" "1500" "15000" "150000"
	   "2" "20" "200" "2000" "20000" "200000"
	   "2.500" "25" "250" "2500" "25000" "250000"
	   "3" "30" "300" "3000" "30000" "300000"
	   "4" "40" "400" "4000" "40000" "400000"
	   "5" "50" "500" "5000" "50000" "500000"
	   "7.500" "75" "750" "7500" "75000" "750000"
	 )
      )
      (setq open_file (open (strcat cnp_root "/config/reg_scale.txt") "w" "utf8"))
      (foreach n reg_scale_list
	(write-line n open_file)
      )
      (close open_file)
    )
    (progn
      (setq reg_scale_list (list " "))
      (setq open_file (open (strcat cnp_root "/config/reg_scale.txt") "r" "utf8"))
      (while (/= nil (setq linha (read-line open_file)))
	(setq reg_scale_list (append reg_scale_list (list linha)))
      )
      (close open_file)
      (setq reg_scale_list (cdr reg_scale_list))
    )
  )
)

;cria lista d escalas regulares
(reg_scale)


;******************************************************************************
;Controle de Escalas Regulares                                                

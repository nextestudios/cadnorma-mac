;isolate by freeze
(defun c:isf ()
  (setq echo (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (prompt "\nSelecione os layers a serem isolados...")
  (setq isolay_keep (ssget))
  (if (null isolay_keep)
    (while (null isolay_keep)
      (princ "\nTente novamente ou pressione <ESC> para sair ")
      (prompt "\nSelecione os layers a serem isolados...")
      (setq isolay_keep (ssget))
    )
  )
  (setq isolay_list (list "")
	counter 0
	isolay_currlay (cdr (assoc 8 (entget (ssname isolay_keep 0))))
	isolay_currcol (cdr (assoc 62 (tblsearch "layer" isolay_currlay)))
  )
  (while (/= nil (setq ent (ssname isolay_keep counter)))
    (setq isolay_list (append isolay_list (list (cdr (assoc 8 (entget ent))))))
    (setq counter (1+ counter))
  )
  (setq isolay_list (cdr isolay_list))
  (if (not (member (getvar "clayer") isolay_list))
    (setvar "clayer" (nth 0 isolay_list))
  )
  (command "._layer" "_freeze" "*")
  (foreach n isolay_list
    (command "_thaw" n)
  )
  (command "")  
  (setvar "CMDECHO" echo)
  (princ)
)



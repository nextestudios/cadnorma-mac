;lâ a lista de alturas disponíveis
(defun jnl_halt_readfile ()
  (setq file (open (strcat cnp_root "/config/jnl_altura.txt") "r" "utf8"))
  (setq jnl_halt_list (list))
  (while (/= nil (setq linha (read-line file)))
    (setq jnl_halt_list (append jnl_halt_list (list linha)))
  )
  (close file)
)

;escreve a lista de alturas disponíveis
(defun jnl_halt_writefile ()
  (setq file (open (strcat cnp_root "/config/jnl_altura.txt") "w" "utf8"))
  (foreach n jnl_halt_list
    (write-line n file)
  )
  (close file)
)


;botão ok
(defun jnl_cfghalt_ok ()
  (jnl_halt_writefile)
  (jnl_main)
)

;botão Excluir
(defun jnl_cfghalt_delete ()
  (setq counter 0
	halt_list_len (length jnl_halt_list)
	new_list (list)
  )
  (repeat halt_list_len
    (if (/= counter (fix (distof jnl_cfghalt_sel)))
      (setq new_list (append new_list (list (nth counter jnl_halt_list))))
    )
    (setq counter (1+ counter))
  )
  (setq jnl_halt_list new_list)
  (start_list "jnl_cfghalt_list")
  (mapcar 'add_list jnl_halt_list)
  (end_list)
  (set_tile "jnl_cfghalt_list" jnl_cfghalt_sel)
)
	    

;botão Adicionar
(defun jnl_cfghalt_addaction ()
  (setq jnl_gethalt_nova nil)
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "jnl_halt_getnew" dcl_id)) (exit))
  (mode_tile "jnl_halt_getnew_edit" 2)
  (action_tile "jnl_halt_getnew_edit" "(setq jnl_gethalt_nova $value)")
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq jnl_gethalt_dclid (start_dialog))
  (unload_dialog dcl_id)
  (if (= 1 jnl_gethalt_dclid)
    (if (and (/= nil jnl_gethalt_nova)
	     (/= "" jnl_gethalt_nova)
	     (distof jnl_gethalt_nova)
	)
      (progn
	(setq jnl_halt_list (append jnl_halt_list (list jnl_gethalt_nova)))
	(jnl_halt_writefile)
	(jnl_halt_file)
        (jnl_haltedit_action)
      )
    )
  )
)

;ao selecionar um item da lista
(defun jnl_cfghalt_selist ()
  (setq jnl_cfghalt_sel $value
	halt_list_len (length jnl_halt_list)
  )
  (cond
    ((= "0" jnl_cfghalt_sel)
     (mode_tile "jnl_cfghalt_up" 1)
     (mode_tile "jnl_cfghalt_down" 0)
    )
    ((= jnl_cfghalt_sel (rtos (1- halt_list_len) 2 0))
     (mode_tile "jnl_cfghalt_up" 0)
     (mode_tile "jnl_cfghalt_down" 1)
    )
    (t
     (mode_tile "jnl_cfghalt_up" 0)
     (mode_tile "jnl_cfghalt_down" 0)
    )     
  )
)

;ação para o botão "up"
(defun jnl_cfghalt_up ()
  (setq halt_1 (fix (distof jnl_cfghalt_sel));selecionado
	halt_2 (1- halt_1);subir
	counter 0
	new_list2 (list))
  (while (< counter (length jnl_halt_list))
    (if (= counter halt_2)
      (progn
	(setq new_list2 (append new_list2 (list (nth (1+ counter) jnl_halt_list))))
	(setq new_list2 (append new_list2 (list (nth counter jnl_halt_list))))
	(setq counter (+ 2 counter))
      )
      (progn
	(setq new_list2 (append new_list2 (list (nth counter jnl_halt_list))))
	(setq counter (1+ counter))
      )
    )
  )
  (setq jnl_halt_list new_list2)
  (start_list "jnl_cfghalt_list")
  (mapcar 'add_list jnl_halt_list)
  (end_list)
  (setq jnl_cfghalt_sel (rtos (1- (fix (distof jnl_cfghalt_sel))) 2 0))
  (set_tile "jnl_cfghalt_list" jnl_cfghalt_sel)
  (cond
    ((= "0" jnl_cfghalt_sel)
     (mode_tile "jnl_cfghalt_up" 1)
     (mode_tile "jnl_cfghalt_down" 0)
    )
    ((= jnl_cfghalt_sel (rtos (1- halt_list_len) 2 0))
     (mode_tile "jnl_cfghalt_up" 0)
     (mode_tile "jnl_cfghalt_down" 1)
    )
    (t
     (mode_tile "jnl_cfghalt_up" 0)
     (mode_tile "jnl_cfghalt_down" 0)
    )     
  )
)


;layer control - botão OK
(defun cn7_lac_ok ()
  (cond
    ((and (= cdn_txt 1) (= cus_txt 1)) (setvar "useri5" 0))
    ((and (= cdn_txt 1) (= cus_txt 0)) (setvar "useri5" 1))
    ((and (= cdn_txt 0) (= cus_txt 1)) (setvar "useri5" 2))
    ((and (= cdn_txt 0) (= cus_txt 0)) (setvar "useri5" 3))
  )
  (cond
    ((and (= cdn_dim 1) (= cus_dim 1)) (setvar "useri4" 0))
    ((and (= cdn_dim 1) (= cus_dim 0)) (setvar "useri4" 1))
    ((and (= cdn_dim 0) (= cus_dim 1)) (setvar "useri4" 2))
    ((and (= cdn_dim 0) (= cus_dim 0)) (setvar "useri4" 3))
  )

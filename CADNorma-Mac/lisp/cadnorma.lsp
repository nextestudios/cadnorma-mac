;******************************************************************************
;Função que verifica o status do layer requisitado: se não existir, será criado!!!
;******************************************************************************
(defun cn7_verylayer (cn7_very_layname cn7_laycol)
  (setq cn7_currlayer nil)
  ;se existe o layer solicitado
  (if (/= nil (setq cn7_currlayer (tblsearch "layer" cn7_very_layname)))
    (progn
      (setq cn7_layname (cdr (assoc 2 cn7_currlayer)))
      ;verifica se está desligado
      (if (= -30 (cdr (assoc 62 cn7_currlayer)))
	(progn
	  (cn7_alert_yes_no
	    "O layer solicitado está desligado!"
	    (strcat "layer = " cn7_layname)
	    "Deseja ligá-lo e Prosseguir?"
	  )
	  (if (= alert_resp "yes")
	    (command "._layer" "_on" cn7_layname "")
	    (exit)
	  )
	)
      );if
      (cond
	;se (assoc 70) é 1, está só freeze
	((= 1 (cdr (assoc 70 cn7_currlayer)))
	 (cn7_alert_yes_no
	   "O layer solicitado está congelado"
	   (strcat "layer = " cn7_layname)
	   "Deseja descongelá-lo e Prosseguir?"
	 )
	 (if (= alert_resp "yes")
	   (command "._layer" "_thaw" cn7_layname "")
	   (exit)
	 )
        )
	;se (assoc 70) é 4, é só lock
	((= 4 (cdr (assoc 70 cn7_currlayer)))
	 (cn7_alert_yes_no
	   "O layer solicitado está trancado"
	   (strcat "layer = " cn7_layname)
	   "Deseja destrancá-lo e Prosseguir?"
	 )
	 (if (= alert_resp "yes")
	   (command "._layer" "_unlock" cn7_layname "")
	   (exit)
	 )
        )
	;se (assoc 70) é 5, está freeze e lock
	((= 5 (cdr (assoc 70 cn7_currlayer)))
	 (cn7_alert_yes_no
	   "O layer solicitado está trancado e congelado!"
	   (strcat "layer = " cn7_layname)
	   "Deseja desfazer e Prosseguir?"
	 )
	 (if (= alert_resp "yes")
	   (progn
	     (command "._layer" "_unlock" cn7_layname "")
	     (command "._layer" "_thaw" cn7_layname "")
	   )
	   (exit)
	 )
        )
      );cond
      (command "._layer" "_m" cn7_very_layname "_c" cn7_laycol "" "");(setvar "clayer" cn7_very_layname)
    )
    (progn
      (command "._layer" "_m" cn7_very_layname "_c" cn7_laycol "" "")
      (prompt (strcat "...Criado layer <" (strcase cn7_very_layname) ">, com a cor <" (rtos cn7_laycol 2 0) ">."))
    )
  )
)


;função que lê o arquivo de dados
(defun cbt_layc_readfile ()
  (setq	file (open (strcat cnp_root "/config/cbt_layc.txt") "r" "utf8"))
  (setq	cbt_layc_cbl (read-line file))
  (setq	cbt_layc_cbc (read-line file))
  (setq	cbt_layc_edl (read-line file))
  (setq	cbt_layc_edc (read-line file))
  (setq	cbt_layc_hcl (read-line file))
  (setq	cbt_layc_hcc (read-line file))
  (setq	cbt_layc_stl (read-line file))
  (setq	cbt_layc_stc (read-line file))
  (close file)
)

;função que escreve o arquivo de dados
(defun cbt_layc_writefile ()
  (setq	file (open (strcat cnp_root "/config/cbt_layc.txt") "w" "utf8"))

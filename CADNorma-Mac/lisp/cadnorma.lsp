;seleção anterior
(defun cnqt_selmode_l1 ()
  (setq s1 (ssget "_P"))
  (sssetfirst gripset s1)
  (initget "Sim Não")
  (setq alert_resp (getkword "\nConcorda com a seleção? <S>/N: "))
  (if (= nil alert_resp) (setq alert_resp "Sim"))
  (if (= alert_resp "Sim")
    (progn
      (command "._undo" "_m")
      (get_linrepet)
      (cn7_find_blkscl)
      (cn7_verylayer "cnqt" 7)
      (setq s1_n (sslength s1) counter 0)
      (repeat s1_n
	(setq ent (ssname s1 counter)
	      ent_list (entget ent)
	      ent_type (cdr (assoc 0 ent_list)))
	(cond
	  ((= (strcase ent_type) "LINE")
	   (setq pt0 (cdr (assoc 10 ent_list))
		 pt2 (cdr (assoc 11 ent_list))
		 dist (distance pt0 pt2)
		 pt1 (polar pt0 (angle pt0 pt2) (/ dist 2)))
	   (setq dist (* cnqt_repet dist))
	  (command "._insert" (strcat cnp_netroot "/quant/cnqt_linha") "_s" cn7_blkscl "_non" pt1 pt2 cnqt_code (rtos dist 2 2))
	  )
	  ((= (strcase ent_type) "ARC")
	   (setq arc_length (* (cdr (assoc 40 ent_list)) (- (cdr (assoc 51 ent_list)) (cdr (assoc 50 ent_list)))))
	   (setq pt1 (polar
		       (cdr (assoc 10 ent_list))
		       (+ (cdr (assoc 50 ent_list)) (/ (- (cdr (assoc 51 ent_list)) (cdr (assoc 50 ent_list))) 2))
		       (cdr (assoc 40 ent_list)))
           )
	   (setq arc_length (* cnqt_repet arc_length))
	   (command "._insert" (strcat cnp_netroot "/quant/cnqt_linha") "_s" cn7_blkscl "_non" pt1 0 cnqt_code (rtos arc_length 2 2))
	  )
	  ((= (strcase ent_type) "CIRCLE")
	   (command "._area" "_e" ent)
	   (setq pt1 (cdr (assoc 10 ent_list)))
	   (setq perim (* cnqt_repet (getvar "perimeter")))
	   (command "._insert" (strcat cnp_netroot "/quant/cnqt_linha") "_s" cn7_blkscl "_non" pt1 0 cnqt_code (rtos perim 2 2))
	  )
	  ((= (strcase ent_type) "LWPOLYLINE")
	   (cnqt_lwpline)
	   (setq counter2 0)
	   (repeat (1- (length lwpline_list))
	     (setq pt0 (nth counter2 lwpline_list)
		   pt2 (nth (1+ counter2) lwpline_list)
		   dist (distance pt0 pt2)
		   pt1 (polar pt0 (angle pt0 pt2) (/ (distance pt0 pt2) 2))
		   counter2 (1+ counter2)
             )
	     (setq dist (* cnqt_repet dist))
	     (command "._insert" (strcat cnp_netroot "/quant/cnqt_linha") "_s" cn7_blkscl "_non" pt1 "_non" pt2 cnqt_code (rtos dist 2 2))
	   )
	   (if (= 1 (cdr (assoc 70 ent_list)))
	     (progn
	       (setq pt0 (nth counter2 lwpline_list)
		     pt2 (nth 0 lwpline_list)
		     dist (distance pt0 pt2)
		     pt1 (polar pt0 (angle pt0 pt2) (/ (distance pt0 pt2) 2))
		     counter2 (1+ counter2)
	       )
	       (setq dist (* cnqt_repet dist))
	       (command "._insert" (strcat cnp_netroot "/quant/cnqt_linha") "_s" cn7_blkscl "_non" pt1 "_non" pt2 cnqt_code (rtos dist 2 2))
	      )
	   );if
	  );cond pline
	);cond
	(setq counter (1+ counter))
	(setq pt1 nil)
      )
    )
  )
  (exit)
  (princ)
)



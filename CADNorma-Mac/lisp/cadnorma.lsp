;linemend
(defun c:linemend ( / ent1 ent2 params1 1pt10 2pt10 old10
                      1pt11 2pt11 old11 dist1 dist2 dist3 dist4
                      distlist maxdist pt1 pt10 pt11)
   (setq ent1 (entsel "\nSelecione a 1a linha:  "))
   (setvar "cmdecho" 0)
   (setvar "orthomode" 1)
   (while ent1
      (setq ent1 (car ent1))
      (redraw ent1 3)
      (setq ent2 (car (entsel "\nSelecione a 2a linha...  ")))
      (while (null ent2)
         (prompt "\nNo entity found.")
         (setq ent1 (car (entsel "\nSelect second line:  ")))
         (if (/= (cdr (assoc 0 (entget ent2))) "LINE")
            (progn
               (prompt "\nLines Only!")
               (setq ent2 nil)
            )                                         ;progn
         )                                            ;if
      )                                               ;while

      (redraw ent2 3)
      (setq params1 (entget ent1)
            1pt10 (cdr (setq old10 (assoc 10 params1)))
            1pt11 (cdr (setq old11 (assoc 11 params1)))
            params2 (entget ent2)
            2pt10 (cdr (assoc 10 params2))
            2pt11 (cdr (assoc 11 params2))
            dist1 (distance 1pt10 2pt10)
            dist2 (distance 1pt10 2pt11)
            dist3 (distance 1pt11 2pt10)
            dist4 (distance 1pt11 2pt11)
            distlist
              (list
                 (list dist1 1pt10 2pt10)
                 (list dist2 1pt10 2pt11)
                 (list dist3 1pt11 2pt10)
                 (list dist4 1pt11 2pt11)
              );list
            maxdist (max dist1 dist2 dist3 dist4)
            pts (cdr (assoc maxdist distlist))
            pt10 (car pts)
            pt11 (cadr pts)
            params1 (subst (cons 10 pt10) old10 params1)
            params1 (subst (cons 11 pt11) old11 params1)
      )                                               ;setq calculations

      (entdel ent2)
      (entmod params1)
      (entupd ent1)
      (setq ent1 (entsel "\nSelect first line:  "))
   )                                                  ;while loop

   (setvar "cmdecho" 1)
   (gc) (princ)
)                                                     ;defun



;altera espassura de várias polilinhas
(defun c:plwid ()
  (command "._undo" "_m")
  (setq new_width (getreal "\nEspessura desejada..."))
  (setq s1 (ssget))
  (setq s1_n (sslength s1)
	counter 0
  )
  (repeat s1_n
    (setq ent (ssname s1 counter))
    (setq ent1 (entget ent))
    (if (or (= "LWPOLYLINE" (cdr (assoc 0 ent1)))
	    (= "POLYLINE" (cdr (assoc 0 ent1)))
	)
      (command "._pedit" ent "_w" new_width "")
    )
    (setq counter (1+ counter))
  )
  (princ)
)

;spline para pline via divide (quantidade)
(defun c:spldv ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
      "textstyle" "luprec" "osmode" ))
  (setq osmo (getvar "osmode"))
  (setvar "osmode" 0)
  (setq cmdecho (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (setq blipmode (getvar "BLIPMODE"))
  (setvar "BLIPMODE" 0)
  (setq snapmode (getvar "SNAPMODE"))
  (setvar "SNAPMODE" 0)
  (setq entpick (entsel "\nSelecione uma SPLINE/3DPOLY: "))
  (setq ent (entget (car entpick)))
  (setq sp (cdr (assoc 10 ent)))
  (setq ep (cdr (assoc 10 (reverse ent))))
  (setq spl_dist (getint "\nEntre com o numero de segmentos: "))
  (setq clayer (getvar "CLAYER"))
  (cn7_verylayer "spl" 214)  
;;;  (command "._layer" "_m" "spl" "_c" "7" "" "")
  (princ "\nAgora, espere...")
  (command "_.divide" entpick spl_dist)
  (setq	aws (ssget "X"
		   (list (cons 0 "POINT") (cons 8 "SPL"))
	    )
  )
  (princ ".")
  (setq number (sslength aws))
  (setq count 0)
  (command "_.pline" ep)
  (princ ".")
  (while (< count number)    (setq entnam (ssname aws count))
    (setq ent (entget entnam))
    (setq ins (cdr (assoc 10 ent)))
    (command ins)
    (princ ".")
    (setq count (1+ count))
  )
  (command sp "")
  (command "_.erase" aws entpick "")
;;;  (command "._layer" "_s" clayer "")
;;;  (setvar "CMDECHO" cmdecho)
;;;  (setvar "BLIPMODE" blipmode)
;;;  (setvar "SNAPMODE" snapmode)
;;;  (setvar "osmode" osmo)
  (princ "\nFeito!")
  (devolve)
  (princ)
)



    (cbt_draw_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/cbt_draw.txt") "w" "utf8"))
      (write-line "100" file)
      (write-line "600" file)
      (write-line "200" file)
      (write-line "600" file)
      (write-line "200" file)
      (write-line "200" file)
      (write-line "200" file)
      (close file)
      (cbt_draw_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun cbt_draw_readfile ()
  (setq	file (open (strcat cnp_root "/config/cbt_draw.txt") "r" "utf8"))
  (setq	cbt_drw_p (read-line file))
  (setq	cbt_drw_a (read-line file))
  (setq	cbt_drw_b (read-line file))
  (setq	cbt_drw_c (read-line file))
  (setq	cbt_drw_d (read-line file))
  (setq	cbt_drw_e (read-line file))
  (setq	cbt_drw_f (read-line file))
  (close file)
)


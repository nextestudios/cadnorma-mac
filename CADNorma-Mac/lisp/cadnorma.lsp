;encontra dimscale / define Layer
(defun cn7_dim_scllay  ()
  (cn7_init)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (cond
    ((and (= cdn_dim 1) (= (getvar "dimstyle") "cadnorma_dim1")) (cn7_verylayer (strcat cn7_blk_prefixlay "dim1") 1))    
    ((and (= cdn_dim 1) (= (getvar "dimstyle") "cadnorma_dim2")) (cn7_verylayer (strcat cn7_blk_prefixlay "dim2") 1))
    ((and (= cdn_dim 1) (= (getvar "dimstyle") "cadnorma_dim3")) (cn7_verylayer (strcat cn7_blk_prefixlay "dim3") 1))
    ((and (= cus_dim 1) (= (getvar "dimstyle") "cadnorma_dim4")) (cn7_verylayer (strcat cn7_blk_prefixlay "dim4") 1))
    ((and (= cus_dim 1) (= (getvar "dimstyle") "cadnorma_dim5")) (cn7_verylayer (strcat cn7_blk_prefixlay "dim5") 1))
  )
  (if (= 1 (getvar "tilemode"))
    (progn
      (setvar "dimscale" (/ (* cn7_msscl cn7_dwgunit) 1000 ))
      (setvar "dimlfac" (* (/ cn7_dimunit cn7_dwgunit) scdim_newscale))
      (if (/= 1.0 scdim_newscale)
	(prompt (strcat "Atenção! Cotas multiplicadas por " (rtos scdim_newscale 2 2) "..."))
      )
    )
    (progn
      (setvar "dimscale" 0.0)
      (setvar "dimlfac" 1.0)
    )
  )
  (princ)
);defun



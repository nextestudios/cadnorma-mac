;troca o código
(defun cnqt_change ()
  (cond
    ((= item_type "1") (setq s1 (ssget '((0 . "INSERT") (2 . "cnqt_ponto")))))
    ((= item_type "2") (setq s1 (ssget '((0 . "INSERT") (2 . "cnqt_linha")))))
    ((= item_type "3") (setq s1 (ssget '((0 . "INSERT") (or (2 . "cnqt_area") (2 . "cnqt_area"))))))
    ((= item_type "4") (setq s1 (ssget '((0 . "INSERT") (2 . "cnqt_volume")))))
  )
  (sssetfirst gripset (ssget "_P"))
  (initget "Sim Não")
  (setq alert_resp (getkword "\nConcorda com a seleção? <S/N>: "))
  (if (or (= alert_resp "Sim") (= alert_resp nil))
    (progn
      (sssetfirst nil)
      (setq s1_len (sslength s1)
	    counter 0
	    cnqt_insert_list nil
	    cnqt_ssent (ssadd)
      )
      (while (< counter s1_len)
	(setq e1 (ssname s1 counter)
	      e1_list (entget e1)
	      e1_blkname (cdr (assoc 2 e1_list))
	)
	(while (/= "SEQEND" (cdr (assoc 0 (setq selent (entget (setq e1 (entnext e1)))))))
	  (if (= "ATTRIB" (cdr (assoc 0 selent)))
	    (cond
	      ((= "CNQT" (strcase (cdr (assoc 2 selent))))
	       (setq e2_list (entget e1))
	       (setq e2_list (entmod (subst (cons 1 cnqt_code) (assoc 1 e2_list) e2_list)))
	       )
	      )
	    )
	  );while
	(setq counter (1+ counter))
      );while
    )
  )
)

;identificar código
(defun c:qid ()
  (prompt "\nSelecione o identificador que deseja verificar...")
  (setq ent (car (entsel)))
  (setq ent_list (entget ent))
  (if (not (= "INSERT" (strcase (cdr (assoc 0 ent_list)))))
    (progn
      (alert "O item selecionado\nnão é um bloco válido!")
      (exit)
    )
    (progn
      (setq blk_name (cdr (assoc 2 ent_list)))
      (cond
	((= (strcase blk_name t) "cnqt_ponto") (setq cnqt_show_type 1) (cd_extract))
	((= (strcase blk_name t) "cnqt_linha") (setq cnqt_show_type 2) (cd_extract))
	((= (strcase blk_name t) "cnqt_vertical") (setq cnqt_show_type 2) (cd_extract))
	((= (strcase blk_name t) "cnqt_area") (setq cnqt_show_type 3) (cd_extract))
	((= (strcase blk_name t) "cnqt_areav") (setq cnqt_show_type 3) (cd_extract))
	((= (strcase blk_name t) "cnqt_volume") (setq cnqt_show_type 4) (cd_extract))
	(t (alert "Bloco Inválido!") (exit))
      )
    )
  )
  (cd_show)
)

;abre a DCL mostrando os dados do código selecionado

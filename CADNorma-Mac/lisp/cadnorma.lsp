	cb2_pt5 (polar cb2_pt4 cb2_angbase (+ (* cbt_fator (distof cbt_drw_a)) (* 2.0 cbt_fator (distof cbt_drw_p))))
	cb2_pt6 (polar cb2_pt5 (+ cb2_angbase (/ pi 2))
		       (+ (* cbt_fator (distof cbt_drw_b)) (* 2.0 cbt_fator (distof cbt_drw_p))))
	cb2_pt7 (polar cb2_pt4 (+ cb2_angbase (/ pi 2))
		       (+ (* cbt_fator (distof cbt_drw_b)) (* 2.0 cbt_fator (distof cbt_drw_p))))

    ((= 0 (getvar "useri5"))
     (set_tile "allay_text_cadnorma" "1")
     (set_tile "allay_text_custom" "1")
     (setq cdn_txt 1 cus_txt 1))    
    ((= 1 (getvar "useri5"))
     (set_tile "allay_text_cadnorma" "1")
     (set_tile "allay_text_custom" "0")
     (setq cdn_txt 1 cus_txt 0))
    ((= 2 (getvar "useri5"))
     (set_tile "allay_text_cadnorma" "0")
     (set_tile "allay_text_custom" "1")
     (setq cdn_txt 0 cus_txt 1))
    ((= 3 (getvar "useri5"))
     (set_tile "allay_text_cadnorma" "0")
     (set_tile "allay_text_custom" "0")
     (setq cdn_txt 0 cus_txt 0))
  )
  (cond
    ((= 0 (getvar "useri4"))
     (set_tile "allay_dim_cadnorma" "1")
     (set_tile "allay_dim_custom" "1")
     (setq cdn_dim 1 cus_dim 1))
    ((= 1 (getvar "useri4"))
     (set_tile "allay_dim_cadnorma" "1")
     (set_tile "allay_dim_custom" "0")
     (setq cdn_dim 1 cus_dim 0))
    ((= 2 (getvar "useri4"))
     (set_tile "allay_dim_cadnorma" "0")
     (set_tile "allay_dim_custom" "1")
     (setq cdn_dim 0 cus_dim 1))
    ((= 3 (getvar "useri4"))
     (set_tile "allay_dim_cadnorma" "0")
     (set_tile "allay_dim_custom" "0")
     (setq cdn_dim 0 cus_dim 0))
  )
  ;ações dos toggles
  (action_tile "allay_text_cadnorma" "(setq cdn_txt (fix (distof $value)))")
  (action_tile "allay_text_custom" "(setq cus_txt (fix (distof $value)))")
  (action_tile "allay_dim_cadnorma" "(setq cdn_dim (fix (distof $value)))")
  (action_tile "allay_dim_custom" "(setq cus_dim (fix (distof $value)))")

;******************************************************************************
; DESENHA OS EIXOS NAS ESCALAS DETERMINADAS -> DCL
;******************************************************************************
(defun c:gre ()
  (cn7_init)
  (if (/= cn7_dwgunit 1.0)
    (progn
      (cn7_alert_ok
	  "Por enquanto, os gráficos aplicam-se"
	  "apenas para desenhos em metros!"
	  "Aguardem novas atualizações..."
      )
      (exit)
     )
  )
  ;verifica se está no Paper Space
  (if (and (= (getvar "tilemode") 0) (= 1 (getvar "cvport")))
    (progn
      (cn7_alert_ok
	"Os gráficos só podem ser"
	"contruídos no Model Space"
	"ou em uma Viewport Ativa.")
      (exit)
    )
  )
  ;define a escala horizontal
  (setq grp_type "2")
  (cn7_find_blkscl)
  (defgraf_readfile)
  (drweixo_file)
  (setq drweixo_hz_scal (rtos (getvar "userr3") 2 2))
  (setq graf_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			   "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (setq cn7_txtsty (nth (fix (distof graf_txs)) graf_stylist))
  (cn7_text_hfinal)
  (cn7_text_height)
  ;abre a DCL
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "graf_eixos" dcl_id)) (exit))
  ;escala horizontal
  (set_tile "hz_scale" drweixo_hz_scal)
  (mode_tile "hz_scale" 1)
  ;x mínimo
  (set_tile "hz_xmin" drweixo_hz_xmin)
  (action_tile "hz_xmin" "(setq drweixo_hz_xmin $value)")
  ;x máximo
  (set_tile "hz_xmax" drweixo_hz_xmax)
  (action_tile "hz_xmax" "(setq drweixo_hz_xmax $value)")
  ;x incremento
  (set_tile "hz_xgap" drweixo_hz_xgap)
  (action_tile "hz_xgap" "(setq drweixo_hz_xgap $value)")
  ;escala vertical
  (start_list "vt_scale")
  (mapcar 'add_list reg_scale_list)
  (end_list)
  (set_tile "vt_scale" drweixo_vt_scal)
  (action_tile "vt_scale" "(setq drweixo_vt_scal $value)")
  ;y mínimo
  (set_tile "vt_ymin" drweixo_vt_ymin)
  (action_tile "vt_ymin" "(setq drweixo_vt_ymin $value)")
  ;y máximo
  (set_tile "vt_ymax" drweixo_vt_ymax)
  (action_tile "vt_ymax" "(setq drweixo_vt_ymax $value)")
  ;y incremento
  (set_tile "vt_ygap" drweixo_vt_ygap)
  (action_tile "vt_ygap" "(setq drweixo_vt_ygap $value)")
  ;ações
  (action_tile "cancel" "(done_dialog 0)")
  (action_tile "accept" "(done_dialog 1)")
  (setq graf_dcl (start_dialog))
  (unload_dialog dcl_id)
  (if (= graf_dcl 1)
    (progn
      (command "undo" "m")
      (drweixo_write_file)
      (drweixo_draw)
    )
  )
  (princ)
)

(defun drweixo_draw ()
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq pt0 (getpoint "\nMarque a origem do eixo...")
	pt0_x (nth 0 pt0)
	pt0_y (nth 1 pt0)
  )
  (cn7_verylayer "Gráficos" 3)
  ;fator de correção e quantidades de grade
  (setq vt_factor (/ (distof drweixo_hz_scal) (distof (nth (fix (distof drweixo_vt_scal)) reg_scale_list)))
	hz_quant (fix (/ (- (distof drweixo_hz_xmax) (distof drweixo_hz_xmin)) (distof drweixo_hz_xgap)))
	vt_quant (fix (/ (- (distof drweixo_vt_ymax) (distof drweixo_vt_ymin)) (distof drweixo_vt_ygap)))
  )
  ;decimais dos textos
  (if (= 0 (- (distof drweixo_hz_xgap) (fix (distof drweixo_hz_xgap))))
    (setq graf_hz_txdec 0)
    (progn
      (setq graf_hz_txdec (getint "\nNúmero de casas decimais na numeração do eixo horizontal...<ENTER = 1>... "))
      (if (= nil graf_hz_txdec) (setq graf_hz_txdec 1))
    )
  )
  (if (= 0 (- (distof drweixo_vt_ygap) (fix (distof drweixo_vt_ygap))))
    (setq graf_vt_txdec 0)
    (progn
      (setq graf_vt_txdec (getint "\nNúmero de casas decimais na numeração do eixo vertical...<ENTER = 1>... "))
      (if (= nil graf_vt_txdec) (setq graf_vt_txdec 1))
    )
  )
  ;linetype da grade
  (setq grf_grdlty (list "Continuous" "hidden" "hidden2")
	grid_ltype (nth (fix (distof graf_glt)) grf_grdlty)
  )
  ;eixo horizontal
  (setq hz_pt_final (polar pt0 0 (- (distof drweixo_hz_xmax) (distof drweixo_hz_xmin)))
	hz_text (distof drweixo_hz_xmin)
  )
  (setvar "cecolor" graf_grd)
  (command "._line" "_non" pt0 "_non" hz_pt_final "")
  (command "._chprop" (entlast) "" "_p" "_lt" grid_ltype ""
	   "._array"  (entlast) "" "r" (1+ vt_quant) "1" (* vt_factor (distof drweixo_vt_ygap))
	   "._chprop" "_p" "" "_p" "_c" graf_eix "_lt" "bylayer" ""
  )
  (setq px pt0
	hz_text (distof drweixo_hz_xmin)
	px_text (polar px (/ (* 3 pi) 2) (*  0.3 cn7_blkscl))
  )
  (setvar "cecolor" graf_tik)
  (command "._line" "_non" px "_non" (polar px (/ (* 3 pi) 2) (*  0.2 cn7_blkscl)) "")
  (setvar "cecolor" graf_txc)
  (command "._text" "_s" cn7_txtsty "_tc" "_non" px_text cn7_txth 0 (rtos hz_text 2 graf_hz_txdec))
  (repeat hz_quant
    (setq px (polar px 0 (distof drweixo_hz_xgap))
	  px_text (polar px (/ (* 3 pi) 2) (*  0.3 cn7_blkscl))
	  hz_text (+ hz_text (distof drweixo_hz_xgap))
    )
    (setvar "cecolor" graf_tik)
    (command "._line" "_non" px "_non" (polar px (/ (* 3 pi) 2) (*  0.2 cn7_blkscl)) "")
    (setvar "cecolor" graf_txc)
    (command "._text" "_s" cn7_txtsty "_tc" "_non" px_text cn7_txth 0 (rtos hz_text 2 graf_hz_txdec) )
  )
  ;eixo vertical
  (setq vt_pt_final (polar pt0 (/ pi 2) (* vt_factor (- (distof drweixo_vt_ymax) (distof drweixo_vt_ymin))))
	vt_text (distof drweixo_vt_ymin)
  )
  (setvar "cecolor" graf_grd)
  (command "._line" "_non" pt0 "_non" vt_pt_final "")
  (command "._chprop" (entlast) "" "_p" "_lt" grid_ltype ""
	   "._array"  (entlast) "" "r" "1" (1+ hz_quant) (distof drweixo_hz_xgap)
	   "._chprop" "_p" "" "_p" "_c" graf_eix ""
  )
  (setq py pt0
	vt_text (distof drweixo_vt_ymin)
	py_text (polar py pi (*  0.3 cn7_blkscl))
  )
  (setvar "cecolor" graf_tik)
  (command "._line" "_non" py "_non" (polar py pi (*  0.2 cn7_blkscl)) "")
  (setvar "cecolor" graf_txc)
  (command "._text" "_s" cn7_txtsty "_mr" "_non" py_text cn7_txth 0 (rtos vt_text 2 graf_vt_txdec))
  (repeat vt_quant
    (setq py (polar py (/ pi 2) (* vt_factor (distof drweixo_vt_ygap)))
	  py_text (polar py pi (*  0.3 cn7_blkscl))
	  vt_text (+ vt_text (distof drweixo_vt_ygap))
    )
    (setvar "cecolor" graf_tik)
    (command "._line" "_non" py "_non" (polar py pi (*  0.2 cn7_blkscl)) "")
    (setvar "cecolor" graf_txc)
    (command "._text" "_s" cn7_txtsty "_mr" "_non" py_text cn7_txth 0 (rtos vt_text 2 graf_vt_txdec))
  )
  (command "._insert" (strcat cnp_root "/blocos/graf_capt") "_s" cn7_blkscl "_non" pt0 0
	   drweixo_hz_scal drweixo_hz_xmin drweixo_hz_xmax drweixo_hz_xgap
	   drweixo_vt_scal drweixo_vt_ymin drweixo_vt_ymax drweixo_vt_ygap
  )
  (devolve)
)



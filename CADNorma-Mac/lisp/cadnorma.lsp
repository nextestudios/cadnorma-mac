;formatação do texto para distâncias
(defun c:txdist () (cn7_cfgmain_txdist)(princ))

;distribuidor
(defun cn7_cfgmain_txdist ()
  (cn7_cfg_txdist_file)
  (cn7_cfg_txdist)
  (if (= cn7_cfgmain_return 1) (cn7_cfg_main))
)

;lê os valores iniciais da DCL no arquivo de dados
(defun cn7_cfg_txdist_file ()
  (if (findfile (strcat cnp_root "/config/txdist.txt"))
    (cn7_txdist_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/txdist.txt") "w" "utf8"))
      (write-line "3" file)
      (write-line "2" file)
      (write-line "2" file)
      (write-line "1" file)
      (write-line "2" file)
      (write-line "0" file)
      (close file)
      (cn7_txdist_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun cn7_txdist_readfile ()
  (setq	file (open (strcat cnp_root "/config/txdist.txt") "r" "utf8"))
  (setq	txdist_sty (read-line file))
  (setq	txdist_dec (read-line file))
  (setq	txdist_und (read-line file))
  (setq	txdist_wrt (read-line file))
  (setq	txdist_col (read-line file))
  (setq	txdist_spc (read-line file))
  (close file)
)

;controle da DCL
(defun cn7_cfg_txdist ()
;abre a dcl
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_txdist" dcl_id)) (exit))
  ;estilo
  (setq txdist_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (start_list "txdist_style")
  (mapcar 'add_list txdist_stylist)
  (end_list)
  (set_tile "txdist_style" txdist_sty)
  (action_tile "txdist_style" "(setq txdist_sty $value)")
  ;decimais
  (setq txdist_declist (list "0" "0.0" "0.00" "0.000" "0.0000" "0.00000"
			     "0.000000" "0.0000000" "0.00000000"))
  (start_list "txdist_decimals")
  (mapcar 'add_list txdist_declist)
  (end_list)
  (set_tile "txdist_decimals" txdist_dec)
  (action_tile "txdist_decimals" "(setq txdist_dec $value)")
  ;unidades
  (setq txdist_untlist (list "mm" "cm" "m" "km"))
  (start_list "txdist_unit")
  (mapcar 'add_list txdist_untlist)
  (end_list)
  (set_tile "txdist_unit" txdist_und)
  (action_tile "txdist_unit" "(setq txdist_und $value)")
  ;cor do texto
  (start_image "txdist_color")
  (fill_image  0  0
    (dimx_tile "txdist_color")
    (dimy_tile "txdist_color")
    (fix (distof txdist_col))
  )
  (end_image)
  (action_tile "txdist_color" "(txdist_txcol)")
  ;tobble escrever ou não
  (set_tile "txdist_write" txdist_wrt)
  (if (= txdist_wrt "0") (mode_tile "txdist_space" 1))
  (action_tile "txdist_write" "(txa_writext)")
  ;toggle espaço entre o texto e a unidade
  (set_tile "txdist_space" txdist_spc)
  (action_tile "txdist_space" "(setq txdist_spc $value)")
  ;ações
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq cn_txdist_dialog (start_dialog))
  (unload_dialog dcl_id)
;o que fazer depois
  (if (= 1 cn_txdist_dialog) (cn7_txdist_ok))
)

;ação do toggle "escrever unidade"
(defun txa_writext ()
  (setq txdist_wrt $value)
  (if (= txdist_wrt "0")
    (mode_tile "txdist_space" 1)
    (mode_tile "txdist_space" 0)
  )
)

;***************************************************
;botão "OK"
;salva o arquivo
;***************************************************
(defun cn7_txdist_ok ()
  (setq file2 (open (strcat cnp_root "/config/txdist.txt") "w" "utf8"))
  (write-line txdist_sty file2)
  (write-line txdist_dec file2)
  (write-line txdist_und file2)
  (write-line txdist_wrt file2)
  (write-line txdist_col file2)
  (write-line txdist_spc file2)
  (close file2)
)

;escolher cor do texto
(defun txdist_txcol ()
  (setq txdist_newcol (acad_colordlg (fix (distof txdist_col))))
  (if (/= nil txdist_newcol) (setq txdist_col (rtos txdist_newcol 2 0)))
  (start_image "txdist_color")
  (fill_image  0  0
    (dimx_tile "txdist_color")
    (dimy_tile "txdist_color")
    (fix (distof txdist_col))
  )
  (end_image)
)

(defun dist_text ()
  (cn7_cfg_txdist_file)
  (setq osmo (getvar "osmode"))
  (setvar "osmode" 0)
  (initget 128)
  (setq pt1 (getpoint "\nEditar existente/Formatar texto/<Ponto do texto>..."))
  (setvar "osmode" osmo)
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (dist_find_text)
     (dist_writext)
    )
    ((= 'STR  (type pt1))
     (cond       
       ((= "E" (strcase pt1))
	(prompt "\nSelecione o texto a ser editado... ")
	(setq s2 (entsel))
	(dist_find_text)
	(entmod (subst (cons 1 dist_txt) (assoc 1 (entget (car s2))) (entget (car s2))))
       )
       ((= "F" (strcase pt1))
	(cn7_cfgmain_txdist)
	(dist_text)
       )
       (t
	(prompt "\nOpção inválida... ")
	(devolve)
	(d2p_action)
       )
     )
    )
    (t (exit))
  );cond
)


;encontra o texto exato
(defun dist_find_text ()
  ;decimais
  (setq dist_dec (fix (distof txdist_dec)))
  ;valor
  (setq dist_num (getvar "distance"))
  (cond
    ;se a unidade de desenho é metos
    ((= cn7_dwgunit 1.0)
     (cond
       ((= txdist_und "0") (setq dist_value (* dist_num 1e3) dist_sufix "mm"))
       ((= txdist_und "1") (setq dist_value (* dist_num 1e2) dist_sufix "cm"))
       ((= txdist_und "2") (setq dist_value (* dist_num 1.0) dist_sufix "m"))
       ((= txdist_und "3") (setq dist_value (/ dist_num 1e3) dist_sufix "km"))
     )
    )
    ;se a unidade de desenho é centímetos
    ((= cn7_dwgunit 100.0)
     (cond
       ((= txdist_und "0") (setq dist_value (* dist_num 1e1) dist_sufix "mm"))
       ((= txdist_und "1") (setq dist_value (* dist_num 1.0) dist_sufix "cm"))
       ((= txdist_und "2") (setq dist_value (/ dist_num 1e2) dist_sufix "m"))
       ((= txdist_und "3") (setq dist_value (/ dist_num 1e5) dist_sufix "km"))
     )
    )
    ;se a unidade de desenho é milímetos
    ((= cn7_dwgunit 1000.0)
     (cond
       ((= txdist_und "0") (setq dist_value (* dist_num 1.0) dist_sufix "mm"))
       ((= txdist_und "1") (setq dist_value (/ dist_num 1e1) dist_sufix "cm"))
       ((= txdist_und "2") (setq dist_value (/ dist_num 1e3) dist_sufix "m"))
       ((= txdist_und "3") (setq dist_value (/ dist_num 1e6) dist_sufix "km"))
     )
    )
  );cond
  ;texto final
  (if (= txdist_wrt "0")
    (setq dist_txt (rtos dist_value 2 dist_dec))
    (if (= txdist_spc "0")
      (setq dist_txt (strcat (rtos dist_value 2 dist_dec) dist_sufix))
      (setq dist_txt (strcat (rtos dist_value 2 dist_dec) " " dist_sufix))
    )
  )
)

;escreve, efetivamente, o texto
(defun dist_writext ()
  ;ponto de inserção
  (setq psimb_txt pt1)
  ;estilo
  (setq txdist_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (setq dist_sty (nth (fix (distof txdist_sty)) txdist_stylist))
  (setq dist_ang (/ (* (angle p1 p2) 180.0) pi))
  (if (= nil dist_ang) (setq dist_ang 0.0))
  (cn7_txsimb dist_sty "c" dist_txt (fix (distof txdist_col)) "Distâncias" dist_ang)
)



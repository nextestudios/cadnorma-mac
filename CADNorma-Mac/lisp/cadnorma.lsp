    (if (/= counter (fix (distof prt_cfglarg_sel)))
      (setq new_list (append new_list (list (nth counter prt_larg_list))))
    )
    (setq counter (1+ counter))
  )
  (setq prt_larg_list new_list)
  (start_list "prt_cfglarg_list")
  (mapcar 'add_list prt_larg_list)
  (end_list)
  (set_tile "prt_cfglarg_list" prt_cfglarg_sel)
)
	    


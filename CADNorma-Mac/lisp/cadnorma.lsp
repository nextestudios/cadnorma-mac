(defun cn7_insert_point ()
  (initget 128)
  (setq pt1 (getpoint "\nMeio de 2 pontos/<Ponto de inserção...>"))
  (cond
    ((= 'LIST (type pt1))
     (setq pt1 pt1)
     )
    ((= 'STR  (type pt1))
     (cond
       ((or (= "M" (strcase pt1)) (= "2" (strcase pt1)))
	(setq pt2 (getpoint "\nPrimeiro ponto, de dois...")
	      pt3 (getpoint pt2 "\nSegundo ponto, de dois...")
	      pt1 (polar pt2 (angle pt2 pt3) (/ (distance pt2 pt3) 2)))
	)
       (t (prompt "\nOpção inválida! Digite 'M' ou marque o primeiro ponto...")
	(cn7_insert_point)
	)
       )
     )
    )
  )






;testa a visibilidade
(defun jnl_test_visible ()
  (if (= jnl_visible 1)
    (progn
      (cn7_verylayer jnl_layc_vil 7)
      (setvar "cecolor" jnl_layc_vic)
    )
    (progn
      (cn7_verylayer jnl_layc_prl 7)

;***********************************
;identificação das janelas          
;***********************************
(defun c:idj () (jnl_identify))

(defun jnl_identify ()
  (jnl_iden_file)
  (setq dzinmo (getvar "dimzin"))
  (setvar "dimzin" 4)
  (setq jnl_iden_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			       "t1" "t2" "t3" "t4" "t5" "t6" "t7")
	jnl_doiden_sty (nth (fix (distof jnl_iden_sty)) jnl_iden_stylist)
  )
  ;texto de largura
  (setq jnl_iden_prefix "" jnl_iden_larg jnl_larg)
  (cond
    ((= cn7_dwgunit 1.0);desenho em metros
     (if (> jnl_iden_larg 1.0)
       (setq jnl_doiden_larg (rtos jnl_iden_larg 2 2))
       (setq jnl_doiden_larg (rtos (* jnl_iden_larg 100.0) 2 0))
     )
    )
    ((= cn7_dwgunit 100.0);desenho em centímetros
     (setq jnl_doiden_larg (rtos (* jnl_iden_larg 1.0) 2 0))
    )
    ((= cn7_dwgunit 1000.0);desenho em milímetros
     (setq jnl_doiden_larg (rtos (/ jnl_iden_larg 10.0) 2 0))
    )
  )
  ;texto da altura
  (setq jnl_doiden_halt (nth (fix (distof jnl_var_halt)) jnl_halt_list)
	jnl_doiden_halt (/ (distof jnl_doiden_halt) 100.0)
  )
  (if (> jnl_doiden_halt 1.0)
    (setq jnl_doiden_halt (rtos jnl_doiden_halt 2 2))
    (setq jnl_doiden_halt (rtos (* jnl_doiden_halt 100.0) 2 0))
  )
  (setvar "dimzin" dzinmo)
  ;define o texto pelo tipo de identificação
  (cond
    ((or (= jnl_iden_typ "11") (= jnl_iden_typ "21") (= jnl_iden_typ "22"))
     (if (= jnl_var_lrad "jnl_larg_radio1")
       (setq jnl_iden_text1 (strcat jnl_iden_prefix jnl_doiden_larg "x" jnl_doiden_halt))
       (setq jnl_iden_text1 (strcat "%%c"jnl_iden_prefix jnl_doiden_larg))
     )
    )
    ((= jnl_iden_typ "13")
     (if (= jnl_var_lrad "jnl_larg_radio1")
       (setq jnl_iden_text1 (strcat "J(" jnl_iden_prefix jnl_doiden_larg ")"))
       (setq jnl_iden_text1 (strcat "J(%%c" jnl_iden_prefix jnl_doiden_larg ")"))
     )
    )
  )
  (if (or (= jnl_iden_typ "21") (= jnl_iden_typ "22") (= jnl_iden_typ "23"))
     (jnl_iden_getcode)
  )
  (jnl_iden_write)
)

;escreve o texto identificador
(defun jnl_iden_write ()
  (setq pt1 nil psimb_txt nil jnl_iden_ang nil)
  (setq psimb_txt (getpoint "\nPonto de inserção do identificador..."))
  (initget 128)
  (setq pt1 (getpoint psimb_txt "\nAlinhado/Ortogonal/<Ângulo do identificador (ENTER=0)>: "))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setq jnl_iden_ang (angle psimb_txt pt1))
    )
    ((= 'STR  (type pt1))
     (cond       
       ((= "A" (strcase pt1))
	(setq jnl_iden_ang jnl_angbase)
       )
       ((= "O" (strcase pt1))
	(setq jnl_iden_ang (+ jnl_angortho pi))
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto, digite <A> ou <R> para determinar o ângulo...")
	(jnl_iden_write)
       )
     )
   )
  )
  (if (= jnl_iden_ang nil) (setq jnl_iden_ang 0.0))
  (if (> jnl_iden_ang (* 2 pi)) (setq jnl_iden_ang (- jnl_iden_ang (* 2 pi))))
  (setq jnl_saveang jnl_iden_ang
	jnl_iden_ang (/ (* 180 jnl_iden_ang) pi)
  )
  (if (and (> jnl_iden_ang 90) (<= jnl_iden_ang 270))
    (setq jnl_iden_ang (+ jnl_iden_ang 180))
  )
  (setvar "celtype" "bylayer")
  (setvar "cecolor" "bylayer")
  (cond
    ((= jnl_iden_typ "11")
     (cn7_txsimb jnl_doiden_sty "_c" jnl_iden_text1 (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
    )
    ((= jnl_iden_typ "12")
     (if (= jnl_var_lrad "jnl_larg_radio1")
       (progn
	 (cn7_txsimb jnl_doiden_sty "_c" jnl_doiden_larg (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
	 (setq pt1 psimb_txt)
	 (setq psimb_txt (polar psimb_txt (/ (* pi (- jnl_iden_ang 90)) 180) (* cn7_txth 2)))
	 (cn7_txsimb jnl_doiden_sty "_c" jnl_doiden_halt (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
	 (setq pt2 (polar pt1 (angle pt1 psimb_txt) (/ (distance pt1 psimb_txt) 4))
	       pt3 (polar pt2 jnl_saveang (* cn7_txth 2.5))
	       pt4 (polar pt2 (+ jnl_saveang pi) (* cn7_txth 2.5))
	 )
	 (cn7_verylayer (strcat cn7_prefixlay jnl_iden_lay) (fix (distof jnl_iden_col)))
	 (command "._line" "_non" pt3 "_non" pt4 "")
       )
       (progn
	 (cn7_txsimb jnl_doiden_sty "_c" (strcat "%%c" jnl_doiden_larg)
	   (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
	 (setq pt1 psimb_txt)
	 (setq psimb_txt (polar psimb_txt (/ (* pi (- jnl_iden_ang 90)) 180) (* cn7_txth 2)))
;;;	 (cn7_txsimb jnl_doiden_sty "_c" jnl_doiden_halt (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
	 (setq pt2 (polar pt1 (angle pt1 psimb_txt) (/ (distance pt1 psimb_txt) 4))
	       pt3 (polar pt2 jnl_saveang (* cn7_txth 2.5))
	       pt4 (polar pt2 (+ jnl_saveang pi) (* cn7_txth 2.5))
	 )
	 (cn7_verylayer (strcat cn7_prefixlay jnl_iden_lay) (fix (distof jnl_iden_col)))
	 (command "._line" "_non" pt3 "_non" pt4 "")
       )
     )
    )
    ((= jnl_iden_typ "13")
     (cn7_txsimb jnl_doiden_sty "_c" jnl_iden_text1 (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
    )
    ((= jnl_iden_typ "21")
     (cn7_txsimb jnl_doiden_sty "_c" jnl_iden_code1 (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
     (setq pt1 psimb_txt)
     (setq psimb_txt (polar psimb_txt (/ (* pi (- jnl_iden_ang 90)) 180) (* cn7_txth 2)))
     (cn7_txsimb jnl_doiden_sty "_c" jnl_iden_text1 (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
     (setq pt2 (polar pt1 (angle pt1 psimb_txt) (/ (distance pt1 psimb_txt) 4))
	   pt3 (polar pt2 jnl_saveang (* cn7_txth 4.0))
	   pt4 (polar pt2 (+ jnl_saveang pi) (* cn7_txth 4.0))
     )
     (cn7_verylayer (strcat cn7_prefixlay jnl_iden_lay) (fix (distof jnl_iden_col)))
     (command "._line" "_non" pt3 "_non" pt4 "")
    )
    ((= jnl_iden_typ "22")
     (cn7_txsimb jnl_doiden_sty "_c" (strcat jnl_iden_code1 "(" jnl_iden_text1 ")")
       (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
    )
    ((= jnl_iden_typ "23")
     (cn7_txsimb jnl_doiden_sty "_c" jnl_iden_code1 (fix (distof jnl_iden_col)) jnl_iden_lay jnl_iden_ang)
    )
   );cond
)

	

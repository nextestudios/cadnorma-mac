;funções para salvar e resgatar os osnaps preferidos

;salva o osnap atual
(defun c:oss ()
  (setq myosnap (getvar "osmode"))
  (setq open_file (open (strcat cnp_root "/config/myosnap.txt") "w" "utf8"))
  (write-line (rtos (getvar "osmode") 2 0) open_file)
  (close open_file)
  (princ)
)

;resgata o osnap do usuário
(if (not (findfile (strcat cnp_root "/config/myosnap.txt")))
  (progn
    (setq open_file (open (strcat cnp_root "/config/myosnap.txt") "w" "utf8"))
    (write-line "255" open_file)
    (close open_file)
    (setvar "osmode" 255)
  )
  (progn
    (setq open_file (open (strcat cnp_root "/config/myosnap.txt") "r" "utf8"))
    (setq myosnap (fix (distof (read-line open_file))))
    (close open_file)
  )
)


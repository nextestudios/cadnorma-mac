(defun cn7_cfg_aldim ()
;abre a dcl
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_aldim" dcl_id)) (exit))
  ;inutilização dos slides
  (mode_tile "aldim_linear_img" 1)
  (mode_tile "aldim_angular_img" 1)
  ;Lineares
  (setq cn7_cfg_aldim_blk (list "Archtick" "Dot" "Open30" "Open90" "Closed Filled" "Tick"))
  (start_list "aldim_linear_popup")
  (mapcar 'add_list cn7_cfg_aldim_blk)
  (end_list)
  (set_tile "aldim_linear_popup" aldim_blk1)
  (setq x (dimx_tile "aldim_linear_img") y (dimy_tile "aldim_linear_img"))
  (start_image "aldim_linear_img")
  (fill_image 0 0 x y -2)
  (end_image)
  (start_image "aldim_linear_img")
  (cond
    ((= "0" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_archtick.sld")))
    ((= "1" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_dot.sld")))
    ((= "2" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_open30.sld")))
    ((= "3" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_open90.sld")))
    ((= "4" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_closed.sld")))
    ((= "5" aldim_blk1) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_tick.sld")))
  )
  (end_image)
  (action_tile "aldim_linear_popup" "(aldim_poplin_updslide)")

  ;angulares
  (start_list "aldim_angular_popup")
  (mapcar 'add_list cn7_cfg_aldim_blk)
  (end_list)
  (set_tile "aldim_angular_popup" aldim_blk2)
  (setq x (dimx_tile "aldim_angular_img") y (dimy_tile "aldim_angular_img"))
  (start_image "aldim_angular_img")
  (fill_image 0 0 x y -2)
  (end_image)
  (start_image "aldim_angular_img")
  (cond
    ((= "0" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_archtick.sld")))
    ((= "1" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_dot.sld")))
    ((= "2" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_open30.sld")))
    ((= "3" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_open90.sld")))
    ((= "4" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_closed.sld")))
    ((= "5" aldim_blk2) (slide_image 0 0 x y (strcat cnp_root "/slides/aldim_tick.sld")))
  )
  (end_image)
  (action_tile "aldim_angular_popup" "(aldim_popang_updslide)")
  
  ;lista de estilos
  (setq aldim_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			    "t1" "t2" "t3" "t4" "t5" "t6" "t7"))
  (start_list "aldim_txt_sty")
  (mapcar 'add_list aldim_stylist)
  (end_list)
  (set_tile "aldim_txt_sty" aldim_txst)
  (action_tile "aldim_txt_sty" "(setq aldim_txst $value)")

  ;lista de Supressão de zeros
  (setq aldim_zerlist (list "à esquerda" "à direita" "ambos" "nenhum"))
  (start_list "aldim_txt_zer")
  (mapcar 'add_list aldim_zerlist)
  (end_list)
  (set_tile "aldim_txt_zer" aldim_dzin)
  (action_tile "aldim_txt_zer" "(setq aldim_dzin $value)")

  ;Número de Casas Decimais
  (setq aldim_declist (list "0" "0.0" "0.00" "0.000" "0.0000" "0.00000"
			     "0.000000" "0.0000000" "0.00000000"))
  (start_list "aldim_txt_dec")
  (mapcar 'add_list aldim_declist)
  (end_list)
  (set_tile "aldim_txt_dec" aldim_ddec)
  (action_tile "aldim_txt_dec" "(setq aldim_ddec $value)")

  ;Separador de Decimais
  (setq aldim_seplist (list "Ponto" "Vírgula"))
  (start_list "aldim_txt_sep")
  (mapcar 'add_list aldim_seplist)
  (end_list)
  (set_tile "aldim_txt_sep" aldim_dsep)
  (action_tile "aldim_txt_sep" "(setq aldim_dsep $value)")

  ;cor do texto
  (start_image "aldim_txt_color")
  (fill_image  0  0
    (dimx_tile "aldim_txt_color")
    (dimy_tile "aldim_txt_color")
    (fix (distof aldim_tcol))
  )
  (end_image)
  (action_tile "aldim_txt_color" "(aldim_txcol)")

  ;cor das linhas
  (start_image "aldim_lines_color")
  (fill_image  0  0
    (dimx_tile "aldim_lines_color")
    (dimy_tile "aldim_lines_color")
    (fix (distof aldim_dcol))
  )
  (end_image)
  (action_tile "aldim_lines_color" "(aldim_lncol)")

  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq cn_aldim_dialog (start_dialog))
  (unload_dialog dcl_id)
;o que fazer depois
  (if (= 1 cn_aldim_dialog) (cn7_aldim_ok))
)



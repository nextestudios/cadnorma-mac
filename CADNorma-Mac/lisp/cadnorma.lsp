;***********************************
;identificação das portas
;***********************************
(defun c:idp () (prt_identify))

(defun prt_identify ()
  (prt_iden_file)
  (setq dzinmo (getvar "dimzin"))
  (setvar "dimzin" 4)
  (setq prt_iden_stylist (list "r50" "r60" "r70" "r80" "r90" "r100" "r120" "r140" "r175" "r200"
			       "t1" "t2" "t3" "t4" "t5" "t6" "t7")
	prt_doiden_sty (nth (fix (distof prt_iden_sty)) prt_iden_stylist)
  )
  ;texto de largura
  (cond
    ((or (= prt_var_tipo "11") (= prt_var_tipo "13") (= prt_var_tipo "14")
	 (= prt_var_tipo "21") (= prt_var_tipo "23") (= prt_var_tipo "41") (= prt_var_tipo "43"))
     (setq prt_iden_prefix "" prt_iden_larg prt_larg))
    ((or (= prt_var_tipo "12") (= prt_var_tipo "31") (= prt_var_tipo "42") (= prt_var_tipo "44"))
     (setq prt_iden_prefix "2x" prt_iden_larg (/ prt_larg 2.0)))
    ((= prt_var_tipo "22") (setq prt_iden_prefix "2x" prt_iden_larg prt_larg))
    ((= prt_var_tipo "24") (setq prt_iden_prefix (strcat prt_pt24_qtd "x")
				 prt_iden_larg (/ prt_larg (distof prt_pt24_qtd))))
    ((= prt_var_tipo "32")
     (setq prt_iden_prefix "3x" prt_iden_larg (/ prt_larg 3.0)))
    ((= prt_var_tipo "33")
     (setq prt_iden_prefix "4x" prt_iden_larg (/ prt_larg 4.0)))
    ((= prt_var_tipo "34") (setq prt_iden_prefix (strcat prt_pt34_qtd "x")
				 prt_iden_larg (/ prt_larg (distof prt_pt34_qtd))))
  )
  (cond
    ((= cn7_dwgunit 1.0);desenho em metros
     (if (> prt_iden_larg 1.0)
       (setq prt_doiden_larg (rtos prt_iden_larg 2 2))
       (setq prt_doiden_larg (rtos (* prt_iden_larg 100.0) 2 0))
     )
    )
    ((= cn7_dwgunit 100.0);desenho em centímetros
     (setq prt_doiden_larg (rtos (* prt_iden_larg 1.0) 2 0))
    )
    ((= cn7_dwgunit 1000.0);desenho em milímetros
     (setq prt_doiden_larg (rtos (/ prt_iden_larg 10.0) 2 0))
    )
  )
  ;texto da altura
  (setq prt_doiden_halt (nth (fix (distof prt_var_halt)) prt_halt_list)
	prt_doiden_halt (/ (distof prt_doiden_halt) 100.0)
  )
  (if (> prt_doiden_halt 1.0)
    (setq prt_doiden_halt (rtos prt_doiden_halt 2 2))
    (setq prt_doiden_halt (rtos (* prt_doiden_halt 100.0) 2 0))
  )
  (setvar "dimzin" dzinmo)
  ;define o texto pelo tipo de identificação
  (cond
    ((or (= prt_iden_typ "11") (= prt_iden_typ "21") (= prt_iden_typ "22"))
     (setq prt_iden_text1 (strcat prt_iden_prefix prt_doiden_larg "x" prt_doiden_halt))
    )
    ((= prt_iden_typ "13")
     (setq prt_iden_text1 (strcat "P(" prt_iden_prefix prt_doiden_larg ")"))
    )
  )
  (if (or (= prt_iden_typ "21") (= prt_iden_typ "22") (= prt_iden_typ "23"))
     (prt_iden_getcode)
  )
  (prt_iden_write)
)

;escreve o texto identificador
(defun prt_iden_write ()
  (setq pt1 nil psimb_txt nil prt_iden_ang nil)
  (setq psimb_txt (getpoint "\nPonto de inserção do identificador..."))
  (initget 128)
  (setq pt1 (getpoint psimb_txt "\nAlinhado/Ortogonal/<Ângulo do identificador (ENTER=0)>: "))
  (cond
    ;se clicar num ponto
    ((= 'LIST (type pt1))
     (setq prt_iden_ang (angle psimb_txt pt1))
    )
    ((= 'STR  (type pt1))
     (cond       
       ((= "A" (strcase pt1))
	(setq prt_iden_ang prt_angbase)
       )
       ((= "O" (strcase pt1))
	(setq prt_iden_ang (+ prt_angortho pi))
       )
       (t
	(prompt "\nOpção inválida... Marque o ponto, digite <A> ou <R> para determinar o ângulo...")
	(prt_iden_write)
       )
     )
   )
  )
  (if (= prt_iden_ang nil) (setq prt_iden_ang 0.0))
  (if (> prt_iden_ang (* 2 pi)) (setq prt_iden_ang (- prt_iden_ang (* 2 pi))))
  (setq prt_saveang prt_iden_ang
	prt_iden_ang (/ (* 180 prt_iden_ang) pi)
  )
  (if (and (> prt_iden_ang 90) (<= prt_iden_ang 270))
    (setq prt_iden_ang (+ prt_iden_ang 180))
  )
  (cond
    ((= prt_iden_typ "11")
     (cn7_txsimb prt_doiden_sty "_c" prt_iden_text1 (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
    )
    ((= prt_iden_typ "12")
     (cn7_txsimb prt_doiden_sty "_c" prt_doiden_larg (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
     (setq pt1 psimb_txt)
     (setq psimb_txt (polar psimb_txt (/ (* pi (- prt_iden_ang 90)) 180) (* cn7_txth 2)))
     (cn7_txsimb prt_doiden_sty "_c" prt_doiden_halt (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
     (setq pt2 (polar pt1 (angle pt1 psimb_txt) (/ (distance pt1 psimb_txt) 4))
	   pt3 (polar pt2 prt_saveang (* cn7_txth 2.5))
	   pt4 (polar pt2 (+ prt_saveang pi) (* cn7_txth 2.5))
     )
     (cn7_verylayer (strcat cn7_prefixlay prt_iden_lay) (fix (distof prt_iden_col)))
     (command "._line" "_non" pt3 "_non" pt4 "")
    )
    ((= prt_iden_typ "13")
     (cn7_txsimb prt_doiden_sty "_c" prt_iden_text1 (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
    )
    ((= prt_iden_typ "21")
     (cn7_txsimb prt_doiden_sty "_c" prt_iden_code1 (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
     (setq pt1 psimb_txt)
     (setq psimb_txt (polar psimb_txt (/ (* pi (- prt_iden_ang 90)) 180) (* cn7_txth 2)))
     (cn7_txsimb prt_doiden_sty "_c" prt_iden_text1 (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
     (setq pt2 (polar pt1 (angle pt1 psimb_txt) (/ (distance pt1 psimb_txt) 4))
	   pt3 (polar pt2 prt_saveang (* cn7_txth 4.0))
	   pt4 (polar pt2 (+ prt_saveang pi) (* cn7_txth 4.0))
     )
     (cn7_verylayer (strcat cn7_prefixlay prt_iden_lay) (fix (distof prt_iden_col)))
     (command "._line" "_non" pt3 "_non" pt4 "")
    )
    ((= prt_iden_typ "22")
     (cn7_txsimb prt_doiden_sty "_c" (strcat prt_iden_code1 "(" prt_iden_text1 ")")
       (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
    )
    ((= prt_iden_typ "23")
     (cn7_txsimb prt_doiden_sty "_c" prt_iden_code1 (fix (distof prt_iden_col)) prt_iden_lay prt_iden_ang)
    )
   );cond
)

	

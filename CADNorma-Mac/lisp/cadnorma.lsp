;lê os dados iniciais da DCL no arquivo de dados
(defun cn7_cfg_limits_file ()
  (if (findfile (strcat cnp_root "/config/limites.txt"))
    (cn7_limits_readfile)
    (progn
      (setq file (open (strcat cnp_root "/config/limites.txt") "w" "utf8"))
      (write-line "40.00" file)
      (write-line "30.00" file)
      (write-line "0.00" file)
      (write-line "0.00" file)
      (close file)
      (cn7_limits_readfile)
    )
  )
)

;função que lê o arquivo de dados
(defun cn7_limits_readfile ()
  (setq	file (open (strcat cnp_root "/config/limites.txt") "r" "utf8")
	cn7_cfg_limits_largura	   (read-line file)
	cn7_cfg_limits_altura	   (read-line file)
	cn7_cfg_limits_x0	   (read-line file)
	cn7_cfg_limits_y0	   (read-line file)
  )
  (close file)
)


;DCL de controle dos limites a serem utilizados
(defun cn7_cfg_limits ()
;abre a dcl
  (setq dcl_id (load_dialog (strcat cnp_root "/lisp/cadnorma.dcl")))
  (if (not (new_dialog "cn7_cfg_limits" dcl_id)) (exit))
  ;preenche a DCL com os dados lidos
  ;largura
  (set_tile "cn7_cfg_limits_largura" cn7_cfg_limits_largura)
  (action_tile "cn7_cfg_limits_largura" "(cn7_lim_verilarg)")
  ;altura
  (set_tile "cn7_cfg_limits_altura" cn7_cfg_limits_altura)
  (action_tile "cn7_cfg_limits_altura" "(cn7_lim_verialt)")
  ;x0
  (set_tile "cn7_cfg_limits_x0" cn7_cfg_limits_x0)
  (action_tile "cn7_cfg_limits_x0" "(cn7_lim_verix0)")
  ;y0
  (set_tile "cn7_cfg_limits_y0" cn7_cfg_limits_y0)
  (action_tile "cn7_cfg_limits_y0" "(cn7_lim_veriy0)")
;ações dos botões
  (action_tile "cn7_cfg_limits_area" "(done_dialog 2)")
  (action_tile "cn7_cfg_limits_pick" "(done_dialog 3)")
  (action_tile "accept" "(done_dialog 1)")
  (action_tile "cancel" "(done_dialog 0)")
  (setq cn_limit_dialog (start_dialog))
  (unload_dialog dcl_id)
;o que fazer depois
  (if (= 0 cn_limit_dialog) (cn7_limit_ok))
  (if (= 1 cn_limit_dialog) (cn7_limit_ok))
  (if (= 2 cn_limit_dialog) (cn7_limits_pickarea))
  (if (= 3 cn_limit_dialog) (cn7_limits_pickpoint))
)

;botão pick_point
(defun cn7_limits_pickpoint ()
  (setq cn7_lim_pt1 (getpoint "\nEntre com o canto inferior esquerdo...")
	cn7_cfg_limits_x0 (rtos (nth 0 cn7_lim_pt1) 2 2)
	cn7_cfg_limits_y0 (rtos (nth 1 cn7_lim_pt1) 2 2)
  )
  (cn7_cfg_limits)
  (set_tile "cn7_cfg_limits_x0" cn7_cfg_limits_x0)
  (set_tile "cn7_cfg_limits_y0" cn7_cfg_limits_y0)
)
	

;botão pick area
(defun cn7_limits_pickarea ()
  (setq cn7_lim_pt1 (getpoint "\nEntre com o canto inferior esquerdo..."))
  (setq cn7_lim_pt2 (getcorner cn7_lim_pt1 "\nEntre com o canto superior direito..."))
  (setq cn7_cfg_limits_x0 (rtos (nth 0 cn7_lim_pt1) 2 2)
	cn7_cfg_limits_y0 (rtos (nth 1 cn7_lim_pt1) 2 2)
	cn7_cfg_limits_largura
	 (rtos (- (nth 0 cn7_lim_pt2) (distof cn7_cfg_limits_x0)) 2 2)
	cn7_cfg_limits_altura
	 (rtos (- (nth 1 cn7_lim_pt2) (distof cn7_cfg_limits_y0)) 2 2)
  )
  (cn7_cfg_limits)
  (set_tile "cn7_cfg_limits_largura" cn7_cfg_limits_largura)
  (set_tile "cn7_cfg_limits_altura" cn7_cfg_limits_altura)
  (set_tile "cn7_cfg_limits_x0" cn7_cfg_limits_x0)
  (set_tile "cn7_cfg_limits_y0" cn7_cfg_limits_y0)
) 




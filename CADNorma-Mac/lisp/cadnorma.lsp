;altera o layer de entidades gráficas
(defun cve_upxxx ()
  (setq counter 0
	n_xxxlist (length cve_xxxlist))
  
  (repeat n_xxxlist
    (setq ent_name (nth counter cve_xxxlist)
	  ent_list (entget ent_name)
	  ent_layer (cdr (assoc 8 ent_list))
	  n_oldlayer (strlen ent_layer)
	  counter2 1
	  oldprefix "")
    (while (/= "-" (substr ent_layer counter2 1))
      (setq oldprefix (strcat oldprefix (substr ent_layer counter2 1))
	    counter2 (1+ counter2)
      )
    )
    (setq counter2 (1+ counter2)
	  layer_sufix (substr ent_layer counter2))
;;;    (cve_ent_verycolor layer_sufix)
    (cn7_verylayer (strcat cn7_blk_prefixlay layer_sufix) lay_color)
    (setq ent_list (entmod (subst (cons 8 (strcat cn7_blk_prefixlay layer_sufix)) (assoc 8 ent_list) ent_list)))
    (setq cve_xxxlist (append cve_xxxlist (list s1_ent)))
    (setq counter (1+ counter))
  )
)


;conversão de textos
(defun cve_uptxt ()
  (setq n_element (length cve_txtlist) counter 0)
  (repeat n_element
    (setq s1_ent (nth counter cve_txtlist))
    ;determina o layer do texto
    (setq ent_list (entget s1_ent))
    ;determina o estilo do texto
    (setq curr_txtstyle (strcase (cdr (assoc 7 ent_list))))
    (cond
      ;estilo romans
      ((= curr_txtstyle "R50")
       (setq new_txtheight 1.25)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R60")
       (setq new_txtheight 1.5)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R70")
       (setq new_txtheight 1.75)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R80")
       (setq new_txtheight 2.0)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R90")
       (setq new_txtheight 2.25)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R100")
       (setq new_txtheight 2.5)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R120")
       (setq new_txtheight 3.0)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R140")
       (setq new_txtheight 3.5)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R175")
       (setq new_txtheight 4.375)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
       )
      ((= curr_txtstyle "R200")
       (setq new_txtheight 5.0)
       (cve_txt_chgsty)
       (cve_uptxt_checklay)
       (setq counter (1+ counter))
      )
      ;custom_text_styles
      ((= curr_txtstyle "T1")

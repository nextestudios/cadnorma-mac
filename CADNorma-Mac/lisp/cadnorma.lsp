  (setq pt1 (polar pt1 (angle pt2 pt1) (* cn7_blkscl 0.40)))
  (setvar "orthomode" 1)
  (command "._line" "_non" pt1 "_non" pt2 "")
  (command "._chprop" "_l" "" "_lt" "dashdot2" "")

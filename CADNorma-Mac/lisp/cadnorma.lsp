(defun C:DULXTRIM ( / edge linset side setsiz looper)
   (setvar "cmdecho" 0)
   (prompt "\nSelecione os limites de corte:  ")
   (setq edge (ssget))                                ;get the edge
   (prompt "\nSelecione elementos a cortar:  ")
   (setq linset (ssget)                               ;get the lines
         side (getpoint "\nSelecione lado para cortar:  ")     ;get the side
         setsiz (sslength linset)                     ;size of line set
         looper -1                                    ;initialize loop ptr
   )                                                  ;setq calculations
   (command "._trim" edge "")                           ;trim it
   (repeat setsiz                                     ;for all lines
      (setq looper (1+ looper))                       ;increment loop ptr
      (command (list (ssname linset looper) side))
   )                                                  ;repeat
   (command "")

   (setvar "cmdecho" 1)
  (princ)
)                                                     ;defun


(defun c:xtrim (/ p1 p2 e1 edge linset side setsiz looper)
    (setvar "cmdecho" 0)
    (prompt "\nDesenhe a linha cortante:  ")
    (setq p1 (getpoint))
    (setq p2 (getpoint p1))
    (command nil nil nil "._point" "@")
    (setq e1 (entlast))
    (entdel e1)
    (command "._line" "_non" p1 "_non" p2 "")
    (setq edge (entnext e1))
    (prompt "\nIndique os objetos para cortar:  ")
    (setq linset (ssget)
            side (getpoint "\nIndique o lado para cortar:  ")
            setsiz (sslength linset)
            looper -1
    )
    (command "._trim" edge "")
    (repeat setsiz
        (setq looper (1+ looper))
        (command (list (ssname linset looper) side))
    )
    (command "")
    (entdel edge)
    (command "._ortho" "_off")
    (setvar "cmdecho" 1)
    (princ)
)


(defun C:DULXEXTD(/ bou ent pt len cou)
 (setvar "CMDECHO" 0)

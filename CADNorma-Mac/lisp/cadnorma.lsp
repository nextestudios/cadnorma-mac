    ((/= nil (ssget "c" (nth 1 cn7_curvp_list) (nth 1 cn7_curvp_list)'((0 . "VIEWPORT"))))
     (setq cn7_cvp_list (entget (ssname (ssget "c" (nth 1 cn7_curvp_list) (nth 1 cn7_curvp_list)'((0 . "VIEWPORT"))) 0))))
    ((/= nil (ssget "c" (nth 1 cn7_curvp_list) (nth 1 cn7_curvp_list)'((0 . "VIEWPORT"))))
     (setq cn7_cvp_list (entget (ssname (ssget "c" (nth 1 cn7_curvp_list) (nth 1 cn7_curvp_list)'((0 . "LWPOLYLINE"))) 0))))
  )
  (if (and (> (cdr (assoc 90 cn7_cvp_list)) 49000) (< (cdr (assoc 90 cn7_cvp_list)) 50000))

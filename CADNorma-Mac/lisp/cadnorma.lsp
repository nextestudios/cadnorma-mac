;*****************************************
;Desenho de Portas                        
;*****************************************
(defun prt_drw22_porta ()
  (setq prt_porta2 (polar prt_porta1 (+ prt_angortho pi) (* prt_fator (distof prt_pt22_poe)))
	prt_porta3 (polar prt_porta2 prt_angbase prt_larg)
	prt_porta4 (polar prt_porta1 prt_angbase prt_larg)
  )
  (cn7_verylayer prt_layc_pol 7)
  (setvar "cecolor" prt_layc_poc)
  (command "._pline"  "_non" prt_porta1 "_non" prt_porta2  "_non" prt_porta3 "_non" prt_porta4 "_c"
	   "._mirror" (entlast) "" "_non" prt_mid1 "_non" prt_mid2 "_n"
  )
)


;*****************************************
;Desenho de Caixilho                      
;*****************************************

;caso 01 - porta externa
(defun prt_drw22a_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (setq prt_cxi1 (polar prt_brk1 prt_angbase prt_caix)
	    prt_cxi2 (polar prt_brk3 prt_angbase prt_caix)
	    prt_cxi3 (polar prt_brk2 (+ pi prt_angbase) prt_caix)
	    prt_cxi4 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
      )
      (command "._pline"  "_non" prt_brk1 "_non" prt_cxi1  "_non" prt_cxi2 "_non" prt_brk3 ""
	       "._pline"  "_non" prt_brk2 "_non" prt_cxi3  "_non" prt_cxi4 "_non" prt_brk4 ""
      )
      (setq prt_porta1 (polar prt_brk1 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_i1 (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
	    prt_sol_i2 (polar prt_brk2 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_e1 prt_cxi2
	    prt_sol_e2 prt_cxi4
      )
    )
    ;se o caixilho for nulo
    (progn
	(setq prt_porta1 (polar prt_brk1 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_i1 (polar prt_brk1 prt_angbase (/ prt_larg 2.0))
	    prt_sol_i2 (polar prt_brk2 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_e1 prt_brk3
	    prt_sol_e2 prt_brk4
      )
    )
  )
)

;caixilho para porta interna
(defun prt_drw22b_caixilho ()
  (cn7_verylayer prt_layc_cxl 7)
  (setvar "cecolor" prt_layc_cxc)
  (if (/= 0.0 prt_caix)
    (progn
      (setq prt_cxi1 (polar prt_brk5 prt_angbase prt_caix)
	    prt_cxi2 (polar prt_brk6 prt_angbase prt_caix)
	    prt_cxi3 (polar prt_brk7 prt_angbase prt_caix)
	    prt_cxi4 (polar prt_brk3 prt_angbase prt_caix)
	    prt_cxi5 (polar prt_brk8 (+ pi prt_angbase) prt_caix)
	    prt_cxi6 (polar prt_brk9 (+ pi prt_angbase) prt_caix)
	    prt_cxi7 (polar prt_brk0 (+ pi prt_angbase) prt_caix)
	    prt_cxi8 (polar prt_brk4 (+ pi prt_angbase) prt_caix)
      )
      (command "._pline" "_non" prt_brk5 "_non" prt_cxi1 "_non" prt_cxi2 ""
	       "._pline" "_non" prt_brk7 "_non" prt_cxi3 "_non" prt_cxi4 "_non" prt_brk3 ""
	       "._pline" "_non" prt_brk8 "_non" prt_cxi5 "_non" prt_cxi6 ""
	       "._pline" "_non" prt_brk0 "_non" prt_cxi7 "_non" prt_cxi8 "_non" prt_brk4 ""
      )
      (setq prt_porta1a (polar prt_brk5 prt_angbase (/ prt_larg 2.0))
	    prt_porta1 (polar prt_porta1a prt_angortho (* prt_fator (distof prt_pt22_poe)))
	    prt_sol_i1 prt_cxi1
	    prt_sol_i2 prt_porta1a
	    prt_sol_i3 prt_cxi5
	    prt_sol_i4 (polar prt_brk8 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_i5 (polar prt_sol_i2 prt_angbase prt_larg)
	    prt_sol_i6 (polar prt_sol_i4 (+ pi prt_angbase) prt_larg)
	    prt_sol_e1 prt_cxi4
	    prt_sol_e2 prt_cxi8
      )
    )
    ;se o caixilho for nulo
    (progn
      (setq prt_porta1a (polar prt_brk5 prt_angbase (/ prt_larg 2.0))
	    prt_porta1 (polar prt_porta1a prt_angortho (* prt_fator (distof prt_pt22_poe)))
	    prt_sol_i1 prt_brk5
	    prt_sol_i2 prt_porta1a
	    prt_sol_i3 prt_brk8
	    prt_sol_i4 (polar prt_brk8 (+ pi prt_angbase) (/ prt_larg 2.0))
	    prt_sol_i5 (polar prt_sol_i2 prt_angbase prt_larg)
	    prt_sol_i6 (polar prt_sol_i4 (+ pi prt_angbase) prt_larg)
	    prt_sol_e1 prt_brk3
	    prt_sol_e2 prt_brk4
	  )
    )
  )
)

;openfree especial para porta 22
(defun prt_drw22_openfree ()
  ;conversão de dados para numerais
  (prt_larg_file)
;;;  (setq prt_larg (* prt_fator (distof (nth (fix (distof prt_var_larg)) prt_larg_list))))
  (if (= prt_var_lrad "prt_larg_radio1")
    (setq prt_larg (* prt_fator (distof (nth (fix (distof prt_var_larg)) prt_larg_list))))
    (setq prt_larg (/ (* prt_fator (distof prt_var_lvao)) 2.0))
  )
  (prt_halt_file)
  (setq prt_halt (* prt_fator (distof (nth (fix (distof prt_var_halt)) prt_halt_list)))
	prt_afas (* prt_fator (distof prt_var_afas))
	prt_wall (* prt_fator (distof prt_var_wall))
	prt_caix (* prt_fator (distof prt_var_caix))
  )
  ;clica na parede
  (prompt "\nSelecione a parede interna...")
  (setq prt_entsel (entsel)
	prt_ent1 (car prt_entsel)
	prt_ent1_type (cdr (assoc 0 (entget prt_ent1)))
	prt_pt0 (nth 0 (cdr prt_entsel))
	prt_ptt1 (cdr (assoc 10 (entget prt_ent1)))
	prt_ptt2 (cdr (assoc 11 (entget prt_ent1)))
	prt_wall_layer (cdr (assoc 8 (entget prt_ent1)))
  )
  (if (/= "LINE" prt_ent1_type)
    (progn
      (alert "A entidade Selecionada não é uma 'LINE'.\nPOLYLINES devem ser explodidas\npara usar este comando...")
      (prt_drw22_openfree)
    )
  )
  (if (<= (distance prt_pt0 prt_ptt1) (distance prt_pt0 prt_ptt2))
    (setq prt_pt1 prt_ptt1 prt_pt2 prt_ptt2 prt_code 1)
    (setq prt_pt1 prt_ptt2 prt_pt2 prt_ptt1 prt_code 2)
  )
  (setq prt_angbase (angle prt_pt1 prt_pt2))
  ;verifica o posicionamento para determinar os pontos de quebra
  (if (= prt_var_posi "prt_center")
    (setq prt_doll (/ (- (distance prt_pt1 prt_pt2) (* 2 prt_larg) (* 2 prt_caix)) 2))
    (setq prt_doll prt_afas)
  )
  (setq
	prt_brk1 (polar prt_pt1 prt_angbase prt_doll)
	prt_brk2 (polar prt_brk1 prt_angbase (+ (* 2 prt_larg) (* 2 prt_caix)))
  )
  (if (= prt_code 1)
    (setq prt_brk3a (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk3b (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
    )
    (setq prt_brk3a (polar prt_brk1 (+ prt_angbase (/ pi 2)) prt_wall)
  	  prt_brk3b (polar prt_brk1 (- prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4a (polar prt_brk2 (+ prt_angbase (/ pi 2)) prt_wall)
	  prt_brk4b (polar prt_brk2 (- prt_angbase (/ pi 2)) prt_wall)
    )
  )
  (if (/= nil (ssget "_f" (list prt_brk3a prt_brk4a) (list (cons 8 prt_wall_layer))))
    (progn
      (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a prt_xcode 1)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 2)
	)
      )
    )
    (progn
      (setq prt_brk3 prt_brk3b prt_brk4 prt_brk4b prt_xcode 2)
      (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2)))
      (if (= nil (ssget "c" prt_brkm prt_brkm))
	(progn
	  (setq prt_brk3 prt_brk3a prt_brk4 prt_brk4a)
	  (setq prt_brkm (polar prt_brk3 (angle prt_brk3 prt_brk4) (/ (distance prt_brk3 prt_brk4) 2))
		prt_xcode 4)
	)
      )
    )
  )
  (setq prt_angortho (angle prt_brk1 prt_brk3))
  (command "._undo" "_m")
  (setq colmo (getvar "cecolor"))
  (if (= prt_pt22_pos "prt_22_pos_01")
    ;porta externa
    (progn
      (command "._break" prt_ent1 "_non" prt_brk1 "_non" prt_brk2)
      (command "._break" (ssget "c" prt_brkm prt_brkm) "_non" prt_brk3 "_non" prt_brk4)
      (command "._layer" "_s" prt_wall_layer "")
      (command "._line" "_non" prt_brk1 "_non" prt_brk3 ""
	       "._line" "_non" prt_brk2 "_non" prt_brk4 "")
    )
    ;porta interna
    (progn
      (setq prt_brk5 (polar prt_brk1 (+ prt_angbase pi) (+ prt_larg (* 2.0 prt_caix)))
	    prt_brk6 (polar prt_brk5 prt_angortho (* prt_fator (+ 1.5 (distof prt_pt22_poe))))
	    prt_brk7 (polar prt_brk6 prt_angbase (+ prt_larg (* 2.0 prt_caix)))
	    prt_brk8 (polar prt_brk2 prt_angbase (+ prt_larg (* 2.0 prt_caix)))
	    prt_brk9 (polar prt_brk8 prt_angortho (* prt_fator (+ 1.5 (distof prt_pt22_poe))))
	    prt_brk0 (polar prt_brk9 (+ prt_angbase pi) (+ prt_larg (* 2.0 prt_caix)))
      )
      (command "._break" prt_ent1 "_non" prt_brk5 "_non" prt_brk8)
      (command "._break" (ssget "c" prt_brkm prt_brkm) "_non" prt_brk3 "_non" prt_brk4)
      (command "._layer" "_s" prt_wall_layer "")
      (command "._line" "_non" prt_brk5 "_non" prt_brk6 "_non" prt_brk7 "_non" prt_brk3 ""
	       "._line" "_non" prt_brk8 "_non" prt_brk9 "_non" prt_brk0 "_non" prt_brk4 "")
    )
  )
  (setq prt_mid1 (polar prt_brk1 prt_angbase (/ (distance prt_brk1 prt_brk2) 2.0))
	prt_mid2 (polar prt_brk3 prt_angbase (/ (distance prt_brk3 prt_brk4) 2.0))
  )
)




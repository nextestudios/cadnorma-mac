;***********  Interpolação de pontos 2D  *************

(defun c:cvn () (setq desnivel (getreal "\nIntervalo entre as curvas de níveis...")) (princ))

;locação de pontos em 2D
(defun c:ip2 ()
  (if (= nil desnivel) (setq desnivel (getreal "Intervalo entre as curvas...")))
  (setq pt1 (getpoint "\nPrimeiro ponto..."))
  (princ "Selecione seu texto...")
  (setq txt1 (entsel))
  (setq pt2 (getpoint "\nSegundo ponto..."))
  (princ "Selecione seu texto...")
  (setq txt2 (entsel))
  (setq
    pt1_cota (atof (cdr (assoc 1 (entget (car txt1)))))
    pt2_cota (atof (cdr (assoc 1 (entget (car txt2)))))
  )
  (cn7_verylayer "Top_pontos_interpolados" 7)
  (if (< pt1_cota pt2_cota) (ip_crescente) (ip_decrescente))
  (ip_vizinhos)
  (if (> ip_nextmult ip_cota2)  (decide2) (define_pontos))
  (princ)
)

(defun decide2 ()
  	(while (/= nil (setq prox_pto (getpoint "\nPróximo ponto...")))
		(setq pt1 pt2)
	  	(setq txt1 txt2)
	  	(setq pt2 prox_pto)
	  	(princ "\nSelecione o texto respectivo...")
	  	(setq txt2 (entsel))
	  	(setq
		  	pt1_cota (atof (cdr (assoc 1 (entget (car txt1)))))
			pt2_cota (atof (cdr (assoc 1 (entget (car txt2)))))
		)
	  	(if (< pt1_cota pt2_cota) (ip_crescente) (ip_decrescente))
	  	(ip_vizinhos)
	  	(if (>= ip_nextmult ip_cota2) (decide2) (define_pontos))
	)
  	(exit)
  	(princ)
)

  
	  
(defun define_pontos ()
  	(setq n_ptos (1+ (/ (- ip_lastmult ip_nextmult) desnivel)))
  	(setq dt (sqrt (+
			 (expt (- ip_cota2 ip_cota1) 2)
			 (expt (- (nth 0 ip_pt1) (nth 0 ip_pt2)) 2)
			 (expt (- (nth 1 ip_pt1) (nth 1 ip_pt2)) 2)
			)
		 )
	);setq
        (setq dh (- ip_cota2 ip_cota1))
  	(loca_pto)
  	(decide_prox)
)

(defun decide_prox ()
  	(setq next_cota (+ desnivel ip_nextmult))
  	(setq ip_nextmult (+ desnivel ip_nextmult))
  	(if (> next_cota ip_cota2)
	  	(decide2)
	  	(progn
		  (setq dx_pad (/ (* desnivel dt) dh))
		  (setq dx_padp (/ (* dx_pad disth) dt))
  		  (setq pto1 (polar pto1 (angle ip_pt1 ip_pt2) dx_padp))
  		  (command "._point" "_non" pto1)
		)
	 )
    	(decide_prox)
)


(defun loca_pto ()
  	(setq disth (distance ip_pt1 ip_pt2))
  	(setq x (/ (* dt (- ip_nextmult ip_cota1)) dh))
  	(setq xp (/ (* disth x) dt))
  	(setq pto1 (polar ip_pt1 (angle ip_pt1 ip_pt2) xp))
  	(command "._point" "_non" pto1)
)

(defun ip_vizinhos ()
	;  calcula os vizinhos do ponto menor (pt1)
	(setq resto1 (- ip_cota1 (* desnivel (fix (/ ip_cota1 desnivel)))))
  	(setq ip_nextmult (+ ip_cota1 (- desnivel resto1)))
  	(setq resto2 (- ip_cota2 (* desnivel (fix (/ ip_cota2 desnivel)))))
	(setq ip_lastmult (- ip_cota2 resto2))
)
  
(defun ip_crescente ()
  	(setq
	  ip_pt1 pt1
	  ip_cota1 pt1_cota
	  ip_pt2 pt2
	  ip_cota2 pt2_cota
	)
)

(defun ip_decrescente ()
  	(setq
	  ip_pt1 pt2
	  ip_cota1 pt2_cota
	  ip_pt2 pt1
	  ip_cota2 pt1_cota
	)
)

;locação de pontos em 3D
(defun c:pt3 ()
  (cn7_init)
  (setq grp_type "2")
  (cn7_find_blkscl)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (while (/= nil (setq psimb_txt (getpoint "\nMarque um ponto na tela...")))
    (cn7_verylayer "Top_pontos_locados" 2)

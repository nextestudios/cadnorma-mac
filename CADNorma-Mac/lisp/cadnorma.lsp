;***********  Lança as coordenadas norte e leste de um ponto selecionado   *************
(defun c:ne_dec () (setq ne_dec (getint "\nNúmero de casas decimais <0,1,2,...> : ")) (princ))

(defun c:ne ();(/ n e pt1 pt2 pt3 pt4 pt4i osmo)
  (cn7_init)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (if (= nil ne_dec) (setq ne_dec (getint "\nNúmero de casas decimais <0,1,2,...> : ")))
  (setq osmo (getvar "osmode"))
  (setq laymo (getvar "clayer"))
  (initget 1)
  (setq pt1 (getpoint "\nOrigem da coordenada : "))
  (setq pt2 (getpoint pt1 "\nOnde  vai   escrever : ")
	e    (strcat "E: " (rtos (car  pt1) 2 ne_dec))
	n    (strcat "N: " (rtos (cadr pt1) 2 ne_dec))
        angrad (angle pt1 pt2)
        pt1a (polar pt1 angrad (* cn7_blkscl 0.2))
  )
  (if (>= (cos angrad) 0)
    (progn
      (setq pt3 (polar pt2 0 (* 0.2 cn7_blkscl))
	    pt4 (polar pt3 (/ pi 2) (* 0.1 cn7_blkscl))
	    )
      (setq psimb_txt pt4)
      (cn7_txsimb "r80" "" n 2 "Top_norte_leste" "0")
      (setq txt_ent (entlast)
	    tb (textbox (entget txt_ent))
	    ll (car tb)
	    ur (cadr tb)
	    lr (list (car ur) (cadr ll))
	    dist (distance ll lr)
      )
      (setq psimb_txt (polar psimb_txt (/ (* 3 pi) 2) (* 0.4 cn7_blkscl)))
      (cn7_txsimb "r80" "" e 2 "Top_norte_leste" "0")
      (cn7_verylayer (strcat cn7_prefixlay "Top_norte_leste") 2)
      (command "._pline" "_non" pt1 "_w" "0.0" (* cn7_blkscl 0.075) "_non" pt1a "_w" "0.0" "0.0" "_non" pt2 "_non" (polar pt3 0 (+ dist (* 0.2 cn7_blkscl)))
	       "" "._chprop" "_l" "" "_c" "1" "")
     )
    (progn
      (setq pt3 (polar pt2 pi (* 0.2 cn7_blkscl))
	    pt4 (polar pt3 (/ pi 2) (* 0.1 cn7_blkscl))
      )
      (setq psimb_txt pt4)
      (cn7_txsimb "r80" "" n 2 "Top_norte_leste" "0")
      (setq txt_ent (entlast)
	    tb (textbox (entget txt_ent))
	    ll (car tb)
	    ur (cadr tb)
	    lr (list (car ur) (cadr ll))
	    dist (distance ll lr)
	    ptxt (polar pt4 pi dist)
	    psimb_txt (polar ptxt (/ (* 3 pi) 2) (* 0.4 cn7_blkscl))
      )
      (command "._move" txt_ent "" "_non" pt4 "_non" ptxt)
      (cn7_txsimb "r80" "" e 2 "Top_norte_leste" "0")
      (command "._pline" "_non" pt1 "_w" "0.0" (* cn7_blkscl 0.075) "_non" pt1a "_w" "0.0" "0.0" "_non" pt2 "_non" (polar pt3 pi (+ dist (* 0.2 cn7_blkscl)))
	       "" "._chprop" "_l" "" "_c" "1" "")
    )      
  )
  (setvar "osmode" osmo)
  (setvar "clayer" laymo)
  (devolve)
  (princ)
)



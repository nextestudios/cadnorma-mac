(defun c:fio () (setq psimb_txt nil) (elet_fiacao 1) (princ))
(defun c:fio2 () (setq psimb_txt nil) (elet_fiacao 2) (princ))


(defun elet_fiacao (fio_tipo)
  (guarda '("blipmode" "cecolor" "celtype" "clayer" "cmdecho" "orthomode"
          "textstyle" "luprec" "osmode" ))
  (setq osmo (getvar "osmode"))
  (setq grp_type "2")
  (cn7_find_blkscl)
  (setvar "osmode" 512)
  (setq p1 (getpoint "\nPonto Inicial... ")
	rang (getangle p1 "\nDireção para representação...(ENTER=0)"))
  (if (= rang nil) (setq rang 0.0))
  (setq	comb (getstring T "\nSequencia da combinacao... (N F T R C ou <ESPAÇO>) ")
	ptxt (polar p1 (+ rang (/ pi 2)) (* cn7_blkscl 0.25))
	n (strlen comb)
	k1 1
  )
  (setvar "osmode" 0)
  (cn7_verylayer (strcat cn7_prefixlay "Ele_circuitos") 2)
  (while (<= k1 n)
    (setq letra (substr comb k1 1))
    (fnt_decide1)
    (setq k1 (1+ k1))
  );while
  (fnt_write_txt)
  (devolve)
);defun fnt

(defun fnt_decide1 ()
  (cond
    ((= (strcase letra) "F") (fnt_desenha_f))
    ((= (strcase letra) "N") (fnt_desenha_n))
    ((= (strcase letra) "R") (fnt_desenha_r))
    ((= (strcase letra) "T")
     (if (= fio_tipo 2) (fnt_desenha_t) (fnt_desenha_t2)))
    ((= (strcase letra) "C") (fnt_desenha_c))
    ((= (strcase letra) " ") (fnt_espaco))
  );cond
);defun

;espaço em branco
(defun fnt_espaco ()
    (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio neutro
(defun fnt_desenha_n ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_n") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
  (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio fase
(defun fnt_desenha_f ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_f") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
  (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio retorno
(defun fnt_desenha_r ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_r") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
  (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio terra tipo 1
(defun fnt_desenha_t ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_t") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
  (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio terra tipo 2
(defun fnt_desenha_t2 ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_t") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
  (setq p1 (polar p1 rang (* cn7_blkscl 0.1)))
)

;fio de campainha
(defun fnt_desenha_c ()
  (command "._insert" (strcat cnp_root "/blocos/ele_circ_c") "_s" cn7_blkscl p1 (/ (* rang 180) pi))
